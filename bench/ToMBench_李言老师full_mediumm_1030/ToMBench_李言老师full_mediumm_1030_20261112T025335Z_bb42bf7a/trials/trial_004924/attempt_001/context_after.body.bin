Content":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0052191936200298,"emotions":[],"relationId":"6af52bdec2ddb05a7fe3169c","courseProgressId":0,"tsGen":1794452446528,"createTime":"2026-11-12 11:00:46","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"11b4fcea2ebd4cbbb92f990643b7864e"}