Content":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004069363573846767,"emotions":[],"relationId":"6af52b76c2ddb05a7fe30624","courseProgressId":0,"tsGen":1794452342445,"createTime":"2026-11-12 10:59:02","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"ea4302721e2a408b95d0df402d60cb82"}