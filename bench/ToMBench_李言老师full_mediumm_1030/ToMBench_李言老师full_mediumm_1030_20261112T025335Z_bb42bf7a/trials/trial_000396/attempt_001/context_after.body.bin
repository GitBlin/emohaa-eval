ull,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.003172149081258851,"emotions":[],"relationId":"6af52a53c2ddb05a7fe2dcfc","courseProgressId":0,"tsGen":1794452051676,"createTime":"2026-11-12 10:54:11","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"0eb9d4dc619e404990112a5fabe1f45d"}