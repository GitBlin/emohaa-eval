l,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0028005357873580154,"emotions":[],"relationId":"6af52b6ec2ddb05a7fe30525","courseProgressId":0,"tsGen":1794452334047,"createTime":"2026-11-12 10:58:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"51211e0830f843b9bb76e38bf4b99d84"}