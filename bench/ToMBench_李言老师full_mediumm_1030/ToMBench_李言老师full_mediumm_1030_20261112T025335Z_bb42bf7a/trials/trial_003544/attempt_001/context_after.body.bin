ontent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012431648291982409,"emotions":[],"relationId":"6af52b6dc2ddb05a7fe30505","courseProgressId":0,"tsGen":1794452333226,"createTime":"2026-11-12 10:58:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"2cd1986643554b70bf7c5d6a47320c22"}