ll,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004609571529846373,"emotions":[],"relationId":"6af52a3ec2ddb05a7fe2d9d4","courseProgressId":0,"tsGen":1794452030808,"createTime":"2026-11-12 10:53:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"64e46516bb39431c8f341c10e2aaee7a"}