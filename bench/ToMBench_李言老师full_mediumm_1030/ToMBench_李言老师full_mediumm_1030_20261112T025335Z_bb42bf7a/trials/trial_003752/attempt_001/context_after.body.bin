l,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005911068943804929,"emotions":[],"relationId":"6af52b80c2ddb05a7fe307c1","courseProgressId":0,"tsGen":1794452352407,"createTime":"2026-11-12 10:59:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"a8df7d6763e9431584e4d6da38198b97"}