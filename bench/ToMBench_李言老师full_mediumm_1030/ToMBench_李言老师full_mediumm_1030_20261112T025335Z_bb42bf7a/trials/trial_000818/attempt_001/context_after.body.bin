xt":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0059100153262533475,"emotions":[],"relationId":"6af52a79c2ddb05a7fe2e263","courseProgressId":0,"tsGen":1794452089525,"createTime":"2026-11-12 10:54:49","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"d75710a48ed544fdadfc09c601f1bd0a"}