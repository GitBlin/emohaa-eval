eContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004070137836701979,"emotions":[],"relationId":"6af52b98c2ddb05a7fe30bb1","courseProgressId":0,"tsGen":1794452376329,"createTime":"2026-11-12 10:59:36","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"c8e714d07adf42dbafb9c7873612792f"}