ageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00669285161773124,"emotions":[],"relationId":"6af52b29c2ddb05a7fe2fb77","courseProgressId":0,"tsGen":1794452265013,"createTime":"2026-11-12 10:57:45","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"8512441fb3be444cb6fed57f3b4a7939"}