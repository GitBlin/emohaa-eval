audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01098427897171705,"emotions":[],"relationId":"6af52b74c2ddb05a7fe305dc","courseProgressId":0,"tsGen":1794452340195,"createTime":"2026-11-12 10:59:00","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"6a3a7dcc1ce64b40a77fcfa583c415de"}