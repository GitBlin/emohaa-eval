":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0031721154528937855,"emotions":[],"relationId":"6af52b1ac2ddb05a7fe2f940","courseProgressId":0,"tsGen":1794452250156,"createTime":"2026-11-12 10:57:30","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"f6420cef533e45c7a0ba5d043df64bc7"}