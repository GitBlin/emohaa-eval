ioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0019264978169031383,"emotions":[],"relationId":"6af52bbac2ddb05a7fe3114d","courseProgressId":0,"tsGen":1794452410260,"createTime":"2026-11-12 11:00:10","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"35f0b5e035d24e798b7d736b17b4b40a"}