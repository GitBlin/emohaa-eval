:null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004069313048994704,"emotions":[],"relationId":"6af52ba2c2ddb05a7fe30d70","courseProgressId":0,"tsGen":1794452386350,"createTime":"2026-11-12 10:59:46","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"50a5f428291b49e88fd25d5c611dc657"}