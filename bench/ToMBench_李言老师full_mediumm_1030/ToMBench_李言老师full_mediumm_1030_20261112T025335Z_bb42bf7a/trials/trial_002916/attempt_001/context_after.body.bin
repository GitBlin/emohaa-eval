Content":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0035927779812570844,"emotions":[],"relationId":"6af52b32c2ddb05a7fe2fcec","courseProgressId":0,"tsGen":1794452274908,"createTime":"2026-11-12 10:57:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"29eaf1ce46fc4d9ea2c000dbc016b2be"}