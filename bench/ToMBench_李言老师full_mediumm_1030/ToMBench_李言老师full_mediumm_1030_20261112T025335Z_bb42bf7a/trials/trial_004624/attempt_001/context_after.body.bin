ull,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002472151657842192,"emotions":[],"relationId":"6af52bc2c2ddb05a7fe312a7","courseProgressId":0,"tsGen":1794452418792,"createTime":"2026-11-12 11:00:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"1f8ca71993b04038aa4b308c45e06715"}