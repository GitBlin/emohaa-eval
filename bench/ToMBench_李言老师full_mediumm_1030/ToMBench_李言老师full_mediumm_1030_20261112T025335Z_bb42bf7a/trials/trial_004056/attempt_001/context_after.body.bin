ll,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010986940525640651,"emotions":[],"relationId":"6af52b97c2ddb05a7fe30b86","courseProgressId":0,"tsGen":1794452375476,"createTime":"2026-11-12 10:59:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"71cb6902e5904f73aff498ba18e3752d"}