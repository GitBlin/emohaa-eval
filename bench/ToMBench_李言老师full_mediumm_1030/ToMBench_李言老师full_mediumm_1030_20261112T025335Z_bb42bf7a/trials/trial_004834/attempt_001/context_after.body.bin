t":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0031722407095070666,"emotions":[],"relationId":"6af52bd6c2ddb05a7fe31572","courseProgressId":0,"tsGen":1794452438800,"createTime":"2026-11-12 11:00:38","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"08500009966e45ca8129d41d223ed574"}