,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.015906393811096483,"emotions":[],"relationId":"6af52a6ec2ddb05a7fe2e0b0","courseProgressId":0,"tsGen":1794452078049,"createTime":"2026-11-12 10:54:38","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"39ad7035c29b49eba70084bccc0dfecc"}