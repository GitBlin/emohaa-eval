Content":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0059097153738586995,"emotions":[],"relationId":"6af52affc2ddb05a7fe2f5b5","courseProgressId":0,"tsGen":1794452223602,"createTime":"2026-11-12 10:57:03","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"dffa6e03162940c6af97d34063fb5a63"}