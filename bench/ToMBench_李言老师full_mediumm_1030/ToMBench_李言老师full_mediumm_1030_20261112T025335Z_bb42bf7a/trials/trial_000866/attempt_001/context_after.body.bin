tions":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002472207283101039,"emotions":[],"relationId":"6af52a7cc2ddb05a7fe2e2d6","courseProgressId":0,"tsGen":1794452092241,"createTime":"2026-11-12 10:54:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"b298c3d7460a48f1b300e704ea3a2e7a"}