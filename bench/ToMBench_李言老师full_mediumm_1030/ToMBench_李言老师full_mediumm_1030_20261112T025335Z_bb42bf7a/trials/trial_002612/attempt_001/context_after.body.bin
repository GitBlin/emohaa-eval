ull,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005911069469171754,"emotions":[],"relationId":"6af52b18c2ddb05a7fe2f906","courseProgressId":0,"tsGen":1794452248541,"createTime":"2026-11-12 10:57:28","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"f8afa104de334071b037fc8d4a754454"}