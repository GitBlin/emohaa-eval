eoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002800582378439707,"emotions":[],"relationId":"6af52b28c2ddb05a7fe2fb56","courseProgressId":0,"tsGen":1794452264009,"createTime":"2026-11-12 10:57:44","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"09cb3310150c47f49e1c8c9db83fb3d9"}