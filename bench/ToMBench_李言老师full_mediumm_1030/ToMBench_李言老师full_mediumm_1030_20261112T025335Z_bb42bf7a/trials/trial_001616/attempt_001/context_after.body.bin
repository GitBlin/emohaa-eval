oCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0028001987167449996,"emotions":[],"relationId":"6af52abac2ddb05a7fe2ec52","courseProgressId":0,"tsGen":1794452154468,"createTime":"2026-11-12 10:55:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"eed5ed5ec88b4a45bf077acca9dfb088"}