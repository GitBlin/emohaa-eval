,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218929318623789,"emotions":[],"relationId":"6af52b03c2ddb05a7fe2f62e","courseProgressId":0,"tsGen":1794452227122,"createTime":"2026-11-12 10:57:07","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"ed9d88e5111e4573a6c311d0e806f27e"}