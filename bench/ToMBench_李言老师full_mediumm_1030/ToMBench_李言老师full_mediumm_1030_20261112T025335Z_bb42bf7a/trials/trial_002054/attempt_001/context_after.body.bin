l,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002182479402812527,"emotions":[],"relationId":"6af52ae2c2ddb05a7fe2f1fa","courseProgressId":0,"tsGen":1794452194692,"createTime":"2026-11-12 10:56:34","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"4d888b4c4f6a4c06acee13e643cbdd82"}