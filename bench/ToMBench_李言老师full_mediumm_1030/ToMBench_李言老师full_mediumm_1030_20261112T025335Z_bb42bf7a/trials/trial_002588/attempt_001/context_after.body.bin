Context":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01098694214483487,"emotions":[],"relationId":"6af52b17c2ddb05a7fe2f8e2","courseProgressId":0,"tsGen":1794452247774,"createTime":"2026-11-12 10:57:27","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"43dde4d9dc074ce1b59fc973375bba23"}