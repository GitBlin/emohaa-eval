t":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691799116195779,"emotions":[],"relationId":"6af52b5fc2ddb05a7fe3032c","courseProgressId":0,"tsGen":1794452319774,"createTime":"2026-11-12 10:58:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"d6b43c8019f44b3e98c5e1fe2f24cb3e"}