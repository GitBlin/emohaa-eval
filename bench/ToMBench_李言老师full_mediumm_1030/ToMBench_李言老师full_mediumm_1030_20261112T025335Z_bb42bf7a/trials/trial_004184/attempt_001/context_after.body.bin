inderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0021823926391828924,"emotions":[],"relationId":"6af52ba0c2ddb05a7fe30d1b","courseProgressId":0,"tsGen":1794452384436,"createTime":"2026-11-12 10:59:44","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"6b93c93efbbb47a99ebdac6d250bd550"}