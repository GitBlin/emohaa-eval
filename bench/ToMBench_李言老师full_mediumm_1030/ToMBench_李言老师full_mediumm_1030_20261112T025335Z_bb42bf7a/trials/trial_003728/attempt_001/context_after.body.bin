,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.003172682795358525,"emotions":[],"relationId":"6af52b7ec2ddb05a7fe3075e","courseProgressId":0,"tsGen":1794452350335,"createTime":"2026-11-12 10:59:10","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"f00458eef86b49929d51f25c0288cac2"}