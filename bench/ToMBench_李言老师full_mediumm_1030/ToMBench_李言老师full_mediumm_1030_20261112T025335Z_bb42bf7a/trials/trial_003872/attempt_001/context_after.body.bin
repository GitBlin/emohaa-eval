l,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608639336357869,"emotions":[],"relationId":"6af52b8ac2ddb05a7fe30938","courseProgressId":0,"tsGen":1794452362000,"createTime":"2026-11-12 10:59:22","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"782a4b1c15004bd5aa23a1bd706aa5cf"}