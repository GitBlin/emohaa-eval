ioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575276822054667,"emotions":[],"relationId":"6af52a8dc2ddb05a7fe2e564","courseProgressId":0,"tsGen":1794452109312,"createTime":"2026-11-12 10:55:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"f91ccac0a8f14fdbabacc2ff7f2b262f"}