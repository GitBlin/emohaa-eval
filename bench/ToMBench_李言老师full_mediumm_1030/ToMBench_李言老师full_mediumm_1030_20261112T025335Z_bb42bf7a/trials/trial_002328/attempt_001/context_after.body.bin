tions":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.003592918562585026,"emotions":[],"relationId":"6af52afdc2ddb05a7fe2f57a","courseProgressId":0,"tsGen":1794452221803,"createTime":"2026-11-12 10:57:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"2ad1fb6ec2014af282076fbe7bd08c8a"}