tent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00522012669949696,"emotions":[],"relationId":"6af52afac2ddb05a7fe2f507","courseProgressId":0,"tsGen":1794452218168,"createTime":"2026-11-12 10:56:58","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"9e23eb632535487c9c11dd7f3cc23b53"}