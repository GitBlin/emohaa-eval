null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00247225554879483,"emotions":[],"relationId":"6af52a53c2ddb05a7fe2dce9","courseProgressId":0,"tsGen":1794452051272,"createTime":"2026-11-12 10:54:11","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"992f6749094f45ed94bd69f01ec8f473"}