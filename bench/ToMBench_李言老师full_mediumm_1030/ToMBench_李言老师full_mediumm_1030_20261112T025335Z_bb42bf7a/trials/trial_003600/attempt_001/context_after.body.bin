ntent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004069260119421767,"emotions":[],"relationId":"6af52b71c2ddb05a7fe3059e","courseProgressId":0,"tsGen":1794452337937,"createTime":"2026-11-12 10:58:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"6d2d0b7c07214ae0b2a6dabaffd2ace6"}