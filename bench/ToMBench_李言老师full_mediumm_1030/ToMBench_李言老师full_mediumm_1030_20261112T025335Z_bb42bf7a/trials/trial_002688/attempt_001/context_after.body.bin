nt":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00150097286317084,"emotions":[],"relationId":"6af52b1fc2ddb05a7fe2fa07","courseProgressId":0,"tsGen":1794452255542,"createTime":"2026-11-12 10:57:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"60a802ff51344795b92f9bebf8ad94ee"}