audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004070137383680052,"emotions":[],"relationId":"6af52b4ac2ddb05a7fe30034","courseProgressId":0,"tsGen":1794452298024,"createTime":"2026-11-12 10:58:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"e5e22e0ccd144fecaddf30d0f94acea1"}