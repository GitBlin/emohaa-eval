ioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004069453706775281,"emotions":[],"relationId":"6af52bd9c2ddb05a7fe315ef","courseProgressId":0,"tsGen":1794452441837,"createTime":"2026-11-12 11:00:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"c747969fbf4c449da25ecb3f6491133b"}