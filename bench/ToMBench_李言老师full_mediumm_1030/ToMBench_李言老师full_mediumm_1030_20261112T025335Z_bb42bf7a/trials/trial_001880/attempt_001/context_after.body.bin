":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.003593602261281596,"emotions":[],"relationId":"6af52ad2c2ddb05a7fe2efc4","courseProgressId":0,"tsGen":1794452178496,"createTime":"2026-11-12 10:56:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"e334bdb5395f4fcca3ecbf9087b87fec"}