l,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0040701385313356995,"emotions":[],"relationId":"6af52b92c2ddb05a7fe30aa4","courseProgressId":0,"tsGen":1794452370511,"createTime":"2026-11-12 10:59:30","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"905b2db7dcd0462483b4a897162963f0"}