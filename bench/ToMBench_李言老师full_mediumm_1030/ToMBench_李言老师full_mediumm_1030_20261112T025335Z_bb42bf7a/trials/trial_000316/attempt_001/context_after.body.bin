xt":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008577485413711986,"emotions":[],"relationId":"6af52a4fc2ddb05a7fe2dc63","courseProgressId":0,"tsGen":1794452047449,"createTime":"2026-11-12 10:54:07","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"4dcc3fafdbde486380d868cff700a894"}