CoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575754218046353,"emotions":[],"relationId":"6af52bf7c2ddb05a7fe31a73","courseProgressId":0,"tsGen":1794452471570,"createTime":"2026-11-12 11:01:11","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"4ca84ea4154c425dbc3111f0cec52a4d"}