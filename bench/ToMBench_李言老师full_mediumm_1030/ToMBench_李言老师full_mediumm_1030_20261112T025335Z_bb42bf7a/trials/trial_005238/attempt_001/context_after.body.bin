":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0534033313063738,"emotions":[],"relationId":"6af52bf8c2ddb05a7fe31a94","courseProgressId":0,"tsGen":1794452472467,"createTime":"2026-11-12 11:01:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"8a32273a3d6c497684eeda92f60259cb"}