":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00460874803572362,"emotions":[],"relationId":"6af52a84c2ddb05a7fe2e411","courseProgressId":0,"tsGen":1794452100841,"createTime":"2026-11-12 10:55:00","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"9b0b8b05db8543a49546b23f46d74256"}