nt":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0010319552576808731,"emotions":[],"relationId":"6af52a73c2ddb05a7fe2e179","courseProgressId":0,"tsGen":1794452083434,"createTime":"2026-11-12 10:54:43","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"af50642d75aa459386e20f211c576e17"}