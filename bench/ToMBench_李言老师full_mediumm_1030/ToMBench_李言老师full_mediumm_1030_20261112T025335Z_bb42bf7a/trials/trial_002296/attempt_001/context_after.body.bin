。累了。","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01590639427760358,"emotions":[],"relationId":"6af52af9c2ddb05a7fe2f4f8","courseProgressId":0,"tsGen":1794452217571,"createTime":"2026-11-12 10:56:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"914debcba0d14fef8641c26fb2ff5e21"}