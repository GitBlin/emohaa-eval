udioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006692851419603694,"emotions":[],"relationId":"6af52abec2ddb05a7fe2ecf2","courseProgressId":0,"tsGen":1794452158713,"createTime":"2026-11-12 10:55:58","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"e22f6c35e74b4f37bcaef01ed7a46b9c"}