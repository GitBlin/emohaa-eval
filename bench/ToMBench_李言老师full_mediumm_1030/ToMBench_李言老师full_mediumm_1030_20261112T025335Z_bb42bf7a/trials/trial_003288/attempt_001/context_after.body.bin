ioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008577484273248568,"emotions":[],"relationId":"6af52b55c2ddb05a7fe301bf","courseProgressId":0,"tsGen":1794452309715,"createTime":"2026-11-12 10:58:29","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"e0df26bd5cc9482fb68f0ced5f9bbf32"}