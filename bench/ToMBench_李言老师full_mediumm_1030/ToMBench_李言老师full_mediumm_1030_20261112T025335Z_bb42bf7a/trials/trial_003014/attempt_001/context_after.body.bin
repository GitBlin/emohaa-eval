ull,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0017003217707907841,"emotions":[],"relationId":"6af52b3bc2ddb05a7fe2fe2b","courseProgressId":0,"tsGen":1794452283080,"createTime":"2026-11-12 10:58:03","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"ec7249869b0045c390bfaaa2f79cc700"}