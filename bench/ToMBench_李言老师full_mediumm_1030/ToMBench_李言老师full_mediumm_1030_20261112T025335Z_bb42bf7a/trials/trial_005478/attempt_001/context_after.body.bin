inderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.06008665354025421,"emotions":[],"relationId":"6af52c0cc2ddb05a7fe31db8","courseProgressId":0,"tsGen":1794452492507,"createTime":"2026-11-12 11:01:32","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"8ee4dfc27120465f9cd4009af5205406"}