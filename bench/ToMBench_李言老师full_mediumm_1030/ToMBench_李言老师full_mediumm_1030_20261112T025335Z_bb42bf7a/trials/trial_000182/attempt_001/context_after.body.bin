":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004609572965644868,"emotions":[],"relationId":"6af52a40c2ddb05a7fe2da1e","courseProgressId":0,"tsGen":1794452032547,"createTime":"2026-11-12 10:53:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"463c663e76c04049b3a13ab402e69368"}