derContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014060626120872817,"emotions":[],"relationId":"6af52a5ec2ddb05a7fe2de7b","courseProgressId":0,"tsGen":1794452062208,"createTime":"2026-11-12 10:54:22","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"7ae8bb540c334e9fb5bef8643a5c5a78"}