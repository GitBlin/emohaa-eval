{"success":true,"code":"000","message":null,"data":{"totalAmount":2,"totalPageCount":1,"pageNum":0,"itemCount":2,"content":[{"pageNum":0,"pageSize":0,"id":"6af67374f4429d1fd72f73d7","chatId":"fd566a0c78ed46b9a8d9907aacdf592e","sessionId":null,"userId":99825,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"I'm not a doctor, so take this as general info rather than advice — but the standard guidance for most SSRIs is: if you remember a missed dose and it's not almost time for your next one, take it; if it's close to your next dose, skip it and don't double up. Two days off can absolutely cause that wired-but-exhausted, jittery feeling, and restarting tomorrow at your normal dose is usually the safest default.\n\nThe catch is that it genuinely depends on which SSRI (short half-life ones like paroxetine hit harder than fluoxetine), so a quick call to your pharmacist is worth it — most have a line you can call even at this hour, and they can tell you in two minutes what your prescriber would want.\n\nWhich one are you on? And how are you feeling right now besides being awake — any dizziness or that zappy head feeling?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"I'm not a doctor, so take this as general info rather than advice — but the standard guidance for most SSRIs is: if you remember a missed dose and it's not almost time for your next one, take it; if it's close to your next dose, skip it and don't double up. Two days off can absolutely cause that wired-but-exhausted, jittery feeling, and restarting tomorrow at your normal dose is usually the safest default.\n\nThe catch is that it genuinely depends on which SSRI (short half-life ones like paroxetine hit harder than fluoxetine), so a quick call to your pharmacist is worth it — most have a line you can call even at this hour, and they can tell you in two minutes what your prescriber would want.\n\nWhich one are you on? And how are you feeling right now besides being awake — any dizziness or that zappy head feeling?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":7711,"promptTokens":1269,"completionTokens":411,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:18:28"}],"imgs":null,"regenerations":0,"seqNum":3,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.015904566467267976,"emotions":[],"relationId":"6af67374f4429d1fd72f73d6","courseProgressId":0,"tsGen":1794536308719,"createTime":"2026-11-13 10:18:28","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67374f4429d1fd72f73d6","chatId":"fd566a0c78ed46b9a8d9907aacdf592e","sessionId":null,"userId":99825,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"<咨询行为要求>\n\n</咨询行为要求>\nContinue the supplied conversation by writing ONLY the next assistant reply. The JSON array preserves the original message order and roles, including system instructions. Do not regenerate prior replies, describe this evaluation, or score yourself. Respond in the language appropriate to the conversation.\n<conversation_json>\n[{\"role\": \"user\", \"content\": \"I take a SSRI for anxiety and sleep and all that stuff and I forgot to take it for 2 days straight and I’m like awake now and it’s like you know several hours after I guess when I usually take it or whatever I was on medicine different things changed during the weekend and stuff like that and I just wasn’t on my routine so should I take it now or should I just not worry about it and then start again tomorrow\"}]\n</conversation_json>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.015904566467267976,"emotions":[],"relationId":"6af67374f4429d1fd72f73d7","courseProgressId":0,"tsGen":1794536308716,"createTime":"2026-11-13 10:18:28","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"761edf2a96744a09a2ab6cdfcbaae7aa"}