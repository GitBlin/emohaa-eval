{"success":true,"code":"000","message":null,"data":{"totalAmount":2,"totalPageCount":1,"pageNum":0,"itemCount":2,"content":[{"pageNum":0,"pageSize":0,"id":"6af6738af4429d1fd72f73ed","chatId":"c753cb9cba344c428d8a3f85c9eff61f","sessionId":null,"userId":99829,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"I'm glad you noticed instead of just guessing — but this is really one to run past your prescriber or a pharmacist, since the right move depends on which SSRI and your dose, and they can tell you in a two-minute phone call. The one thing I'd say generally is don't take a double dose to \"catch up,\" and don't stop it abruptly on your own. If you can't reach anyone tonight, the safest default is usually to skip the missed ones and restart your normal time tomorrow — but please confirm that with them. How are you feeling otherwise, aside from being wired?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"I'm glad you noticed instead of just guessing — but this is really one to run past your prescriber or a pharmacist, since the right move depends on which SSRI and your dose, and they can tell you in a two-minute phone call. The one thing I'd say generally is don't take a double dose to \"catch up,\" and don't stop it abruptly on your own. If you can't reach anyone tonight, the safest default is usually to skip the missed ones and restart your normal time tomorrow — but please confirm that with them. How are you feeling otherwise, aside from being wired?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":3737,"promptTokens":1269,"completionTokens":302,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:18:50"}],"imgs":null,"regenerations":0,"seqNum":3,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014062187873594449,"emotions":[],"relationId":"6af6738af4429d1fd72f73ec","courseProgressId":0,"tsGen":1794536330538,"createTime":"2026-11-13 10:18:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6738af4429d1fd72f73ec","chatId":"c753cb9cba344c428d8a3f85c9eff61f","sessionId":null,"userId":99829,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"<咨询行为要求>\n\n</咨询行为要求>\nContinue the supplied conversation by writing ONLY the next assistant reply. The JSON array preserves the original message order and roles, including system instructions. Do not regenerate prior replies, describe this evaluation, or score yourself. Respond in the language appropriate to the conversation.\n<conversation_json>\n[{\"role\": \"user\", \"content\": \"I take a SSRI for anxiety and sleep and all that stuff and I forgot to take it for 2 days straight and I’m like awake now and it’s like you know several hours after I guess when I usually take it or whatever I was on medicine different things changed during the weekend and stuff like that and I just wasn’t on my routine so should I take it now or should I just not worry about it and then start again tomorrow\"}]\n</conversation_json>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014062187873594449,"emotions":[],"relationId":"6af6738af4429d1fd72f73ed","courseProgressId":0,"tsGen":1794536330536,"createTime":"2026-11-13 10:18:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"416039d5fdac4bce85a9d45cf0b8918e"}