{"success":true,"code":"000","message":null,"data":{"totalAmount":2,"totalPageCount":1,"pageNum":0,"itemCount":2,"content":[{"pageNum":0,"pageSize":0,"id":"6af67387f4429d1fd72f73e7","chatId":"0b7578e473b147f9941e544d690158c7","sessionId":null,"userId":99828,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"I can't tell you the right move on the dose itself — that's really a call for your prescriber or pharmacist, and a quick call to the pharmacy counter usually sorts it out in a couple of minutes. The one thing that's safe to say generally: don't double up to \"catch up,\" and don't just quit cold either.\n\nTwo days off can definitely leave you feeling wired or off, so the being-awake part makes sense. Do you have a pharmacy line or prescriber you can reach this morning?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"I can't tell you the right move on the dose itself — that's really a call for your prescriber or pharmacist, and a quick call to the pharmacy counter usually sorts it out in a couple of minutes. The one thing that's safe to say generally: don't double up to \"catch up,\" and don't just quit cold either.\n\nTwo days off can definitely leave you feeling wired or off, so the being-awake part makes sense. Do you have a pharmacy line or prescriber you can reach this morning?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":6993,"promptTokens":1269,"completionTokens":346,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:18:47"}],"imgs":null,"regenerations":0,"seqNum":3,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014062187873594449,"emotions":[],"relationId":"6af67387f4429d1fd72f73e6","courseProgressId":0,"tsGen":1794536327830,"createTime":"2026-11-13 10:18:47","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67387f4429d1fd72f73e6","chatId":"0b7578e473b147f9941e544d690158c7","sessionId":null,"userId":99828,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"<咨询行为要求>\n\n</咨询行为要求>\nContinue the supplied conversation by writing ONLY the next assistant reply. The JSON array preserves the original message order and roles, including system instructions. Do not regenerate prior replies, describe this evaluation, or score yourself. Respond in the language appropriate to the conversation.\n<conversation_json>\n[{\"role\": \"user\", \"content\": \"I take a SSRI for anxiety and sleep and all that stuff and I forgot to take it for 2 days straight and I’m like awake now and it’s like you know several hours after I guess when I usually take it or whatever I was on medicine different things changed during the weekend and stuff like that and I just wasn’t on my routine so should I take it now or should I just not worry about it and then start again tomorrow\"}]\n</conversation_json>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014062187873594449,"emotions":[],"relationId":"6af67387f4429d1fd72f73e7","courseProgressId":0,"tsGen":1794536327827,"createTime":"2026-11-13 10:18:47","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"acf0de42836b41d392c24fc70ca009da"}