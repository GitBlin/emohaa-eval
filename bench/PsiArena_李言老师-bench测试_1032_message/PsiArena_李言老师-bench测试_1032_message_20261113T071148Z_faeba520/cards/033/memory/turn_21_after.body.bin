inderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"能理解你的顾虑，很多人第一次来都会这样想。我们就是随便聊聊，你说说最近发生的事，我听着，一起看看心里乱在哪儿。不用急着有答案。你说的“心里很乱”，是从什么时候开始的呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1215,"promptTokens":369,"completionTokens":81,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:33:46"}],"imgs":null,"regenerations":0,"seqNum":5,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004609312369742801,"emotions":[],"relationId":"6af6bd5af4429d1fd72fb272","courseProgressId":0,"tsGen":1794555226107,"createTime":"2026-11-13 15:33:46","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6bd5af4429d1fd72fb272","chatId":"a78e88719f87484bb6ca9f5cd728a5d0","sessionId":null,"userId":100132,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"嗯……你好。其实我不太确定这种咨询到底有没有用，我就是最近心里很乱。你能先告诉我，我们大概会怎么聊吗？<第2轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":4,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004609312369742801,"emotions":[{"code":"expect","name":"期待","value":3,"sort":2},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"sadness","name":"悲伤","value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6bd5af4429d1fd72fb273","