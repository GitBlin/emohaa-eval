296,"completionTokens":132,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:34:35"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0066911563407082725,"emotions":[],"relationId":"6af6bd8bf4429d1fd72fb2dd","courseProgressId":0,"tsGen":1794555275290,"createTime":"2026-11-13 15:34:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6bd8bf4429d1fd72fb2dd","chatId":"a78e88719f87484bb6ca9f5cd728a5d0","sessionId":null,"userId":100132,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"更早吧……我从小就不太敢自己做决定，怕做错。我爸妈管得挺严的，尤其是我妈，什么都要过问。现在谈恋爱，好像也总在等她点头似的。<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":26,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0066911563407082725,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af6bd8bf4429d1fd72fb2de","courseProgressId":0,"tsGen":1794555275287,"createTime":"2026-11-13 15:34:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6bd83f4429d1fd72fb2d3","chatId":"a78e88719f87484bb6ca9f5cd728a5d0