ull,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575526017230644,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6bd65f4429d1fd72fb287","courseProgressId":0,"tsGen":1794555237279,"createTime":"2026-11-13 15:33:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6bd5df4429d1fd72fb27c","chatId":"a78e88719f87484bb6ca9f5cd728a5d0","sessionId":null,"userId":100132,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"会的，我们聊的内容我会保密，不会随便告诉你家里人。只有在涉及你或他人安全的时候，我才会和你商量怎么处理。你放心。你刚说最近越来越觉得累，这种累更像是身体上的，还是心里的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"会的，我们聊的内容我会保密，不会随便告诉你家里人。只有在涉及你或他人安全的时候，我才会和你商量怎么处理。你放心。你刚说最近越来越觉得累，这种累更像是身体上的，还是心里的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1361,"promptTokens":491,"completionTokens":129,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:33:49"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010982094302168587,"emotio