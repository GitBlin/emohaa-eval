rust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2}],"relationId":"6af6bd83f4429d1fd72fb2d3","courseProgressId":0,"tsGen":1794555267961,"createTime":"2026-11-13 15:34:27","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6bd80f4429d1fd72fb2cb","chatId":"a78e88719f87484bb6ca9f5cd728a5d0","sessionId":null,"userId":100132,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"听起来像是个循环：吵完更不安，不安就忍不住去查，查完又自责。你不是“不好”，是心里那个不安一直没被安顿下来。查完之后，那一刻你心里是踏实一点，还是更慌了？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来像是个循环：吵完更不安，不安就忍不住去查，查完又自责。你不是“不好”，是心里那个不安一直没被安顿下来。查完之后，那一刻你心里是踏实一点，还是更慌了？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1842,"promptTokens":1266,"completionTokens":154,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:34:24"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008572807657411492,"emotions":[],"relationId":"6af6bd80f4429d1fd72fb2ca","courseProgressId":0,"tsGen":1794555264697,"createTime":"2026-11-13 15:34:24","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6bd80f4429d1fd72fb2ca","chatId":"a78e88719f87484bb6ca9f5cd728a5d0","sessionId":null,"userId":100132,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"更堵吧。吵完他摔门走，我又后悔，又害怕。然后就开始忍不住查他手机、问他去哪了……我知道这样不好，可就是停不下来。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，