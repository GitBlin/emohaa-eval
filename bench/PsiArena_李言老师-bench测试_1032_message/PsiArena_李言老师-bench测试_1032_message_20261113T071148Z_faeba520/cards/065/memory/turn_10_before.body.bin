{"success":true,"code":"000","message":null,"data":{"totalAmount":18,"totalPageCount":1,"pageNum":0,"itemCount":18,"content":[{"pageNum":0,"pageSize":0,"id":"6af6c3e8f4429d1fd72fba73","chatId":"145bde436ff942e5bfacd464ad7b3ff8","sessionId":null,"userId":100164,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"硬压着确实很累，越用力念头越缠人，这不是你的错。离开那里之后，那种难受会跟着你，还是会慢慢散掉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"硬压着确实很累，越用力念头越缠人，这不是你的错。离开那里之后，那种难受会跟着你，还是会慢慢散掉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1243,"promptTokens":1134,"completionTokens":118,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:01:44"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.07584391463702703,"emotions":[],"relationId":"6af6c3e8f4429d1fd72fba72","courseProgressId":0,"tsGen":1794556904580,"createTime":"2026-11-13 16:01:44","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c3e8f4429d1fd72fba72","chatId":"145bde436ff942e5bfacd464ad7b3ff8","sessionId":null,"userId":100164,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"（苦笑）还能怎么做，硬压着呗。使劲不去想，假装没事。可越压越凶，有时候我都想赶紧走，离开那个地方。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.07584391463702703,"emotions":[],"relationId":"6af6c3e8f4429d1fd72fba73","courseProgress