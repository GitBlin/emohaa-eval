"value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6c31cf4429d1fd72fb976","courseProgressId":0,"tsGen":1794556700843,"createTime":"2026-11-13 15:58:20","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c317f4429d1fd72fb973","chatId":"516e18118a8d4d9cb4b9fffeda115a79","sessionId":null,"userId":100160,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"我理解你希望难受时能有人找，但咨询之外我不提供私下联系方式，这也是为了保持我们关系的界限。晚上特别难受时，我们可以一起想些应对办法。你愿意先说说，测试结果里哪一点最让你慌吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我理解你希望难受时能有人找，但咨询之外我不提供私下联系方式，这也是为了保持我们关系的界限。晚上特别难受时，我们可以一起想些应对办法。你愿意先说说，测试结果里哪一点最让你慌吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1849,"promptTokens":699,"completionTokens":183,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:58:15"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.020326817414653062,"emotions":[],"relationId":"6af6c317f4429d1fd72fb972","courseProgressId":0,"tsGen":1794556695988,"createTime":"2026-11-13 15:58:15","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c317f4429d1fd72fb972","chatId":"516e18118a8d4d9cb4b9fffeda115a79","sessionId":null,"userId":100160,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"哦……好，那我大概明白了。嗯……（犹豫）其实我就是……最近做了个什么人格的测试，结果不太好，我就有点慌。不过这个……我还没想好要不要细说。对了，我平时能私下加你联系方式吗？万一我晚上特别难受的时候。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.020326817414653062,"emotions":[{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6c317f4429d1fd72fb973","courseProgressId":0,"tsGen":1794556695985,"createTime":"2026-11-13 15:58:15","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c313f4429d1fd72fb971","chatId":"516e18118a8d4d9cb4b9fffeda115a79","sessionId":null,"userId":100160,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"你的担心很正常。咨询里你说的话我会保密，不会告诉你家里人。只有在涉及你或他人的安全风险时，我才会按专业要求处理。这样解释后，你愿意说说刚才犹豫的那部分吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你的担心很正常。咨询里你说的话我会保密，不会告诉你家里人。只有在涉及你或他人的安全风险时，我才会按专业要求处理。这样解释后，你愿意说说刚才犹豫的那部分吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1842,"promptTokens":558,"completionTokens":140,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:58:11"}],"imgs":null,"regenerations":0,"seqNu