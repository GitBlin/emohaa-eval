{"success":true,"code":"000","message":null,"data":{"totalAmount":28,"totalPageCount":1,"pageNum":0,"itemCount":28,"content":[{"pageNum":0,"pageSize":0,"id":"6af6c9baf4429d1fd72fc6c3","chatId":"34a9086773614f0c95f91ccddb395151","sessionId":null,"userId":100195,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"那个声音一直在，就算没人说，你自己也会一直说，确实很累。它最常在什么时候冒出来，是晚上，还是做某件事的时候？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那个声音一直在，就算没人说，你自己也会一直说，确实很累。它最常在什么时候冒出来，是晚上，还是做某件事的时候？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1325,"promptTokens":1277,"completionTokens":98,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:26:34"}],"imgs":null,"regenerations":0,"seqNum":29,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.022970727097671173,"emotions":[],"relationId":"6af6c9baf4429d1fd72fc6c2","courseProgressId":0,"tsGen":1794558394021,"createTime":"2026-11-13 16:26:34","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c9baf4429d1fd72fc6c2","chatId":"34a9086773614f0c95f91ccddb395151","sessionId":null,"userId":100195,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"有吧……它一直在。就算没人说我，我自己也会一直说，说我还不够好。有时候真的觉得好累。<第14轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":28,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.022970727097671173,"emotions":[],"relationId":"6af6c9baf4429d1fd72fc6c3","courseP