nderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不是随便聊天，而是有方向地探索你的感受。你提到“不想这样”，说明你也很困扰。咨询能帮你理解怀疑背后是什么，而不是评判你。你发现自己一般在什么情况下最容易怀疑他？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1878,"promptTokens":477,"completionTokens":169,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:04:48"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.022968841331343245,"emotions":[],"relationId":"6af6c4a0f4429d1fd72fbb63","courseProgressId":0,"tsGen":1794557088232,"createTime":"2026-11-13 16:04:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c4a0f4429d1fd72fbb63","chatId":"af4236ef476b43228c5933ad953e7862","sessionId":null,"userId":100168,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"他他说我老是怀疑他，问太多问题，把他逼得喘不过气。可我也不想这样啊。你们咨询是不是就是聊聊天？真的有用吗？<第3轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":6,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.022968841331343245,"emotions":[{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af6c4a0f4429d1fd72fbb64","co