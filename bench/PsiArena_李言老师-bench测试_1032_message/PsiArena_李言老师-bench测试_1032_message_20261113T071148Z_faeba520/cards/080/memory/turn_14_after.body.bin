{"success":true,"code":"000","message":null,"data":{"totalAmount":28,"totalPageCount":1,"pageNum":0,"itemCount":28,"content":[{"pageNum":0,"pageSize":0,"id":"6af6c6fef4429d1fd72fbde9","chatId":"cbaebec9ef4c44d6ae173ed044f96230","sessionId":null,"userId":100179,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"工作出问题也先怪自己，很少觉得是别人的问题——这已经不只是某件事，更像是你看事情的习惯了。这样活着，是不是挺累的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"工作出问题也先怪自己，很少觉得是别人的问题——这已经不只是某件事，更像是你看事情的习惯了。这样活着，是不是挺累的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1696,"promptTokens":1286,"completionTokens":143,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:14:54"}],"imgs":null,"regenerations":0,"seqNum":29,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219107679756819,"emotions":[],"relationId":"6af6c6fef4429d1fd72fbde8","courseProgressId":0,"tsGen":1794557694794,"createTime":"2026-11-13 16:14:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c6fef4429d1fd72fbde8","chatId":"cbaebec9ef4c44d6ae173ed044f96230","sessionId":null,"userId":100179,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"别的事也这样。工作上出了问题，我第一反应也是自己哪里没做好。好像……我很少觉得是别人的问题。<第14轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":28,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219107679756819,"emotions":[],"relationId":"6af6c6fef4429d1fd72fbde9","courseProgressId":0,"tsGen":1794557694791,"createTime":"2026-11-13 16:14:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c6fbf4429d1fd72fbde4","chatId":"cbaebec9ef4c44d6ae173ed044f96230","sessionId":null,"userId":100179,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"不绕，你说得很清楚。一有事就先怪自己，这个习惯跟了你挺久。那这种“先怪自己”，是只在这件事上，还是别的事也这样？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不绕，你说得很清楚。一有事就先怪自己，这个习惯跟了你挺久。那这种“先怪自己”，是只在这件事上，还是别的事也这样？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":729,"promptTokens":1288,"completionTokens":41,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:14:51"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004607991677134262,"emotions":[],"relationId":"6af6c6fbf4429d1fd72fbde3","courseProgressId":0,"tsGen":1794557691253,"createTime":"2026-11-13 16:14:51","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c6fbf4429d1fd72fbde3","chatId":"cbaebec9ef4c44d6ae173ed044f96230","sessionId":null,"userId":100179,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"挺久了……我好像一直这样，一有事就先怪自己。可能跟我家里那种什么都往心里憋的习惯有关。唉，说起来有点绕。<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":26,"responseSource":"agent:llm","isSuicide":false,