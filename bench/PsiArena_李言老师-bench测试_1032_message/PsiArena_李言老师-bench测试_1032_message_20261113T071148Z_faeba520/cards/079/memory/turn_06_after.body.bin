:false,"isSuicideConf":0.00521830447129645,"emotions":[],"relationId":"6af6c6c7f4429d1fd72fbd99","courseProgressId":0,"tsGen":1794557639032,"createTime":"2026-11-13 16:13:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c6bff4429d1fd72fbd8f","chatId":"61eef6c8feac446a8bf9b7dec8d05780","sessionId":null,"userId":100178,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"你的顾虑我理解。咨询里的内容我会保密，这是基本的职业要求，不会随便告诉别人。你可以放心说。刚才你提到这半年一直拖着，那这段时间里，有没有什么时候感觉稍微好一点？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你的顾虑我理解。咨询里的内容我会保密，这是基本的职业要求，不会随便告诉别人。你可以放心说。刚才你提到这半年一直拖着，那这段时间里，有没有什么时候感觉稍微好一点？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1612,"promptTokens":554,"completionTokens":120,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:13:51"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009701651467095344,"emotions":[],"relationId":"6af6c6bff4429d1fd72fbd8e","courseProgressId":0,"tsGen":1794557631927,"createTime":"2026-11-13 16:13:51","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c6bff4429d1fd72fbd8e","chatId":"61eef6c8feac446a8bf9b7dec8d05780","sessionId":null,"userId":100178,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"嗯……大概有半年多了吧，反正就是一天天拖着。（犹豫）对了，我想问一下，我跟你说的事情，你会不会告诉别人啊？<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"m