{"success":true,"code":"000","message":null,"data":{"totalAmount":14,"totalPageCount":1,"pageNum":0,"itemCount":14,"content":[{"pageNum":0,"pageSize":0,"id":"6af6ca94f4429d1fd72fc763","chatId":"7f3792344d2b46689fdd9248571bdfa1","sessionId":null,"userId":100198,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"不烦，你愿意说，我就在听。你提到“不再是那个优秀的人”，听起来“优秀”这个身份对你很重要。如果不再优秀，你担心自己会变成什么样的人呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不烦，你愿意说，我就在听。你提到“不再是那个优秀的人”，听起来“优秀”这个身份对你很重要。如果不再优秀，你担心自己会变成什么样的人呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1317,"promptTokens":923,"completionTokens":110,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:30:12"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010982815050282124,"emotions":[],"relationId":"6af6ca94f4429d1fd72fc762","courseProgressId":0,"tsGen":1794558612914,"createTime":"2026-11-13 16:30:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6ca94f4429d1fd72fc762","chatId":"7f3792344d2b46689fdd9248571bdfa1","sessionId":null,"userId":100198,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"最难受的是……好像从那以后，我就不再是那个“优秀”的人了。老师同学看我的眼神都变了。嗯……我这么一直说这些，你会不会觉得烦？<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010982815050282124,"emotions":[],"relationId":"6af6ca94f4429d1fd72fc763","courseProgressId":0,"tsGen":1794558612911,"createTime":"2026-11-13 16:30:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6ca91f4429d1fd72fc75d","chatId":"7f3792344d2b46689fdd9248571bdfa1","sessionId":null,"userId":100198,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"不是矫情。一件事过去多久，和它在你心里留下的分量，是两回事。别人走没走在前面，也衡量不了你的感受。高考那件事，对你来说最难受的是哪一部分？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不是矫情。一件事过去多久，和它在你心里留下的分量，是两回事。别人走没走在前面，也衡量不了你的感受。高考那件事，对你来说最难受的是哪一部分？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1931,"promptTokens":804,"completionTokens":142,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:30:09"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909330308109458,"emotions":[],"relationId":"6af6ca91f4429d1fd72fc75c","courseProgressId":0,"tsGen":1794558609114,"createTime":"2026-11-13 16:30:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6ca91f4429d1fd72fc75c","chatId":"7f3792344d2b46689fdd9248571bdfa1","sessionId":null,"userId":100198,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"就是……高考那事儿。都过去好几年了，我是不是还揪着不放挺矫情的？别人早就往前走了吧。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909330308109458,"emotions":[],"relationId":"6af6ca91f4429d1fd72fc75d","courseProgressId":0,"tsGen":1794558609112,"createTime":"2026-11-13 16:30:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6ca8cf4429d1fd72fc759","chatId":"7f3792344d2b46689fdd9248571bdfa1","sessionId":null,"userId":100198,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"我不会觉得没什么大不了的。你刚才犹豫了一下，那个“算了”后面的话，往往才是真正压着你的东西。愿意试着说出来吗？哪怕只是一点点。","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我不会觉得没什么大不了的。你刚才犹豫了一下，那个“算了”后面的话，往往才是真正压着你的东西。愿意试着说出来吗？哪怕只是一点点。","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1834,"promptTokens":704,"completionTokens":133,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:30:04"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909901963308115,"emotions":[],"relationId":"6af6ca8cf4429d1fd72fc758","courseProgressId":0,"tsGen":1794558604650,"createTime":"2026-11-13 16:30:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6ca8cf4429d1fd72fc758","chatId":"7f3792344d2b46689fdd9248571bdfa1","sessionId":null,"userId":100198,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"挺久了……具体多久我也说不上来。好像是从……算了，说了你可能也觉得没什么大不了的。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909901963308115,"emotions":[],"relationId":"6af6ca8cf4429d1fd72fc759","courseProgressId":0,"tsGen":1794558604647,"createTime":"2026-11-13 16:30:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6ca88f4429d1fd72fc754","chatId":"7f3792344d2b46689fdd9248571bdfa1","sessionId":null,"userId":100198,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"不乱，你其实说得很清楚——晚上脑子停不下来，白天又没力气，这两件事常常是连在一起的。不用怕表达得不好，我听懂了。这种状态大概持续多久了？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不乱，你其实说得很清楚——晚上脑子停不下来，白天又没力气，这两件事常常是连在一起的。不用怕表达得不好，我听懂了。这种状态大概持续多久了？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1226,"promptTokens":604,"completionTokens":82,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:30:00"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705964823292583,"emotions":[],"relationId":"6af6ca88f4429d1fd72fc753","courseProgressId":0,"tsGen":1794558600289,"createTime":"2026-11-13 16:30:00","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6ca88f4429d1fd72fc753","chatId":"7f3792344d2b46689fdd9248571bdfa1","sessionId":null,"userId":100198,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"都有吧……晚上躺下脑子就停不下来，白天又没劲。说这些是不是有点乱？我也不太会表达。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705964823292583,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6ca88f4429d1fd72fc754","courseProgressId":0,"tsGen":1794558600286,"createTime":"2026-11-13 16:30:00","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6ca84f4429d1fd72fc752","chatId":"7f3792344d2b46689fdd9248571bdfa1","sessionId":null,"userId":100198,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"说不清也没关系，很多人来的时候都是这样，只知道难受，却找不到原因。这种“说不清”本身也是值得聊的。那这种难受，更多是心里发闷，还是身体上也会觉得累、睡不好之类的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"说不清也没关系，很多人来的时候都是这样，只知道难受，却找不到原因。这种“说不清”本身也是值得聊的。那这种难受，更多是心里发闷，还是身体上也会觉得累、睡不好之类的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":3637,"promptTokens":490,"completionTokens":145,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:29:56"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00857361632448118,"emotions":[],"relationId":"6af6ca84f4429d1fd72fc751","courseProgressId":0,