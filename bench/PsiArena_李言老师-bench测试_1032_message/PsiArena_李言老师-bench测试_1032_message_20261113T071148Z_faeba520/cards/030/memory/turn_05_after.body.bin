{"success":true,"code":"000","message":null,"data":{"totalAmount":10,"totalPageCount":1,"pageNum":0,"itemCount":10,"content":[{"pageNum":0,"pageSize":0,"id":"6af6bd4bf4429d1fd72fb25f","chatId":"400e9cad7cd848a2a5c60293a5ba986e","sessionId":null,"userId":100129,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"我不太喜欢用“正常”或“不正常”来框住人。长期做一件事，热情被磨掉，心里发闷、提不起劲，这挺常见的。倒是你，这种状态持续多久了？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我不太喜欢用“正常”或“不正常”来框住人。长期做一件事，热情被磨掉，心里发闷、提不起劲，这挺常见的。倒是你，这种状态持续多久了？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":5641,"promptTokens":727,"completionTokens":142,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:33:31"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009703740110580797,"emotions":[],"relationId":"6af6bd4bf4429d1fd72fb25e","courseProgressId":0,"tsGen":1794555211758,"createTime":"2026-11-13 15:33:31","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6bd4bf4429d1fd72fb25e","chatId":"400e9cad7cd848a2a5c60293a5ba986e","sessionId":null,"userId":100129,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"也不是不舒服……就是不太习惯被人这么问。累的话，大概是心里那种吧，做设计做久了，好像什么都提不起劲。你呢，你觉得我这样正常吗？<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009703740110580797,"emotions":[],"relationId":"6af6bd4bf4429d1fd72fb25f","courseProgressId":0,"tsGen":1794555211756,"createTime":"2026-11-13 15:33:31","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6bd44f4429d1fd72fb25a","chatId":"400e9cad7cd848a2a5c60293a5ba986e","sessionId":null,"userId":100129,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"是的，我习惯多问、多听，因为答案在你那里，不在我这儿。你觉得这样问让你不舒服，还是有点好奇？另外你说工作累，是身体上的疲惫，还是心里那种提不起劲的累？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"是的，我习惯多问、多听，因为答案在你那里，不在我这儿。你觉得这样问让你不舒服，还是有点好奇？另外你说工作累，是身体上的疲惫，还是心里那种提不起劲的累？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1562,"promptTokens":604,"completionTokens":131,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:33:24"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007573365238399835,"emotions":[],"relationId":"6af6bd44f4429d1fd72fb259","courseProgressId":0,"tsGen":1794555204217,"createTime":"2026-11-13 15:33:24","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6bd44f4429d1fd72fb259","chatId":"400e9cad7cd848a2a5c60293a5ba986e","sessionId":null,"userId":100129,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"嗯……都有点吧。有时候是压着，有时候又觉得空。不过说不上来，可能最近工作也累。你平时……都是这样问问题的吗？<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenera