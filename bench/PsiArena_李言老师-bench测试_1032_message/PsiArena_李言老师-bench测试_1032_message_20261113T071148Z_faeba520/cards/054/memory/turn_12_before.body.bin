-11-13 15:50:16","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c138f4429d1fd72fb77b","chatId":"b887e752403f45c98ddd9c402c281948","sessionId":null,"userId":100153,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"都有吧……我也分不清。有时候早上起来就觉得没劲，可又说不上来哪儿不舒服。可能是我自己想太多了。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00669171254259184,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6c138f4429d1fd72fb77c","courseProgressId":0,"tsGen":1794556216220,"createTime":"2026-11-13 15:50:16","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c132f4429d1fd72fb771","chatId":"b887e752403f45c98ddd9c402c281948","sessionId":null,"userId":100153,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"带两个这么小的孩子，确实很不容易，累是正常的。你说的“心里堵得慌”，是更偏向身体上的疲惫，还是那种闷闷的、说不出的烦？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":