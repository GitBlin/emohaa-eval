{"success":true,"code":"000","message":null,"data":{"totalAmount":12,"totalPageCount":1,"pageNum":0,"itemCount":12,"content":[{"pageNum":0,"pageSize":0,"id":"6af6c143f4429d1fd72fb790","chatId":"b887e752403f45c98ddd9c402c281948","sessionId":null,"userId":100153,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"你好像很习惯把责任都揽在自己身上，连累都不能说。这份“该做的”，是从什么时候开始变成你一个人扛的呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你好像很习惯把责任都揽在自己身上，连累都不能说。这份“该做的”，是从什么时候开始变成你一个人扛的呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":5133,"promptTokens":783,"completionTokens":104,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:50:27"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575120562564882,"emotions":[],"relationId":"6af6c143f4429d1fd72fb78f","courseProgressId":0,"tsGen":1794556227417,"createTime":"2026-11-13 15:50:27","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c143f4429d1fd72fb78f","chatId":"b887e752403f45c98ddd9c402c281948","sessionId":null,"userId":100153,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"我老公……他早上很早就出门了，指望不上。其实这些本来就是我该做的，说出来好像在抱怨一样。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575120562564882,"emotions":[],"relationId":"6af6c143f4429d1fd72fb790","courseProgress