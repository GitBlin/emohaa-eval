SuicideConf":0.008573618017808489,"emotions":[],"relationId":"6af6c13bf4429d1fd72fb785","courseProgressId":0,"tsGen":1794556219908,"createTime":"2026-11-13 15:50:19","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c138f4429d1fd72fb77c","chatId":"b887e752403f45c98ddd9c402c281948","sessionId":null,"userId":100153,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"听起来你不是想太多，而是真的在硬撑。这种没劲的感觉，通常什么时候最明显呢？比如早上那会儿，家里是什么样的情况？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来你不是想太多，而是真的在硬撑。这种没劲的感觉，通常什么时候最明显呢？比如早上那会儿，家里是什么样的情况？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2641,"promptTokens":573,"completionTokens":137,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:50:16"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00669171254259184,"emotions":[],"relationId":"6af6c138f4429d1fd72fb77b","courseProgressId":0,"tsGen":1794556216223,"createTime":"2026-11-13 15:50:16","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c138f4429d1fd72fb77b","chatId":"b887e752403f45c98ddd9c402c281948","sessionId":null,"userId":100153,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"都有吧……我也分不清。有时候早上起来就觉得没劲，可又说不上来哪儿不舒服。可能是我自己想太多了。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"