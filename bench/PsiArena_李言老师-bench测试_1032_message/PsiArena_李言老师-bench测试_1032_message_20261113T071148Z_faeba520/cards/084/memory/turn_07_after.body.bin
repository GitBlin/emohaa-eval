{"success":true,"code":"000","message":null,"data":{"totalAmount":14,"totalPageCount":1,"pageNum":0,"itemCount":14,"content":[{"pageNum":0,"pageSize":0,"id":"6af6c7a5f4429d1fd72fbed8","chatId":"5919bd1b45554f14a5625b2cc42932d1","sessionId":null,"userId":100183,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"你好像习惯把矛头指向自己，觉得是\"我不行\"。这种烦自己的感觉，平时出现的多吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你好像习惯把矛头指向自己，觉得是\"我不行\"。这种烦自己的感觉，平时出现的多吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1411,"promptTokens":943,"completionTokens":126,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:17:41"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008574968898975745,"emotions":[],"relationId":"6af6c7a5f4429d1fd72fbed7","courseProgressId":0,"tsGen":1794557861094,"createTime":"2026-11-13 16:17:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c7a5f4429d1fd72fbed7","chatId":"5919bd1b45554f14a5625b2cc42932d1","sessionId":null,"userId":100183,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"说不上来……就是有点烦自己吧。感觉别人都能管住自己，怎么就我不行。可能我想太多了，其实也没什么大事。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008574968898975745,"emotions":[],"relationId":"6af6c7a5f4429d1fd72fbed8","courseProgressId":0,"tsGen":1794557861091,"createTime":"2026-11-13 16:17:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c7a1f4429d1fd72fbed2","chatId":"5919bd1b45554f14a5625b2cc42932d1","sessionId":null,"userId":100183,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"听起来这个循环让你挺累的，想放松，放松完又自责，第二天更疲惫。这种反反复复的感觉，除了累，还让你心里有什么感受呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来这个循环让你挺累的，想放松，放松完又自责，第二天更疲惫。这种反反复复的感觉，除了累，还让你心里有什么感受呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1870,"promptTokens":841,"completionTokens":140,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:17:37"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008574136927690042,"emotions":[],"relationId":"6af6c7a1f4429d1fd72fbed1","courseProgressId":0,"tsGen":1794557857397,"createTime":"2026-11-13 16:17:37","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c7a1f4429d1fd72fbed1","chatId":"5919bd1b45554f14a5625b2cc42932d1","sessionId":null,"userId":100183,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"哦……好吧，我理解。（停顿了一下）那天晚上其实也没想什么特别的，就是觉得白天太累了，想放松一下。可刷完了又后悔，觉得第二天肯定没精神。就这样，一直反反复复的。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"