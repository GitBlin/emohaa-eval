28f432a","sessionId":null,"userId":100114,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"怕……怕真闹开了，家就散了，别人会说我连个家都守不住。还有孩子……我怀着孕呢，一想到这个就更不敢动了。<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":26,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.042071424175665006,"emotions":[],"relationId":"6af6babaf4429d1fd72faf1a","courseProgressId":0,"tsGen":1794554554167,"createTime":"2026-11-13 15:22:34","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6bab6f4429d1fd72faf11","chatId":"4a7d25e0c8ad40efaa90cfb5528f432a","sessionId":null,"userId":100114,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"冒火是真的，缩回去也是真的，两股劲在心里拉扯，很耗人。父母那句“忍一忍”像根绳子拉着你。你缩回去的时候，心里最怕的是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"冒火是真的，缩回去也是真的，两股劲在心里拉扯，很耗人。父母那句“忍一忍”像根绳子拉着你。你缩回去的时候，心里最怕的是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":5527,"promptTokens":1297,"completionTokens":205,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:22:30"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909818766493923,"emotions":[],"relationId":"6af6bab6f4429d1fd72faf10","courseProgressId":0,"tsGen":1794554550840,"createTime":"2026-11-13 15:22:30","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":