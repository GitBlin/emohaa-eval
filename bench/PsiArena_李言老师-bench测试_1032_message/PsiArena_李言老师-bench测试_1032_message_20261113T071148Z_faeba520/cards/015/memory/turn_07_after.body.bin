{"success":true,"code":"000","message":null,"data":{"totalAmount":14,"totalPageCount":1,"pageNum":0,"itemCount":14,"content":[{"pageNum":0,"pageSize":0,"id":"6af6ba9cf4429d1fd72faed9","chatId":"4a7d25e0c8ad40efaa90cfb5528f432a","sessionId":null,"userId":100114,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"不计较。被摔门留下，一个人坐一晚上，那种滋味不好受。你不是在计较，是心里真的被碰到了。那晚他走后，你脑子里都在想些什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不计较。被摔门留下，一个人坐一晚上，那种滋味不好受。你不是在计较，是心里真的被碰到了。那晚他走后，你脑子里都在想些什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":999,"promptTokens":931,"completionTokens":66,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:22:04"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01242636537879766,"emotions":[],"relationId":"6af6ba9cf4429d1fd72faed8","courseProgressId":0,"tsGen":1794554524380,"createTime":"2026-11-13 15:22:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6ba9cf4429d1fd72faed8","chatId":"4a7d25e0c8ad40efaa90cfb5528f432a","sessionId":null,"userId":100114,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"有吧……就前几天，我们又吵了一架，其实也不算吵，就是他一句话不说，摔门走了。我在家坐了一晚上。唉，说这些是不是显得我很计较？<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01242636537879766,"emotions":[],"relationId":"6af6ba9cf4429d1fd72faed9","courseProgressId":0,"tsGen":1794554524377,"createTime":"2026-11-13 15:22:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6ba98f4429d1fd72faed0","chatId":"4a7d25e0c8ad40efaa90cfb5528f432a","sessionId":null,"userId":100114,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"不扯远，这些都有联系。讲不明白很正常，累到一定程度反而说不清。我们慢慢来。最近有没有哪一次，你特别明显地感觉到这种累？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不扯远，这些都有联系。讲不明白很正常，累到一定程度反而说不清。我们慢慢来。最近有没有哪一次，你特别明显地感觉到这种累？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1729,"promptTokens":820,"completionTokens":135,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:22:00"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012429296212943267,"emotions":[],"relationId":"6af6ba98f4429d1fd72faecf","courseProgressId":0,"tsGen":1794554520688,"createTime":"2026-11-13 15:22:00","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6ba98f4429d1fd72faecf","chatId":"4a7d25e0c8ad40efaa90cfb5528f432a","sessionId":null,"userId":100114,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"主要是我妈吧，但她也很忙……哎呀，说这些感觉有点扯远了。我就是觉得，现在这段婚姻把我搞得特别累，可具体哪里累，我又讲不明白。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource