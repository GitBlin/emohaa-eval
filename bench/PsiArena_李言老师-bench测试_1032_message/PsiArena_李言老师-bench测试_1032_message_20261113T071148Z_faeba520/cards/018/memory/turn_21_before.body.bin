"恐惧","value":7,"sort":6},{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6bb3ff4429d1fd72fafb0","courseProgressId":0,"tsGen":1794554687371,"createTime":"2026-11-13 15:24:47","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6bb3bf4429d1fd72fafa9","chatId":"723e799d3ec9463d9b11b6ce7d993a33","sessionId":null,"userId":100117,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"被戳到，说明我们碰到了一些真实的东西。你能这样坦诚地看到自己，其实很难得。这份“难接受”，你愿意再多说一点点吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"被戳到，说明我们碰到了一些真实的东西。你能这样坦诚地看到自己，其实很难得。这份“难接受”，你愿意再多说一点点吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1817,"promptTokens":911,"completionTokens":111,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:24:43"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005910639666405306,"emotions":[],"relationId":"6af6bb3bf4429d1fd72fafa8","courseProgressId":0,"tsGen":1794554683471,"createTime":"2026-11-13 15:24:43","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6bb3bf4429d1fd72fafa8","chatId":"723e799d3ec9463d9b11b6ce7d993a33","sessionId":null,"userId":100117,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"（停顿）你这话说得……我有点被戳到的感觉。其实我有时候会想，要是换作别人跟我讲我现在的处境，我可能也会觉得，嗯，有点难接受。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005910639666405306,"emotions":[{"code":"calm","name":"平静","value":4,"sort":4},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"surprised","name":"惊讶","value":3,"sort":5},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6bb3bf4429d1fd72fafa9","courseProgressId":0,"tsGen":1794554683468,"createTime":"2026-11-13 15:24:43","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6bb37f4429d1fd72faf9f","chatId":"723e799d3ec9463d9b11b6ce7d993a33","sessionId":null,"userId":100117,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"平时能和朋友畅聊，却在这里担心被评判，这个反差挺有意思的。也许不是怕别人怎么看，而是有些话连你自己都觉得难以接受？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"平时能和朋友畅聊，却在这里担心被评判，这个反差挺有意思的。也许不是怕别人怎么看，而是有些话连你自己都觉得难以接受？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1521,"promptTokens":800,"completionTokens":109,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:24:39"}],"imgs":null,"regenera