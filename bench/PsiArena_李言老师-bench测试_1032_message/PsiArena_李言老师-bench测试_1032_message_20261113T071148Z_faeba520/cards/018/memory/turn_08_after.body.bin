{"success":true,"code":"000","message":null,"data":{"totalAmount":16,"totalPageCount":1,"pageNum":0,"itemCount":16,"content":[{"pageNum":0,"pageSize":0,"id":"6af6bb3ff4429d1fd72fafb0","chatId":"723e799d3ec9463d9b11b6ce7d993a33","sessionId":null,"userId":100117,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"我理解，说出口有时候就像给自己定了性，谁都会犹豫。你不用急着讲内容。我们可以只谈那份“不想面对”的感觉，它更像害怕，还是更像失望？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我理解，说出口有时候就像给自己定了性，谁都会犹豫。你不用急着讲内容。我们可以只谈那份“不想面对”的感觉，它更像害怕，还是更像失望？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1719,"promptTokens":1012,"completionTokens":111,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:24:47"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219697978928766,"emotions":[],"relationId":"6af6bb3ff4429d1fd72fafaf","courseProgressId":0,"tsGen":1794554687374,"createTime":"2026-11-13 15:24:47","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6bb3ff4429d1fd72fafaf","chatId":"723e799d3ec9463d9b11b6ce7d993a33","sessionId":null,"userId":100117,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"就是……我担心一旦说出口，等于承认了某些我不太想面对的东西。我还没想好怎么讲，你能理解吗？<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219697978928766,"emotions":[],"relationId":"6af6bb3ff