":"2026-11-13 15:59:14"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575868243175718,"emotions":[],"relationId":"6af6c352f4429d1fd72fb99f","courseProgressId":0,"tsGen":1794556754753,"createTime":"2026-11-13 15:59:14","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c352f4429d1fd72fb99f","chatId":"455dc435745e48f69d10939659d7af63","sessionId":null,"userId":100161,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"哦……好吧。（沉默几秒）身体上，就是胸口闷，有时候手会发麻。不过这些可能都是我自己想多了吧。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575868243175718,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6c352f4429d1fd72fb9a0","courseProgressId":0,"tsGen":1794556754750,"createTime":"2026-11-13 15:59:14","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c34ef4429d1fd72fb99b","chatId":"455dc435745e48f69d10939659d7af63","sessionId":null,"userId":100161,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"我理解你想有个依靠的心情，不过咨询之外我没办法