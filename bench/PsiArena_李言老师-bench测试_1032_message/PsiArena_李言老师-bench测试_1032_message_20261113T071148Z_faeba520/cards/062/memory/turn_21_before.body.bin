就亮了。","就硬撑呗，想着不去不行，家里还等着这点工资。"]},"conversation":{"type":"焦虑和恐惧","topic":"工作压力引发的焦虑、自我苛责与就医犹豫"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c345f4429d1fd72fb992","chatId":"455dc435745e48f69d10939659d7af63","sessionId":null,"userId":100161,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"我不会觉得没什么大不了，你的感受对我来说很重要。听起来这种累已经持续一阵子了。工作上具体发生了什么，让你有这种感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我不会觉得没什么大不了，你的感受对我来说很重要。听起来这种累已经持续一阵子了。工作上具体发生了什么，让你有这种感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1335,"promptTokens":457,"completionTokens":88,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:59:01"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007574280367215628,"emotions":[],"relationId":"6af6c345f4429d1fd72fb991","courseProgressId":0,"tsGen":1794556741723,"createTime":"2026-11-13 15:59:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c345f4429d1fd72fb991","chatId":"455dc435745e48f69d10939659d7af63","sessionId":null,"userId":100161,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"嗯……其实我也说不太清楚，就是觉得累，干什么都提不起劲。工作上的事吧……说了您可能也觉得没什么大不了的。<第3轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":6,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0