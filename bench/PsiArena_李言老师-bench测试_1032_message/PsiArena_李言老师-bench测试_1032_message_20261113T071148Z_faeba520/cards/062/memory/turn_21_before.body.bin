":35,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.015900445586499962,"emotions":[],"relationId":"6af6c37df4429d1fd72fb9df","courseProgressId":0,"tsGen":1794556797643,"createTime":"2026-11-13 15:59:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c37df4429d1fd72fb9df","chatId":"455dc435745e48f69d10939659d7af63","sessionId":null,"userId":100161,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"嗯，能松一点。（想了想）其实我也知道光靠这个不够，可请假去看病这事儿……我一直拿不定主意。<第17轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":34,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.015900445586499962,"emotions":[{"code":"calm","name":"平静","value":4,"sort":4},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"sadness","name":"悲伤","value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6c37df4429d1fd72fb9e0","courseProgressId":0,"tsGen":1794556797640,"createTime":"2026-11-13 15:59:57","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["疲惫","焦虑","自责","担忧","无助"],"originalText":["就是觉得累，干什么都提不起劲。","每天上班像上刑一样，回到家又觉得对不起家里人。","一进那个门就喘不上气，领导还老催。","怕被人看出来我不行。","越想越觉得自己没用，然后天就亮了。","就硬撑呗，想着不去不行，家里还等着这点工资。"]},"conversation":{"type":"焦虑和恐惧","topic":"工作压力引发的焦虑、自我苛责与就医犹豫"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":