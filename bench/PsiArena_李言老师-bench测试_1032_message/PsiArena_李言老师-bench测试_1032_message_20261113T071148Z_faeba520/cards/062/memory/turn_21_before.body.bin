":1794556779293,"createTime":"2026-11-13 15:59:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c36bf4429d1fd72fb9c8","chatId":"455dc435745e48f69d10939659d7af63","sessionId":null,"userId":100161,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"嗯……好像是。工作上也一样，总觉得做得不够，领导一句话我就能琢磨一晚上。可越这样越累，越累越做不好。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218833739501914,"emotions":[{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6c36bf4429d1fd72fb9c9","courseProgressId":0,"tsGen":1794556779290,"createTime":"2026-11-13 15:59:39","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["疲惫","焦虑","自责","担忧","无助"],"originalText":["就是觉得累，干什么都提不起劲。","每天上班像上刑一样，回到家又觉得对不起家里人。","一进那个门就喘不上气，领导还老催。","怕被人看出来我不行。","越想越觉得自己没用，然后天就亮了。","就硬撑呗，想着不去不行，家里还等着这点工资。"]},"conversation":{"type":"焦虑和恐惧","topic":"工作压力引发的焦虑、自我苛责与就医犹豫"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c366f4429d1fd72fb9bf","chatId":"455dc435745e48f69d10939659d7af63","sessionId":null,"userId":100161,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","c