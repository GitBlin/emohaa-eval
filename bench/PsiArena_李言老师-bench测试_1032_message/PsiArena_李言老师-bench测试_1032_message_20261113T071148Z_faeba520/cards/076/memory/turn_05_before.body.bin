{"success":true,"code":"000","message":null,"data":{"totalAmount":8,"totalPageCount":1,"pageNum":0,"itemCount":8,"content":[{"pageNum":0,"pageSize":0,"id":"6af6c609f4429d1fd72fbd03","chatId":"ec463b9d906d4a34bd2072dc9c0d5794","sessionId":null,"userId":100175,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"这个顾虑很合理。你说的话我会保密，不会告诉你单位或其他人。除非涉及你或他人的安全风险，那我会先和你商量。现在你可以放心说。睡不好这件事，大概持续多久了？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"这个顾虑很合理。你说的话我会保密，不会告诉你单位或其他人。除非涉及你或他人的安全风险，那我会先和你商量。现在你可以放心说。睡不好这件事，大概持续多久了？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1293,"promptTokens":604,"completionTokens":112,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:10:49"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008574442685315379,"emotions":[],"relationId":"6af6c609f4429d1fd72fbd02","courseProgressId":0,"tsGen":1794557449506,"createTime":"2026-11-13 16:10:49","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c609f4429d1fd72fbd02","chatId":"ec463b9d906d4a34bd2072dc9c0d5794","sessionId":null,"userId":100175,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"都有吧……晚上睡不好，白天就像没电一样。嗯，我能问一下吗，我在这儿说的话，您会告诉别人吗？比如我单位什么的。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008574442685315379,"emotions":