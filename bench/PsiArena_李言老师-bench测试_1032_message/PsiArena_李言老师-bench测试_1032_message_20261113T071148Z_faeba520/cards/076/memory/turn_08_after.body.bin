prised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1}],"relationId":"6af6c609f4429d1fd72fbd03","courseProgressId":0,"tsGen":1794557449503,"createTime":"2026-11-13 16:10:49","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c606f4429d1fd72fbcfe","chatId":"ec463b9d906d4a34bd2072dc9c0d5794","sessionId":null,"userId":100175,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"第一次来，能说出这些已经很不容易了。那种说不清的累，往往最磨人。我想多了解一点——你说的“累”，是身体上的疲惫，还是心里那种提不起劲的感觉呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"第一次来，能说出这些已经很不容易了。那种说不清的累，往往最磨人。我想多了解一点——你说的“累”，是身体上的疲惫，还是心里那种提不起劲的感觉呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":916,"promptTokens":489,"completionTokens":76,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:10:46"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012427152793069045,"emotions":[],"relationId":"6af6c606f4429d1fd72fbcfd","courseProgressId":0,"tsGen":1794557446202,"createTime":"2026-11-13 16:10:46","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c606f4429d1fd72fbcfd","chatId":"ec463b9d906d4a34bd2072dc9c0d5794","sessionId":null,"userId":100175,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"没有，第一次。嗯……其实我也不太确定该从哪儿说起，就是最近总觉得很累，工作上也老是出问题，但说不清到底是怎么回事。<第3轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"video