{"success":true,"code":"000","message":null,"data":{"totalAmount":16,"totalPageCount":1,"pageNum":0,"itemCount":16,"content":[{"pageNum":0,"pageSize":0,"id":"6af6c61cf4429d1fd72fbd13","chatId":"ec463b9d906d4a34bd2072dc9c0d5794","sessionId":null,"userId":100175,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"高中那件事，听起来像在心里留下了一个印记。那时候没能去成想去的学校，你心里是什么感受，有跟谁说过吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"高中那件事，听起来像在心里留下了一个印记。那时候没能去成想去的学校，你心里是什么感受，有跟谁说过吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1752,"promptTokens":1017,"completionTokens":140,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:11:08"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009707208439107976,"emotions":[],"relationId":"6af6c61cf4429d1fd72fbd12","courseProgressId":0,"tsGen":1794557468927,"createTime":"2026-11-13 16:11:08","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c61cf4429d1fd72fbd12","chatId":"ec463b9d906d4a34bd2072dc9c0d5794","sessionId":null,"userId":100175,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"（停顿）最早啊……可能是高中吧。那时候家里条件不太好，没能上想去的学校，从那以后我好像就一直觉得自己不行。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009707208439107976,"emotions":[],"relationId":"6af6c61cf4429d1fd72fbd13","cour