{"success":true,"code":"000","message":null,"data":{"totalAmount":12,"totalPageCount":1,"pageNum":0,"itemCount":12,"content":[{"pageNum":0,"pageSize":0,"id":"6af6c842f4429d1fd72fbf79","chatId":"a31b4fe766ed4dde828454e917255eb8","sessionId":null,"userId":100185,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"你好像习惯把自己的感受往小里说。不过在我看来，这些烦恼并不小。你说“想太多”的时候，心里具体是什么感觉呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你好像习惯把自己的感受往小里说。不过在我看来，这些烦恼并不小。你说“想太多”的时候，心里具体是什么感觉呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1660,"promptTokens":758,"completionTokens":133,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:20:18"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608693930319727,"emotions":[],"relationId":"6af6c842f4429d1fd72fbf78","courseProgressId":0,"tsGen":1794558018925,"createTime":"2026-11-13 16:20:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c842f4429d1fd72fbf78","chatId":"a31b4fe766ed4dde828454e917255eb8","sessionId":null,"userId":100185,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"嗯……可能是吧。我老觉得自己想太多，别人好像都没这些烦恼。算了，可能也没什么大不了的。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608693930319727,"emotions":[],"relationId":"6af6c842f4429d1fd72fbf79","coursePro