ode":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"fear","name":"恐惧","value":0,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6cd46f4429d1fd72fcdf6","courseProgressId":0,"tsGen":1794559302912,"createTime":"2026-11-13 16:41:42","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6cd42f4429d1fd72fcdf4","chatId":"c6da515815db42b88bbeda5d532129d0","sessionId":null,"userId":100206,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"“算了”这两个字，你好像说过好几次了。那种想开口又咽回去的瞬间，其实挺孤单的。我们不用急着理清楚，可以从最近一次“算了”的时候说起——那次是什么情况呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“算了”这两个字，你好像说过好几次了。那种想开口又咽回去的瞬间，其实挺孤单的。我们不用急着理清楚，可以从最近一次“算了”的时候说起——那次是什么情况呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":5279,"promptTokens":887,"completionTokens":152,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:41:38"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010986244307212416,"emotions":[],"relationId":"6af6cd42f4429d1fd72fcdf3","courseProgressId":0,"tsGen":1794559298998,"createTime":"2026-11-13 16:41:38","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6cd42f4429d1fd72fcdf3","chatId":"c6da515815db42b88bbeda5d532129d0","sessionId":null,"userId":100206,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"没怎么说过……真的。我家里人不太聊这些，他们觉得熬一熬就过去了。我有时候想开口，又觉得……算了，不知道从哪说起。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010986244307212416,"emotions":[],"relationId":"6af6cd42f4429d1fd72fcdf4","courseProgressId":0,"tsGen":1794559298995,"createTime":"2026-11-13 16:41:38","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6cd3bf4429d1fd72fcdf1","chatId":"c6da515815db42b88bbeda5d532129d0","sessionId":null,"userId":100206,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"“说了又能怎么样”，这话里有种很深的无力感，好像说了也改变不了什么。不过在这里，你不用先证明自己够不够格被听。我想问，你有没有试过跟谁真正说出过一点？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“说了又能怎么样”，这话里有种很深的无力感，好像说了也改变不了什么。不过在这里，你不用先证明自己够不够格被听。我想问，你有没有试过跟谁真正说出过一点？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1851,"promptTokens":769,"completionTokens":165,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:41:31"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575525612566566,"emotions":[],"relationId":"6af6cd3bf4429d1fd72fcdf0","courseProgressId":0,"tsGen":1794559291946,"createTime":"2026-11-13 16:41:31","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6cd3bf4429d1fd72fcdf0","chatId":"c6da515815db42b88bbeda5d532129d0","sessionId":null,"userId":100206,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"就是……同事吧，还有家里人。他们都有自己的事，我说这些好像显得矫情。而且……唉，说了又能怎么样呢。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575525612566566,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6cd3bf4429d1fd72fcdf1","courseProgressId":0,"tsGen":1794559291944,"createTime":"2026-11-13 16:41:31","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6cd35f4429d1fd72fcdef","chatId":"c6da515815db42b88bbeda5d532129d0","sessionId":null,"userId":100206,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"“不好多说什么”，这句话让我有点在意。是觉得说了也没人理解，还是担心说了会带来别的麻烦？你心里那个不好说出口的对象，是谁呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“不好多说什么”，这句话让我有点在意。是觉得说了也没人理解，还是担心说了会带来别的麻烦？你心里那个不好说出口的对象，是谁呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1153,"promptTokens":668,"completionTokens":79,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-1