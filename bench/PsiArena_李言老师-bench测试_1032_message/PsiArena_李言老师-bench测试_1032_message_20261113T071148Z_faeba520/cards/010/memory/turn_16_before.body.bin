心理咨询对话，在回应时保持心理咨询师的角色，说话方式和语气应贴合真正的心理咨询师。确保反应和情感表现真实，避免表现得像机器。\n3.咨询过程应包含25轮互动，在后期对话回顾咨询过程并引导来访者进行总结，不要太早说“谢谢”或“再见”。\n4.让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。\n</咨询行为要求>\n咨询师你好！<第1轮>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0,"emotions":[{"code":"calm","name":"平静","value":6,"sort":4},{"code":"expect","name":"期待","value":4,"sort":2},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"fear","name":"恐惧","value":0,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7},{"code":"sadness","name":"悲伤","value":0,"sort":8},{"code":"dislike","name":"厌恶","value":0,"sort":9}],"relationId":"6af6b9a7f4429d1fd72fad87","courseProgressId":0,"tsGen":1794554279481,"createTime":"2026-11-13 15:17:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"ec535f5e3a3b4f3abe15e5ecb7f75cab"}