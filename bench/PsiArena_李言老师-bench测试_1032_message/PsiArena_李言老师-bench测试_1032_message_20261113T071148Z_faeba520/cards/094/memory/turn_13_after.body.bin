{"success":true,"code":"000","message":null,"data":{"totalAmount":26,"totalPageCount":1,"pageNum":0,"itemCount":26,"content":[{"pageNum":0,"pageSize":0,"id":"6af6c9a5f4429d1fd72fc69d","chatId":"56406300ca724806bc7923d9fd9cf1af","sessionId":null,"userId":100193,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"你能听出那个语气像妈妈，这个发现本身就挺重要的。那个“你怎么连这点小事都做不好”的声音出现时，你心里是什么感受？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你能听出那个语气像妈妈，这个发现本身就挺重要的。那个“你怎么连这点小事都做不好”的声音出现时，你心里是什么感受？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1369,"promptTokens":1206,"completionTokens":108,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:26:13"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909902359912914,"emotions":[],"relationId":"6af6c9a5f4429d1fd72fc69c","courseProgressId":0,"tsGen":1794558373437,"createTime":"2026-11-13 16:26:13","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c9a5f4429d1fd72fc69c","chatId":"56406300ca724806bc7923d9fd9cf1af","sessionId":null,"userId":100193,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"我就会想，你怎么连这点小事都做不好……有点像我妈以前说我的语气。哎，说出来才发现，好像真是这样。<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":26,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909902359912914,"emotions":[],"relationId":"6af6c9a5f4429d1fd72fc69d","courseProgressId":0,"tsGen":1794558373434,"createTime":"2026-11-13 16:26:13","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c9a2f4429d1fd72fc698","chatId":"56406300ca724806bc7923d9fd9cf1af","sessionId":null,"userId":100193,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"什么都想做到最好，连早餐也想，结果来不及就随便对付，之后又后悔——这个来回挺消耗人的。那种后悔冒出来的时候，你一般会怎么对自己说呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"什么都想做到最好，连早餐也想，结果来不及就随便对付，之后又后悔——这个来回挺消耗人的。那种后悔冒出来的时候，你一般会怎么对自己说呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1234,"promptTokens":1235,"completionTokens":101,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:26:10"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007574627391297703,"emotions":[],"relationId":"6af6c9a2f4429d1fd72fc697","courseProgressId":0,"tsGen":1794558370220,"createTime":"2026-11-13 16:26:10","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c9a2f4429d1fd72fc697","chatId":"56406300ca724806bc7923d9fd9cf1af","sessionId":null,"userId":100193,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"工作吧，什么都想做到最好，方案改了一遍又一遍。还有吃的，我明明知道该吃健康的，可早上根本来不及，就随便买点……然后又后悔。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007574627391297703,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af6c9a2f4429d1fd72fc698","courseProgressId":0,"tsGen":1794558370217,"createTime":"2026-11-13 16:26:10","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c99ef4429d1fd72fc691","chatId":"56406300ca724806bc7923d9fd9cf1af","sessionId":null,"userId":100193,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"说不清也没关系，这种“对不起自己”的感觉本来就很难一句话讲明白。你说自己明明已经够努力了，那这份努力，平时都用在哪些地方呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"说不清也没关系，这种“对不起自己”的感觉本来就很难一句话讲明白。你说自己明明已经够努力了，那这份努力，平时都用在哪些地方呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1963,"promptTokens":1209,"completionTokens":151,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:26:06"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00970641164906344,"emotions":[],"relationId":"6af6c99ef4429d1fd72fc690","courseProgressId":0,"tsGen":1794558366563,"createTime":"2026-11-13 16:26:06","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c99ef4429d1fd72fc690","chatId":"56406300ca724806bc7923d9fd9cf1af","sessionId":null,"userId":100193,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"都有吧……说不清。好像更多是对不起我自己？可又觉得不对，我明明已经够努力了。唉，我也说不好。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00970641164906344,"emotions":[],"relationId":"6af6c99ef4429d1fd72fc691","courseProgressId":0,"tsGen":1794558366560,"createTime":"2026-11-13 16:26:06","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c99af4429d1fd72fc689","chatId":"56406300ca724806bc7923d9fd9cf1af","sessionId":null,"userId":100193,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"“松下来就对不起谁”——这句话像是从小就装在心里了。那种对不起的感觉，更多是指向爸妈，还是指向你自己呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“松下来就对不起谁”——这句话像是从小就装在心里了。那种对不起的感觉，更多是指向爸妈，还是指向你自己呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1307,"promptTokens":1114,"completionTokens":81,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:26:02"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012429377827762378,"emotions":[],"relationId":"6af6c99af4429d1fd72fc688","courseProgressId":0,"tsGen":1794558362261,"createTime":"2026-11-13 16:26:02","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c99af4429d1fd72fc688","chatId":"56406300ca724806bc7923d9fd9cf1af","sessionId":null,"userId":100193,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"我……说实话，我好像从来没认真想过。在我家，松懈就是不对的，我爸妈都是公务员，做什么都讲效率、讲责任。我从小就觉得，要是松下来，好像就对不起谁似的。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012429377827762378,"emotions":[],"relationId":"6af6c99af4429d1fd72fc689","courseProgressId":0,"tsGen":1794558362258,"createTime":"2026-11-13 16:26:02","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c996f4429d1fd72fc682","chatId":"56406300ca724806bc7923d9fd9cf1af","sessionId":null,"userId":100193,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"松一会儿又觉得不该松，好像连休息都要先过一道“懒散”的审查。你妈妈那句话，听起来在你心里分量不轻。那你自己是怎么看待“松懈”这件事的呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"松一会儿又觉得不该松，好像连休息都要先过一道“懒散”的审查。你妈妈那句话，听起来在你心里分量不轻。那你自己是怎么看待“松懈”这件事的呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1524,"promptTokens":1166,"completionTokens":120,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:25:58"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005908552900044741,"emotions":[],"relationId":"6af6c996f4429d1fd72fc681","courseProgressId":0,"tsGen":1794558358684,"createTime"