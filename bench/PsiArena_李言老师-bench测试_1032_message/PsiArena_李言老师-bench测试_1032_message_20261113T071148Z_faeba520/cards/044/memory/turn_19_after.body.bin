","value":1,"sort":1},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6bf7af4429d1fd72fb59a","courseProgressId":0,"tsGen":1794555770635,"createTime":"2026-11-13 15:42:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6bf76f4429d1fd72fb58e","chatId":"cf4cfbb6f93f46f1a96e2a6b18e28b82","sessionId":null,"userId":100143,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"你不傻，愿意为一段关系付出，说明你很真诚。只是这份付出没有得到回应，才会觉得委屈。现在回头看，你会怎么看待当时为她疏远其他人的选择呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你不傻，愿意为一段关系付出，说明你很真诚。只是这份付出没有得到回应，才会觉得委屈。现在回头看，你会怎么看待当时为她疏远其他人的选择呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1313,"promptTokens":1176,"completionTokens":115,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:42:46"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012424862617697489,"emotions":[],"relationId":"6af6bf76f4429d1fd72fb58d","courseProgressId":0,"tsGen":1794555766971,"createTime":"2026-11-13 15:42:46","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6bf76f4429d1fd72fb58d","chatId":"cf4cfbb6f93f46f1a96e2a6b18e28b82","sessionId":null,"userId":100143,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"问过……她说没事，让我别多想。可她的态度明明就是变了啊。（有些激动）我为了她，连原来一起玩的人都疏远了，结果……我是不是很傻？<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数