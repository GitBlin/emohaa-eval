ionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c4c0f4429d1fd72fbb99","chatId":"46f0796156e842e8b3ef0f31a98d8fcf","sessionId":null,"userId":100169,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"嗯……工作里最明显。尤其坐在来访者对面的时候，我会突然想，我是不是根本没资格帮别人。上次督导完，我甚至有一会儿不敢看自己的笔记。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007576561618858127,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6c4c0f4429d1fd72fbb9a","courseProgressId":0,"tsGen":1794557120438,"createTime":"2026-11-13 16:05:20","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c4bcf4429d1fd72fbb93","chatId":"46f0796156e842e8b3ef0f31a98d8fcf","sessionId":null,"userId":100169,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"骄傲和怕同时出现，那种滋味挺复杂的。你妈不是凶的人，却让你背上了“不能停”。现在那个“怕下次更糟”的担心，还在哪些时刻冒出来？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"骄傲和怕同时出现，