26776185,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6b9ebf4429d1fd72fae23","courseProgressId":0,"tsGen":1794554347799,"createTime":"2026-11-13 15:19:07","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b9e7f4429d1fd72fae19","chatId":"ff280b2d9b6947539224232d8508087e","sessionId":null,"userId":100107,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"对，别急着怪自己，敷衍是她那一刻的状态，不等于你说了不该说的。那个“果然不该说”的念头，你熟悉它多久了？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"对，别急着怪自己，敷衍是她那一刻的状态，不等于你说了不该说的。那个“果然不该说”的念头，你熟悉它多久了？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1405,"promptTokens":1292,"completionTokens":109,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:19:03"}],"imgs":null,"regenerations":0,"seqNum":41,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575730379786341,"emotions":[],"relationId":"6af6b9e7f4429d1fd72fae18","courseProgressId":0,"tsGen":1794554343794,"createTime":"2026-11-13 15:19:03","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b9e7f4429d1fd72fae18","chatId":"ff280b2d9b6947539224232d8508087e","sessionId":null,"userId":100107