{"success":true,"code":"000","message":null,"data":{"totalAmount":12,"totalPageCount":1,"pageNum":0,"itemCount":12,"content":[{"pageNum":0,"pageSize":0,"id":"6af6c5bff4429d1fd72fbcae","chatId":"9249c6596df74ac3ae981b7cdca78ce0","sessionId":null,"userId":100174,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"前一天晚上就开始堵，早上起来胸口也闷，身体已经在替你反应了。这种提前就难受的感觉，确实很磨人。那到了真要出门的时候，你心里最不想面对的会是什么呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"前一天晚上就开始堵，早上起来胸口也闷，身体已经在替你反应了。这种提前就难受的感觉，确实很磨人。那到了真要出门的时候，你心里最不想面对的会是什么呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2082,"promptTokens":798,"completionTokens":140,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:09:35"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00970596681898894,"emotions":[],"relationId":"6af6c5bff4429d1fd72fbcad","courseProgressId":0,"tsGen":1794557375966,"createTime":"2026-11-13 16:09:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c5bff4429d1fd72fbcad","chatId":"9249c6596df74ac3ae981b7cdca78ce0","sessionId":null,"userId":100174,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"一般是前一天晚上，想到第二天要去，就特别明显。早上起来的时候也是，胸口闷闷的。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00970596681898894,"emotions":[],"relationId":"6af6c5bff4429d1fd72fbcae","courseProgressId":0,"tsGen":1794557375963,"createTime":"2026-11-13 16:09:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c5bbf4429d1fd72fbca8","chatId":"9249c6596df74ac3ae981b7cdca78ce0","sessionId":null,"userId":100174,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"不会，我一点都不觉得乱。心里堵得慌的时候，话说不清楚是很自然的事，你能说出来已经很不容易了。想到上班就堵得慌——这种感觉通常是在一天里的什么时候最明显呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不会，我一点都不觉得乱。心里堵得慌的时候，话说不清楚是很自然的事，你能说出来已经很不容易了。想到上班就堵得慌——这种感觉通常是在一天里的什么时候最明显呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1208,"promptTokens":696,"completionTokens":118,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:09:31"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008573104722911057,"emotions":[],"relationId":"6af6c5bbf4429d1fd72fbca7","courseProgressId":0,"tsGen":1794557371201,"createTime":"2026-11-13 16:09:31","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c5bbf4429d1fd72fbca7","chatId":"9249c6596df74ac3ae981b7cdca78ce0","sessionId":null,"userId":100174,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"我也说不太清楚……就是一想到要去上班，心里就堵得慌。唉，我这样说是不是挺乱的？你会不会觉得我连自己想说什么都不知道。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008573104722911057,"emotions":[],"relationId":"6af6c5bbf4429d1fd72fbca8","courseProgressId":0,"tsGen":1794557371198,"createTime":"2026-11-13 16:09:31","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c5b7f4429d1fd72fbca5","chatId":"9249c6596df74ac3ae981b7cdca78ce0","sessionId":null,"userId":100174,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"工作的事一想就烦，越想越睡不着，这样循环着确实很消耗人。听起来工作里有些事一直压着你。最近让你最烦心的，是工作里的哪一部分呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"工作的事一想就烦，越想越睡不着，这样循环着确实很消耗人。听起来工作里有些事一直压着你。最近让你最烦心的，是工作里的哪一部分呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1903,"promptTokens":586,"completionTokens":173,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:09:27"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608486018144978,"emotions":[],"relationId":"6af6c5b7f4429d1fd72fbca4","courseProgressId":0,"tsGen":1794557367713,"createTime":"2026-11-13 16:09:27","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c5b7f4429d1fd72fbca4","chatId":"9249c6596df74ac3ae981b7cdca78ce0","sessionId":null,"userId":100174,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"大概……有一阵子了吧，我也记不清具体多久。就是工作的事，一想就烦，越想越睡不着。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null