{"success":true,"code":"000","message":null,"data":{"totalAmount":18,"totalPageCount":1,"pageNum":0,"itemCount":18,"content":[{"pageNum":0,"pageSize":0,"id":"6af6bbcff4429d1fd72fb074","chatId":"50c1f3406514430394a69b323594d54f","sessionId":null,"userId":100120,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"原来这种沉重感，从小就伴随着你。习惯了硬撑，也习惯了那种气氛。你觉得小时候的那种感觉，和现在心里的“沉”，像吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"原来这种沉重感，从小就伴随着你。习惯了硬撑，也习惯了那种气氛。你觉得小时候的那种感觉，和现在心里的“沉”，像吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1574,"promptTokens":1021,"completionTokens":121,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:27:11"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01798159289462788,"emotions":[],"relationId":"6af6bbcff4429d1fd72fb073","courseProgressId":0,"tsGen":1794554831351,"createTime":"2026-11-13 15:27:11","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6bbcff4429d1fd72fb073","chatId":"50c1f3406514430394a69b323594d54f","sessionId":null,"userId":100120,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"熬……其实也没什么办法，就是硬撑着。（停了停）说起来，我小时候家里也有过类似的气氛，那时候舅舅走了，后来外公也是……好像我从小就习惯了这种感觉。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01798159289462788,"emotions":[],"relationId":"6a