ue":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af6c37ff4429d1fd72fb9e2","courseProgressId":0,"tsGen":1794556799900,"createTime":"2026-11-13 15:59:59","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["焦虑","疲惫","自责","担忧","自我怀疑","不确定"],"originalText":["就是……乱吧，也累。说不上来具体哪件事最难受，好像一堆事压在一起。","像桌上摊了一堆表格和材料，我一张张找，却总找不到对的那张……你会不会觉得我这样很没用？","焦虑，还有点发紧，越查越觉得自己笨。","就是会骂自己，怎么这么点事都弄不明白……其实我也不想这样。","可一停下来，脑子里就全是还没办完的事。"]},"conversation":{"type":"焦虑和恐惧","topic":"来访者因孩子出生后的登记手续等待办事务感到焦虑、疲惫和自责，担心咨询隐私，并寻求如何应对当前压力与自我怀疑。"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c37bf4429d1fd72fb9de","chatId":"24b1f689a2344992b44c3e4f6e36451d","sessionId":null,"userId":100162,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"你的担心我听到了。咨询内容我会保密，不会随意告诉别人，这是基本的专业原则。你刚才说“越查越觉得自己笨”，这种自我怀疑出现时，你通常会怎么对自己说话？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你的担心我听到了。咨询内容我会保密，不会随意告诉别人，这是基本的专业原则。你刚才说“越查越觉得自己笨”，这种自我怀疑出现时，你通常会怎么对自己说话？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2145,"promptTokens":908,"completionTokens":178,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:59:55"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010984731220831146,"emotions":[],"relationId":"6af6c37bf4429d1fd72fb9dd","courseProgressId":0,"tsGen":1794556795889,"createTime":"2026-11-13 15:59:55","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c37bf4429d1fd72fb9dd","chatId":"24b1f689a2344992b44c3e4f6e36451d","sessionId":null,"userId":100162,"orgId":37