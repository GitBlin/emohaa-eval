,"sort":4},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6be34f4429d1fd72fb3c6","courseProgressId":0,"tsGen":1794555444130,"createTime":"2026-11-13 15:37:24","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6be30f4429d1fd72fb3bd","chatId":"2c7837fe5a3b45fc812e311d88795d63","sessionId":null,"userId":100136,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"两个都怕，尤其怕自己错了却不知道，这种悬着的感觉最磨人。找不到证据，脑子反而更容易反复猜。你“找证据”的时候，通常会去翻看或回想哪些细节？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"两个都怕，尤其怕自己错了却不知道，这种悬着的感觉最磨人。找不到证据，脑子反而更容易反复猜。你“找证据”的时候，通常会去翻看或回想哪些细节？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1184,"promptTokens":1131,"completionTokens":130,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:37:20"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575455178715878,"emotions":[],"relationId":"6af6be30f4429d1fd72fb3bc","courseProgressId":0,"tsGen":1794555440232,"createTime":"2026-11-13 15:37:20","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6be30f4429d1fd72fb3bc","chatId":"2c7837fe5a3b45fc812e311d88795d63","sessionId":null,"userId":100136,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"两个都怕吧……但更多是怕自己做错了什么，却完全不知道。我总想找点证据，可又找不到，越想越乱。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575455178715878,"emotions":[{"code":"fear","name":"恐惧","value":8,"sort":6},{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"calm","name":"平静","value":0,"sort":4}],"relationId":"6af6be30f4429d1fd72fb3bd","courseProgressId":0,"tsGen":1794555440230,"createTime":"2026-11-13 15:37:20","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6be2df4429d1fd72fb3b7","chatId":"2c7837fe5a3b45fc812e311d88795d63","sessionId":null,"userId":100136,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"那种回得慢、只说“没事”却又很冷的感觉，确实让人心里发闷，也容易胡思乱想。你问过她，她没多说，这让你最担心的是什么——是怕她渐渐疏远你，还是怕自己哪里做错了？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那种回得慢、只说“没事”却又很冷的感觉，确实让人心里发闷，也容易胡思乱想。你问过她，她没多说，这让你最担心的是什么——是怕她渐渐疏远你，还是怕自己哪里做错了？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1568,"promptTokens":1182,"completionTokens":100,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:37:17"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008573825594869225,"emotions":[],"relationId":"6af6be2df4429d1fd72fb3b6","courseProgressId":0,"tsGen":1794555437342,"createTime":"2026-11-13 15:37:17","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6be2df4429d1fd72fb3b6","chatId":"2c7837fe5a3b45fc812e311d88795d63","sessionId":null,"userId":100136,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"就是……发消息她回得很慢，有时候就几个字。见面也说累，不太想说话。我问过她怎么了，她只说没事，可那种感觉……挺冷的。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008573825594869225,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af6be2df4429d1fd72fb3b7","courseProgressId":0,"tsGen":1794555437339,"createTime":"2026-11-13 15:37:17","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6be29f4429d1fd72fb3ab","chatId":"2c7837fe5a3b45fc812e311d88795d63","sessionId":null,"userId":100136,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"从小被这样要求，确实容易把难受往心里压。你愿意说出来，不是矫情。关于女朋友最近不太理你，这种“不太理”具体是怎样的？比如消息回得少，还是见面时也疏远了？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"从小被这样要求，确实容易把难受往心里压。你愿意说出来，不是矫情。关于女朋友最近不太理你，这种“不太理”具体是怎样的？比如消息回得少，还是见面时也疏远了？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1795,"promptTokens":1058,"completionTokens":171,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:37:13"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575569980373473,"emotions":[],"relationId":"6af6be29f4429d1fd72fb3aa","courseProgressId":0,"tsGen":1794555433707,"createTime":"2026-11-13 15:37:13","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6be29f4429d1fd72fb3aa","chatId":"2c7837fe5a3b45fc812e311d88795d63","sessionId":null,"userId":100136,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"可能……是我从小习惯了，觉得难受这种事说出来有点矫情吧。其实主要就是女朋友的事，她最近不太理我，我也不知道该怎么办。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575569980373473,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6be29f4429d1fd72fb3ab","courseProgressId":0,"tsGen":1794555433705,"createTime":"2026-11-13 15:37:13","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6be25f4429d1fd72fb3a2","chatId":"2c7837fe5a3b45fc812e311d88795d63","sessionId":null,"userId":100136,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"不会觉得奇怪，也不会觉得你“不值得来”。一个人愿不愿意来谈，和困扰看起来严不严重，并没有固定标准；你觉得闷、乱、睡不好，这些本身就值得被认真对待。是什么让你担心自己的问题“不够严重”呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不会觉得奇怪，也不会觉得你“不值得来”。一个人愿不愿意来谈，和困扰看起来严不严重，并没有固定标准；你觉得闷、乱、睡不好，这些本身就值得被认真对待。是什么让你担心自己的问题“不够严重”呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1615,"promptTokens":937,"completionTokens":131,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:37:09"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575775393074242,"emotions":[],"relationId":"6af6be25f4429d1fd72fb3a1","courseProgressId":0,"tsGen":1794555429693,"createTime":"2026-11-13 15:37:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6be25f4429d1fd72fb3a1","chatId":"2c7837fe5a3b45fc812e311d88795d63","sessionId":null,"userId":100136,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"嗯，稍微放心点了。不过……我还有个问题，问出来你别觉得奇怪——你会不会觉得我这种问题其实没那么严重，不值得来咨询？<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"reg