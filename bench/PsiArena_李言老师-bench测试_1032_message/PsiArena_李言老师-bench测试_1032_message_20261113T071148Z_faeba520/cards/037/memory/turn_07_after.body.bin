":0,"tsGen":1794555418646,"createTime":"2026-11-13 15:36:58","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6be1af4429d1fd72fb385","chatId":"2c7837fe5a3b45fc812e311d88795d63","sessionId":null,"userId":100136,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"嗯……大概是前几天晚上吧，躺床上翻来覆去睡不着，脑子一直在转。其实也没什么特别的事发生，就是……唉，说起来好像挺没出息的。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575114567268283,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6be1af4429d1fd72fb386","courseProgressId":0,"tsGen":1794555418643,"createTime":"2026-11-13 15:36:58","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6be16f4429d1fd72fb377","chatId":"2c7837fe5a3b45fc812e311d88795d63","sessionId":null,"userId":100136,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"这种“心里乱却说不清”的感觉很常见，不习惯也没关系，我们可以先不急着找原因。要不从最近一次你明显感到心里乱的时候说起，那时大概发生了什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"这种“心里乱却说不清”的感觉很常见，不习惯也没关系，我们可以先不急着找原因。要不从最近一次你明显感到心里乱的时候说起，那时大概发生了什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1310,"promptTokens":482,"completionTokens":82,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:36:54"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004069842122175356,"emotions":[],"relationId":"6af6be16f4429d1fd72fb376","courseProgressId":0,"tsGen":1794555414931,"createTime":"2026-11-13 15:36:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6be16f4429d1fd72fb376","chatId":"2c7837fe5a3b45fc812e311d88795d63","sessionId":null,"userId":100136,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"说实话，有点不太习惯。我也说不太清楚……就是最近心里挺乱的，但真要讲，又不知道从哪儿说起。<第3轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":6,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004069842122175356,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6be16f4429d1fd72fb377","courseProgressId":0,"tsGen":1794555414928,"createTime":"2026-11-13 15:36:54","delFlag":0,"emotionTenden