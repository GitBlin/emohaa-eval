,"sort":6},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6c596f4429d1fd72fbc78","courseProgressId":0,"tsGen":1794557334083,"createTime":"2026-11-13 16:08:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c591f4429d1fd72fbc74","chatId":"a1b438412c9e4ce3ac3fb4eb357c77a8","sessionId":null,"userId":100173,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"当然可以，不想说的地方你随时可以停下，不用勉强。至于我的私人情况，我可能会保留一些，不是拒你，而是想把空间留给你。你担心问多了会让我不舒服，这种怕添麻烦的感觉，是不是也常出现在你和别人相处时？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"当然可以，不想说的地方你随时可以停下，不用勉强。至于我的私人情况，我可能会保留一些，不是拒你，而是想把空间留给你。你担心问多了会让我不舒服，这种怕添麻烦的感觉，是不是也常出现在你和别人相处时？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2333,"promptTokens":924,"completionTokens":222,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 16:08:49"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575479497375511,"emotions":[],"relationId":"6af6c591f4429d1fd72fbc73","courseProgressId":0,"tsGen":1794557329596,"createTime":"2026-11-13 16:08:49","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6c591f4429d1fd72fbc73","chatId":"a1b438412c9e4ce3ac3fb4eb357c77a8","s