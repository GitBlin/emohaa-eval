CoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006689606597475805,"emotions":[],"relationId":"6af3e8e4d6006945d280ab47","courseProgressId":0,"tsGen":1794369764642,"createTime":"2026-11-11 12:02:44","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"c5ad7ff0c1c145778266257c058ce78c"}