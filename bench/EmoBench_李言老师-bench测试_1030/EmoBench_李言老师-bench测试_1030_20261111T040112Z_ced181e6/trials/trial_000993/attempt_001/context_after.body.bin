到了","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004068598248952242,"emotions":[],"relationId":"6af3e892d6006945d2809ac8","courseProgressId":0,"tsGen":1794369682078,"createTime":"2026-11-11 12:01:22","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"86cb67b63ead454bab99d46a77ce7e5f"}