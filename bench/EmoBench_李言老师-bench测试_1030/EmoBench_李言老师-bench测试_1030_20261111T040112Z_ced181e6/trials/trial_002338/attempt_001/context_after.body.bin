l,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218770426195192,"emotions":[],"relationId":"6af3e89ed6006945d2809d4e","courseProgressId":0,"tsGen":1794369694901,"createTime":"2026-11-11 12:01:34","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"bca119e852594f059bfbd66f30418d4b"}