a":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009708474798133124,"emotions":[],"relationId":"6af3e8d7d6006945d280a883","courseProgressId":0,"tsGen":1794369751041,"createTime":"2026-11-11 12:02:31","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"9558cb84029346479ed8901d906d359a"}