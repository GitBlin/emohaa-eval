"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004607828581763227,"emotions":[],"relationId":"6af3e8aed6006945d280a047","courseProgressId":0,"tsGen":1794369710063,"createTime":"2026-11-11 12:01:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"ff186487612d4eda997ff41b87435c70"}