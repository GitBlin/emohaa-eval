l,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004069410250037707,"emotions":[],"relationId":"6af3e8dfd6006945d280aa3d","courseProgressId":0,"tsGen":1794369759625,"createTime":"2026-11-11 12:02:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"0c335ba61c944faf804d8c377870f451"}