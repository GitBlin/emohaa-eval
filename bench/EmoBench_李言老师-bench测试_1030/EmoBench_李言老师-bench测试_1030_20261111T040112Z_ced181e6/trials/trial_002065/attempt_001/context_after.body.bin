Message":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.001926291192844921,"emotions":[],"relationId":"6af3e8d0d6006945d280a71d","courseProgressId":0,"tsGen":1794369744512,"createTime":"2026-11-11 12:02:24","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"36435c3923f5441f9e96ca35fb871656"}