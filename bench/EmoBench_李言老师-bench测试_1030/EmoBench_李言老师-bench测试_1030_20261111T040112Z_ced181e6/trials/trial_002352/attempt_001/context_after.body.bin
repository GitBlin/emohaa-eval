CoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0015006792359633322,"emotions":[],"relationId":"6af3e8b5d6006945d280a1ac","courseProgressId":0,"tsGen":1794369717195,"createTime":"2026-11-11 12:01:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"239e56ae6c524aed8308b71e74b4ef85"}