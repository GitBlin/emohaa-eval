":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002799989723610885,"emotions":[],"relationId":"6af3e89ad6006945d2809c8a","courseProgressId":0,"tsGen":1794369690949,"createTime":"2026-11-11 12:01:30","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"6494d8cbcb224a878b2e1bec0783e851"}