选项\nA) 他被他不喜欢的工作拒绝了\nB) 小格害怕让他的家人失望\nC) 小格担心工作的责任\nD) 小格担心即将到来的面试","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218153008769077,"emotions":[],"relationId":"6af5a0d29aa9dc5a833d90d9","courseProgressId":0,"tsGen":1794482386046,"createTime":"2026-11-12 19:19:46","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"566562d7a418498283c0fd2e7e5637e6"}