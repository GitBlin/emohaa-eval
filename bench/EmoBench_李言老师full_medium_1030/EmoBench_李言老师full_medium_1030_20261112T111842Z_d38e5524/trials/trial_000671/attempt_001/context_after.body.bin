hips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.003592241346878083,"emotions":[],"relationId":"6af5a0d79aa9dc5a833d9187","courseProgressId":0,"tsGen":1794482391479,"createTime":"2026-11-12 19:19:51","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"5016229b803d4d2da558d1524ced4187"}