l,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004068936666590965,"emotions":[],"relationId":"6af5a0aa9aa9dc5a833d8c2a","courseProgressId":0,"tsGen":1794482346944,"createTime":"2026-11-12 19:19:06","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"56028dc5930648f6b7accccaed47f501"}