xt":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608372675826596,"emotions":[],"relationId":"6af5a0959aa9dc5a833d893a","courseProgressId":0,"tsGen":1794482325972,"createTime":"2026-11-12 19:18:45","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"127c0dd78cf442eaa81da4e0b2b1f335"}