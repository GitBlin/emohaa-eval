l,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005217886123441319,"emotions":[],"relationId":"6af5a09d9aa9dc5a833d8a4b","courseProgressId":0,"tsGen":1794482333545,"createTime":"2026-11-12 19:18:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"db262307e2814975b4439996f3a6e056"}