l,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002799990680680923,"emotions":[],"relationId":"6af5a0c49aa9dc5a833d8f39","courseProgressId":0,"tsGen":1794482372184,"createTime":"2026-11-12 19:19:32","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"4248cf4c9a994cd19c6eb751a454eab1"}