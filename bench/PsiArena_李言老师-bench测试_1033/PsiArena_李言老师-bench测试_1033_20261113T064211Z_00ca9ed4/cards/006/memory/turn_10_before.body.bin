ue":2,"sort":9},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6b210f4429d1fd72fa4c3","courseProgressId":0,"tsGen":1794552336310,"createTime":"2026-11-13 14:45:36","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b20cf4429d1fd72fa4bb","chatId":"6803b957f9d4407383777fb15ac46ccc","sessionId":null,"userId":100051,"orgId":3721,"botId":1033,"isGreeting":false,"role":"role","content":"保密是咨询的基本前提，你的个人信息和谈话内容我都会严格保密，不会透露给单位或其他人。只有涉及你或他人的人身安全时，才会按规范处理。你在单位上班，有这样的顾虑很正常。是担心被别人知道你来咨询吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"保密是咨询的基本前提，你的个人信息和谈话内容我都会严格保密，不会透露给单位或其他人。只有涉及你或他人的人身安全时，才会按规范处理。你在单位上班，有这样的顾虑很正常。是担心被别人知道你来咨询吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":3041,"promptTokens":2373,"completionTokens":73,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 14:45:32"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705251900397848,"emotions":[],"relationId":"6af6b20cf4429d1fd72fa4ba","courseProgressId":0,"tsGen":1794552332352,"createTime":"2026-11-13 14:45:32","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b20cf4429d1fd72fa4ba","chatId":"6803b957f9d4407383777fb15ac46ccc","sessionId":null,"userId":100051,"orgId":3721,"botId":1033,"isGreeting":false,"role":"user","content":"挺久的了吧……可能一两年，也可能更久，我自己都记不清了。嗯……我想问一下，你们这个咨询，会保密吗？毕竟我在单位上班，不太想让别人知道。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null