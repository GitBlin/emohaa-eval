{"success":true,"code":"000","message":null,"data":{"totalAmount":18,"totalPageCount":1,"pageNum":0,"itemCount":18,"content":[{"pageNum":0,"pageSize":0,"id":"6af6b519f4429d1fd72fa8f2","chatId":"c03b8e5a85114822bee65b1c727e1cb5","sessionId":null,"userId":100074,"orgId":3721,"botId":1033,"isGreeting":false,"role":"role","content":"碎片溅到脚边，妈妈却一句话没说，那一刻你大概又怕又孤单。后来这件事，你跟她提过吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"碎片溅到脚边，妈妈却一句话没说，那一刻你大概又怕又孤单。后来这件事，你跟她提过吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":814,"promptTokens":2962,"completionTokens":62,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 14:58:33"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.025945019918032653,"emotions":[],"relationId":"6af6b519f4429d1fd72fa8f1","courseProgressId":0,"tsGen":1794553113631,"createTime":"2026-11-13 14:58:33","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b519f4429d1fd72fa8f1","chatId":"c03b8e5a85114822bee65b1c727e1cb5","sessionId":null,"userId":100074,"orgId":3721,"botId":1033,"isGreeting":false,"role":"user","content":"就在客厅。他嫌我不听话，说什么相亲的事，我顶了两句，他抄起碗就砸地上。碎片溅到我脚边……我妈就站旁边，一句话没说。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.025945019918032653,"emotions":[],"relationId":"6af6b519f4429d1fd72fa8f2","courseProgressId":0,