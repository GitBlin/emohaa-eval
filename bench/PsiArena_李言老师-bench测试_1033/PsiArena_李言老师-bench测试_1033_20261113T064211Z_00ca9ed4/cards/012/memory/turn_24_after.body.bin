sage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":30,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.03307986848748165,"emotions":[],"relationId":"6af6b314f4429d1fd72fa638","courseProgressId":0,"tsGen":1794552596930,"createTime":"2026-11-13 14:49:56","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["压抑","焦虑","无助","羞耻","自责","孤独","矛盾"],"originalText":["最近总是睡不好，心里堵得慌。我也不太清楚自己为什么会这么难受，说不上来。","就是……我和我丈夫之间，有时候会吵得很厉害，吵到动手。这种事说出来，真的挺没脸的。","可能我也有不对的地方。","我就是想让他听我说一句，我也累，我也需要人管管我。可他根本听不进去……","我是不是有点毛病啊。","没有……真的没有。同事面前得装着，家里更不能说。这么多年，好像就自己一个人扛着。"]},"conversation":{"type":"人际关系处理","topic":"亲密关系中的夫妻冲突、沟通障碍、情感支持需求与孤独感"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b310f4429d1fd72fa633","chatId":"d1da1b8cb6ee492f97aef841c0f0d9f6","sessionId":null,"userId":100057,"orgId":3721,"botId":1033,"isGreeting":false,"role":"role","content":"盼他说句软话，其实就是盼他也承认在乎——这个盼头一点都不过分。倒是你爸妈那句“别把家丑往外说”，好像让你连找人说说都难。这些年，你有能说上话的人吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"盼他说句软话，其实就是盼他也承认在乎——这个盼头一点都不过分。倒是你爸妈那句“别把家丑往外说”，好像让你连找人说说都难。这些年，你有能说上话的人吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1966,"promptTokens":3203,"completionTokens":160,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 14:49:52"}],"imgs":null,"regenerations":0,"seqNum":29,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008574877705036834,"emotions":[],"relationId":"6af6b310f4429d1fd72fa632","courseProgressId":0,"tsGen":1794552592785,"createTime":"2026-11-13 14:49:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultant