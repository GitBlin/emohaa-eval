{"success":true,"code":"000","message":null,"data":{"totalAmount":12,"totalPageCount":1,"pageNum":0,"itemCount":12,"content":[{"pageNum":0,"pageSize":0,"id":"6af6b2f1f4429d1fd72fa610","chatId":"d1da1b8cb6ee492f97aef841c0f0d9f6","sessionId":null,"userId":100057,"orgId":3721,"botId":1033,"isGreeting":false,"role":"role","content":"不只是聊天。我们会一起把你那些说不上来的感受慢慢理清楚，看看它们是怎么来的、在什么时候冒出来。你刚才提到怕让人烦，这种心思本身也常是我们要聊的部分。你希望咨询能帮你解决的最要紧的是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不只是聊天。我们会一起把你那些说不上来的感受慢慢理清楚，看看它们是怎么来的、在什么时候冒出来。你刚才提到怕让人烦，这种心思本身也常是我们要聊的部分。你希望咨询能帮你解决的最要紧的是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1576,"promptTokens":2530,"completionTokens":124,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 14:49:21"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005910320935600484,"emotions":[],"relationId":"6af6b2f1f4429d1fd72fa60f","courseProgressId":0,"tsGen":1794552561954,"createTime":"2026-11-13 14:49:21","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b2f1f4429d1fd72fa60f","chatId":"d1da1b8cb6ee492f97aef841c0f0d9f6","sessionId":null,"userId":100057,"orgId":3721,"botId":1033,"isGreeting":false,"role":"user","content":"好像……是有点。我不太想让人家觉得我烦。那个，你们咨询一般是怎么帮人的？就是聊聊天吗？<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00