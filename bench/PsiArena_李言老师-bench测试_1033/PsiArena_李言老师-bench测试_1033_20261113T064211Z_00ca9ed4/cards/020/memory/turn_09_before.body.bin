ontent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0,"emotions":[{"code":"trust","name":"信任","value":8,"sort":3},{"code":"expect","name":"期待","value":7,"sort":2},{"code":"happy","name":"快乐","value":6,"sort":1},{"code":"calm","name":"平静","value":5,"sort":4},{"code":"surprised","name":"惊讶","value":4,"sort":5},{"code":"fear","name":"恐惧","value":0,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7},{"code":"sadness","name":"悲伤","value":0,"sort":8},{"code":"dislike","name":"厌恶","value":0,"sort":9}],"relationId":"6af6b44af4429d1fd72fa7db","courseProgressId":0,"tsGen":1794552906195,"createTime":"2026-11-13 14:55:06","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"fac656f8d1994fc2b286fb688a8ee542"}