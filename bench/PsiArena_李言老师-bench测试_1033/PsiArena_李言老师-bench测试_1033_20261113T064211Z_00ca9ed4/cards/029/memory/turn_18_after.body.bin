appy","name":"快乐","value":0,"sort":1},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6b663f4429d1fd72faa96","courseProgressId":0,"tsGen":1794553443299,"createTime":"2026-11-13 15:04:03","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b65ff4429d1fd72faa8f","chatId":"e4fc444f78434e1f82121b020308d89e","sessionId":null,"userId":100080,"orgId":3721,"botId":1033,"isGreeting":false,"role":"role","content":"你这话挺真实的，想要有人管，又怕被管得喘不过气，其实你要的可能不是“被管”，是心里有个底。那如果这个“底”是你自己给自己定的，你觉得会是什么样？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你这话挺真实的，想要有人管，又怕被管得喘不过气，其实你要的可能不是“被管”，是心里有个底。那如果这个“底”是你自己给自己定的，你觉得会是什么样？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1912,"promptTokens":3257,"completionTokens":114,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:03:59"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01589965452721701,"emotions":[],"relationId":"6af6b65ff4429d1fd72faa8e","courseProgressId":0,"tsGen":1794553439017,"createTime":"2026-11-13 15:03:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b65ff4429d1fd72faa8e","chatId":"e4fc444f78434e1f82121b020308d89e","sessionId":null,"userId":100080,"orgId":3721,"botId":1033,"isGreeting":false,"role":"user","content":"早上不用一睁眼就算这个月还剩多少……（声音低下去）不过真这么过，我又怕自己更没谱了。可能我就是缺个管着我的，又烦被管。<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioConte