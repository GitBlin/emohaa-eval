","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6b67df4429d1fd72faacb","courseProgressId":0,"tsGen":1794553469627,"createTime":"2026-11-13 15:04:29","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b679f4429d1fd72faac1","chatId":"953a9623b6dd4e02bd4829ed77fcd93f","sessionId":null,"userId":100081,"orgId":3721,"botId":1033,"isGreeting":false,"role":"role","content":"想被人主动靠近，这真的不算要求多，反而是很基本的需要。只是你好像一冒出这个念头，就先替对方把自己劝退了。这个“是不是要求太多”的判断，通常是在你话还没说出口时就出现了吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"想被人主动靠近，这真的不算要求多，反而是很基本的需要。只是你好像一冒出这个念头，就先替对方把自己劝退了。这个“是不是要求太多”的判断，通常是在你话还没说出口时就出现了吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1166,"promptTokens":3192,"completionTokens":99,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:04:25"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219431748978492,"emotions":[],"relationId":"6af6b679f4429d1fd72faac0","courseProgressId":0,"tsGen":1794553465406,"createTime":"2026-11-13 15:04:25","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b679f4429d1fd72faac0","chatId":"953a9623b6dd4e02bd4829ed77fcd93f","sessionId":null,"userId":100081,"orgId":3721,"botId":1033,"isGreeting":false,"role":"user","content":"我……我其实想说，我也想被人主动靠近一点，而不是总由我来猜、来迁就。可这话说出来，又觉得自己是不是要求太多了。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不