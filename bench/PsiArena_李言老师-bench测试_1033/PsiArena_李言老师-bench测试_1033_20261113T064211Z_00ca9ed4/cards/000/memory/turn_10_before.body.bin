{"success":true,"code":"000","message":null,"data":{"totalAmount":18,"totalPageCount":1,"pageNum":0,"itemCount":18,"content":[{"pageNum":0,"pageSize":0,"id":"6af6b16bf4429d1fd72fa3e5","chatId":"12489d45580f4c6eaf1b316e09594e0f","sessionId":null,"userId":100045,"orgId":3721,"botId":1033,"isGreeting":false,"role":"role","content":"那种发慌，其实不是现在的你做错了什么，更像是小时候那个怕让人失望的你，又站出来了。发慌的时候，你一般会怎么应对，是忍着，还是会做点什么让自己好受些？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那种发慌，其实不是现在的你做错了什么，更像是小时候那个怕让人失望的你，又站出来了。发慌的时候，你一般会怎么应对，是忍着，还是会做点什么让自己好受些？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2102,"promptTokens":2942,"completionTokens":141,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 14:42:51"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00590971060863735,"emotions":[],"relationId":"6af6b16bf4429d1fd72fa3e4","courseProgressId":0,"tsGen":1794552171033,"createTime":"2026-11-13 14:42:51","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b16bf4429d1fd72fa3e4","chatId":"12489d45580f4c6eaf1b316e09594e0f","sessionId":null,"userId":100045,"orgId":3721,"botId":1033,"isGreeting":false,"role":"user","content":"嗯……会。比如在公司，我总先看别人脸色，怕自己哪句话说得不对。有时候明明没做错什么，心里也会发慌，像小时候那种感觉又回来了。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00590971060863735,"emo