{"success":true,"code":"000","message":null,"data":{"totalAmount":16,"totalPageCount":1,"pageNum":0,"itemCount":16,"content":[{"pageNum":0,"pageSize":0,"id":"6af6b5f5f4429d1fd72faa34","chatId":"6311f0d9f2e64f98bb93ffdb9271b1ed","sessionId":null,"userId":100079,"orgId":3721,"botId":1033,"isGreeting":false,"role":"role","content":"你看到的“别人家”，多半只是表面那一层，里面什么样其实谁也不知道。你会这么想，恰恰说明你习惯先怀疑自己。那这种“是不是我太在意了”的念头，通常是在什么时刻冒出来的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你看到的“别人家”，多半只是表面那一层，里面什么样其实谁也不知道。你会这么想，恰恰说明你习惯先怀疑自己。那这种“是不是我太在意了”的念头，通常是在什么时刻冒出来的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1739,"promptTokens":2800,"completionTokens":93,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:02:13"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014061432071650944,"emotions":[],"relationId":"6af6b5f5f4429d1fd72faa33","courseProgressId":0,"tsGen":1794553333704,"createTime":"2026-11-13 15:02:13","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b5f5f4429d1fd72faa33","chatId":"6311f0d9f2e64f98bb93ffdb9271b1ed","sessionId":null,"userId":100079,"orgId":3721,"botId":1033,"isGreeting":false,"role":"user","content":"我……也说不上来。可能就是想有人告诉我，我这样想是不是正常的。总觉得别人家好像没这么多事，是不是我自己太在意了。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014061432071