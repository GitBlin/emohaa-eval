{"success":true,"code":"000","message":null,"data":{"totalAmount":28,"totalPageCount":1,"pageNum":0,"itemCount":28,"content":[{"pageNum":0,"pageSize":0,"id":"6af6b2b6f4429d1fd72fa5ae","chatId":"6c862786ed9a48719ab2a4a77cad99da","sessionId":null,"userId":100053,"orgId":3721,"botId":1033,"isGreeting":false,"role":"role","content":"白天收着，晚上回到家，那些收起来的东西好像一下子全涌上来了。那种空，不是没事，是太满了没处放吧。晚上一个人想哭的时候，你通常会做点什么，还是就让它那样待着？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"白天收着，晚上回到家，那些收起来的东西好像一下子全涌上来了。那种空，不是没事，是太满了没处放吧。晚上一个人想哭的时候，你通常会做点什么，还是就让它那样待着？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1906,"promptTokens":3165,"completionTokens":122,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 14:48:22"}],"imgs":null,"regenerations":0,"seqNum":29,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010986137512706232,"emotions":[],"relationId":"6af6b2b6f4429d1fd72fa5ad","courseProgressId":0,"tsGen":1794552502043,"createTime":"2026-11-13 14:48:22","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b2b6f4429d1fd72fa5ad","chatId":"6c862786ed9a48719ab2a4a77cad99da","sessionId":null,"userId":100053,"orgId":3721,"botId":1033,"isGreeting":false,"role":"user","content":"（沉默了一下）都堆在心里了吧。白天收着，晚上一个人回到家里，就特别空，有时候莫名其妙想哭。<第14轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":28,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010986137512706232,"emotions"