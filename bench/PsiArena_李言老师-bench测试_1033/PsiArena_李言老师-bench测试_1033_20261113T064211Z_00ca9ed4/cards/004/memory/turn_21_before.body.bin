,"sort":5},{"code":"fear","name":"恐惧","value":0,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6b21af4429d1fd72fa4dd","courseProgressId":0,"tsGen":1794552346944,"createTime":"2026-11-13 14:45:46","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b217f4429d1fd72fa4d5","chatId":"3117abbff1c44284ae0a52748710b446","sessionId":null,"userId":100049,"orgId":3721,"botId":1033,"isGreeting":false,"role":"role","content":"旁边的人没伸手，甚至跟着笑，那是他们的选择，不是你“没用”的证据。被围着的时候僵住、不敢动，换谁都会这样。你愿意把这件事说出来，已经比很多人有勇气了。那几个人里，有没有谁是你稍微能预料到什么时候会来的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"旁边的人没伸手，甚至跟着笑，那是他们的选择，不是你“没用”的证据。被围着的时候僵住、不敢动，换谁都会这样。你愿意把这件事说出来，已经比很多人有勇气了。那几个人里，有没有谁是你稍微能预料到什么时候会来的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1920,"promptTokens":3277,"completionTokens":144,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 14:45:43"}],"imgs":null,"regenerations":0,"seqNum":33,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.06753465303105625,"emotions":[],"relationId":"6af6b217f4429d1fd72fa4d4","courseProgressId":0,"tsGen":1794552343475,"createTime":"2026-11-13 14:45:43","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b217f4429d1fd72fa4d4","chatId":"3117abbff1c44284ae0a52748710b446","sessionId":null,"userId":100049,"orgId":3721,"botId":1033,"isGreeting":false,"role":"user","content":"有……有别的同学在旁边，但他们就是看着，有的还笑。我有时候想，是不是我太没用了，才没人帮我。<第16轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":32,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.06753465303105625,"emotions":[{"code":"sadness","name":"悲伤","value":7,"sort":8},{"code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"calm","name":"平静","value":0,"sort":4}],"relationId":"6af6b217f4429d1fd72fa4d5","courseProgressId":0,"tsGen":1794552343472,"createTime":"2026-11-13 14:45:43","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b212f4429d1fd72fa4cc","chatId":"3117abbff1c44284ae0a52748710b446","sessionId":null,"userId":100049,"orgId":3721,"botId":1033,"isGreeting":false,"role":"role","content":"低着头不敢动，不是你懦弱，是那种情况下人本能会僵住。他们说的那些话很难听，但“没人管你”不是事实——至少现在，我就在听你说。当时周围有别的人看到吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"低着头不敢动，不是你懦弱，是那种情况下人本能会僵住。他们说的那些话很难听，但“没人管你”不是事实——至少现在，我就在听你说。当时周围有别的人看到吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1513,"promptTokens":3265,"completionTokens":98,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 14:45:38"}],"imgs":null,"regenerations":0,"seqNum":31,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705252168837714,"emotions":[],"relationId":"6af6b212f4429d1fd72fa4cb","courseProgressId":0,"tsGen":1794552338992,"