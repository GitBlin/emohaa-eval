{"success":true,"code":"000","message":null,"data":{"totalAmount":36,"totalPageCount":1,"pageNum":0,"itemCount":36,"content":[{"pageNum":0,"pageSize":0,"id":"6af6b6d0f4429d1fd72fab3a","chatId":"c600895de03a4c4ab5ce868d4a44f1b6","sessionId":null,"userId":100083,"orgId":3721,"botId":1033,"isGreeting":false,"role":"role","content":"自己扛习惯了，连找人搭把手都要先掂量会不会打扰到别人，这份懂事听着让人有点心酸。你有没有想过，要是真跟朋友说一句“我最近有点难受”，她们会是什么反应？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"自己扛习惯了，连找人搭把手都要先掂量会不会打扰到别人，这份懂事听着让人有点心酸。你有没有想过，要是真跟朋友说一句“我最近有点难受”，她们会是什么反应？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1268,"promptTokens":3224,"completionTokens":85,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:05:52"}],"imgs":null,"regenerations":0,"seqNum":37,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.020327762241503965,"emotions":[],"relationId":"6af6b6d0f4429d1fd72fab39","courseProgressId":0,"tsGen":1794553552572,"createTime":"2026-11-13 15:05:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b6d0f4429d1fd72fab39","chatId":"c600895de03a4c4ab5ce868d4a44f1b6","sessionId":null,"userId":100083,"orgId":3721,"botId":1033,"isGreeting":false,"role":"user","content":"（想了想）好像……真说不上来有谁。大家都挺忙的，我也不好意思老去烦别人。可能我一直就习惯自己扛，扛不住了才去找他。<第18轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":36,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.020327762241503965,"emot