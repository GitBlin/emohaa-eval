{"success":true,"code":"000","message":null,"data":{"totalAmount":46,"totalPageCount":1,"pageNum":0,"itemCount":46,"content":[{"pageNum":0,"pageSize":0,"id":"6af6b3acf4429d1fd72fa6f9","chatId":"686498e8a01340ae84a6980a75551892","sessionId":null,"userId":100058,"orgId":3721,"botId":1033,"isGreeting":false,"role":"role","content":"怕被丢下，所以宁可先把自己按下去——这个代价其实挺大的，等于用委屈自己来换关系不散。可这样的关系，你待着也不踏实。你有没有想过，那种“被丢下”的怕，最早是从哪儿来的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"怕被丢下，所以宁可先把自己按下去——这个代价其实挺大的，等于用委屈自己来换关系不散。可这样的关系，你待着也不踏实。你有没有想过，那种“被丢下”的怕，最早是从哪儿来的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":3547,"promptTokens":3217,"completionTokens":85,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 14:52:28"}],"imgs":null,"regenerations":0,"seqNum":47,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009706769925175437,"emotions":[],"relationId":"6af6b3acf4429d1fd72fa6f8","courseProgressId":0,"tsGen":1794552748867,"createTime":"2026-11-13 14:52:28","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b3acf4429d1fd72fa6f8","chatId":"686498e8a01340ae84a6980a75551892","sessionId":null,"userId":100058,"orgId":3721,"botId":1033,"isGreeting":false,"role":"user","content":"担心……担心一开口就成了那种难搞的人，怕他觉得我事多，然后关系就变味了。其实我挺怕被丢下的。<第23轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":46,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009706769925175437,