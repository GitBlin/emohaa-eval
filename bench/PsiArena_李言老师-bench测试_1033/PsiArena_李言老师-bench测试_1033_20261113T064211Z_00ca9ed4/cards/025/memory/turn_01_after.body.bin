s":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0,"emotions":[],"relationId":"6af6b578f4429d1fd72fa972","courseProgressId":0,"tsGen":1794553208019,"createTime":"2026-11-13 15:00:08","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"d0f815b290354cafa1c2f9bb783b6744"}