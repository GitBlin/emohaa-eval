ll,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"早上一边是孩子哭着不让你走，一边是上班不能迟到，那种拉扯确实很磨人。你提到怕被觉得当妈做得不好，这个担心，是家里有人这样说过你吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1484,"promptTokens":2483,"completionTokens":164,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:00:23"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005908835729177089,"emotions":[],"relationId":"6af6b587f4429d1fd72fa97a","courseProgressId":0,"tsGen":1794553223055,"createTime":"2026-11-13 15:00:23","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b587f4429d1fd72fa97a","chatId":"28a20f98bd0f42189f86d157d3dc4931","sessionId":null,"userId":100076,"orgId":3721,"botId":1033,"isGreeting":false,"role":"user","content":"就是……有些话我不想让家里人知道，尤其是关于孩子的事。说了怕他们觉得我这个当妈的做得不好。至于早上，就是孩子一直哭闹不让我走，我急着上班，心里特别乱。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005908835729177089,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af6b587f4429d1fd72fa97b","courseProgressId":0,"tsGen":1794553223053,"createTime":"2026-11-13 15:00:23","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b583f4429d1fd72fa979","chatId":"28a20f98bd0f42189f86d157d3dc4931","sessionId":null,"userId":100076,"orgId":3721,"botId":1033,"isGreeting":false,"role":"role","content":"你的担心很合理，保密是咨询的基本前提。我们聊的内容我不会告诉你家里人。只有涉及你或他人的人身安全风险时，才会按专业要求处理，那种情况我也会先跟你说。你问这个，是担心家里人会知道什么吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你的担心很合理，保密是咨询的基本前提。我们聊的内容我不会告诉你家里人。只有涉及你或他人的人身安全风险时，才会按专业要求处理，那种情况我也会先跟你说。你问这个，是担心家里人会知道什么吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":928,"promptTokens":2346,"completionTokens":81,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:00:19"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007574336954736974,"emotions":[],"relationId":"6af6b583f4429d1fd72fa978","courseProgressId":0,"tsGen":1794553219529,"createTime":"2026-11-13 15:00:19","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b583f4429d1fd72fa978","chatId":"28a20f98bd0f42189f86d157d3dc4931","sessionId":null,"userId":100076,"orgId":3721,"botId":1033,"isGreeting":false,"role":"user","content":"嗯……我想想。可能就是早上急着出门上班的时候吧。不过，我先问一下，我们聊的这些，你会告诉别人吗？比如我家里人？<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"ag