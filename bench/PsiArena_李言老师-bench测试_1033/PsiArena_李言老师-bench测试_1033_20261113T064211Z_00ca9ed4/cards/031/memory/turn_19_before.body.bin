":"期待","value":0,"sort":2},{"code":"fear","name":"恐惧","value":0,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7},{"code":"sadness","name":"悲伤","value":0,"sort":8},{"code":"dislike","name":"厌恶","value":0,"sort":9}],"relationId":"6af6b67df4429d1fd72faac9","courseProgressId":0,"tsGen":1794553469282,"createTime":"2026-11-13 15:04:29","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b679f4429d1fd72faac5","chatId":"465e99a0dfbd4a6582de73887d5d13ea","sessionId":null,"userId":100082,"orgId":3721,"botId":1033,"isGreeting":false,"role":"role","content":"你说自己没学会跟人说心里话，可刚刚你跟我讲的这些，其实已经是很实在的心里话了。也许不是不会，只是以前没遇到能听的人。那在你印象里，有没有哪一次你试着开口，结果还算不错？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你说自己没学会跟人说心里话，可刚刚你跟我讲的这些，其实已经是很实在的心里话了。也许不是不会，只是以前没遇到能听的人。那在你印象里，有没有哪一次你试着开口，结果还算不错？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1534,"promptTokens":3070,"completionTokens":107,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:04:25"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00857490099380601,"emotions":[],"relationId":"6af6b679f4429d1fd72faac4","courseProgressId":0,"tsGen":1794553465761,"createTime":"2026-11-13 15:04:25","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b679f4429d1fd72faac4","chatId":"465e99a0dfbd4a6582de73887d5d13ea","sessionId":null,"userId":100082,"orgId":3721,"botId":1033,"isGreeting":false,"role":"user","content":"说不上来……有点堵。其实我知道他们不是不爱我，就是……不会表达吧。我也一样，好像从小就没学会怎么跟人说心里话。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，