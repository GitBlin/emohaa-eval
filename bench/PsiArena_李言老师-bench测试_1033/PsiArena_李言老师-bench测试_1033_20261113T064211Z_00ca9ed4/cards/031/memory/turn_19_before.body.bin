ppy","name":"快乐","value":1,"sort":1},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af6b665f4429d1fd72faa9b","courseProgressId":0,"tsGen":1794553445781,"createTime":"2026-11-13 15:04:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b662f4429d1fd72faa94","chatId":"465e99a0dfbd4a6582de73887d5d13ea","sessionId":null,"userId":100082,"orgId":3721,"botId":1033,"isGreeting":false,"role":"role","content":"说不清也没关系，心里乱的时候，往往就是这样一团模糊的感觉。你能觉察到“有点不对劲”，这本身已经是一个起点。我们可以不急着找答案，先看看它。最近这段时间，这种感觉大概是从什么时候开始出现的呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"说不清也没关系，心里乱的时候，往往就是这样一团模糊的感觉。你能觉察到“有点不对劲”，这本身已经是一个起点。我们可以不急着找答案，先看看它。最近这段时间，这种感觉大概是从什么时候开始出现的呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1761,"promptTokens":2236,"completionTokens":109,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:04:02"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219129415575699,"emotions":[],"relationId":"6af6b662f4429d1fd72faa93","courseProgressId":0,"tsGen":1794553442199,"createTime":"2026-11-13 15:04:02","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b662f4429d1fd72faa93","chatId":"465e99a0dfbd4a6582de73887d5d13ea","sessionId":null,"userId":100082,"orgId":3721,"botId":1033,"isGreeting":false,"role":"user","content":"我也说不太清楚……就是最近心里挺乱的，总觉得自己有点不对劲。嗯……但具体是哪儿不对劲，我讲不上来。<第3轮:让你的回答保持简短，限制每次回复中的