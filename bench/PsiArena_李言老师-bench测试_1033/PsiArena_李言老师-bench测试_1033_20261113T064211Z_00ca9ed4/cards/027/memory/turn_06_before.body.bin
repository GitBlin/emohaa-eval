{"success":true,"code":"000","message":null,"data":{"totalAmount":10,"totalPageCount":1,"pageNum":0,"itemCount":10,"content":[{"pageNum":0,"pageSize":0,"id":"6af6b5acf4429d1fd72fa9b2","chatId":"f8c563aba5c547b9919941c6579be341","sessionId":null,"userId":100078,"orgId":3721,"botId":1033,"isGreeting":false,"role":"role","content":"“我怎么又不够好”虽然一闪就过去了，但它好像不是第一次出现。后面那句“讲了也没用”，听着更像是早就试过、然后慢慢不说了。你愿意回想一下，这种感觉是从什么时候开始有的吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“我怎么又不够好”虽然一闪就过去了，但它好像不是第一次出现。后面那句“讲了也没用”，听着更像是早就试过、然后慢慢不说了。你愿意回想一下，这种感觉是从什么时候开始有的吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1563,"promptTokens":2456,"completionTokens":143,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:01:00"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005910333302668789,"emotions":[],"relationId":"6af6b5acf4429d1fd72fa9b1","courseProgressId":0,"tsGen":1794553260313,"createTime":"2026-11-13 15:01:00","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b5acf4429d1fd72fa9b1","chatId":"f8c563aba5c547b9919941c6579be341","sessionId":null,"userId":100078,"orgId":3721,"botId":1033,"isGreeting":false,"role":"user","content":"第一个念头？……大概是“我怎么又不够好”。不过也就一闪而过，后面就懒得想了。可能我本来就不太会跟她说这些，讲了也没用。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0059