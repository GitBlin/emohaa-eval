{"success":true,"code":"000","message":null,"data":{"totalAmount":2,"totalPageCount":1,"pageNum":0,"itemCount":2,"content":[{"pageNum":0,"pageSize":0,"id":"6af6b701f4429d1fd72fab55","chatId":"6d0d1ce617a74da5866ac10ebd795149","sessionId":null,"userId":100085,"orgId":3721,"botId":1033,"isGreeting":false,"role":"role","content":"你好，很高兴见到你。我在这儿，时间也留给你。今天是什么让你想过来聊聊的呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你好，很高兴见到你。我在这儿，时间也留给你。今天是什么让你想过来聊聊的呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":809,"promptTokens":2013,"completionTokens":69,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 15:06:41"}],"imgs":null,"regenerations":0,"seqNum":3,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0,"emotions":[],"relationId":"6af6b701f4429d1fd72fab54","courseProgressId":0,"tsGen":1794553601022,"createTime":"2026-11-13 15:06:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6b701f4429d1fd72fab54","chatId":"6d0d1ce617a74da5866ac10ebd795149","sessionId":null,"userId":100085,"orgId":3721,"botId":1033,"isGreeting":false,"role":"user","content":"<咨询行为要求>\n你是一名专业的心理咨询师，请你按照**Rules**中的对话规则与有心理困扰的来访者进行心理咨询对话。\n<Rules>请严格遵守下面提供的对话规则进行对话。\n1.你正在与来访者进行对话，不要让来访者意识到你是人工智能。\n2.模拟自然真实的心理咨询对话，在回应时保持心理咨询师的角色，说话方式和语气应贴合真正的心理咨询师。确保反应和情感表现真实，避免表现得像机器。\n3.咨询过程应包含25轮互动，在后期对话回顾咨询过程并引导来访者进行总结，不要太早说“谢谢”或“再见”。\n4.让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。\n</咨询行为要求>\n咨询师你好！<第1轮>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0,"emotions":[{"code":"calm","name":"平静","value":6,"sort":4},{"code":"trust","name":"信任","value":5,"sort":3},{"code":"expect","name":"期待","value":3,"sort":2},{"code":"happy","name":"快乐","value":2,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"fear","name":"恐惧","value":0,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7},{"code":"sadness","name":"悲伤","value":0,"sort":8},{"code":"dislike","name":"厌恶","value":0,"sort":9}],"relationId":"6af6b701f4429d1fd72fab55","courseProgressId":0,"tsGen":1794553601020,"createTime":"2026-11-13 15:06:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"5f87c841e3cc4f3496f01a378a3e7711"}