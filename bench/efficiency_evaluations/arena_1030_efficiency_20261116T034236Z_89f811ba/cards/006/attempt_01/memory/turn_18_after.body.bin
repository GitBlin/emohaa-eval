ame":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6afa7c414a7028114331c581","courseProgressId":0,"tsGen":1794800705831,"createTime":"2026-11-16 11:45:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6afa7c3d4a7028114331c578","chatId":"1d5352b7c7184328aef1c219ace803a2","sessionId":null,"userId":100436,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"能理解，不想被贴标签、也不想把家人说成坏人，这两点我都不做。说不清从哪讲也没关系，不用从头理。要不就从最近某天早上“心里沉沉”的那个瞬间说起，当时你脑子里最先冒出来的是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"能理解，不想被贴标签、也不想把家人说成坏人，这两点我都不做。说不清从哪讲也没关系，不用从头理。要不就从最近某天早上“心里沉沉”的那个瞬间说起，当时你脑子里最先冒出来的是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1831,"promptTokens":1988,"completionTokens":95,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-16 11:45:01"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","promptTraceId":"42c7be933538450b9c4842997228b3d7","isSuicide":false,"isSuicideConf":0.005219408667824104,"emotions":[],"relationId":"6afa7c3d4a7028114331c577","courseProgressId":0,"tsGen":1794800701069,"createTime":"2026-11-16 11:45:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6afa7c3d4a7028114331c577","chatId":"1d5352b7c7184328aef1c219ace803a2","sessionId":null,"userId":100436,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"说不好……可能都有点。我不太喜欢被人贴标签，也不想把家里人说成什么坏人。就是有些事，讲出来也不知道从哪讲。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent