恶","value":6,"sort":9},{"code":"anger","name":"愤怒","value":4,"sort":7},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6afa7ced4a7028114331c68b","courseProgressId":0,"tsGen":1794800877468,"createTime":"2026-11-16 11:47:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6afa7ce84a7028114331c684","chatId":"b4fe078cbb614f478db6975be171bb89","sessionId":null,"userId":100438,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那个“太吵了”，可能让你学会了一件事：高兴也得收着。原本是分享喜悦，却被挡回来，久了就变成先否定自己。说到这里，你心里是什么感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那个“太吵了”，可能让你学会了一件事：高兴也得收着。原本是分享喜悦，却被挡回来，久了就变成先否定自己。说到这里，你心里是什么感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1728,"promptTokens":2496,"completionTokens":90,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-16 11:47:52"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","promptTraceId":"06e888917a77482fb8618bb58371c778","isSuicide":false,"isSuicideConf":0.004068776543147311,"emotions":[],"relationId":"6afa7ce84a7028114331c683","courseProgressId":0,"tsGen":1794800872876,"createTime":"2026-11-16 11:47:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6afa7ce84a7028114331c683","chatId":"b4fe078cbb614f478db6975be171bb89","sessionId":null,"userId":100438,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最早啊……可能是小时候吧。我爸妈老说，女孩子别太情绪化，在外面要稳一点。我记得有次我特别高兴地跟他们讲学校的事，他们却说我太吵了。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","promptTraceId":null,"isSuicide":false,"isSuicideConf":0.004068776543147311,"emotions":[{"code":"happy","name":"快乐","value":5,"sort":1},{"code":"calm","name":"平静","value":5,"sort":4},{"code":"trust","name":"信任","value":4,"sort":3},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"expect","name":"期待","value":3,"sort":2},{"code":"surprised","name":"惊讶","value":2,"sort":5},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"fear","name":"恐惧","value":0,"sort":6}],"relationId":"6afa7ce84a7028114331c684","courseProgressId":0,"tsGen":1794800872873,"createTime":"2026-11-16 11:47:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6afa7ce44a7028114331c67f","chatId":"b4fe078cbb614f478db6975be171bb89","sessionId":null,"userId":100438,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"习惯改不过来，往往是因为它曾经保护过你——先踩自己一脚，别人就伤不到更深。所以我们不急着改，先看看它从哪儿来的。你回想得到，最早开始这样对自己说话，大概是什么时候吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"习惯改不过来，往往是因为它曾经保护过你——先踩自己一脚，别人就伤不到更深。所以我们不急着改，先看看它从哪儿来的。你回想得到，最早开始这样对自己说话，大概是什么时候吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1824,"promptTokens":2246,"completionTokens":103,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-16 11:47:48"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","promptTraceId":"3bf7ec5d690d443ea38acfb83feaa3f1","isSuicide":false,"isSuicideConf":0.03308249355045816,"emotions":[],"relationId":"6afa7ce44a7028114331c67e","courseProgressId":0,"tsGen":1794800868896,"createTime":"2026-11-16 11:47:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6afa7ce44a7028114331c67e","chatId":"b4fe078cbb614f478db6975be171bb89","sessionId":null,"userId":100438,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……留意到了。好像我经常这样，话还没说完就先踩自己一脚。习惯了，一时也改不过来。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","promptTraceId":"3bf7ec5d690d443ea38acfb83feaa3f1","isSuicide":false,"isSuicideConf":0.03308249355045816,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"fear","name":"恐惧","value":0,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6afa7ce44a7028114331c67f","courseProgressId":0,"tsGen":1794800868892,"createTime":"2026-11-16 11:47:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6afa7cb94a7028114331c667","chatId":"b4fe078cbb614f478db6975be171bb89","sessionId":null,"userId":100438,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"说自己“没出息”的时候，你其实已经在批评自己了。我们先把这个放一放——关于私下联系，我这边只能在咨询时间里陪你聊，这样对你也更稳妥。倒是刚才那句自我否定，你留意到了吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"说自己“没出息”的时候，你其实已经在批评自己了。我们先把这个放一放——关于私下联系，我这边只能在咨询时间里陪你聊，这样对你也更稳妥。倒是刚才那句自我否定，你留意到了吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2025,"promptTokens":2247,"completionTokens":89,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-16 11:47:05"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","promptTraceId":"c70f43017a8f4f1fb05ffff5b081df23","isSuicide":false,"isSuicideConf":0.022971508688429263,"emotions":[],"relationId":"6afa7cb94a7028114331c666","courseProgressId":0,"tsGen":1794800825904,"createTime":"2026-11-16 11:47:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6afa7cb94a7028114331c666","chatId":"b4fe078cbb614f478db6975be171bb89","sessionId":null,"userId":100438,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"好像是……总是先觉得是不是自己不对。唉，说着说着又觉得挺没出息的。对了，我要是平时情绪上来了，能不能私下给你发消息？<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","promptTraceId":"c70f43017a8f4f1fb05ffff5b081df23","isSuicide":false,"isSuicideConf":0.022971508688429263,"emotions":[{"code":"trust","name":"信任","value":4,"sort":3},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"expect","name":"期待","value":3,"sort":2},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6afa7cb94a7028114331c667","courseProgressId":0,"tsGen":1794800825900,"createTime":"2026-11-16 11:47:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6afa7cb54a7028114331c660","chatId":"b4fe078cbb614f478db6975be171bb89","sessionId":null,"userId":100438,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"敏感不是问题，它只是说明你对关系里的信号接收得很细。真正让人难受的，往往是你一边有感受，一边又怪自己不该有。你平时是不是也常这样，先怀疑自己，再去想别人说得对不对？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"敏感不是问题，它只是说明你对关系里的信号接收得很细。真正让人难受的，往往是你一边有感受，一边又怪自己不该有。你平时是不是也常这样，先怀疑自己，再去想别人说得对不对？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1870,"promptTokens":2120,"completionTokens":99,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-16 11:47:01"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","promptTraceId":"8c831581a71b4d74b5b02d5074ec364a","isSuicide":false,"isSuicideConf":0.007575349123929908,"emotions":[],"relationId":"6afa7cb54a7028114331c65f","courseProgressId":0,"tsGen":1794800821649,"createTime":"2026-11-16 11:47:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6afa7cb54a7028114331c65f","chatId":"b4fe078cbb614f478db6975be171bb89","sessionId":null,"userId":100438,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"说不好……可能评判多一点吧。可我也怕是我自己太敏感了。你说，是不是我这样想本身就有问题？<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","promptTraceId":null,"isSuicide":false,"isSuicideConf":0.007575349123929908,"emotions":[{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6afa7cb54a7028114331c660","courseProgressId":0,"tsGen":1794800821646,"createTime":"2026-11-16 11:47:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6afa7cb14a7028114331c65b","chatId":"b4fe078cbb614f478db6975be171bb89","sessionId":null,"userId":100438,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不服气，说明你心里其实知道自己没做错什么；慌，可能是怕这份真实真的会让你付出代价。被提醒和被判定“你这样不行”，感觉差很远。你听那句话时，觉得里面关心多一点，还是评判多一点？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不服气，说明你心里其实知道自己没做错什么；慌，可能是怕这份真实真的会让你付出代价。被提醒和被判定“你这样不行”，感觉差很远。你听那句话时，觉得里面关心多一点，还是评判多一点？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2384,"promptTokens":2000,"completionTokens":160,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-16 11:46:57"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","promptTraceId":"6acb0c5a8d444d1f83539082cb3baa80","isSuicide":false,"isSuicideConf":0.006691655236516182,"emotions":[],"relationId":"6afa7cb14a7028114331c65a","courseProgressId":0,"tsGen":1794800817228,"createTime":"2026-11-16 11:46:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6afa7cb14a7028114331c65a","chatId":"b4fe078cbb614f478db6975be171bb89","sessionId":null,"userId":100438,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"第一下……有点不服气吧，又有点慌。好像我平时那样也没什么不好，可被这么一说，我就开始怀疑是不是自己太不稳重了。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","promptTraceId":null,"isSuicide":false,"isSuicideConf":0.006691655236516182,"emotions":[{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"anger","name":"愤怒","value":3,"sort":7},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2}],"relationId":"6afa7cb14a7028114331c65b","courseProgressId":0,"tsGen":1794800817224,"createTime":"2026-11-16 11:46:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6afa7cac4a7028114331c656","chatId":"b4fe078cbb614f478db6975be171bb89","sessionId":null,"userId":100438,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那句“会吃亏”，听着像提醒，可落到心里更像在说：你的真实不太安全。堵可能不是因为你信了它，而是你开始怀疑自己是不是该收着点。当时听完，你心里第一下冒出来的是什么感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那句“会吃亏”，听着像提醒，可落到心里更像在说：你的真实不太安全。堵可能不是因为你信了它，而是你开始怀疑自己是不是该收着点。当时听完，你心里第一下冒出来的是什么感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1902,"promptTokens":1881,"completionTokens":118,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-16 11:46:52"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","promptTraceId":"4a3870ae769c44b3adbb775b586ab9e2","isSuicide":false,"isSuicideConf":0.007574383156126502,"emotions":[],"relationId":"6afa7cac4a7028114331c655","courseProgressId":0,"tsGen":1794800812666,"createTime":"2026-11-16 11:46:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6afa7cac4a7028114331c655","chatId":"b4fe078cbb614f478db6975be171bb89","sessionId":null,"userId":100438,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"有句话我记挺久的，说我“什么都写脸上，这样会吃亏”。当时我笑笑就过去了，可后来老想起来。其实……我也不确定他们是不是好意。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","promptTraceId":null,"isSuicide":false,"isSuicideConf":0.007574383156126502,"emotions":[{"code":"calm","name":"平静","value":4,"sort":4},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":