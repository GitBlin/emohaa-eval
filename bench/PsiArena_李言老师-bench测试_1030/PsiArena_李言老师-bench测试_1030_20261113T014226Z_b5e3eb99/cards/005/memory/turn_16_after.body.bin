"value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66b16f4429d1fd72f666f","courseProgressId":0,"tsGen":1794534166115,"createTime":"2026-11-13 09:42:46","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66b0ff4429d1fd72f665c","chatId":"3dd5804bc1db4ee39aaa72105a9082e5","sessionId":null,"userId":99775,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"等消息的那段时间，心好像被吊着，明明难受却放不下手机。那种等待里，你心里最常冒出来的念头是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"等消息的那段时间，心好像被吊着，明明难受却放不下手机。那种等待里，你心里最常冒出来的念头是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1606,"promptTokens":1878,"completionTokens":81,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:42:39"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004607619274002661,"emotions":[],"relationId":"6af66b0ff4429d1fd72f665b","courseProgressId":0,"tsGen":1794534159512,"createTime":"2026-11-13 09:42:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66b0ff4429d1fd72f665b","chatId":"3dd5804bc1db4ee39aaa72105a9082e5","sessionId":null,"userId":99775,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"好像……就是拿着手机的时候吧。等消息的时候特别明显，可我又放不下手机。哎，我也