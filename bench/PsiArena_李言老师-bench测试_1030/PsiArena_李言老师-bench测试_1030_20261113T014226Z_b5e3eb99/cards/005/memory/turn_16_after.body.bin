me":"恐惧","value":4,"sort":6},{"code":"expect","name":"期待","value":3,"sort":2},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66b31f4429d1fd72f66c0","courseProgressId":0,"tsGen":1794534193871,"createTime":"2026-11-13 09:43:13","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66b2ef4429d1fd72f66b6","chatId":"3dd5804bc1db4ee39aaa72105a9082e5","sessionId":null,"userId":99775,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那种“不回就是我不够好”的念头来得太快，几乎不经过思考，所以不是你控制得不好，而是它早就成了习惯。先不用急着纠正它。这个念头冒出来的时候，你身体上有没有哪里跟着紧起来，比如胸口或者喉咙？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那种“不回就是我不够好”的念头来得太快，几乎不经过思考，所以不是你控制得不好，而是它早就成了习惯。先不用急着纠正它。这个念头冒出来的时候，你身体上有没有哪里跟着紧起来，比如胸口或者喉咙？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2814,"promptTokens":3181,"completionTokens":203,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:43:10"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.022970727515582264,"emotions":[],"relationId":"6af66b2ef4429d1fd72f66b5","courseProgressId":0,"tsGen":1794534190598,"createTime":"2026-11-13 09:43:10","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66b2ef4429d1fd72f66b5","chatId":"3dd5804bc1db4ee39aaa72105a9082e5","sessionId":null,"userId":99775,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"会觉得是不是我不够好、不值得人家回。我知道这么想不太对，可就是控制不住……好像别人不回，就说明我这个人有问题似的。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.022970727515582264,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66b2ef4429d1fd72f66b6","courseProgressId":0,"tsGen":1794534190595,"createTime":"2026-11-13 09:43:10","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66b2af4429d1fd72f66ac","chatId":"3dd5804bc1db4ee39aaa72105a9082e5","sessionId":null,"userId":99775,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来，别人的回应慢慢变成了你确认“自己被在意”的方式。这跟你从小被要求主动问候、等人回音的经历连在一起。那如果某一次对方没回，那一刻你会怎么看自己？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来，别人的回应慢慢变成了你确认“自己被在意”的方式。这跟你从小被要求主动问候、等人回音的经历连在一起。那如果某一次对方没回，那一刻你会怎么看自己？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2242,"promptTokens":2474,"completionTokens":116,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:43:06"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008574255361955918,"emotions":[],"relationId":"6af66b2af4429d1fd72f66ab","courseProgressId":0,"tsGen":1794534186066,"createTime":"2026-11-13 09:43:06","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66b2af4429d1fd72f66ab","chatId":"3dd5804bc1db4ee39aaa72105a9082e5","sessionId":null,"userId":99775,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"其实挺累的，有时候明明不想说话，还是硬着头皮发。发完就等着人家回，回了心里才踏实一点。好像……我一直在等别人给我个回应，才觉得自己是被在意的。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008574255361955918,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"expect","name":"期待","value":3,"sort":2},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66b2af4429d1fd72f66ac","courseProgressId":0,"tsGen":1794534186063,"createTime":"2026-11-13 09:43:06","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66b26f4429d1fd72f66a4","chatId":"3dd5804bc1db4ee39aaa72105a9082e5","sessionId":null,"userId":99775,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"原来这份“要多跟人打交道”的期待，从很早就在你家里了。发消息问候亲戚，更像一件必须完成的任务，而不是自己想做的事。那你自己在做这些的时候，心里是什么感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"原来这份“要多跟人打交道”的期待，从很早就在你家里了。发消息问候亲戚，更像一件必须完成的任务，而不是自己想做的事。那你自己在做这些的时候，心里是什么感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2370,"promptTokens":2347,"completionTokens":141,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:43:02"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575549829410198,"emotions":[],"relationId":"6af66b26f4429d1fd72f66a3","courseProgressId":0,"tsGen":1794534182736,"createTime":"2026-11-13 09:43:02","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66b26f4429d1fd72f66a3","chatId":"3dd5804bc1db4ee39aaa72105a9082e5","sessionId":null,"userId":99775,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"应该是……想靠近的那个吧。从小家里人就老说，要多跟人打交道，人脉广才有出路。我妈特别在意这个，逢年过节都要我挨个给亲戚发消息问候。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575549829410198,"emotions":[{"code":"expect","name":"期待","value":5,"sort":2},{"code":"trust","name":"信任","value":4,"sort":3},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"happy","name":"快乐","value":2,"sort":1},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af66b26f4429d1fd72f66a4","courseProgressId":0,"tsGen":1794534182733,"createTime":"2026-11-13 09:43:02","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66b23f4429d1fd72f669a","chatId":"3dd5804bc1db4ee39aaa72105a9082e5","sessionId":null,"userId":99775,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"越说越乱，是因为心里有两个声音在拉扯：一个想靠近、想确认，另一个怕被嫌烦、怕被推开。这种乱不是你说不清楚，而是它们同时在场。这两个声音里，你更熟悉哪一个？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"越说越乱，是因为心里有两个声音在拉扯：一个想靠近、想确认，另一个怕被嫌烦、怕被推开。这种乱不是你说不清楚，而是它们同时在场。这两个声音里，你更熟悉哪一个？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2387,"promptTokens":2217,"completionTokens":192,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:42:59"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575748417118428,"emotions":[],"relationId":"6af66b23f4429d1fd72f6699","courseProgressId":0,"tsGen":1794534179190,"createTime":"2026-11-13 09:42:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66b23f4429d1fd72f6699","chatId":"3dd5804bc1db4ee39aaa72105a9082e5","sessionId":null,"userId":99775,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"好像……都有吧。怪自己没忍住，又怕对方觉得我烦。唉，说着说着感觉更乱了。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"medi