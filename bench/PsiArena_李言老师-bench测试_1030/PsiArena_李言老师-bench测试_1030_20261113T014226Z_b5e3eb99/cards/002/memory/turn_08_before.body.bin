},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af66b17f4429d1fd72f6677","courseProgressId":0,"tsGen":1794534167935,"createTime":"2026-11-13 09:42:47","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66b15f4429d1fd72f666c","chatId":"b6bb243243ee408e8269d799cd394d2e","sessionId":null,"userId":99777,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"上课走神、听不进去，这种状态持续久了确实挺磨人的。你说“不知道是不是自己想太多”，我倒好奇，走神的时候你脑子里一般会飘到哪儿去？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"上课走神、听不进去，这种状态持续久了确实挺磨人的。你说“不知道是不是自己想太多”，我倒好奇，走神的时候你脑子里一般会飘到哪儿去？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1672,"promptTokens":2495,"completionTokens":74,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:42:45"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.003593299133270134,"emotions":[],"relationId":"6af66b15f4429d1fd72f666b","courseProgressId":0,"tsGen":1794534165501,"createTime":"2026-11-13 09:42:45","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66b15f4429d1fd72f666b","chatId":"b6bb243243ee408e8269d799cd394d2e","sessionId":null,"userId":99777,"orgId":3721,"botId":1030,"isGreeting":false,"r