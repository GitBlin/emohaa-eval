,"value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af66a8cf4429d1fd72f65ce","courseProgressId":0,"tsGen":1794534028077,"createTime":"2026-11-13 09:40:28","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66a88f4429d1fd72f65c8","chatId":"85bdd4c7c6194d7684fedb1515403f58","sessionId":null,"userId":99773,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"嗯，听得出来，你对“说出去”这件事很慎重，像是吃过这种亏，或者怕吃了亏。我们不急着往深处走，你可以只说你愿意说的。那种“收不回来”的感觉，是从什么时候开始有的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"嗯，听得出来，你对“说出去”这件事很慎重，像是吃过这种亏，或者怕吃了亏。我们不急着往深处走，你可以只说你愿意说的。那种“收不回来”的感觉，是从什么时候开始有的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1706,"promptTokens":2209,"completionTokens":99,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:40:24"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00406966831974768,"emotions":[],"relationId":"6af66a88f4429d1fd72f65c7","courseProgressId":0,"tsGen":1794534024456,"createTime":"2026-11-13 09:40:24","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66a88f4429d1fd72f65c7","chatId":"85bdd4c7c6194d7684fedb1515403f58","sessionId":null,"userId":99773,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"也不是担心什么具体的事……就是习惯先问清楚。（移开视线）毕竟有些话，说出去就收不回来了。<第7轮:让你的回答保持简短，限制每次回复中的信息量，