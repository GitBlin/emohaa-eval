45728025,"emotions":[{"code":"fear","name":"恐惧","value":8,"sort":6},{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67f24f4429d1fd72f80de","courseProgressId":0,"tsGen":1794539300985,"createTime":"2026-11-13 11:08:20","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f20f4429d1fd72f80d9","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“想太多”这三个字，听久了就变成你看自己的眼睛了——本来是妈妈的说法，后来成了你评判自己的标准。可那些感受是真的，不是事多。如果不用“想太多”来说它，你会怎么形容自己当时的感受？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“想太多”这三个字，听久了就变成你看自己的眼睛了——本来是妈妈的说法，后来成了你评判自己的标准。可那些感受是真的，不是事多。如果不用“想太多”来说它，你会怎么形容自己当时的感受？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2496,"promptTokens":2546,"completionTokens":148,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:08:16"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705794606449948,"emotions":[],"relationId":"6af67f20f4429d1fd72f80d8","courseProgressId":0,"tsGen":1794539296864,"createTime":"2026-11-13 11:08:16","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f20f4429d1fd72f80d8","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（愣了一下）好像是……我妈吧。她总说我“想太多”。后来我自己也这么觉得了，觉得别人都没事，就我事多。<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":26,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705794606449948,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"surprised","name":"惊讶","value":2,"sort":5},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2}],"relationId":"6af67f20f4429d1fd72f80d9","courseProgressId":0,"tsGen":1794539296861,"createTime":"2026-11-13 11:08:16","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f1cf4429d1fd72f80d1","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"委屈和怕都是真的，不是“太敏感”。一个眼神能记这么多年，说明它当时对你很重要，不是你脆弱。你只是习惯了先怪自己，这样比较安全。你觉得自己“敏感”这个说法，是从谁那儿听来的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"委屈和怕都是真的，不是“太敏感”。一个眼神能记这么多年，说明它当时对你很重要，不是你脆弱。你只是习惯了先怪自己，这样比较安全。你觉得自己“敏感”这个说法，是从谁那儿听来的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1787,"promptTokens":2678,"completionTokens":93,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:08:12"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010982812562641501,"emotions":[],"relationId":"6af67f1cf4429d1fd72f80d0","courseProgressId":0,"tsGen":1794539292227,"createTime":"2026-11-13 11:08:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f1cf4429d1fd72f80d0","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（低下头）说不清……有点委屈，又有点怕。其实我知道他们不是故意的，可我就是过不去。有时候会想，是不是我太敏感了。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010982812562641501,"emotions":[{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67f1cf4429d1fd72f80d1","courseProgressId":0,"tsGen":1794539292223,"createTime":"2026-11-13 11:08:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f18f4429d1fd72f80c9","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"一个眼神记了这么多年，比责骂还沉——那大概是你第一次发现，“让人失望”比挨骂更难受。从那时起，你学会了先看别人的脸色，再决定自己怎么做。这份“懂事”保护过你，也让你慢慢听不见自己想要什么。现在想起那个眼神，你心里更多的是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"一个眼神记了这么多年，比责骂还沉——那大概是你第一次发现，“让人失望”比挨骂更难受。从那时起，你学会了先看别人的脸色，再决定自己怎么做。这份“懂事”保护过你，也让你慢慢听不见自己想要什么。现在想起那个眼神，你心里更多的是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2364,"promptTokens":2704,"completionTokens":161,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:08:08"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691232569476711,"emotions":[],"relationId":"6af67f18f4429d1fd72f80c8","courseProgressId":0,"tsGen":1794539288531,"createTime":"2026-11-13 11:08:08","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f18f4429d1fd72f80c8","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（想了一会儿）好像是小学的时候吧。有一次考试没考好，我记得我爸没骂我，就是很失望地看了我一眼。那眼神我到现在都记得，比骂我还难受。从那以后我就特别怕让人失望。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691232569476711,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67f18f4429d1fd72f80c9","courseProgressId":0,"tsGen":1794539288528,"createTime":"2026-11-13 11:08:08","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f14f4429d1fd72f80bf","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“懂事”听起来是夸人的话，可它背后常常是——先照顾别人的感受，自己的那一份就慢慢说不清了。你在家里习惯了这样，到了工作里不知道自己想要什么，好像也接得上。你还记得自己第一次这样“懂事”，大概是什么时候吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“懂事”听起来是夸人的话，可它背后常常是——先照顾别人的感受，自己的那一份就慢慢说不清了。你在家里习惯了这样，到了工作里不知道自己想要什么，好像也接得上。你还记得自己第一次这样“懂事”，大概是什么时候吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2875,"promptTokens":3240,"completionTokens":175,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:08:04"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006690324641722839,"emotions":[],"relationId":"6af67f14f4429d1fd72f80be","courseProgressId":0,"tsGen":1794539284132,"createTime":"2026-11-13 11:08:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f14f4429d1fd72f80be","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"在家里啊……（停顿）我大概是那个“懂事”的人吧。什么事都先想爸妈会怎么看，很少说自己真正想要什么。好像从小就是这样，习惯了。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006690324641722839,"emotions":[{"code":"calm","name":"平静","value":6,"sort":4},{"code":"trust","name":"信任","value":5,"sort":3},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"happy","name":"快乐","value":2,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67f14f4429d1fd72f80bf","courseProgressId":0,"tsGen":1794539284129,"createTime":"2026-11-13 11:08:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f0ff4429d1fd72f80b6","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“有点像”——这个感觉挺重要的。在工作里插不上话的那种位置，好像在你家里也出现过。那时候在家里，你通常是那个什么样的人？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“有点像”——这个感觉挺重要的。在工作里插不上话的那种位置，好像在你家里也出现过。那时候在家里，你通常是那个什么样的人？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1812,"promptTokens":3001,"completionTokens":76,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:07:59"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218116177983672,"emotions":[],"relationId":"6af67f0ff4429d1fd72f80b5","courseProgressId":0,"tsGen":1794539279178,"createTime":"2026-11-13 11:07:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f0ff4429d1fd72f80b5","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最压着的……应该是工作吧。同事们聊项目聊得特别起劲，我就在旁边坐着，插不上话，也不知道自己到底想要什么。（叹气）其实这种感觉，跟我以前在家里有点像。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218116177983672,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67f0ff4429d1fd72f80b6","courseProgressId":0,"tsGen":1794539279176,"createTime":"2026-11-13 11:07:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f08f4429d1fd72f80ad","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"东西太多、一开口就乱，这本身就很消耗人，你不必急着一次全理清楚。我们可以先从最压着你的那一件说起，其他的先放一放。此刻如果只挑一件出来，你最先想到的是哪一件？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"东西太多、一开口就乱，这本身就很消耗人，你不必急着一次全理清楚。我们可以先从最压着你的那一件说起，其他的先放一放。此刻如果只挑一件出来，你最先想到的是哪一件？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2624,"promptTokens":2843,"completionTokens":136,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:07:52"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219735117498005,"emotions":[],"relationId":"6af67f08f4429d1fd72f80ac","courseProgressId":0,"tsGen":1794539272957,"createTime":"2026-11-13 11:07:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f08f4429d1fd72f80ac","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"大概是……不知道该从哪儿说起吧。脑子里东西很多，可一开口就全乱了，好像哪件都不重要，又好像哪件都压得我喘不过气。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219735117498005,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67f08f4429d1fd72f80ad","courseProgressId":0,"tsGen":1794539272954,"createTime":"2026-11-13 11:07:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f04f4429d1fd72f80a3","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"接下来其实就是顺着你想说的聊下去，比如那些让你累的念头是怎么来的，它们又在生活里怎样影响你。不用急着理清，慢慢来就好。刚才你说“一想到这些就觉得挺乱的”，那种乱，更像是事情太多，还是不知道该从哪儿说起？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"接下来其实就是顺着你想说的聊下去，比如那些让你累的念头是怎么来的，它们又在生活里怎样影响你。不用急着理清，慢慢来就好。刚才你说“一想到这些就觉得挺乱的”，那种乱，更像是事情太多，还是不知道该从哪儿说起？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2144,"promptTokens":2734,"completionTokens":97,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:07:48"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691960394857264,"emotions":[],"relationId":"6af67f04f4429d1fd72f80a2","courseProgressId":0,"tsGen":1794539268033,"createTime":"2026-11-13 11:07:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f04f4429d1fd72f80a2","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……是有点为难，不过我也说不清楚。反正就是，一想到这些就觉得挺乱的。（顿了顿）那个，接下来我们一般会聊些什么？<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691960394857264,"emotions":[{"code":"expect","name":"期待","value":3,"sort":2},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67f04f4429d1fd72f80a3","courseProgressId":0,"tsGen":1794539268030,"createTime":"2026-11-13 11:07:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f00f4429d1fd72f8099","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"这个你可以放心，我们聊的内容我会保密，不会随便告诉别人，包括你的家人。只有在涉及人身安全这类很特殊的情况下，我才会考虑别的办法，而且也会先跟你商量。你刚才提到爸妈，说不太想怪他们——这种又理解又委屈的感觉，是不是一直挺让你为难的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"这个你可以放心，我们聊的内容我会保密，不会随便告诉别人，包括你的家人。只有在涉及人身安全这类很特殊的情况下，我才会考虑别的办法，而且也会先跟你商量。你刚才提到爸妈，说不太想怪他们——这种又理解又委屈的感觉，是不是一直挺让你为难的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2368,"promptTokens":2141,"completionTokens":141,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:07:44"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575068613450092,"emotions":[],"relationId":"6af67f00f4429d1fd72f8098","courseProgressId":0,"tsGen":1794539264116,"createTime":"2026-11-13 11:07:44","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f00f4429d1fd72f8098","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"这个……（停顿）可能是我爸妈吧。不过他们也是为我好，我不太想怪他们。嗯，我能问一下，你会不会把这些都记下来，告诉别人？<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575068613450092,"emotions":[{"code":"calm","name":"平静","value":5,"sort":4},{"code":"trust","name":"信任","value":4,"sort":3},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"happy","name":"快乐","value":2,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67f00f4429d1fd72f8099","courseProgressId":0,"tsGen":1794539264113,"createTime":"2026-11-13 11:07:44","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67efbf4429d1fd72f8090","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你说“什么都不做就不会让人失望”，这句话里好像藏着一个前提：你的价值，取决于有没有让别人失望。这样活着，确实会累。那种怕让人失望的感觉，最早是从谁那里来的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你说“什么都不做就不会让人失望”，这句话里好像藏着一个前提：你的价值，取决于有没有让别人失望。这样活着，确实会累。那种怕让人失望的感觉，最早是从谁那里来的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2026,"promptTokens":2023,"completionTokens":127,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:07:39"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.11920291107043361,"emotions":[],"relationId":"6af67efbf4429d1fd72f808f","courseProgressId":0,"tsGen":1794539259315,"createTime":"2026-11-13 11:07:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67efbf4429d1fd72f808f","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是……总觉得自己不行吧，做什么都做不好。有时候会想，要是我干脆什么都不做，是不是就不会让人失望了。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.11920291107043361,"emotions":[{"code":"sadness","name":"悲伤","value":7,"sort":8},{"code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67efbf4429d1fd72f8090","courseProgressId":0,"tsGen":1794539259312,"createTime":"2026-1