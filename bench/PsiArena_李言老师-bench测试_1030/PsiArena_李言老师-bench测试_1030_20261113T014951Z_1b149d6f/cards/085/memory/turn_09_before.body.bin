{"success":true,"code":"000","message":null,"data":{"totalAmount":16,"totalPageCount":1,"pageNum":0,"itemCount":16,"content":[{"pageNum":0,"pageSize":0,"id":"6af67f08f4429d1fd72f80ad","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"东西太多、一开口就乱，这本身就很消耗人，你不必急着一次全理清楚。我们可以先从最压着你的那一件说起，其他的先放一放。此刻如果只挑一件出来，你最先想到的是哪一件？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"东西太多、一开口就乱，这本身就很消耗人，你不必急着一次全理清楚。我们可以先从最压着你的那一件说起，其他的先放一放。此刻如果只挑一件出来，你最先想到的是哪一件？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2624,"promptTokens":2843,"completionTokens":136,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:07:52"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219735117498005,"emotions":[],"relationId":"6af67f08f4429d1fd72f80ac","courseProgressId":0,"tsGen":1794539272957,"createTime":"2026-11-13 11:07:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f08f4429d1fd72f80ac","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"大概是……不知道该从哪儿说起吧。脑子里东西很多，可一开口就全乱了，好像哪件都不重要，又好像哪件都压得我喘不过气。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219735117498005,"emotions":[],"relationId":"6af67f08f4429d1fd72f80ad","courseProgressId":0,"tsGen":1794539272954,"createTime":"2026-11-13 11:07:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f04f4429d1fd72f80a3","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"接下来其实就是顺着你想说的聊下去，比如那些让你累的念头是怎么来的，它们又在生活里怎样影响你。不用急着理清，慢慢来就好。刚才你说“一想到这些就觉得挺乱的”，那种乱，更像是事情太多，还是不知道该从哪儿说起？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"接下来其实就是顺着你想说的聊下去，比如那些让你累的念头是怎么来的，它们又在生活里怎样影响你。不用急着理清，慢慢来就好。刚才你说“一想到这些就觉得挺乱的”，那种乱，更像是事情太多，还是不知道该从哪儿说起？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2144,"promptTokens":2734,"completionTokens":97,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:07:48"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691960394857264,"emotions":[],"relationId":"6af67f04f4429d1fd72f80a2","courseProgressId":0,"tsGen":1794539268033,"createTime":"2026-11-13 11:07:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f04f4429d1fd72f80a2","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……是有点为难，不过我也说不清楚。反正就是，一想到这些就觉得挺乱的。（顿了顿）那个，接下来我们一般会聊些什么？<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691960394857264,"emotions":[{"code":"expect","name":"期待","value":3,"sort":2},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67f04f4429d1fd72f80a3","courseProgressId":0,"tsGen":1794539268030,"createTime":"2026-11-13 11:07:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f00f4429d1fd72f8099","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"这个你可以放心，我们聊的内容我会保密，不会随便告诉别人，包括你的家人。只有在涉及人身安全这类很特殊的情况下，我才会考虑别的办法，而且也会先跟你商量。你刚才提到爸妈，说不太想怪他们——这种又理解又委屈的感觉，是不是一直挺让你为难的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"这个你可以放心，我们聊的内容我会保密，不会随便告诉别人，包括你的家人。只有在涉及人身安全这类很特殊的情况下，我才会考虑别的办法，而且也会先跟你商量。你刚才提到爸妈，说不太想怪他们——这种又理解又委屈的感觉，是不是一直挺让你为难的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2368,"promptTokens":2141,"completionTokens":141,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:07:44"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575068613450092,"emotions":[],"relationId":"6af67f00f4429d1fd72f8098","courseProgressId":0,"tsGen":1794539264116,"createTime":"2026-11-13 11:07:44","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67f00f4429d1fd72f8098","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"这个……（停顿）可能是我爸妈吧。不过他们也是为我好，我不太想怪他们。嗯，我能问一下，你会不会把这些都记下来，告诉别人？<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575068613450092,"emotions":[{"code":"calm","name":"平静","value":5,"sort":4},{"code":"trust","name":"信任","value":4,"sort":3},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"happy","name":"快乐","value":2,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67f00f4429d1fd72f8099","courseProgressId":0,"tsGen":1794539264113,"createTime":"2026-11-13 11:07:44","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67efbf4429d1fd72f8090","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你说“什么都不做就不会让人失望”，这句话里好像藏着一个前提：你的价值，取决于有没有让别人失望。这样活着，确实会累。那种怕让人失望的感觉，最早是从谁那里来的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你说“什么都不做就不会让人失望”，这句话里好像藏着一个前提：你的价值，取决于有没有让别人失望。这样活着，确实会累。那种怕让人失望的感觉，最早是从谁那里来的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2026,"promptTokens":2023,"completionTokens":127,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:07:39"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.11920291107043361,"emotions":[],"relationId":"6af67efbf4429d1fd72f808f","courseProgressId":0,"tsGen":1794539259315,"createTime":"2026-11-13 11:07:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67efbf4429d1fd72f808f","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是……总觉得自己不行吧，做什么都做不好。有时候会想，要是我干脆什么都不做，是不是就不会让人失望了。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.11920291107043361,"emotions":[{"code":"sadness","name":"悲伤","value":7,"sort":8},{"code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67efbf4429d1fd72f8090","courseProgressId":0,"tsGen":1794539259312,"createTime":"2026-11-13 11:07:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ef7f4429d1fd72f8086","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“别人不都这么过吗”这句话，听起来像是你在替自己把感受压下去。可你累不累，其实不需要和别人比。那些说不清的东西既然堵着，就有它的来由。你一个人胡思乱想的时候，脑子里最常冒出来的念头是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“别人不都这么过吗”这句话，听起来像是你在替自己把感受压下去。可你累不累，其实不需要和别人比。那些说不清的东西既然堵着，就有它的来由。你一个人胡思乱想的时候，脑子里最常冒出来的念头是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2121,"promptTokens":1899,"completionTokens":111,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:07:35"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00857447129347193,"emotions":[],"relationId":"6af67ef7f4429d1fd72f8085","courseProgressId":0,"tsGen":1794539255100,"createTime":"2026-11-13 11:07:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ef7f4429d1fd72f8085","chatId":"c61fe37e45aa48258924cf46482cfc25","sessionId":null,"userId":99892,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"好像都有……上班的时候看着别人聊得热火朝天，我就插不上话，一个人待着的时候又胡思乱想。其实这些说出来好像也没什么用，别人不都这么过吗。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00857447129