me":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af672ebf4429d1fd72f72c9","courseProgressId":0,"tsGen":1794536171751,"createTime":"2026-11-13 10:16:11","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af672e7f4429d1fd72f72c7","chatId":"8578c4a58c544c63873bdc9f1b3af202","sessionId":null,"userId":99813,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不奇怪，你带着最放不下的那件事来，恰恰说明它对你很重要。只是“想到他反而更堵”，这中间像是有些没说出口的东西。是最近和他之间发生了什么，还是你在他面前也不太敢说自己难受？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不奇怪，你带着最放不下的那件事来，恰恰说明它对你很重要。只是“想到他反而更堵”，这中间像是有些没说出口的东西。是最近和他之间发生了什么，还是你在他面前也不太敢说自己难受？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2185,"promptTokens":2541,"completionTokens":102,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:16:07"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014058609106512108,"emotions":[],"relationId":"6af672e7f4429d1fd72f72c6","courseProgressId":0,"tsGen":1794536167320,"createTime":"2026-11-13 10:16:07","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af672e7f4429d1fd72f72c6","chatId":"8578c4a58c544c63873bdc9f1b3af202","sessionId":null,"userId":99813,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"说实话，我第一反应是我男朋友……但想到他又觉得更堵。唉，我是不是有点奇怪，明明来做咨询，还想着他。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMe