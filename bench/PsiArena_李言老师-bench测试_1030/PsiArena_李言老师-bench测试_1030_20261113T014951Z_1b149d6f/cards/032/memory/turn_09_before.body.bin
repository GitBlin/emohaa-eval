13,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"说不清原因也没关系，心里堵着的那种感觉，本身就可以拿出来说。在这里，敏感或黏人都不会被当成缺点。此刻这种堵，更像是压着什么东西，还是空落落的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"说不清原因也没关系，心里堵着的那种感觉，本身就可以拿出来说。在这里，敏感或黏人都不会被当成缺点。此刻这种堵，更像是压着什么东西，还是空落落的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1719,"promptTokens":1876,"completionTokens":105,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:15:57"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575427524637115,"emotions":[],"relationId":"6af672ddf4429d1fd72f72c1","courseProgressId":0,"tsGen":1794536157142,"createTime":"2026-11-13 10:15:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af672ddf4429d1fd72f72c1","chatId":"8578c4a58c544c63873bdc9f1b3af202","sessionId":null,"userId":99813,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"被评价……可能是怕别人觉得我太敏感、太黏人吧。其实我也说不清自己为什么最近这么难受，就是心里堵得慌。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575427524637115,"emotions":[{"code":"sadness","name":"悲伤","value":7,"sort":8},{"code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af672ddf4429d1fd72f72c2","courseProgressId":0,"tsGen":1794536157139,"createTime":"2026-11-13 10:15:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af672d9f4429d1fd72f72bf","chatId":"8578c4a58c544c63873bdc9f1b3af202","sessionId":null,"userId":99813,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"会担心被评价，这很自然。咨询内容通常是保密的，也不会随便联系你身边的人；只有在涉及你或他人的安全等法定情况时，才会按必要程序处理。你更担心被谁评价，或者被怎样看待呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"会担心被评价，这很自然。咨询内容通常是保密的，也不会随便联系你身边的人；只有在涉及你或他人的安全等法定情况时，才会按必要程序处理。你更担心被谁评价，或者被怎样看待呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2905,"promptTokens":1753,"completionTokens":241,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:15:53"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00857609728272887,"emotions":[],"relationId":"6af672d9f4429d1fd72f72be","courseProgressId":0,"tsGen":1794536153182,"createTime":"2026-11-13 10:15:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af672d9f4429d1fd72f72be","chatId":"8578c4a58c544c63873bdc9f1b3af202","sessionId":null,"userId":99813,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"我也不是不想说……就是有点怕被评价吧。还有，我说的话你会保密吗？会不会跟我身边的人联系？<第3轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"vid