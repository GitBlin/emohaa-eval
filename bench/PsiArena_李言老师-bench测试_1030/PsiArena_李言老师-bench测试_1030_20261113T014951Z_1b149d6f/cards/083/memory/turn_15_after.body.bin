{"success":true,"code":"000","message":null,"data":{"totalAmount":30,"totalPageCount":1,"pageNum":0,"itemCount":30,"content":[{"pageNum":0,"pageSize":0,"id":"6af67ef8f4429d1fd72f808b","chatId":"30a6d78c4709424daf6336379fad325d","sessionId":null,"userId":99890,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那种发怵，好像不只是怕检查本身，更像是怕报告一出来，自己就真成了“有问题”的人。这和小时候躺着那天，等着我爸回来时的感觉，是不是有点像？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那种发怵，好像不只是怕检查本身，更像是怕报告一出来，自己就真成了“有问题”的人。这和小时候躺着那天，等着我爸回来时的感觉，是不是有点像？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2887,"promptTokens":2619,"completionTokens":165,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:07:36"}],"imgs":null,"regenerations":0,"seqNum":31,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00970506976037423,"emotions":[],"relationId":"6af67ef8f4429d1fd72f808a","courseProgressId":0,"tsGen":1794539256686,"createTime":"2026-11-13 11:07:36","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ef8f4429d1fd72f808a","chatId":"30a6d78c4709424daf6336379fad325d","sessionId":null,"userId":99890,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"是，差不多。一不舒服，心里就先数落自己。所以去医院这事……我一想就发怵，好像去了就等于承认自己真有问题，还得面对一堆报告。<第15轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":30,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00970506976037423,"emotions":[],"relationId":"6af67ef8f4429d1fd72f808b","courseProgressId":0,"tsGen":1794539256683,"createTime":"2026-11-13 11:07:36","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ef3f4429d1fd72f8082","chatId":"30a6d78c4709424daf6336379fad325d","sessionId":null,"userId":99890,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那次你其实只是生病了，需要躺下，可留下来的不是身体的记忆，是爸爸脸上那种失望。好像从那以后，你就学会先看别人的脸色，再决定自己能不能难受。那现在你身体不舒服的时候，心里第一个冒出来的还是那种“我不该”吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那次你其实只是生病了，需要躺下，可留下来的不是身体的记忆，是爸爸脸上那种失望。好像从那以后，你就学会先看别人的脸色，再决定自己能不能难受。那现在你身体不舒服的时候，心里第一个冒出来的还是那种“我不该”吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2786,"promptTokens":2608,"completionTokens":162,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:07:31"}],"imgs":null,"regenerations":0,"seqNum":29,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00669032571204143,"emotions":[],"relationId":"6af67ef3f4429d1fd72f8081","courseProgressId":0,"tsGen":1794539251331,"createTime":"2026-11-13 11:07:31","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ef3f4429d1fd72f8081","chatId":"30a6d78c4709424daf6336379fad325d","sessionId":null,"userId":99890,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"有一次吧……小时候发烧，我没去上学，在家躺着。结果我爸回来脸色很难看，没骂我，但那种失望……我记到现在。<第14轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":28,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00669032571204143,"emotions":[],"relationId":"6af67ef3f4429d1fd72f8082","courseProgressId":0,"tsGen":1794539251328,"createTime":"2026-11-13 11:07:31","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67eedf4429d1fd72f8076","chatId":"30a6d78c4709424daf6336379fad325d","sessionId":null,"userId":99890,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“任性”“不懂事”这两个词，听着不像你自己想出来的，更像被安上去的标签。那我想问，你记忆里有没有哪一次，真的按自己的想法做了，后来发生了什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“任性”“不懂事”这两个词，听着不像你自己想出来的，更像被安上去的标签。那我想问，你记忆里有没有哪一次，真的按自己的想法做了，后来发生了什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2000,"promptTokens":2627,"completionTokens":99,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:07:25"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219406941418096,"emotions":[],"relationId":"6af67eedf4429d1fd72f8075","courseProgressId":0,"tsGen":1794539245745,"createTime":"2026-11-13 11:07:25","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67eedf4429d1fd72f8075","chatId":"30a6d78c4709424daf6336379fad325d","sessionId":null,"userId":99890,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"第一个念头……大概是“不行，那太不像话了”。好像按自己的想法来，就是任性、不懂事。（声音低下去）<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":26,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219406941418096,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67eedf4429d1fd72f8076","courseProgressId":0,"tsGen":1794539245742,"createTime":"2026-11-13 11:07:25","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ee9f4429d1fd72f806d","chatId":"30a6d78c4709424daf6336379fad325d","sessionId":null,"userId":99890,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“照他们的方式活”——你能说出这句，说明你已经开始往回看了。只是这么活着，你自己的那部分一直在后面等着。如果有一天不照着他们的方式，你心里冒出来的第一个念头会是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“照他们的方式活”——你能说出这句，说明你已经开始往回看了。只是这么活着，你自己的那部分一直在后面等着。如果有一天不照着他们的方式，你心里冒出来的第一个念头会是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2147,"promptTokens":2616,"completionTokens":126,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:07:21"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01797200394121073,"emotions":[],"relationId":"6af67ee9f4429d1fd72f806c","courseProgressId":0,"tsGen":1794539241406,"createTime":"2026-11-13 11:07:21","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ee9f4429d1fd72f806c","chatId":"30a6d78c4709424daf6336379fad325d","sessionId":null,"userId":99890,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"我爸吧。他不太说这些，但那种意思一直在。发烧了也让我去上学，说人不能娇气。（顿了顿）现在想想，我好像一直在照他们的方式活。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01797200394121073,"emotions":[{"code":"trust","name":"信任","value":5,"sort":3},{"code":"calm","name":"平静","value":4,"sort":4},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"anger","name":"愤怒","value":3,"sort":7},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67ee9f4429d1fd72f806d","courseProgressId":0,"tsGen":1794539241403,"createTime":"2026-11-13 11:07:21","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ee3f4429d1fd72f8063","chatId":"30a6d78c4709424daf6336379fad325d","sessionId":null,"userId":99890,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那个“别太矫情了”，像是有人很早以前就放进你脑子里的一句话。你能看见自己对自己苛刻，这本身已经不容易了。那这句话，最早是谁对你说的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那个“别太矫情了”，像是有人很早以前就放进你脑子里的一句话。你能看见自己对自己苛刻，这本身已经不容易了。那这句话，最早是谁对你说的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2420,"promptTokens":3113,"completionTokens":88,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:07:15"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008576051869089461,"emotions":[],"relationId":"6af67ee3f4429d1fd72f8062","courseProgressId":0,"tsGen":1794539235386,"createTime":"2026-11-13 11:07:15","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ee3f4429d1fd72f8062","chatId":"30a6d78c4709424daf6336379fad325d","sessionId":null,"userId":99890,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（苦笑）说句什么……我也不知道。可能就，别太矫情了？不过你这么一说，好像我对自己确实挺苛刻的。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008576051869089461,"emotions":[{"code":"calm","name":"平静","value":4,"sort":4},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"happy","name":"快乐","value":2,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67ee3f4429d1fd72f8063","courseProgressId":0,"tsGen":1794539235383,"createTime":"2026-11-13 11:07:15","delFlag":0,"emotionTendency":