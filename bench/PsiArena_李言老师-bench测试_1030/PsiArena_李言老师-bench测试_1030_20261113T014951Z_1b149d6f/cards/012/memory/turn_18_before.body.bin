ions":null,"isShow":true,"label":"","evaluate":"","takingTime":2408,"promptTokens":3098,"completionTokens":160,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:01:27"}],"imgs":null,"regenerations":0,"seqNum":29,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.022974231018588216,"emotions":[],"relationId":"6af66f77f4429d1fd72f6d4b","courseProgressId":0,"tsGen":1794535287818,"createTime":"2026-11-13 10:01:27","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f77f4429d1fd72f6d4b","chatId":"a40c8d264af942d6a2eb92072c4fd46e","sessionId":null,"userId":99793,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（声音有点抖）对……我怕他跟我一样，觉得家里就该忍着、吵着过。可要是离婚，我又怕是我亲手把这个家拆了。<第14轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":28,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.022974231018588216,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66f77f4429d1fd72f6d4c","courseProgressId":0,"tsGen":1794535287815,"createTime":"2026-11-13 10:01:27","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id"