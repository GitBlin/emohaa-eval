e":3,"sort":7},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2}],"relationId":"6af66f71f4429d1fd72f6d3a","courseProgressId":0,"tsGen":1794535281845,"createTime":"2026-11-13 10:01:21","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f6df4429d1fd72f6d26","chatId":"a40c8d264af942d6a2eb92072c4fd46e","sessionId":null,"userId":99793,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你夹在两套声音里：一边是从小被教的那套“忍”，一边是你自己真实感受到的委屈。这两套东西在你心里打架，难怪会堵。那你有没有想过，爸妈说这些的时候，他们自己是不是也没被允许过别的活法？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你夹在两套声音里：一边是从小被教的那套“忍”，一边是你自己真实感受到的委屈。这两套东西在你心里打架，难怪会堵。那你有没有想过，爸妈说这些的时候，他们自己是不是也没被允许过别的活法？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2302,"promptTokens":3295,"completionTokens":103,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:01:17"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01406017645020105,"emotions":[],"relationId":"6af66f6df4429d1fd72f6d25","courseProgressId":0,"tsGen":1794535277801,"createTime":"2026-11-13 10:01:17","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f6df4429d1fd72f6d25","chatId":"a40c8d264af942d6a2eb92072c4fd46e","sessionId":null,"userId":99793,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（沉默几秒）可能是我爸妈吧。从小他们就说，女人要忍，家和万事兴，离婚是丢人的事。可我有时候又觉得……他们是不是根本没想过我过得怎么样。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01406017645020105,"emotions":[{"code":"sadness","name":"悲伤","value":7,"sort":8},{"code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"anger","name":"愤怒","value":3,"sort":7},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2}],"relationId":"6af66f6df4429d1fd72f6d26","courseProgressId":0,"tsGen":1794535277798,"createTime":"2026-11-13 10:01:17","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f68f4429d1fd72f6d10","chatId":"a40c8d264af942d6a2eb92072c4fd46e","sessionId":null,"userId":99793,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"把这些说出来，需要的不是承认失败，反而是勇气。被摔东西、被推，这些不该由你来背“失败”这个名。那个“讲了就显得很失败”的念头，你想想，最早是从谁那儿来的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"把这些说出来，需要的不是承认失败，反而是勇气。被摔东西、被推，这些不该由你来背“失败”这个名。那个“讲了就显得很失败”的念头，你想想，最早是从谁那儿来的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":3480,"promptTokens":2506,"completionTokens":214,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:01:12"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00669240358332722,"emotions":[],"relationId":"6af66f68f4429d1fd72f6d0f","courseProgressId":0,"tsGen":1794535272211,"createTime":"2026-11-13 10:01:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f68f4429d1fd72f6d0f","chatId":"a40c8d264af942d6a2eb92072c4fd46e","sessionId":null,"userId":99793,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（声音低下去）有点发紧，胸口闷闷的。其实这些事我很少跟人讲，讲了好像就显得……显得我的婚姻很失败。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00669240358332722,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66f68f4429d1fd72f6d10","courseProgressId":0,"tsGen":1794535272208,"createTime":"2026-11-13 10:01:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f62f4429d1fd72f6d05","chatId":"a40c8d264af942d6a2eb92072c4fd46e","sessionId":null,"userId":99793,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听到你说这些，我心里一沉。摔东西、吼你、推你，这些不是小事，你一直不愿回想，大概也是因为太疼了。谢谢你愿意把它说出来。说到这些的时候，你现在身体上有什么感觉吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听到你说这些，我心里一沉。摔东西、吼你、推你，这些不是小事，你一直不愿回想，大概也是因为太疼了。谢谢你愿意把它说出来。说到这些的时候，你现在身体上有什么感觉吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1971,"promptTokens":2384,"completionTokens":107,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:01:06"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0066918460466376724,"emotions":[],"relationId":"6af66f62f4429d1fd72f6d04","courseProgressId":0,"tsGen":1794535266188,"createTime":"2026-11-13 10:01:06","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f62f4429d1fd72f6d04","chatId":"a40c8d264af942d6a2eb92072c4fd46e","sessionId":null,"userId":99793,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（停顿）结婚头两年就有过吧……吵架的时候他摔东西、吼我，有一次还推了我。我一直不太愿意回想这些。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0066918460466376724,"emotions":[{"code":"sadness","name":"悲伤","value":7,"sort":8},{"code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"fear","name":"恐惧","value":6,"sort":6},{"code":"anger","name":"愤怒","value":5,"sort":7},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"re