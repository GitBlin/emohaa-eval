{"success":true,"code":"000","message":null,"data":{"totalAmount":14,"totalPageCount":1,"pageNum":0,"itemCount":14,"content":[{"pageNum":0,"pageSize":0,"id":"6af68111f4429d1fd72f8221","chatId":"09d8d9888b65448696e788f5f47d0cb0","sessionId":null,"userId":99898,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"能说出来不丢人。你也不是难相处，只是习惯了先绷着，好像放松一点就会被挑出毛病。这份小心，其实是在保护自己。那你想过没有，这种“绷着”是从什么时候开始的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"能说出来不丢人。你也不是难相处，只是习惯了先绷着，好像放松一点就会被挑出毛病。这份小心，其实是在保护自己。那你想过没有，这种“绷着”是从什么时候开始的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1621,"promptTokens":2239,"completionTokens":113,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:16:33"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014060431794105058,"emotions":[],"relationId":"6af68111f4429d1fd72f8220","courseProgressId":0,"tsGen":1794539793927,"createTime":"2026-11-13 11:16:33","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68111f4429d1fd72f8220","chatId":"09d8d9888b65448696e788f5f47d0cb0","sessionId":null,"userId":99898,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"让我想想……好像真的没有。跟谁在一起我多少都会绷着，包括家里人。这么说出来有点丢人，是不是我这个人太难相处了？<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014060431794105058,"emotio