,"seqNum":6,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00460916995582387,"emotions":[{"code":"fear","name":"恐惧","value":6,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"sadness","name":"悲伤","value":1,"sort":8},{"code":"dislike","name":"厌恶","value":1,"sort":9},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af680fcf4429d1fd72f8208","courseProgressId":0,"tsGen":1794539772009,"createTime":"2026-11-13 11:16:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af680f7f4429d1fd72f8201","chatId":"09d8d9888b65448696e788f5f47d0cb0","sessionId":null,"userId":99898,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你的节奏由你掌握，不想说的可以不说，我们只聊你愿意聊的。开始时我会多听，慢慢了解你的情况，不会一上来就追问隐私。你更希望先聊聊来这里的原因，还是先说说你担心的部分？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你的节奏由你掌握，不想说的可以不说，我们只聊你愿意聊的。开始时我会多听，慢慢了解你的情况，不会一上来就追问隐私。你更希望先聊聊来这里的原因，还是先说说你担心的部分？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1819,"promptTokens":1638,"completionTokens":89,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:16:07"}],"imgs":null,"regenerations":0,"seqNum":5,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0011694765009611784,"emotions":[],"relationId":"6af680f7f4429d1fd72f8200","courseProgressId":0,"tsGen":1794539767196,"createTime":"2026-11-13 11:16:07","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUser