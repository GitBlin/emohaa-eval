takingTime":2994,"promptTokens":3096,"completionTokens":194,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:57:35"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909097121656177,"emotions":[],"relationId":"6af66e8ff4429d1fd72f6b50","courseProgressId":0,"tsGen":1794535055388,"createTime":"2026-11-13 09:57:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e8ff4429d1fd72f6b50","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"吃饭的时候……我爸随口就来一句“人家谁谁又考了多少”。我妈不说什么，但那个眼神我懂。说多了我也懒得解释，反正说了也是我不够努力。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909097121656177,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"anger","name":"愤怒","value":3,"sort":7},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"surprised","name":"惊讶","value":2,"sort":5},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"expect","name":"期待","value":0,"sort":2}],"relationId":"6af66e8ff4429d1fd72f6b51","courseProgressId":0,"tsGen":1794535055385,"createTime":"2026-11-13 09:57:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e89f4429d1fd72f6b38","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听你这么说，我好像明白了一点：他说“不学了”，你却认真，那刻你像被放到一个尴尬位置——认真反倒像会被人笑的事。家里总拿成绩比，可能也让你觉得认真了就得被评判。你家里一般是怎么比成绩的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听你这么说，我好像明白了一点：他说“不学了”，你却认真，那刻你像被放到一个尴尬位置——认真反倒像会被人笑的事。家里总拿成绩比，可能也让你觉得认真了就得被评判。你家里一般是怎么比成绩的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2274,"promptTokens":2360,"completionTokens":128,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:57:29"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0066912494536566945,"emotions":[],"relationId":"6af66e89f4429d1fd72f6b37","courseProgressId":0,"tsGen":1794535049722,"createTime":"2026-11-13 09:57:29","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e89f4429d1fd72f6b37","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"可能……都有。他那样说，让我觉得自己认真反而像个傻子。而且我家里也总拿成绩比来比去，我一听这种话就特别烦。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0066912494536566945,"emotions":[{"code":"anger","name":"愤怒","value":5,"sort":7},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af66e89f4429d1fd72f6b38","courseProgressId":0,"tsGen":1794535049719,"createTime":"2026-11-13 09:57:29","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e84f4429d1fd72f6b22","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来，让你不舒服的不是他嘴上放弃，而是他明明在认真做，却偏要说自己不行——这种不一致让人有点别扭。你更在意的是他不够坦诚，还是那种“认真还要装作无所谓”的感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来，让你不舒服的不是他嘴上放弃，而是他明明在认真做，却偏要说自己不行——这种不一致让人有点别扭。你更在意的是他不够坦诚，还是那种“认真还要装作无所谓”的感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2052,"promptTokens":2358,"completionTokens":130,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:57:24"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005910233186669706,"emotions":[],"relationId":"6af66e84f4429d1fd72f6b21","courseProgressId":0,"tsGen":1794535044584,"createTime":"2026-11-13 09:57:24","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e84f4429d1fd72f6b21","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……那个同学吧，嘴上老说自己不考了、学不会，可我看他笔记做得比谁都细。我就……有点说不上来的不舒服。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005910233186669706,"emotions":[{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"surprised","name":"惊讶","value":2,"sort":5},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"fear","name":"恐惧","value":0,"sort":6}],"relationId":"6af66e84f4429d1fd72f6b22","courseProgressId":0,"tsGen":1794535044582,"createTime":"2026-11-13 09:57:24","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e7ff4429d1fd72f6b11","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你问这些不算多，我倒觉得它挺重要——你连问我怎么看，都会先担心是不是打扰到我了。这个先放着，我们不急。你想回到那个同学的事，就从哪儿说起都行。","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你问这些不算多，我倒觉得它挺重要——你连问我怎么看，都会先担心是不是打扰到我了。这个先放着，我们不急。你想回到那个同学的事，就从哪儿说起都行。","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1887,"promptTokens":2236,"completionTokens":102,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:57:19"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705967375043397,"emotions":[],"relationId":"6af66e7ff4429d1fd72f6b10","courseProgressId":0,"tsGen":1794535039423,"createTime":"2026-11-13 09:57:19","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e7ff4429d1fd72f6b10","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"这个……我也不太记得了，好像一直就这样吧。哎，我是不是问太多了，老问你咋看我。要不还是说那个同学的事？<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705967375043397,"emotions":[{"code":"calm","name":"平静","value":5,"sort":4},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"sadness","name":"悲伤","value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66e7ff4429d1fd72f6b11","courseProgressId":0,"tsGen":1794535039420,"createTime":"2026-11-13 09:57:19","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e7af4429d1fd72f6afb","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不会觉得你计较，我反而注意到，你几次都在确认我会怎么看你。好像你心里有话，先冒出来的却是“我这样说会不会不好”。这种小心翼翼，是从什么时候开始有的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不会觉得你计较，我反而注意到，你几次都在确认我会怎么看你。好像你心里有话，先冒出来的却是“我这样说会不会不好”。这种小心翼翼，是从什么时候开始有的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1828,"promptTokens":2126,"completionTokens":99,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:57:14"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0031721943979445637,"emotions":[],"relationId":"6af66e7af4429d1fd72f6afa","courseProgressId":0,"tsGen":1794535034196,"createTime":"2026-11-13 09:57:14","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e7af4429d1fd72f6afa","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"第一个念头……可能就是“他明明不是这样”。但说出来又好像我在背后议论人。你不会觉得我太计较吧？<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0031721943979445637,"emotions":[],"relationId":"6af66e7af4429d1fd72f6afb","courseProgressId":0,"tsGen":1794535034193,"createTime":"2026-11-13 09:57:14","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e75f4429d1fd72f6aea","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"这种“堵得慌”往往不是烦那个人，而是他那种无力感让你有点接不住。听别人反复说自己不行，心里容易跟着沉下去。你自己听到这类话时，心里冒出来的第一个念头是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"这种“堵得慌”往往不是烦那个人，而是他那种无力感让你有点接不住。听别人反复说自己不行，心里容易跟着沉下去。你自己听到这类话时，心里冒出来的第一个念头是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1839,"promptTokens":2011,"completionTokens":104,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:57:09"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909653645095007,"emotions":[],"relationId":"6af66e75f4429d1fd72f6ae9","courseProgressId":0,"tsGen":1794535029704,"createTime":"2026-11-13 09:57:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e75f4429d1fd72f6ae9","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是……班里有个人老说自己不行、学不会，我听着挺别扭的。但具体为什么难受，我也讲不清楚，可能就是心里堵得慌。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909653645095007,"emotions":[],"relationId":"6af66e75f4429d1fd72f6aea","courseProgressId":0,"tsGen":1794535029701,"createTime":"2026-11-13 09:57:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e71f4429d1fd72f6ad9","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不会觉得你想太多。会担心被看成矫情，说明你其实很在意别人怎么看，这挺常见的。咨询室里没有“矫情”这回事，能开口说这些已经不容易了。最近有没有哪件事，最常让你觉得自己“想太多”？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不会觉得你想太多。会担心被看成矫情，说明你其实很在意别人怎么看，这挺常见的。咨询室里没有“矫情”这回事，能开口说这些已经不容易了。最近有没有哪件事，最常让你觉得自己“想太多”？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2353,"promptTokens":1881,"completionTokens":156,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:57:05"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691214637365515,"emotions":[],"relationId":"6af66e71f4429d1fd72f6ad8","courseProgressId":0,"tsGen":1794535025345,"createTime":"2026-11-13 09:57:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e71f4429d1fd72f6ad8","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"都有吧……我也说不太清。就是有时候说着说着，怕自己显得特别矫情。你会不会觉得我想太多？<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691214637365515,"emotions":[{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"co