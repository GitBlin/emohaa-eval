{"success":true,"code":"000","message":null,"data":{"totalAmount":12,"totalPageCount":1,"pageNum":0,"itemCount":12,"content":[{"pageNum":0,"pageSize":0,"id":"6af66e7af4429d1fd72f6afb","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不会觉得你计较，我反而注意到，你几次都在确认我会怎么看你。好像你心里有话，先冒出来的却是“我这样说会不会不好”。这种小心翼翼，是从什么时候开始有的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不会觉得你计较，我反而注意到，你几次都在确认我会怎么看你。好像你心里有话，先冒出来的却是“我这样说会不会不好”。这种小心翼翼，是从什么时候开始有的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1828,"promptTokens":2126,"completionTokens":99,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:57:14"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0031721943979445637,"emotions":[],"relationId":"6af66e7af4429d1fd72f6afa","courseProgressId":0,"tsGen":1794535034196,"createTime":"2026-11-13 09:57:14","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e7af4429d1fd72f6afa","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"第一个念头……可能就是“他明明不是这样”。但说出来又好像我在背后议论人。你不会觉得我太计较吧？<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0031721943979445637,"emotions":[],"relationId":"6af66e7af4429d1fd72f6afb","courseProgressId":0,"tsGen":1794535034193,"createTime":"2026-11-13 09:57:14","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e75f4429d1fd72f6aea","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"这种“堵得慌”往往不是烦那个人，而是他那种无力感让你有点接不住。听别人反复说自己不行，心里容易跟着沉下去。你自己听到这类话时，心里冒出来的第一个念头是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"这种“堵得慌”往往不是烦那个人，而是他那种无力感让你有点接不住。听别人反复说自己不行，心里容易跟着沉下去。你自己听到这类话时，心里冒出来的第一个念头是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1839,"promptTokens":2011,"completionTokens":104,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:57:09"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909653645095007,"emotions":[],"relationId":"6af66e75f4429d1fd72f6ae9","courseProgressId":0,"tsGen":1794535029704,"createTime":"2026-11-13 09:57:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e75f4429d1fd72f6ae9","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是……班里有个人老说自己不行、学不会，我听着挺别扭的。但具体为什么难受，我也讲不清楚，可能就是心里堵得慌。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909653645095007,"emotions":[],"relationId":"6af66e75f4429d1fd72f6aea","courseProgressId":0,"tsGen":1794535029701,"createTime":"2026-11-13 09:57:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e71f4429d1fd72f6ad9","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不会觉得你想太多。会担心被看成矫情，说明你其实很在意别人怎么看，这挺常见的。咨询室里没有“矫情”这回事，能开口说这些已经不容易了。最近有没有哪件事，最常让你觉得自己“想太多”？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不会觉得你想太多。会担心被看成矫情，说明你其实很在意别人怎么看，这挺常见的。咨询室里没有“矫情”这回事，能开口说这些已经不容易了。最近有没有哪件事，最常让你觉得自己“想太多”？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2353,"promptTokens":1881,"completionTokens":156,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:57:05"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691214637365515,"emotions":[],"relationId":"6af66e71f4429d1fd72f6ad8","courseProgressId":0,"tsGen":1794535025345,"createTime":"2026-11-13 09:57:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e71f4429d1fd72f6ad8","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"都有吧……我也说不太清。就是有时候说着说着，怕自己显得特别矫情。你会不会觉得我想太多？<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691214637365515,"emotions":[{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66e71f4429d1fd72f6ad9","courseProgressId":0,"tsGen":1794535025342,"createTime":"2026-11-13 09:57:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e6cf4429d1fd72f6ac4","chatId":"ba80be402c5e4a0da795153f059524eb","sessionId":null,"userId":99791,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"保密是咨询的基本前提，你说的话不会被随便传出去，涉及安全风险时我会和你商量怎么处理。我也不是那种逮着一点就追着问的人，你想停就可以停。你担心的“说多了收不住”，是怕自己情绪失控，还是怕被评判？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"保密是咨询的基本前提，你说的话不会被随便传出去，涉及安全风险时我会和你商量怎么处理。我也不是那种逮着一点就追着问的人，你想停就可以停。你担心的“说多了收不住”，是怕自己情绪失控，还是怕被评判？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1736,"promptTokens":1750,"completionTokens":92,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:57:00"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575068066464109,"emotions":[],"relationId":"6af66e6cf4429d1fd72f6ac3","courseProgr