ode":"calm","name":"平静","value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af68008f4429d1fd72f813b","courseProgressId":0,"tsGen":1794539528276,"createTime":"2026-11-13 11:12:08","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68001f4429d1fd72f812d","chatId":"e6b55cfd2dc745aba219f5e629885440","sessionId":null,"userId":99894,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不会，我反而觉得你挺真诚的——能把“我自己也不太明白”说出来，本身就不容易。乱一点没关系，我们可以慢慢看。你好像挺在意别人怎么看你，这种担心是最近才有的吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不会，我反而觉得你挺真诚的——能把“我自己也不太明白”说出来，本身就不容易。乱一点没关系，我们可以慢慢看。你好像挺在意别人怎么看你，这种担心是最近才有的吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1964,"promptTokens":2509,"completionTokens":103,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:12:01"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00521937584609669,"emotions":[],"relationId":"6af68001f4429d1fd72f812c","courseProgressId":0,"tsGen":1794539521870,"createTime":"2026-11-13 11:12:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68001f4429d1fd72f812c","chatId":"e6b55cfd2dc745aba219f5e629885440","sessionId":null,"userId":99894,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯，清楚一点了。那个……如果我说得乱七八糟，你会不会觉得我很难搞？我自己都不太明白自己怎么了。<第6轮