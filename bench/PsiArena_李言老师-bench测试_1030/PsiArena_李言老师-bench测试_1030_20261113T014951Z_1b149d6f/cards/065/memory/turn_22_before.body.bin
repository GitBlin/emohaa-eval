code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"fear","name":"恐惧","value":6,"sort":6},{"code":"anger","name":"愤怒","value":4,"sort":7},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af6797ff4429d1fd72f7bda","courseProgressId":0,"tsGen":1794537855970,"createTime":"2026-11-13 10:44:15","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6797bf4429d1fd72f7bd3","chatId":"e0f65fb4d1704f04a7a0a85c80a0d55e","sessionId":null,"userId":99865,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“快炸了”这个感觉，我听见了——憋了这么多年，还得在家里装作没事，真的很累。那当你觉得快炸的时候，通常会发生什么，是自己躲起来，还是硬撑着？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“快炸了”这个感觉，我听见了——憋了这么多年，还得在家里装作没事，真的很累。那当你觉得快炸的时候，通常会发生什么，是自己躲起来，还是硬撑着？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1904,"promptTokens":2544,"completionTokens":92,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:44:11"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006690599930646046,"emotions":[],"relationId":"6af6797bf4429d1fd72f7bd2","courseProgressId":0,"tsGen":1794537851989,"createTime":"2026-11-13 10:44:11","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6797bf4429d1fd72f7bd2","chatId":"e0f65fb4d1704f04a7a0a85c80a0d55e","sessionId":null,"userId":99865,"orgId":3721,"botId":1030,"isGreeting":