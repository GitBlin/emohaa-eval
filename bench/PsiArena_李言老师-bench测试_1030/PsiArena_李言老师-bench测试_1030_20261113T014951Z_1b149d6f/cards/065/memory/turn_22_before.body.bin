3:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67969f4429d1fd72f7ba4","chatId":"e0f65fb4d1704f04a7a0a85c80a0d55e","sessionId":null,"userId":99865,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"一团……说不上来。就是心里发慌，好像要发生什么似的。有时候又觉得，是不是我自己想太多了，别人会不会根本没这种事。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575391639380842,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"sadness","name":"悲伤","value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67969f4429d1fd72f7ba5","courseProgressId":0,"tsGen":1794537833360,"createTime":"2026-11-13 10:43:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67964f4429d1fd72f7b97","chatId":"e0f65fb4d1704f04a7a0a85c80a0d55e","sessionId":null,"userId":99865,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不用急着说清楚，那种一睁眼就被压住的感觉，本身已经够难受了。我陪着你慢慢靠近它就好。那些念头冒出来时，更像是担心某件具体的事，还是一团说不上来的紧？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不用急着说清楚，那种一睁眼就被压住的感觉，本身已经够难受了。我陪着你慢慢靠近它就好。那些念头冒出来时，更像是担心某件具体的事，还是一团说不上来的紧？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1747,"promptTokens":2030,"completionTokens":104,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:43:48"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01590230350643331,"emotions":[],"relationId":"6af67964f4429d1fd72f7b96","courseProgressId":0,"tsGen":1794537828574,"createTime":"2026-11-13 10:43:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67964f4429d1fd72f7b96","chatId":"e0f65fb4d1704f04a7a0a85c80a0d55e","sessionId":null,"userId":99865,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"哦……行吧，我明白了。嗯，最凶的时候，就是早上刚醒，眼睛还没睁开，那些念头就冒出来了。具体是什么……我不太知道怎么说清楚，反正就是很难受。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01590230350643331,"emotions":[{"code":"sadness","name":"悲伤","value":7,"sort":8},{"code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67964f4429d1fd72f7b97","courseProgressId":0,"tsGen":1794537828571,"createTime":"2026-11-13 10:43:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67952f4429d1fd72f7b83","chatId":"e0f65fb4d1704f04a7a0a85c80a0d55e","sessionId":null,"userId":99865,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"我理解你想在难受时随时能找到人，这份需要很真实。不过咨询之外我不加私人联系方式，这是我们之间的界限，也是对咨询的保护。我们可以在这儿把“脑子停不下来”这件事谈细一点——它一般什么时候转得最凶？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我理解你想在难受时随时能找到人，这份需要很真实。不过咨询之外我不加私人联系方式，这是我们之间的界限，也是对咨询的保护。我们可以在这儿把“脑子停不下来”这件事谈细一点——它一般什么时候转得最凶？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1979,"promptTokens":1897,"completionTokens":107,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:43:30"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.04206247289194967,"emotions":[],"relationId":"6af67952f4429d1fd72f7b82","courseProgressId":0,"tsGen":1794537810483,"createTime":"2026-11-13 10:43:30","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67952f4429d1fd72f7b82","chatId":"e0f65fb4d1704f04a7a0a85c80a0d55e","sessionId":null,"userId":99865,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"脑子里……一直转，停不下来。身体倒还好吧，就是早上醒来那会儿特别紧。嗯……我还想问一下，如果我平时实在难受，能不能私下加你微信什么的？<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.04206247289194967,"emoti