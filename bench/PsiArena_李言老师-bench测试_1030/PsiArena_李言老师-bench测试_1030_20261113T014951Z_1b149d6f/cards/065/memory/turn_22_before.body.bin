11-13 10:44:07"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.08509108131952726,"emotions":[],"relationId":"6af67977f4429d1fd72f7bc7","courseProgressId":0,"tsGen":1794537847505,"createTime":"2026-11-13 10:44:07","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67977f4429d1fd72f7bc7","chatId":"e0f65fb4d1704f04a7a0a85c80a0d55e","sessionId":null,"userId":99865,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……怕你觉得我这人怎么会有这种念头，太不敬了。其实在家里，有些话我都不敢让爸妈知道，他们要是知道了，肯定觉得我出问题了。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.08509108131952726,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67977f4429d1fd72f7bc8","courseProgressId":0,"tsGen":1794537847503,"createTime":"2026-11-13 10:44:07","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67973f4429d1fd72f7bb9","chatId":"e0f65fb4d1704f04a7a0a85c80a0d55e","sessionId":null,"userId":99865,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你刚才说的“后悔”，我听得很清楚——可你并没有小题大做，那种烦和怕都是真的。说完想收回去，也很常见。我想知道，那个“后悔”冒出来时，你心里是在担心我怎么看你吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你刚才说的“后悔”，我听得很清楚——可你并没有小题大做，那种烦和怕都是真的。说完想收回去，也很常见。我想知道，那个“后悔”冒出来时，你心里是在担心我怎么看你吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2256,"promptTokens":2278,"completionTokens":80,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:44:03"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01098537591250265,"emotions":[],"relationId":"6af67973f4429d1fd72f7bb8","courseProgressId":0,"tsGen":1794537843177,"createTime":"2026-11-13 10:44:03","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67973f4429d1fd72f7bb8","chatId":"e0f65fb4d1704f04a7a0a85c80a0d55e","sessionId":null,"userId":99865,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"都有吧……烦，想躲开，可底下又有点怕。唉，说出来之后我又有点后悔，感觉自己在小题大做。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01098537591250265,"emotions":[{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67973f4429d1fd72f7bb9","courseProgressId":0,"tsGen":1794537843175,"createTime":"2026-11-13 10:44:03","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6796ef4429d1fd72f7bb1","chatId":"e0f65fb4d1704f04a7a0a85c80a0d55e","sessionId":null,"userId":99865,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不会觉得你奇怪。你愿意把这件事说出来，已经不容易了。看到那些场景时浑身不对劲，是身体先有反应，不是你多心。那种不对劲里，更多是害怕，还是烦、想躲开？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不会觉得你奇怪。你愿意把这件事说出来，已经不容易了。看到那些场景时浑身不对劲，是身体先有反应，不是你多心。那种不对劲里，更多是害怕，还是烦、想躲开？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1689,"promptTokens":2162,"completionTokens":86,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:43:58"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006689491824656291,"emotions":[],"relationId":"6af6796ef4429d1fd72f7bb0","courseProgressId":0,"tsGen":1794537838602,"createTime":"2026-11-13 10:43:58","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6796ef4429d1fd72f7bb0","chatId":"e0f65fb4d1704f04a7a0a85c80a0d55e","sessionId":null,"userId":99865,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最近……嗯，家里那边每周都要去寺庙，我一看到那些就浑身不对劲。这个……我不知道该不该说，怕说出来你会觉得我很奇怪。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage