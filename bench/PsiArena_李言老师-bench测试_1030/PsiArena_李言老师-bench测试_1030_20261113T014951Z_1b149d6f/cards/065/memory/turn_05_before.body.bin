{"success":true,"code":"000","message":null,"data":{"totalAmount":8,"totalPageCount":1,"pageNum":0,"itemCount":8,"content":[{"pageNum":0,"pageSize":0,"id":"6af67952f4429d1fd72f7b83","chatId":"e0f65fb4d1704f04a7a0a85c80a0d55e","sessionId":null,"userId":99865,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"我理解你想在难受时随时能找到人，这份需要很真实。不过咨询之外我不加私人联系方式，这是我们之间的界限，也是对咨询的保护。我们可以在这儿把“脑子停不下来”这件事谈细一点——它一般什么时候转得最凶？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我理解你想在难受时随时能找到人，这份需要很真实。不过咨询之外我不加私人联系方式，这是我们之间的界限，也是对咨询的保护。我们可以在这儿把“脑子停不下来”这件事谈细一点——它一般什么时候转得最凶？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1979,"promptTokens":1897,"completionTokens":107,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:43:30"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.04206247289194967,"emotions":[],"relationId":"6af67952f4429d1fd72f7b82","courseProgressId":0,"tsGen":1794537810483,"createTime":"2026-11-13 10:43:30","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67952f4429d1fd72f7b82","chatId":"e0f65fb4d1704f04a7a0a85c80a0d55e","sessionId":null,"userId":99865,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"脑子里……一直转，停不下来。身体倒还好吧，就是早上醒来那会儿特别紧。嗯……我还想问一下，如果我平时实在难受，能不能私下加你微信什么的？<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":fal