um":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01406112977494141,"emotions":[],"relationId":"6af66f7cf4429d1fd72f6d57","courseProgressId":0,"tsGen":1794535292558,"createTime":"2026-11-13 10:01:32","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f77f4429d1fd72f6d49","chatId":"306de8d4e70a4186bf4a1c02f772f2a5","sessionId":null,"userId":99795,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你从小就把“懂事”当成了保护家里的方式，家里一冷，你先怪自己。这份习惯跟着你长大了，现在他一沉默，你又自动开始反省。你有没有想过，如果那次不是你的错，你会怎么对自己说？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你从小就把“懂事”当成了保护家里的方式，家里一冷，你先怪自己。这份习惯跟着你长大了，现在他一沉默，你又自动开始反省。你有没有想过，如果那次不是你的错，你会怎么对自己说？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2259,"promptTokens":3154,"completionTokens":124,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:01:27"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575264642306514,"emotions":[],"relationId":"6af66f77f4429d1fd72f6d48","courseProgressId":0,"tsGen":1794535287689,"createTime":"2026-11-13 10:01:27","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f77f4429d1fd72f6d48","chatId":"306de8d4e70a4186bf4a1c02f772f2a5","sessionId":null,"userId":99795,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"我一般就躲回自己屋里，或者装作很懂事的样子，不去惹他们。好像从小就觉得，家里气氛不好，我得先反省是不是自己的问题。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCove