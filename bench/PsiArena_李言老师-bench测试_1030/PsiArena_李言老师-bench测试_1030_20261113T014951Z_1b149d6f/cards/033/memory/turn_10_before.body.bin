e":"恐惧","value":2,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2}],"relationId":"6af6731af4429d1fd72f7316","courseProgressId":0,"tsGen":1794536218164,"createTime":"2026-11-13 10:16:58","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67315f4429d1fd72f730b","chatId":"922a762e7b0448d592a88e08a0938b78","sessionId":null,"userId":99814,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你说“怕被否定”，又马上补一句“那样挺烦人的”——好像还没等我回应，你就先把自己说小了。想被人稳稳接住，这个愿望本身不丢人。最近一次让你觉得被否定，是什么时候的事？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你说“怕被否定”，又马上补一句“那样挺烦人的”——好像还没等我回应，你就先把自己说小了。想被人稳稳接住，这个愿望本身不丢人。最近一次让你觉得被否定，是什么时候的事？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1950,"promptTokens":1858,"completionTokens":125,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:16:53"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0066920514584589315,"emotions":[],"relationId":"6af67315f4429d1fd72f730a","courseProgressId":0,"tsGen":1794536213654,"createTime":"2026-11-13 10:16:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67315f4429d1fd72f730a","chatId":"922a762e7b0448d592a88e08a0938b78","sessionId":null,"userId":99814,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"我也说不好……可能就是怕被否定吧。其实我也知道不能随时找人，那样挺烦人的。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0066920514584589315,"emotions":[{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67315f4429d1fd72f730b","courseProgressId":0,"tsGen":1794536213652,"createTime":"2026-11-13 10:16:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67311f4429d1fd72f72ff","chatId":"922a762e7b0448d592a88e08a0938b78","sessionId":null,"userId":99814,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你怕被我在心里看轻，这份担心我收到了。咨询里我不会评判你，也不会因为你说的事就认定你这个人有问题。平时发消息这件事，我们需要先定好界限。你更在意的是“随时能找到人”，还是“说出来之后不被否定”？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你怕被我在心里看轻，这份担心我收到了。咨询里我不会评判你，也不会因为你说的事就认定你这个人有问题。平时发消息这件事，我们需要先定好界限。你更在意的是“随时能找到人”，还是“说出来之后不被否定”？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1692,"promptTokens":1857,"completionTokens":103,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:16:49"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705996305270215,"emotions":[],"relationId":"6af6