"恐惧","value":4,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af66fa9f4429d1fd72f6dd6","courseProgressId":0,"tsGen":1794535337956,"createTime":"2026-11-13 10:02:17","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66fa4f4429d1fd72f6dcc","chatId":"f16068a132cf49859298fc8addcf6347","sessionId":null,"userId":99796,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“和”是你一个人在撑——这句话说出来，分量挺重的。表面上家还在，可里头的累和孤单，好像只有你自己知道。我想问，这份撑着，他看见过吗，还是你一直没让他看见？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“和”是你一个人在撑——这句话说出来，分量挺重的。表面上家还在，可里头的累和孤单，好像只有你自己知道。我想问，这份撑着，他看见过吗，还是你一直没让他看见？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2381,"promptTokens":2591,"completionTokens":105,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:02:12"}],"imgs":null,"regenerations":0,"seqNum":31,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.053393665721602944,"emotions":[],"relationId":"6af66fa4f4429d1fd72f6dcb","courseProgressId":0,"tsGen":1794535332546,"createTime":"2026-11-13 10:02:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66fa4f4429d1fd72f6dcb","chatId":"f16068a132cf49859298fc8addcf6347","sessionId":null,"userId":99796,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（苦笑）像我妈吧。她总说女人别太较真，家和万事兴。可我现在越来越觉得，这“和”是我一个人在撑。<第15轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":30,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.053393665721602944,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"anger","name":"愤怒","value":4,"sort":7},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af66fa4f4429d1fd72f6dcc","courseProgressId":0,"tsGen":1794535332543,"createTime":"2026-11-13 10:02:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f9ff4429d1fd72f6dc3","chatId":"f16068a132cf49859298fc8addcf6347","sessionId":null,"userId":99796,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"气得手抖的那一刻，你其实很清楚自己要什么——被当回事。可它刚冒头，你又用“太计较”把它按了回去。我想问，那个嫌你计较的声音，听起来更像谁的口气？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"气得手抖的那一刻，你其实很清楚自己要什么——被当回事。可它刚冒头，你又用“太计较”把它按了回去。我想问，那个嫌你计较的声音，听起来更像谁的口气？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2674,"promptTokens":3306,"completionTokens":173,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:02:07"}],"imgs":null,"regenerations":0,"seqNum":29,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010984810555249204,"emotions":[],"relationId":"6af66f9ff4429d1fd72f6dc2","courseProgressId":0,"tsGen":1794535327593,"createTime":"2026-11-13 10:02:07","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f9ff4429d1fd72f6dc2","chatId":"f16068a132cf49859298fc8addcf6347","sessionId":null,"userId":99796,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（犹豫）有一次……看到他跟别人聊天，我气得手都在抖。那会儿我特别清楚，我想要的是被当回事，不是被晾在一边。可说完了又后悔，觉得自己是不是太计较了。<第14轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":28,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010984810555249204,"emotions":[],"relationId":"6af66f9ff4429d1fd72f6dc3","courseProgressId":0,"tsGen":1794535327590,"createTime":"2026-11-13 10:02:07","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f99f4429d1fd72f6db2","chatId":"f16068a132cf49859298fc8addcf6347","sessionId":null,"userId":99796,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"这么一说，好像有点心疼你。忍了那么多年，你把自己的需要一层层压了下去，压到最后，连自己想要什么都模糊了。最近有没有哪一刻，你清楚知道自己想要什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"这么一说，好像有点心疼你。忍了那么多年，你把自己的需要一层层压了下去，压到最后，连自己想要什么都模糊了。最近有没有哪一刻，你清楚知道自己想要什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2601,"promptTokens":3318,"completionTokens":140,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:02:01"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008577073691848102,"emotions":[],"relationId":"6af66f99f4429d1fd72f6db1","courseProgressId":0,"tsGen":1794535321901,"createTime":"2026-11-13 10:02:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f99f4429d1fd72f6db1","chatId":"f16068a132cf49859298fc8addcf6347","sessionId":null,"userId":99796,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（沉默几秒）……你这么一说，好像真是。我一直觉得忍一忍是为这个家好，可忍到最后，我连自己想要什么都说不清了。<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":26,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008577073691848102,"emotions":[],"relationId":"6af66f99f4429d1fd72f6db2","courseProgressId":0,"tsGen":1794535321898,"createTime":"2026-11-13 10:02:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f93f4429d1fd72f6da2","chatId":"f16068a132cf49859298fc8addcf6347","sessionId":null,"userId":99796,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"委屈是真的，可你马上又用“是不是我要求太多”把它压了回去。那句“忍忍就过去了”，是爸妈过日子的办法，不一定适合你和他。你有没有发现，你评判自己该不该说的时候，用的常是他们的尺子？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"委屈是真的，可你马上又用“是不是我要求太多”把它压了回去。那句“忍忍就过去了”，是爸妈过日子的办法，不一定适合你和他。你有没有发现，你评判自己该不该说的时候，用的常是他们的尺子？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2014,"promptTokens":3350,"completionTokens":96,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:01:55"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691922152496166,"emotions":[],"relationId":"6af66f93f4429d1fd72f6da1","courseProgressId":0,"tsGen":1794535315882,"createTime":"2026-11-13 10:01:55","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f93f4429d1fd72f6da1","chatId":"f16068a132cf49859298fc8addcf6347","sessionId":null,"userId":99796,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"委屈吧……但说出口又觉得，是不是我要求太多了。我爸妈总说，过日子哪有那么多话说，忍忍就过去了。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691922152496166,"emotions":[],"relationId":"6af66f93f4429d1fd72f6da2","courseProgressId":0,"tsGen":1794535315880,"createTime":"2026-11-13 10:01:55","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f8ff4429d1fd72f6d95","chatId":"f16068a132cf49859298fc8addcf6347","sessionId":null,"userId":99796,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那次被挡回来之后，你好像就给自己定了个规矩：先别说，省得添乱。这套规矩从家里带出来，现在又落在了你和他之间。我有点想知道，每次你觉得“说了也没用”的时候，心里头最先冒出来的，是失望还是委屈？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那次被挡回来之后，你好像就给自己定了个规矩：先别说，省得添乱。这套规矩从家里带出来，现在又落在了你和他之间。我有点想知道，每次你觉得“说了也没用”的时候，心里头最先冒出来的，是失望还是委屈？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2312,"promptTokens":3130,"completionTokens":149,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:01:51"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01590269099962873,"emotions":[],"relationId":"6af66f8ff4429d1fd72f6d94","courseProgressId":0,"tsGen":1794535311290,"createTime":"2026-11-13 10:01:51","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f8ff4429d1fd72f6d94","chatId":"f16068a132cf49859298fc8addcf6347","sessionId":null,"userId":99796,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（停顿）好像……是试过的。有一次说了，她正烦着，让我别添乱。后来我就不太说了。现在跟他吵架也是，说不了几句就觉得，说了也没用。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01590269099962873,"emotions":[],"relationId":"6af66f8ff4429d1fd72f6d95","courseProgressId":0,"tsGen":1794535311288,"createTime":"2026-11-13 10:01:51","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f89f4429d1fd72f6d73","chatId":"f16068a132cf49859298fc8addcf6347","sessionId":null,"userId":99796,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听你这么说，我有点心疼。你替妈妈想过她的累，却把自己的话咽回去了。那句“说了也没用”，是那时候你试过之后得出的，还是当时就默认了？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听你这么说，我有点心疼。你替妈妈想过她的累，却把自己的话咽回去了。那句“说了也没用”，是那时候你试过之后得出的，还是当时就默认了？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1766,"promptTokens":3058,"completionTokens":84,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:01:45"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010982263914525477,"emotions":[],"relationId":"6af66f89f4429d1fd72f6d72","courseProgressId":0,"tsGen":1794535305644,"createTime":"2026-11-13 10:01:45","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f89f4429d1fd72f6d72","chatId":"f16068a132cf49859298fc8addcf6347","sessionId":null,"userId":99796,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最想对我妈说吧……但那时候她也忙，也累，家里的事她自己也顾不过来。说了又能怎么样呢，好像也没什么用。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010982263914525477,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af66f89f4429d1fd72f6d73","courseProgressId":0,"tsGen":1794535305642,"createTime":"2026-11-13 10:01:45","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f80f4429d1fd72f6d63","chatId":"f16068a132cf49859298fc8addcf6347","sessionId":null,"userId":99796,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"从小听着吵声长大，慢慢学会把事都往自己肚子里咽——这不是你的性格，更像是那时候你保护自己的方式。只是现在，这套办法开始让你夜里喘不上气了。你有没有想过，如果当时能说出来，你最想对谁说？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"从小听着吵声长大，慢慢学会把事都往自己肚子里咽——这不是你的性格，更像是那时候你保护自己的方式。只是现在，这套办法开始让你夜里喘不上气了。你有没有想过，如果当时能说出来，你最想对谁说？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2560,"promptTokens":2939,"completionTokens":140,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:01:36"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.020326603482294512,"emotions":[],"relationId":"6af66f80f4429d1fd72f6d62","courseProgressId":0,"tsGen":1794535296935,"createTime":"2026-11-13 10:01:36","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f80f4429d1fd72f6d62","chatId":"f16068a132cf49859298fc8addcf6347","sessionId":null,"userId":99796,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"可能……不太想让脑子空下来吧。一空下来就会想家里的事，想他，想以后怎么办。其实我从小家里就这样，我爸妈也老吵，我好像习惯了什么事都自己憋着。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTi