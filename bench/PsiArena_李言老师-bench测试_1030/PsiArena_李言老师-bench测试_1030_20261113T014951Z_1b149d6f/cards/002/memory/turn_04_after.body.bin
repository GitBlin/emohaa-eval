{"success":true,"code":"000","message":null,"data":{"totalAmount":8,"totalPageCount":1,"pageNum":0,"itemCount":8,"content":[{"pageNum":0,"pageSize":0,"id":"6af66cd4f4429d1fd72f6785","chatId":"cdd4daba58c942dd93ff86b730223f78","sessionId":null,"userId":99784,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"说不清具体是什么也没关系，心里堵着的感觉本身就很真实。你说可能跟朋友有关，那最近和那个朋友之间，有没有哪一刻让你觉得不太对劲？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"说不清具体是什么也没关系，心里堵着的感觉本身就很真实。你说可能跟朋友有关，那最近和那个朋友之间，有没有哪一刻让你觉得不太对劲？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2055,"promptTokens":1839,"completionTokens":132,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:50:12"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00590932903292166,"emotions":[],"relationId":"6af66cd4f4429d1fd72f6784","courseProgressId":0,"tsGen":1794534612242,"createTime":"2026-11-13 09:50:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66cd4f4429d1fd72f6784","chatId":"cdd4daba58c942dd93ff86b730223f78","sessionId":null,"userId":99784,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是……最近老觉得心里堵得慌，但要说具体是什么事，我又说不太清楚。可能是跟朋友有关吧，嗯……我也不是很确定。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00590932903292166,"emotions":[],"relationId":"6af66cd4f442