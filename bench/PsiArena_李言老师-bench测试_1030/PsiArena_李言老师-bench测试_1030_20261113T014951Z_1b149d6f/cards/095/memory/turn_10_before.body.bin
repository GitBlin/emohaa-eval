ame":"信任","value":1,"sort":3},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af68254f4429d1fd72f8396","courseProgressId":0,"tsGen":1794540116735,"createTime":"2026-11-13 11:21:56","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6824ff4429d1fd72f8387","chatId":"d841d1b78be94459827389925ce79cff","sessionId":null,"userId":99907,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你的担心很正常，我先把这点说清楚：你说的话我会保密，不会告诉别人。只有涉及你或他人的安全风险时，我才会考虑找合适的人一起帮你，而且会先跟你讲。这样你会不会安心一些？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你的担心很正常，我先把这点说清楚：你说的话我会保密，不会告诉别人。只有涉及你或他人的安全风险时，我才会考虑找合适的人一起帮你，而且会先跟你讲。这样你会不会安心一些？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1850,"promptTokens":1859,"completionTokens":81,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:21:51"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005908098383386376,"emotions":[],"relationId":"6af6824ff4429d1fd72f8386","courseProgressId":0,"tsGen":1794540111991,"createTime":"2026-11-13 11:21:51","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6824ff4429d1fd72f8386","chatId":"d841d1b78be94459827389925ce79cff","sessionId":null,"userId":99907,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"大概是晚上吧……一个人待着的时候。刷手机刷着刷着，就感觉特别不对劲。对了，我想问一下，我在这儿说的话，你会告诉别人吗？<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"au