0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af6800ef4429d1fd72f8147","courseProgressId":0,"tsGen":1794539534789,"createTime":"2026-11-13 11:12:14","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6800af4429d1fd72f813d","chatId":"0f50918009a74949b02af42b35b1287c","sessionId":null,"userId":99893,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你说“可能想多了”，我倒觉得那一下的自我怀疑是真的。看到别人自律就觉得自己不行，这中间好像有个很快的评判在跑。你留意过吗——那时候你心里具体在对自己说什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你说“可能想多了”，我倒觉得那一下的自我怀疑是真的。看到别人自律就觉得自己不行，这中间好像有个很快的评判在跑。你留意过吗——那时候你心里具体在对自己说什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1981,"promptTokens":2149,"completionTokens":112,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:12:10"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691157388154971,"emotions":[],"relationId":"6af6800af4429d1fd72f813c","courseProgressId":0,"tsGen":1794539530451,"createTime":"2026-11-13 11:12:10","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6800af4429d1fd72f813c","chatId":"0f50918009a74949b02af42b35b1287c","sessionId":null,"userId":99893,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"呃……好像是有。就是平时吧，看到别人特别自律那种，我就会觉得自己不行。不过我也不确定，可能是我自己想多了。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691157388154971,"emotions":[{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"surprised","name":"惊讶","value":2,"sort":5},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6800af4429d1fd72f813d","courseProgressId":0,"tsGen":1794539530448,"createTime":"2026-11-13 11:12:10","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68004f4429d1fd72f8134","chatId":"0f50918009a74949b02af42b35b1287c","sessionId":null,"userId":99893,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不会觉得没什么好聊的。恰恰是这种说不上来的“毛毛的”，往往比明确的疼更值得好好看看。你能把它讲出来，已经是在认真对待自己了。我倒是想问一句——这种怕自己“不值得被认真对待”的感觉，平时在别的地方也出现过吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不会觉得没什么好聊的。恰恰是这种说不上来的“毛毛的”，往往比明确的疼更值得好好看看。你能把它讲出来，已经是在认真对待自己了。我倒是想问一句——这种怕自己“不值得被认真对待”的感觉，平时在别的地方也出现过吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2660,"promptTokens":2543,"completionTokens":152,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:12:04"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00970562506724029,"emotions":[],"relationId":"6af68004f4429d1fd72f8133","courseProgressId":0,"tsGen":1794539524161,"createTime":"2026-11-13 11:12:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68004f4429d1fd72f8133","chatId":"0f50918009a74949b02af42b35b1287c","sessionId":null,"userId":99893,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就……说不上来，好像也不是身体疼，就是心里毛毛的。哎，我这样是不是挺奇怪的？你们咨询师遇到我这种，会不会觉得没什么好聊的？<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00970562506724029,"emotions":[{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af68004f4429d1fd72f8134","courseProgressId":0,"tsGen":1794539524158,"createTime":"2026-11-13 11:12:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ffdf4429d1fd72f812b","chatId":"0f50918009a74949b02af42b35b1287c","sessionId":null,"userId":99893,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来那次身体的状况虽然过去了，可你心里好像还留着点什么没放下。你说的“哪儿不对劲”，更像是身体上的感觉，还是心里那种不踏实？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来那次身体的状况虽然过去了，可你心里好像还留着点什么没放下。你说的“哪儿不对劲”，更像是身体上的感觉，还是心里那种不踏实？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2290,"promptTokens":2024,"completionTokens":167,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:11:57"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705992205278234,"emotions":[],"relationId":"6af67ffdf4429d1fd72f812a","courseProgressId":0,"tsGen":1794539517773,"createTime":"2026-11-13 11:11:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ffdf4429d1fd72f812a","chatId":"0f50918009a74949b02af42b35b1287c","sessionId":null,"userId":99893,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……都有点吧。以前我身体出过点状况，瘦得挺厉害的，后来……反正现在体重是稳了，可我就是老觉得哪儿不对劲。算了，这个说起来挺长的。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705992205278234,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67ffdf4429d1fd72f812b","courseProgressId":0,"tsGen":1794539517770,"createTime":"2026-11-13 11:11:57","delFlag":0,"emotion