":5,"sort":4},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"happy","name":"快乐","value":2,"sort":1},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67ff8f4429d1fd72f811f","courseProgressId":0,"tsGen":1794539512715,"createTime":"2026-11-13 11:11:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ff3f4429d1fd72f8118","chatId":"0f50918009a74949b02af42b35b1287c","sessionId":null,"userId":99893,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你的顾虑很正常。这里说的内容我会保密，不会告诉别人。只有一种情况例外——如果你有伤害自己或别人的风险，我必须联系能帮到你的人。除此之外，都会留在我们之间。这样你会不会安心一点？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你的顾虑很正常。这里说的内容我会保密，不会告诉别人。只有一种情况例外——如果你有伤害自己或别人的风险，我必须联系能帮到你的人。除此之外，都会留在我们之间。这样你会不会安心一点？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1607,"promptTokens":1778,"completionTokens":79,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:11:47"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575163400692714,"emotions":[],"relationId":"6af67ff3f4429d1fd72f8117","courseProgressId":0,"tsGen":1794539507952,"createTime":"2026-11-13 11:11:47","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ff3f4429d1fd72f8117","chatId":"0f50918009a74949b02af42b35b1287c","sessionId":null,"userId":99893,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"那……那我随便说说吧。其实我也说不清自己到底怎么了，就是最近老觉得心里堵得慌。对了，你们做咨询的，会不会把我说的这些告诉别人啊？<第3轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":6,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575163400692714,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67ff3f4429d1fd72f8118","courseProgressId":0,"tsGen":1794539507949,"createTime":"2026-11-13 11:11:47","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67feef4429d1fd72f810e","chatId":"0f50918009a74949b02af42b35b1287c","sessionId":null,"userId":99893,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不用特意准备什么，你就按自己舒服的节奏说，想停就停，我不会追问你不想讲的部分。这里也没有标准答案，聊到哪儿算哪儿。那你是想先说说最近让你心里有点堵的事，还是先随便聊点别的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不用特意准备什么，你就按自己舒服的节奏说，想停就停，我不会追问你不想讲的部分。这里也没有标准答案，聊到哪儿算哪儿。那你是想先说说最近让你心里有点堵的事，还是先随便聊点别的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2158,"promptTokens":1637,"completionTokens":93,"responseSource":"age