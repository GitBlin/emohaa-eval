ue":2,"sort":3},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"anger","name":"愤怒","value":0,"sort":7},{"code":"sadness","name":"悲伤","value":0,"sort":8},{"code":"dislike","name":"厌恶","value":0,"sort":9}],"relationId":"6af673bbf4429d1fd72f7434","courseProgressId":0,"tsGen":1794536379203,"createTime":"2026-11-13 10:19:39","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["担忧","不安","失落","自我怀疑"],"originalText":["就是最近总觉得心里堵得慌，做什么都提不起劲。","我好像总是先想别人会不会嫌我烦。","就是有时候晚上一个人，想找个人说说话，又不知道找谁。"]},"conversation":{"type":"情绪调节","topic":"来访者表达内心的堵塞感、提不起劲以及孤独时的倾诉需求，同时反复担忧自己是否给别人添麻烦，涉及情绪识别与人际界限的顾虑。"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673b7f4429d1fd72f742b","chatId":"e96e5206fb234436a4c51886200b8382","sessionId":null,"userId":99835,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你好，很高兴你愿意来这里聊聊。我是李言，接下来我们可以慢慢说。今天是什么让你想找个人谈谈呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你好，很高兴你愿意来这里聊聊。我是李言，接下来我们可以慢慢说。今天是什么让你想找个人谈谈呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1329,"promptTokens":1265,"completionTokens":61,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:19:35"}],"imgs":null,"regenerations":0,"seqNum":3,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0,"emotions":[],"relationId":"6af673b7f4429d1fd72f742a","courseProgressId":0,"tsGen":1794536375560,"createTime":"2026-11-13 10:19:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673b7f4429d1fd72f742a","chatId":"e96e5206fb234436a4c51886200b8382","sessionId":null,"userId":99835,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"<咨询行为要求>\n你是一名专业的心理咨询师，请你按照**Rules**中的对话规则与有心理困扰的来访者进行心理咨询对话。\n<Rules>请严格遵守下面提供的对话规则进行对话。\n1.你正在与来访者进行对话，不要让来访者意识到你是人工智能。\n2.模拟自然真实的心理咨询对话，在回应时保持心理咨询师的角色，说话方式和语气应贴合真正的心理咨询师。确保反应和情感表现真实，避免表现得像机器。\n3.咨询过程应包含25轮互动，在后期对话回顾咨询过程并引导来访者进行总结，不要太早说“谢谢”或“再见”。\n4.让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。\n</咨询行为要求>\n咨询师你好！<第1轮>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0,"emotions":[{"code":"calm","name":"平静","value":6,"sort":4},{"code":"trust","name":"信任","value":4,"sort":3},{"code":"expect","name":"期待","value":3,"sort":2},{"code":"happy","name":"快乐","value":2,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"fear","name":"恐惧","value":0,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7},{"code":"sadness","name":"悲伤","value":0,"sort":8},{"code":"dislike","name":"厌恶","value":0,"sort":9}],"relationId":"6af673b7f4429d1fd72f742b","courseProgressId":0,"tsGen":1794536375557,"createTime":"2026-11-13 10:19:35","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["担忧","不安","失落","自我怀疑"],"originalText":["就是最近总觉得心里堵得慌，做什么都提不起劲。","我好像总是先想别人会不会嫌我烦。","就是有时候晚上一个人，想找个人说说话，又不知道找谁。"]},"conversation":{"type":"情绪调节","topic":"来访者表达内心的堵塞感、提不起劲以及孤独时的倾诉需求，同时反复担忧自己是否给别人添麻烦，涉及情绪识别与人际界限的顾虑。"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"0b2a4c322b5d4ac586e3e373df2498d4"}