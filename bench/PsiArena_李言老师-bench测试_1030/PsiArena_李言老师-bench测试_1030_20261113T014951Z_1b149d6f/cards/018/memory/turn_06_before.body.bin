rust","name":"信任","value":7,"sort":3},{"code":"happy","name":"快乐","value":6,"sort":1},{"code":"calm","name":"平静","value":6,"sort":4},{"code":"expect","name":"期待","value":5,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"fear","name":"恐惧","value":0,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7},{"code":"sadness","name":"悲伤","value":0,"sort":8},{"code":"dislike","name":"厌恶","value":0,"sort":9}],"relationId":"6af67025f4429d1fd72f6e61","courseProgressId":0,"tsGen":1794535461969,"createTime":"2026-11-13 10:04:21","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"4bb56e49dd1046ce9648995661cc8bda"}