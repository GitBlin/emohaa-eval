34","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67866f4429d1fd72f7a97","chatId":"ae315d85b02b4095a692ed7e6105f582","sessionId":null,"userId":99861,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"哦……这样。那，我说了你会保密吧？我是说，不会跟我公司或者家里人说之类的？<第3轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":6,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006690648778606646,"emotions":[{"code":"trust","name":"信任","value":4,"sort":3},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"sadness","name":"悲伤","value":1,"sort":8},{"code":"dislike","name":"厌恶","value":1,"sort":9},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67866f4429d1fd72f7a98","courseProgressId":0,"tsGen":1794537574665,"createTime":"2026-11-13 10:39:34","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["不确定","担心","慌","后悔","心里堵","害怕"],"originalText":["就是最近心里堵得慌，也说不上来为什么。","我怕说出来你会觉得我这人有点问题。","第一反应……有点慌。就觉得，是不是我这个人真的哪里不对劲。","但说完我又有点后悔，好像承认了似的。","有时候半夜会想，万一那分数是真的呢？"]},"conversation":{"type":"焦虑和恐惧","topic":"来访者对网上心理量表高分结果感到担忧和焦虑，担心自己心理有问题，并纠结是否该重视测试结果。"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67862f4429d1fd72f7a95","chatId":"ae315d85b02b4095a692ed7e6105f582","sessionId":null,"userId":99861,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不太确定该不该来，这很正常，很多第一次来的人都会有这样的犹豫。咨询大概就是你讲讲你的感受，我陪你一起看看这些感受背后是什么，不需要你提前准备什么。你想先从哪儿说起都行。","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不太确定该不该来，这很正常，很多第一次来的人都会有这样的犹豫。咨询大概就是你讲讲你的感受，我陪你一起看看这些感受背后是什么，不需要你提前准备什么。你想先从哪儿说起都行。","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1660,"promptTokens":1633,"completionTokens":75,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:39:30"}],"imgs":null,"regenerations":0,"seqNum":5,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002182637118341816,"emotions":[],"relationId":"6af67862f4429d1fd72f7a94","courseProgressId":0,"tsGen":1794537570196,"createTime":"2026-11-13 10:39:30","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67862f4429d1fd72f7a94","chatId":"ae315d85b02b4095a692ed7e6105f582","sessionId":null,"userId":99861,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……你好。说实话，我不太确定自己该不该来。就是想先问问，你们这个咨询一般是怎么进行的？我需要做什么？<第2轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":4,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002182637118341816,"emotions":[{"code":"calm","name":"平静","value":5,"sort":4},{"code":"expect","name":"期待","value":3,"sort":2},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"happy","name":"快乐","value":1,"sort":1},{"code