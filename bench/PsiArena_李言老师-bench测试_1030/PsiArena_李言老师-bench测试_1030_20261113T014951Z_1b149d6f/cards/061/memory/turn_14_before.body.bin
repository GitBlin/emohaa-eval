{"success":true,"code":"000","message":null,"data":{"totalAmount":26,"totalPageCount":1,"pageNum":0,"itemCount":26,"content":[{"pageNum":0,"pageSize":0,"id":"6af6789cf4429d1fd72f7ad3","chatId":"ae315d85b02b4095a692ed7e6105f582","sessionId":null,"userId":99861,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"修东西、拼模型的时候能踏实一点——这可不是“不算什么事”，反而挺重要：那是你少数不拿尺子量自己的时刻。手上有具体的东西，做好就是做好了。拼模型的时候，你脑子里还会冒出“哪里还不够”吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"修东西、拼模型的时候能踏实一点——这可不是“不算什么事”，反而挺重要：那是你少数不拿尺子量自己的时刻。手上有具体的东西，做好就是做好了。拼模型的时候，你脑子里还会冒出“哪里还不够”吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2022,"promptTokens":3299,"completionTokens":105,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:40:28"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010986148439073218,"emotions":[],"relationId":"6af6789cf4429d1fd72f7ad2","courseProgressId":0,"tsGen":1794537628357,"createTime":"2026-11-13 10:40:28","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6789cf4429d1fd72f7ad2","chatId":"ae315d85b02b4095a692ed7e6105f582","sessionId":null,"userId":99861,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（想了很久）踏实……好像真说不太出来。硬要说的话，周末修修东西、拼个模型的时候，会稍微好一点。不过那个也不算什么事。<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":26,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010986148439073218,"emotions":[],"relationId":"6af6789cf4429d1fd72f7ad3","courseProgressId":0,"tsGen":1794537628354,"createTime":"2026-11-13 10:40:28","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67896f4429d1fd72f7ace","chatId":"ae315d85b02b4095a692ed7e6105f582","sessionId":null,"userId":99861,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不知道“够了”是什么感觉，听起来有点让人心里发酸——你不是不够好，是那把尺子从来没让你停下来过。那我们换个方向：有没有哪件事，哪怕很小，你做完心里是踏实的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不知道“够了”是什么感觉，听起来有点让人心里发酸——你不是不够好，是那把尺子从来没让你停下来过。那我们换个方向：有没有哪件事，哪怕很小，你做完心里是踏实的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2738,"promptTokens":3318,"completionTokens":133,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:40:22"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0059095907992433245,"emotions":[],"relationId":"6af67896f4429d1fd72f7acd","courseProgressId":0,"tsGen":1794537622383,"createTime":"2026-11-13 10:40:22","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67896f4429d1fd72f7acd","chatId":"ae315d85b02b4095a692ed7e6105f582","sessionId":null,"userId":99861,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"第一个念头……基本总是“哪里还不够”。很少会觉得“还行”。（苦笑）说出来有点怪，我好像根本不知道“够了”是什么感觉。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0059095907992433245,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"surprised","name":"惊讶","value":2,"sort":5},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67896f4429d1fd72f7ace","courseProgressId":0,"tsGen":1794537622380,"createTime":"2026-11-13 10:40:22","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67891f4429d1fd72f7ac3","chatId":"ae315d85b02b4095a692ed7e6105f582","sessionId":null,"userId":99861,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"改到半夜、别人说可以了还是不踏实，这把尺子好像从来不在别人手里，一直在你自己心里。做完一件事，你心里冒出来的第一个念头，通常是“还行”，还是“哪里还不够”？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"改到半夜、别人说可以了还是不踏实，这把尺子好像从来不在别人手里，一直在你自己心里。做完一件事，你心里冒出来的第一个念头，通常是“还行”，还是“哪里还不够”？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2172,"promptTokens":2591,"completionTokens":109,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:40:17"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009707427650332709,"emotions":[],"relationId":"6af67891f4429d1fd72f7ac2","courseProgressId":0,"tsGen":1794537617331,"createTime":"2026-11-13 10:40:17","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67891f4429d1fd72f7ac2","chatId":"ae315d85b02b4095a692ed7e6105f582","sessionId":null,"userId":99861,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（停顿）你这么一说……好像是。我写代码，一个地方不满意能改到半夜，明明可以交了还是放不下。别人说可以了，我心里就是不踏实。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009707427650332709,"emotions":[{"code":"calm","name":"平静","value":4,"sort":4},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"surprised","name":"惊讶","value":3,"sort":5},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"sadness","name":"悲伤","value":1,"sort":8},{"code":"dislike","name":"厌恶","value":1,"sort":9},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67891f4429d1fd72f7ac3","courseProgressId":0,"tsGen":1794537617328,"createTime":"2026-11-13 10:40:17","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6788cf4429d1fd72f7ac0","chatId":"ae315d85b02b4095a692ed7e6105f582","sessionId":null,"userId":99861,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听你这么说，我有点明白了——从小被这样量着长大，很容易把“我做到了什么”当成“我是谁”。你现在的累，可能不只是加班累。工作里，你是不是也还在用同一把尺子量自己？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听你这么说，我有点明白了——从小被这样量着长大，很容易把“我做到了什么”当成“我是谁”。你现在的累，可能不只是加班累。工作里，你是不是也还在用同一把尺子量自己？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2482,"promptTokens":3188,"completionTokens":149,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:40:12"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.029305671560907912,"emotions":[],"relationId":"6af6788cf4429d1fd72f7abf","courseProgressId":0,"tsGen":1794537612479,"createTime":"2026-11-13 10:40:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6788cf4429d1fd72f7abf","chatId":"ae315d85b02b4095a692ed7e6105f582","sessionId":null,"userId":99861,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"说了也没用吧……更难受。我从小就这样，考好了他们高兴，考砸了就是我不够努力。好像我这个人怎么样不重要，重要的是我做到了什么。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.029305671560907912,"emotions":[{"code":"sadness","name":"悲伤","value":7,"sort":8},{"code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af6788cf4429d1fd72f7ac0","courseProgressId":0,"tsGen":1794537612476,"createTime":"2026-11-13 10:40:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67884f4429d1fd72f7ab7","chatId":"ae315d85b02b4095a692ed7e6105f582","sessionId":null,"userId":99861,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"爸妈那句“别想太多”，听起来像安慰，其实是把话堵回去了。你想说的没人接住，久了就自己咽下去，难怪会堵。一个人扛着这些的时候，最难受的是没人接住，还是说了也没用？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"爸妈那句“别想太多”，听起来像安慰，其实是把话堵回去了。你想说的没人接住，久了就自己咽下去，难怪会堵。一个人扛着这些的时候，最难受的是没人接住，还是说了也没用？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1941,"promptTokens":3059,"completionTokens":100,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:40:04"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691050747020821,"emotions":[],"relationId":"6af67884f4429d1fd72f7ab6","courseProgressId":0,"tsGen":1794537604916,"createTime":"2026-11-13 10:40:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67884f4429d1fd72f7ab6","chatId":"ae315d85b02b4095a692ed7e6105f582","sessionId":null,"userId":99861,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"基本都是一个人。加班回家就挺晚了，室友早睡了。其实……我好像也没什么能说这些的人。家里更不行，我爸妈要是知道了，估计只会说“别想太多，好好工作”。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691050747020821,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67884f4429d1fd72f7ab7","courseProgressId":0,"tsGen":1794537604913,"createTime":"2026-11-13 10:40:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6787ef4429d1fd72f7ab0","chatId":"ae315d85b02b4095a692ed7e6105f582","sessionId":null,"userId":99861,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"白天和半夜像是两个你在说话，一个想把它推开，一个又忍不住当真。其实两个声音都在意同一件事。那种半夜冒出念头的时候，你通常是一个人待着吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"白天和半夜像是两个你在说话，一个想把它推开，一个又忍不住当真。其实两个声音都在意同一件事。那种半夜冒出念头的时候，你通常是一个人待着吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2342,"promptTokens":2358,"completionTokens":106,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:39:58"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.033077622735815444,"emotions":[],"relationId":"6af6787ef4429d1fd72f7aaf","courseProgressId":0,"tsGen":1794537598324,"createTime":"2026-11-13 10:39:58","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6787ef4429d1fd72f7aaf","chatId":"ae315d85b02b4095a692ed7e6105f582","sessionId":null,"userId":99861,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"我……说不好。可能两个都有吧。有时候半夜会想，万一那分数是真的呢？但白天又觉得，不就是个测试嘛，可能不准。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.033077622735815444,"emotions":[{"code":"calm","name":"平静","value":5,"sort":4},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"sadness","name":"悲伤","value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6787ef4429d1fd72f7ab0","courseProgressId":0,"tsGen":1794537598321,"createTime":"2026-11-13 10:39:58","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["不确定","担心","慌","后悔","心里堵","害怕"],"originalText":["就是最近心里堵得慌，也说不上来为什么。","我怕说出来你会觉得我这人有点问题。","第一反应……有点慌。就觉得，是不是我这个人真的哪里不对劲。","但说完我又有点后悔，好像承认了似的。","有时候半夜会想，万一那分数是真的呢？"]},"conversation":{"type":"焦虑和恐惧","topic":"来访者对网上心理量表高分结果感到担忧和焦虑，担心自己心理有问题，并纠结是否该重视测试结果。"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67878f4429d1fd72f7aac","chatId":"ae315d85b02b4095a692ed7e6105f582","sessionId":null,"userId":99861,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"说出口的那一刻会后悔，我懂。可你刚才说的，不是在承认自己“有问题”，更像是承认自己一个人扛了很久。这两者不太一样。那份后悔里，你更怕的是我拿这个分数来评判你，还是怕自己真的信了它？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"说出口的那一刻会后悔，我懂。可你刚才说的，不是在承认自己“有问题”，更像是承认自己一个人扛了很久。这两者不太一样。那份后悔里，你更怕的是我拿这个分数来评判你，还是怕自己真的信了它？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2150,"promptTokens":2227,"completionTokens":154,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:39:52"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608853997106548,"emotions":[],"relationId":"6af67878f4429d1fd72f7aab","courseProgressId":0,"tsGen":1794537592706,"createTime":"2026-11-13 10:39:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67878f4429d1fd72f7aab","chatId":"ae315d85b02b4095a692ed7e6105f582","sessionId":null,"userId":99861,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"第一反应……有点慌。就觉得，是不是我这个人真的哪里不对劲。但说完我又有点后悔，好像承认了似的。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608853997106548,"emotions":[{"code":"fear","name":"恐惧","value":6,"sort":6},{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"surprised","name":"惊讶","value":2,"sort":5},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67878f4429d1fd72f7aac","courseProgressId":0,"tsGen":1794537592703,"createTime":"2026-11-13 10:39:52","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["不确定","担心","慌"