{"success":true,"code":"000","message":null,"data":{"totalAmount":8,"totalPageCount":1,"pageNum":0,"itemCount":8,"content":[{"pageNum":0,"pageSize":0,"id":"6af6786bf4429d1fd72f7a9f","chatId":"ae315d85b02b4095a692ed7e6105f582","sessionId":null,"userId":99861,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"心里堵得慌，却说不清为什么，这种感觉确实挺让人无措的。那这种“堵”是有个具体的时间点开始的，还是慢慢积累起来的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"心里堵得慌，却说不清为什么，这种感觉确实挺让人无措的。那这种“堵”是有个具体的时间点开始的，还是慢慢积累起来的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1673,"promptTokens":1880,"completionTokens":86,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:39:39"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010983296056845891,"emotions":[],"relationId":"6af6786bf4429d1fd72f7a9e","courseProgressId":0,"tsGen":1794537579242,"createTime":"2026-11-13 10:39:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6786bf4429d1fd72f7a9e","chatId":"ae315d85b02b4095a692ed7e6105f582","sessionId":null,"userId":99861,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"都有一点吧……公司那边倒还好，就是家里人，他们不太信这个。其实我也说不太清自己到底怎么了，就是最近心里堵得慌，也说不上来为什么。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010983296056845891,"emotions":[],"relationId":"6af6786bf4429d1