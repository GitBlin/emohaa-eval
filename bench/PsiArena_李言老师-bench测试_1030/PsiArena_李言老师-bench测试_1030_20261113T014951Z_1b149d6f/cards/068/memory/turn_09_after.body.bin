:"dislike","name":"厌恶","value":5,"sort":9},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67a0ff4429d1fd72f7c94","courseProgressId":0,"tsGen":1794537999391,"createTime":"2026-11-13 10:46:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67a0bf4429d1fd72f7c87","chatId":"f3ade68ab20545b6a074a2688c19d657","sessionId":null,"userId":99873,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"说不清具体原因也很正常，很多难受在刚出现时都是模糊的。我们可以先不急着找原因，从身体感受入手。你回想最近一次突然难受时，身体最先出现的是什么感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"说不清具体原因也很正常，很多难受在刚出现时都是模糊的。我们可以先不急着找原因，从身体感受入手。你回想最近一次突然难受时，身体最先出现的是什么感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1715,"promptTokens":1869,"completionTokens":76,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:46:35"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575429436510497,"emotions":[],"relationId":"6af67a0bf4429d1fd72f7c86","courseProgressId":0,"tsGen":1794537995047,"createTime":"2026-11-13 10:46:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67a0bf4429d1fd72f7c86","chatId":"f3ade68ab20545b6a074a2688c19d657","sessionId":null,"userId":99873,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"说实话我也说不清楚。就是……有时