,{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"expect","name":"期待","value":3,"sort":2},{"code":"anger","name":"愤怒","value":3,"sort":7},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af677c0f4429d1fd72f79ef","courseProgressId":0,"tsGen":1794537408784,"createTime":"2026-11-13 10:36:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af677b9f4429d1fd72f79df","chatId":"90e893ef53e64b078494ca0357c9ee7d","sessionId":null,"userId":99859,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"被亲近的人说“想太多”，那种感觉像是自己的紧张没被当真，反而成了毛病，难受是很自然的。她说这话的时候，你心里最想让她明白的是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"被亲近的人说“想太多”，那种感觉像是自己的紧张没被当真，反而成了毛病，难受是很自然的。她说这话的时候，你心里最想让她明白的是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1795,"promptTokens":2648,"completionTokens":86,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:36:41"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.017984289833427033,"emotions":[],"relationId":"6af677b9f4429d1fd72f79de","courseProgressId":0,"tsGen":1794537401210,"createTime":"2026-11-13 10:36:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af677b9f4429d1fd72f79de","chatId":"90e893ef53e64b078494ca0357c9ee7d","sessionId":null,"userId":99859,"orgId":3721,"botId":1030,"isGreeting":false,"