islike","name":"厌恶","value":6,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"surprised","name":"惊讶","value":2,"sort":5},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"calm","name":"平静","value":0,"sort":4}],"relationId":"6af677b9f4429d1fd72f79df","courseProgressId":0,"tsGen":1794537401207,"createTime":"2026-11-13 10:36:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af677b1f4429d1fd72f79d7","chatId":"90e893ef53e64b078494ca0357c9ee7d","sessionId":null,"userId":99859,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"还没开口，脑子里已经先演了一遍别人笑你的样子——那种提前绷紧的感觉，挺累人的。这种“怕说错”的念头，在跟女朋友说话时也会冒出来吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"还没开口，脑子里已经先演了一遍别人笑你的样子——那种提前绷紧的感觉，挺累人的。这种“怕说错”的念头，在跟女朋友说话时也会冒出来吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2036,"promptTokens":1985,"completionTokens":72,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:36:33"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005910387207254454,"emotions":[],"relationId":"6af677b1f4429d1fd72f79d6","courseProgressId":0,"tsGen":1794537393931,"createTime":"2026-11-13 10:36:33","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af677b1f4429d1fd72f79d6","chatId":"90e893ef53e64b078494ca0357c9ee7d","sessionId":null,"userId":99859,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是……怕自己说错，怕他们觉得我说得没水平。有时候还没开口，脑子里就已经在想他们会不会笑我了。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005910387207254454,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af677b1f4429d1fd72f79d7","courseProgressId":0,"tsGen":1794537393928,"createTime":"2026-11-13 10:36:33","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af677aaf4429d1fd72f79cc","chatId":"90e893ef53e64b078494ca0357c9ee7d","sessionId":null,"userId":99859,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"我不会觉得你小题大做。那种被人看着、被人评价的紧张，是真实存在的，不是你想多了。你能把它说出来，本身就需要一点勇气。课堂发言的时候，你脑子里最先冒出来的念头通常是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我不会觉得你小题大做。那种被人看着、被人评价的紧张，是真实存在的，不是你想多了。你能把它说出来，本身就需要一点勇气。课堂发言的时候，你脑子里最先冒出来的念头通常是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2192,"promptTokens":2417,"completionTokens":120,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:36:26"}],"img