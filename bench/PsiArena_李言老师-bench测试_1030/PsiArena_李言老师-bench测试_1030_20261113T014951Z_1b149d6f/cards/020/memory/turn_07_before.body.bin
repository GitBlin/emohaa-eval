e":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"anger","name":"愤怒","value":3,"sort":7},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af670e6f4429d1fd72f6f95","courseProgressId":0,"tsGen":1794535654743,"createTime":"2026-11-13 10:07:34","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af670e2f4429d1fd72f6f90","chatId":"3b14e5f6c344443b83154462eb1fad86","sessionId":null,"userId":99801,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"没关系，不用一次讲清楚，我们可以慢慢来。你说在家里总得小心点，这种感觉一定挺耗人的。那最近一次让你喘不过气，大概是什么时候、当时发生了什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"没关系，不用一次讲清楚，我们可以慢慢来。你说在家里总得小心点，这种感觉一定挺耗人的。那最近一次让你喘不过气，大概是什么时候、当时发生了什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1668,"promptTokens":1972,"completionTokens":85,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:07:30"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005910537063242846,"emotions":[],"relationId":"6af670e2f4429d1fd72f6f8f","courseProgressId":0,"tsGen":1794535650839,"createTime":"2026-11-13 10:07:30","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af670e2f4429d1fd72f6f8f","chatId":"3b14e5f6c344443b83154462eb1fad86","sessionId":null,"userId