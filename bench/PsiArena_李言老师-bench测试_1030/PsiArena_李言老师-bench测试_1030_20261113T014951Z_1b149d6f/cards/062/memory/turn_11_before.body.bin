{"success":true,"code":"000","message":null,"data":{"totalAmount":20,"totalPageCount":1,"pageNum":0,"itemCount":20,"content":[{"pageNum":0,"pageSize":0,"id":"6af678b6f4429d1fd72f7afb","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“别人都干着，怎么就我撑不住”——这句话听着不像在问，倒像在责备自己。可你每天两百公里、十多个小时，这是实实在在的重，不是谁扛不住的问题。这种“是不是我不够好”的念头，以前也常冒出来吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“别人都干着，怎么就我撑不住”——这句话听着不像在问，倒像在责备自己。可你每天两百公里、十多个小时，这是实实在在的重，不是谁扛不住的问题。这种“是不是我不够好”的念头，以前也常冒出来吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2209,"promptTokens":3131,"completionTokens":150,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:40:54"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.020325674216601412,"emotions":[],"relationId":"6af678b6f4429d1fd72f7afa","courseProgressId":0,"tsGen":1794537654347,"createTime":"2026-11-13 10:40:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678b6f4429d1fd72f7afa","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"跟谁说都难开口……其实我心里也犯嘀咕，是不是我太没用了。别人不都这么干着吗，怎么就我撑不住？<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.020325674216601412,"emotions":[],"relationId":"6af678b6f4429d1fd72f7afb","courseProgressId":0,"tsGen":1794537654344,"createTime":"2026-11-13 10:40:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678b2f4429d1fd72f7af0","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"夹在父母认定的“稳定”和你自己的状态中间，确实挺难的，好像一开口就成了不懂事的那一个。那如果真要迈出请假这一步，你觉得最先能跟谁说、或者怎么开这个口，会稍微没那么难？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"夹在父母认定的“稳定”和你自己的状态中间，确实挺难的，好像一开口就成了不懂事的那一个。那如果真要迈出请假这一步，你觉得最先能跟谁说、或者怎么开这个口，会稍微没那么难？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2511,"promptTokens":2365,"completionTokens":161,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:40:50"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.017981595821168175,"emotions":[],"relationId":"6af678b2f4429d1fd72f7aef","courseProgressId":0,"tsGen":1794537650431,"createTime":"2026-11-13 10:40:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678b2f4429d1fd72f7aef","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"为难……是挺为难的。我爸妈那辈人，就认“稳定”两个字，从小就跟我说，有份正经工作比啥都强。我要是说想请假，他们第一个不理解。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.017981595821168175,"emotions":[],"relationId":"6af678b2f4429d1fd72f7af0","courseProgressId":0,"tsGen":1794537650428,"createTime":"2026-11-13 10:40:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678abf4429d1fd72f7ae9","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"我一点不觉得这是偷懒。撑了半年还硬扛着，想请假去看病，那是身体在报警，不是躲。倒是你家里指望你这份工作，这事让你挺为难吧？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我一点不觉得这是偷懒。撑了半年还硬扛着，想请假去看病，那是身体在报警，不是躲。倒是你家里指望你这份工作，这事让你挺为难吧？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1918,"promptTokens":2912,"completionTokens":70,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:40:43"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.06750963487079549,"emotions":[],"relationId":"6af678abf4429d1fd72f7ae8","courseProgressId":0,"tsGen":1794537643712,"createTime":"2026-11-13 10:40:43","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678abf4429d1fd72f7ae8","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"继续干？我也不知道……有时候真想一走了之，可又不敢。这工作再不好，好歹是个铁饭碗，家里也指望着。唉，我要是说想请假去治病，你会不会也觉得我是想偷懒？<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.06750963487079549,"emotions":[],"relationId":"6af678abf4429d1fd72f7ae9","courseProgressId":0,"tsGen":1794537643710,"createTime":"2026-11-13 10:40:43","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678a7f4429d1fd72f7adf","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"两百公里、十多个小时，换来的是一千九——这数字听着都让人心里发沉，你还说自己可笑，我倒觉得一点都不可笑。这样的日子撑了半年，光是每天上路就已经很不容易了。这份工作，你还有打算继续干下去吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"两百公里、十多个小时，换来的是一千九——这数字听着都让人心里发沉，你还说自己可笑，我倒觉得一点都不可笑。这样的日子撑了半年，光是每天上路就已经很不容易了。这份工作，你还有打算继续干下去吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2004,"promptTokens":2088,"completionTokens":109,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:40:39"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006690997108613798,"emotions":[],"relationId":"6af678a7f4429d1fd72f7ade","courseProgressId":0,"tsGen":1794537639180,"createTime":"2026-11-13 10:40:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678a7f4429d1fd72f7ade","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最压着的……还是工作吧。每天来回两百公里，干十多个小时，到手就一千九。说出来都觉得可笑。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006690997108613798,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"anger","name":"愤怒","value":4,"sort":7},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"surprised","name":"惊讶","value":2,"sort":5},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2}],"relationId":"6af678a7f4429d1fd72f7adf","courseProgressId":0,"tsGen":1794537639177,"createTime":"2026-11-13 10:40:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678a1f4429d1fd72f7add","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"我不会直接给你一个“该怎么办”的答案，更多是陪你把这种累拆开看看——是哪些事压着，又是什么让你提不起劲，然后一起找能松一松的地方。你觉得，眼下最压着你的，是哪件事？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我不会直接给你一个“该怎么办”的答案，更多是陪你把这种累拆开看看——是哪些事压着，又是什么让你提不起劲，然后一起找能松一松的地方。你觉得，眼下最压着你的，是哪件事？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2743,"promptTokens":2521,"completionTokens":134,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:40:33"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.017980283675083263,"emotions":[],"relationId":"6af678a1f4429d1fd72f7adc","courseProgressId":0,"tsGen":1794537633052,"createTime":"2026-11-13 10:40:33","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678a1f4429d1fd72f7adc","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"两个都有吧……事情压着，可我又不想动，什么都不想干。哎，我问一下——像这种情况，你们一般会怎么帮人？<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.017980283675083263,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af678a1f4429d1fd72f7add","courseProgressId":0,"tsGen":1794537633049,"createTime":"2026-11-13 10:40:33","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6789cf4429d1fd72f7ad1","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"小半年这么熬下来，人确实会被一点点磨空。我听着，这种累好像不全是身体上的，更像心里那根弦一直松不下来。你说的“熬着”，是事情太多撑不住，还是做什么都提不起劲？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"小半年这么熬下来，人确实会被一点点磨空。我听着，这种累好像不全是身体上的，更像心里那根弦一直松不下来。你说的“熬着”，是事情太多撑不住，还是做什么都提不起劲？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2225,"promptTokens":1966,"completionTokens":115,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:40:28"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01590176105937235,"emotions":[],"relationId":"6af6789cf4429d1fd72f7ad0","courseProgressId":0,"tsGen":1794537628080,"createTime":"2026-11-13 10:40:28","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6789cf4429d1fd72f7ad0","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"说不好，可能……小半年了吧。就是一天天熬着，也说不上具体哪天开始的。反正每天就是上班、下班，来回折腾，人跟散了架一样。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01590176105937235,"emotions":[],"relationId":"6af6789cf4429d1fd72f7ad1","courseProgressId":0,"tsGen":1794537628077,"createTime":"2026-11-13 10:40:28","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67895f4429d1fd72f7ac9","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来这种累不是睡一觉就能缓过来的那种。你愿意说说，这种感觉大概是从什么时候开始的吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来这种累不是睡一觉就能缓过来的那种。你愿意说说，这种感觉大概是从什么时候开始的吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1893,"promptTokens":1863,"completionTokens":77,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:40:21"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006690773492771462,"emotions":[],"relationId":"6af67895f4429d1fd72f7ac8","courseProgressId":0,"tsGen":1794537621455,"createTime":"2026-11-13 10:40:21","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67895f4429d1fd72f7ac8","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……那还行。其实我也说不太清楚自己怎么了，就是最近老觉得累，早上起来一点劲都没有。也不知道从哪儿说起。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006690773492771462,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2}