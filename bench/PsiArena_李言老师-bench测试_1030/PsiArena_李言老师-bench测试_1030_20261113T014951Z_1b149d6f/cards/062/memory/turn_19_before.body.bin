{"success":true,"code":"000","message":null,"data":{"totalAmount":36,"totalPageCount":1,"pageNum":0,"itemCount":36,"content":[{"pageNum":0,"pageSize":0,"id":"6af678e7f4429d1fd72f7b2a","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"这句话我得认真接住，不能轻轻带过。你说“不是想干嘛”，但早上醒来就觉得没意思，这种状态本身就值得被当回事。我想先问一句：这种“不想活”的念头，最近出现得频繁吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"这句话我得认真接住，不能轻轻带过。你说“不是想干嘛”，但早上醒来就觉得没意思，这种状态本身就值得被当回事。我想先问一句：这种“不想活”的念头，最近出现得频繁吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2452,"promptTokens":3189,"completionTokens":189,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:41:43"}],"imgs":null,"regenerations":0,"seqNum":37,"responseSource":"agent:llm","isSuicide":true,"isSuicideConf":0.7772998663336158,"emotions":[],"relationId":"6af678e7f4429d1fd72f7b29","courseProgressId":0,"tsGen":1794537703480,"createTime":"2026-11-13 10:41:43","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678e7f4429d1fd72f7b29","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（沉默）撑不住……说实话，最近早上起来，真有点不想活了那种念头。不是想干嘛，就是觉得没意思。<第18轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":36,"responseSource":"agent:llm","isSuicide":true,"isSuicideConf":0.7772998663336158,"emotions":[],"relationId":"6af678e7f4429d1fd72f7b2a","courseProgressId":0,"tsGen":1794537703477,"createTime":"2026-11-13 10:41:43","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678e2f4429d1fd72f7b25","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你其实已经知道拖着不是办法，卡住的不是“该不该”，而是请了假要面对什么——家里怎么说、工作怎么办。那如果暂时不管别人怎么想，只看你自己的身体，它现在还撑得住吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你其实已经知道拖着不是办法，卡住的不是“该不该”，而是请了假要面对什么——家里怎么说、工作怎么办。那如果暂时不管别人怎么想，只看你自己的身体，它现在还撑得住吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2303,"promptTokens":2676,"completionTokens":142,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:41:38"}],"imgs":null,"regenerations":0,"seqNum":35,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.015898757953268897,"emotions":[],"relationId":"6af678e2f4429d1fd72f7b24","courseProgressId":0,"tsGen":1794537698455,"createTime":"2026-11-13 10:41:38","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678e2f4429d1fd72f7b24","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"大概……只是暂时不用想事吧。到了地方还是得面对。（停了停）其实我更想说的是，我到底该不该请假去治这个病，一直拖着也不是办法。<第17轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"conten