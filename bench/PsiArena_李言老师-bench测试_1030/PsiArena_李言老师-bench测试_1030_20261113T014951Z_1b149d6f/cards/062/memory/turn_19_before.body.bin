kens":2912,"completionTokens":70,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:40:43"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.06750963487079549,"emotions":[],"relationId":"6af678abf4429d1fd72f7ae8","courseProgressId":0,"tsGen":1794537643712,"createTime":"2026-11-13 10:40:43","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678abf4429d1fd72f7ae8","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"继续干？我也不知道……有时候真想一走了之，可又不敢。这工作再不好，好歹是个铁饭碗，家里也指望着。唉，我要是说想请假去治病，你会不会也觉得我是想偷懒？<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.06750963487079549,"emotions":[{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af678abf4429d1fd72f7ae9","courseProgressId":0,"tsGen":1794537643710,"createTime":"2026-11-13 10:40:43","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678a7f4429d1fd72f7adf","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"两百公里、十多个小时，换来的是一千九——这数字听着都让人心里发沉，你还说自己可笑，我倒觉得一点都不可笑。这样的日子撑了半年，光是每天上路就已经很不容易了。这份工作，你还有打算继续干下去吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"两百公里、十多个小时，换来的是一千九——这数字听着都让人心里发沉，你还说自己可笑，我倒觉得一点都不可笑。这样的日子撑了半年，光是每天上路就已经很不容易了。这份工作，你还有打算继续干下去吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2004,"promptTokens":2088,"completionTokens":109,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:40:39"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006690997108613798,"emotions":[],"relationId":"6af678a7f4429d1fd72f7ade","courseProgressId":0,"tsGen":1794537639180,"createTime":"2026-11-13 10:40:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678a7f4429d1fd72f7ade","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最压着的……还是工作吧。每天来回两百公里，干十多个小时，到手就一千九。说出来都觉得可笑。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006690997108613798,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"anger","name":"愤怒","value":4,"sort":7},{"code":"fear","name":"恐惧","value":3