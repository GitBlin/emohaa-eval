courseProgressId":0,"tsGen":1794537663444,"createTime":"2026-11-13 10:41:03","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678bff4429d1fd72f7b0b","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（沉默了一会儿）……你这么一说，还真是。我平时骂自己的话，跟我爸当年一模一样。可知道像又怎么样，这声音跟了我三十年了。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005910764669965032,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"calm","name":"平静","value":4,"sort":4},{"code":"surprised","name":"惊讶","value":3,"sort":5},{"code":"anger","name":"愤怒","value":3,"sort":7},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2}],"relationId":"6af678bff4429d1fd72f7b0c","courseProgressId":0,"tsGen":1794537663441,"createTime":"2026-11-13 10:41:03","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678bbf4429d1fd72f7b02","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"这种“我不行”的感觉，好像不是天生的，是听多了那些话，慢慢长进心里的——考好了不夸，考差了就怪，久了就学会自己怪自己。你有没有发现，现在责备你的那个声音，跟你爸妈当年说话的语气挺像的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"这种“我不行”的感觉，好像不是天生的，是听多了那些话，慢慢长进心里的——考好了不夸，考差了就怪，久了就学会自己怪自己。你有没有发现，现在责备你的那个声音，跟你爸妈当年说话的语气挺像的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2503,"promptTokens":2620,"completionTokens":148,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:40:59"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01590113914533827,"emotions":[],"relationId":"6af678bbf4429d1fd72f7b01","courseProgressId":0,"tsGen":1794537659445,"createTime":"2026-11-13 10:40:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678bbf4429d1fd72f7b01","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"常冒出来……从小就这样。我爸妈不太夸人，考好了说别骄傲，考差了就是我不够努力。久了就总觉得，是我自己不行。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01590113914533827,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2}],"relationId":"6af678bbf4429d1fd72f7b02","courseProgressId":0,"tsGen":1794537659442,"createTime":"2026-11-13 10:40:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678b6f4429d1fd72f7afb","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“别人都干着，怎么就我撑不住”——这句话听着不像在问，倒像在责备自己。可你每天两百公里、十多个小时，这是实实在在的重，不是谁扛不住的问题。这种“是不是我不够好”的念头，以前也常冒出来吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“别人都干着，怎么就我撑不住”——这句话听着不像在问，倒像在责备自己。可你每天两百公里、十多个小时，这是实实在在的重，不是谁扛不住的问题。这种“是不是我不够好”的念头，以前也常冒出来吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2209,"promptTokens":3131,"completionTokens":150,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:40:54"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.020325674216601412,"emotions":[],"relationId":"6af678b6f4429d1fd72f7afa","courseProgressId":0,"tsGen":1794537654347,"createTime":"2026-11-13 10:40:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678b6f4429d1fd72f7afa","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"跟谁说都难开口……其实我心里也犯嘀咕，是不是我太没用了。别人不都这么干着吗，怎么就我撑不住？<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.020325674216601412,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":1,"sort":7}],"relationId":"6af678b6f4429d1fd72f7afb","courseProgressId":0,"tsGen":1794537654344,"createTime":"2026-11-13 10:40:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af678b2f4429d1fd72f7af0","chatId":"b7045b1e1491410db00453b7d7ec6251","sessionId":null,"userId":99862,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"夹在父母认定的“稳定”和你自己的状态中间，确实挺难的，好像一开口就成了不懂事的那一个。那如果真要迈出请假这一步，你觉得最先能跟谁说、或者怎么开这个口，会稍微没那么难？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"夹在父母认定的“稳定”和你自己的状态中间，确实挺难的，好像一开口就成了不懂事的那一个。那如果真要迈出请假这一步，你觉得最先能跟谁说、或者怎么开这个口，会稍微没那么难？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2511,"promptTokens":2365,"completionTokens":161,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:40:50"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.017981595821168175,"emotions":[],"relationId":"6af678b2f4429d1fd72f7aef","courseProgressId":0,"tsGen":1794537650431,"createTime":"2026-11-13 10:40:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"