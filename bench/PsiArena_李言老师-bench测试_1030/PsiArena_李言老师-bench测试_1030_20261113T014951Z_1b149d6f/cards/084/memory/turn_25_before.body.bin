eProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ed2f4429d1fd72f804d","chatId":"2dde6eebc56446638e9cf382136270f7","sessionId":null,"userId":99891,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"想的东西挺杂的，有时候就是忍不住想吃点东西、刷刷剧，一刷就到半夜。第二天又后悔……我是不是有点小题大做？会不会聊几次你就觉得我没什么好聊的了？<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008573337896979893,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"happy","name":"快乐","value":2,"sort":1},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67ed2f4429d1fd72f804e","courseProgressId":0,"tsGen":1794539218820,"createTime":"2026-11-13 11:06:58","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ecdf4429d1fd72f8047","chatId":"2dde6eebc56446638e9cf382136270f7","sessionId":null,"userId":99891,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"晚上一个人静下来，那些白天压着的东西就容易冒出来，这不算控制不住，更像是它们在找出口。你说“没什么大不了的”，可心里那份堵是真的。那种时候，你脑子里通常会想些什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"晚上一个人静下来，那些白天压着的东西就容易冒出来，这不算控制不住，更像