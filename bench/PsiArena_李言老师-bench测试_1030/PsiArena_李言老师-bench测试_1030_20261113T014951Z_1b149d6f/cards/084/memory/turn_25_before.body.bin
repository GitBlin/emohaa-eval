,"sort":9},{"code":"expect","name":"期待","value":3,"sort":2},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67efef4429d1fd72f8097","courseProgressId":0,"tsGen":1794539262946,"createTime":"2026-11-13 11:07:42","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ef9f4429d1fd72f808d","chatId":"2dde6eebc56446638e9cf382136270f7","sessionId":null,"userId":99891,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"改到半夜，交上去没人说什么，可那个“是不是还差点”的念头还跟着你一整天。累的其实不只是方案，是心里那场没人打分的考试。别人没说什么的时候，你心里是松了口气，还是更没底？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"改到半夜，交上去没人说什么，可那个“是不是还差点”的念头还跟着你一整天。累的其实不只是方案，是心里那场没人打分的考试。别人没说什么的时候，你心里是松了口气，还是更没底？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2557,"promptTokens":3297,"completionTokens":147,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:07:37"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005217829538529942,"emotions":[],"relationId":"6af67ef9f4429d1fd72f808c","courseProgressId":0,"tsGen":1794539257924,"createTime":"2026-11-13 11:07:37","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ef9f4429d1fd72f808c","chatId":"2dde6eebc56446638e9cf382136270f7","sessionId":null,"userId":99891,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就昨天吧，工作上有个方案，我改到半夜还是觉得不行。其实交上去也没人说什么，可我一整天都在想是不是哪里还差点。<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":26,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005217829538529942,"emotions":[{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"calm","name":"平静","value":4,"sort":4},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67ef9f4429d1fd72f808d","courseProgressId":0,"tsGen":1794539257921,"createTime":"2026-11-13 11:07:37","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ef5f4429d1fd72f8084","chatId":"2dde6eebc56446638e9cf382136270f7","sessionId":null,"userId":99891,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你一边替爸爸留着余地，一边把“没用”扣在自己头上——好像怪自己，比怪他更安全一点。这不是你没用，是你太早学会把矛头转向自己了。这种“都是我的问题”的念头，最近一次冒出来是在什么时候？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你一边替爸爸留着余地，一边把“没用”扣在自己头上——好像怪自己，比怪他更安全一点。这不是你没用，是你太早学会把矛头转向自己了。这种“都是我的问题”的念头，最近一次冒出来是在什么时候？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2750,"promptTokens":2593,"completionTokens":209,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:07:33"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010984784634616242,"emotions":[],"relationId":"6af67ef5f4429d1fd72f8083","courseProgressId":0,"tsGen":1794539253189,"createTime":"2026-11-13 11:07:33","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ef5f4429d1fd72f8083","chatId":"2dde6eebc56446638e9cf382136270f7","sessionId":null,"userId":99891,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（停顿）……你这么一问，我有点愣住了。好像还真是，我总在心里替他把话说完。可我不想怪他，他也是为我好，是我自己太没用了。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010984784634616242,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"trust","name":"信任","value":5,"sort":3},{"code":"surprised","name":"惊讶","value":5,"sort":5},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2}],"relationId":"6af67ef5f4429d1fd72f8084","courseProgressId":0,"tsGen":1794539253186,"createTime":"2026-11-13 11:07:33","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67eeff4429d1fd72f807a","chatId":"2dde6eebc56446638e9cf382136270f7","sessionId":null,"userId":99891,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那种沉默确实比骂更让人心里没底，因为你还得自己去猜它是什么意思。你现在做事情时那种“还不够好”的声音，是不是有点像在替你爸把没说出口的话补上？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那种沉默确实比骂更让人心里没底，因为你还得自己去猜它是什么意思。你现在做事情时那种“还不够好”的声音，是不是有点像在替你爸把没说出口的话补上？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2717,"promptTokens":2622,"completionTokens":182,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:07:27"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575120905538692,"emotions":[],"relationId":"6af67eeff4429d1fd72f8079","courseProgressId":0,"tsGen":1794539247392,"createTime":"2026-11-13 11:07:27","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67eeff4429d1fd72f8079","chatId":"2dde6eebc56446638e9cf382136270f7","sessionId":null,"userId":99891,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"可能……是我爸吧。他很少夸我，做得好是应该的，做不好就一句话不说，那种沉默比骂我还难受。我现在做事总怕结果不够好，好像一放松就会被他看见似的。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575120905538692,"emotions":[{"code":"fear","name":"恐惧","value":6,"sort":6},{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67eeff4429d1fd72f807a","courseProgressId":0,"tsGen":1794539247389,"createTime":"2026-11-13 11:07:27","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ee9f4429d1fd72f8071","chatId":"2dde6eebc56446638e9cf382136270f7","sessionId":null,"userId":99891,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你这句话问得很准——放松时那种“在犯错”的感觉，往往不是天生的，是长期被要求“管住自己”之后留下的回声。你不是不会放松，是一放松就有个声音来审判你。那种“被要求”的感觉，现在最常从谁身上冒出来？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你这句话问得很准——放松时那种“在犯错”的感觉，往往不是天生的，是长期被要求“管住自己”之后留下的回声。你不是不会放松，是一放松就有个声音来审判你。那种“被要求”的感觉，现在最常从谁身上冒出来？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1979,"promptTokens":3301,"completionTokens":101,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:07:21"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012430416302405557,"emotions":[],"relationId":"6af67ee9f4429d1fd72f8070","courseProgressId":0,"tsGen":1794539241803,"createTime":"2026-11-13 11:07:21","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ee9f4429d1fd72f8070","chatId":"2dde6eebc56446638e9cf382136270f7","sessionId":null,"userId":99891,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"说起来容易……我试过设闹钟、下决心，可到了那个点根本不想停。您说的“绷得太紧”我有点感觉，但我说不上来。是不是我从小被要求惯了，现在连放松都觉得是在犯错？<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"