":"期待","value":1,"sort":2},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67de8f4429d1fd72f7f6b","courseProgressId":0,"tsGen":1794538984963,"createTime":"2026-11-13 11:03:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67de3f4429d1fd72f7f60","chatId":"cd8f9180ae6f4751935357dd6a7b48a1","sessionId":null,"userId":99885,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"（轻声）对不起，我不该这么随口问的。这几年你一个人撑着这个家，还得在公婆面前装作没事，那份沉一直没处放吧。愿意的话，跟我说说他。","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"（轻声）对不起，我不该这么随口问的。这几年你一个人撑着这个家，还得在公婆面前装作没事，那份沉一直没处放吧。愿意的话，跟我说说他。","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2000,"promptTokens":3037,"completionTokens":82,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:02:59"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.037324917616273226,"emotions":[],"relationId":"6af67de3f4429d1fd72f7f5f","courseProgressId":0,"tsGen":1794538979747,"createTime":"2026-11-13 11:02:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67de3f4429d1fd72f7f5f","chatId":"cd8f9180ae6f4751935357dd6a7b48a1","sessionId":null,"userId":99885,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（沉默了几秒）先生……他不在了。早几年走的。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoCon