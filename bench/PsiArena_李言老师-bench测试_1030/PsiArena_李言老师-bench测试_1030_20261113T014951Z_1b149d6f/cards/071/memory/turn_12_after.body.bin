,{"code":"trust","name":"信任","value":2,"sort":3},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"fear","name":"恐惧","value":0,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67c11f4429d1fd72f7d99","courseProgressId":0,"tsGen":1794538513940,"createTime":"2026-11-13 10:55:13","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67c0cf4429d1fd72f7d8d","chatId":"5d1d822d275a4288a38916327deb4736","sessionId":null,"userId":99878,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听你这么说，我有个感觉：你怕的或许不是选错，而是选出一个连自己都不认的“我”。这么在意真假，说明你心里其实有个标准在。那个“不是我”的感觉，具体是什么样的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听你这么说，我有个感觉：你怕的或许不是选错，而是选出一个连自己都不认的“我”。这么在意真假，说明你心里其实有个标准在。那个“不是我”的感觉，具体是什么样的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2169,"promptTokens":2291,"completionTokens":153,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:55:08"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010985223420923621,"emotions":[],"relationId":"6af67c0cf4429d1fd72f7d8c","courseProgressId":0,"tsGen":1794538508966,"createTime":"2026-11-13 10:55:08","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67c0cf4429d1fd72f7d8c","chatId":"5d1d822d275a4288a38916327deb4736","sessionId":null,"userId":99878,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是……怕选出来的那个“我”，根本不是我。可到底哪个才是我，我自己也说不清。越这么想，越不敢