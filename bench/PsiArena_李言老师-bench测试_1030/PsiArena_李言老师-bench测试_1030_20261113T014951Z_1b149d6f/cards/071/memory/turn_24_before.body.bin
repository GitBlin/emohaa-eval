,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"fear","name":"恐惧","value":0,"sort":6}],"relationId":"6af67c2af4429d1fd72f7dc9","courseProgressId":0,"tsGen":1794538538208,"createTime":"2026-11-13 10:55:38","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67c25f4429d1fd72f7dc0","chatId":"5d1d822d275a4288a38916327deb4736","sessionId":null,"userId":99878,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那个叹气的声音，现在好像住进了你心里，不用她在场，你自己就替她说完了。这大概也是你每次选完就后悔的原因之一。听到自己这么念叨时，你心里是种什么滋味？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那个叹气的声音，现在好像住进了你心里，不用她在场，你自己就替她说完了。这大概也是你每次选完就后悔的原因之一。听到自己这么念叨时，你心里是种什么滋味？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2088,"promptTokens":3387,"completionTokens":98,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:55:33"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006692249482019241,"emotions":[],"relationId":"6af67c25f4429d1fd72f7dbf","courseProgressId":0,"tsGen":1794538533980,"createTime":"2026-11-13 10:55:33","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67c25f4429d1fd72f7dbf","chatId":"5d1d822d275a4288a38916327deb4736","sessionId":null,"userId":99878,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","conten