9384,"createTime":"2026-11-13 11:21:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68252f4429d1fd72f8394","chatId":"6b85abb862384042850e87054a484cbd","sessionId":null,"userId":99905,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"胸口闷、肩膀僵，这些都不是矫情，是身体在替你说话——情绪压久了，它先撑不住了。早上还没睁眼就觉得累，说明这份消耗整夜都没真正卸下来。你醒来那一刻，脑子里冒出来的第一个念头通常是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"胸口闷、肩膀僵，这些都不是矫情，是身体在替你说话——情绪压久了，它先撑不住了。早上还没睁眼就觉得累，说明这份消耗整夜都没真正卸下来。你醒来那一刻，脑子里冒出来的第一个念头通常是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2518,"promptTokens":2908,"completionTokens":148,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:21:54"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00590910829630654,"emotions":[],"relationId":"6af68252f4429d1fd72f8393","courseProgressId":0,"tsGen":1794540114772,"createTime":"2026-11-13 11:21:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68252f4429d1fd72f8393","chatId":"6b85abb862384042850e87054a484cbd","sessionId":null,"userId":99905,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"身体……胸口有点闷，肩膀也是僵的。早上闹钟响的时候，感觉整个人像被什么东西压着，还没睁眼就觉得累了。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00590910829630654,"emotions":[{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af68252f4429d1fd72f8394","courseProgressId":0,"tsGen":1794540114769,"createTime":"2026-11-13 11:21:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6824cf4429d1fd72f8382","chatId":"6b85abb862384042850e87054a484cbd","sessionId":null,"userId":99905,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那些说不上来的念头，往往不是事情本身，而是背后压着的某种情绪，只是还没找到词去形容它。先不急着说清内容，我想知道，那些念头转起来的时候，你身体上是什么感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那些说不上来的念头，往往不是事情本身，而是背后压着的某种情绪，只是还没找到词去形容它。先不急着说清内容，我想知道，那些念头转起来的时候，你身体上是什么感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2284,"promptTokens":2194,"completionTokens":113,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:21:48"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004069707442777984,"emotions":[],"relationId":"6af6824cf4429d1fd72f8381","courseProgressId":0,"tsGen":1794540108895,"createTime":"2026-11-13 11:21:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":