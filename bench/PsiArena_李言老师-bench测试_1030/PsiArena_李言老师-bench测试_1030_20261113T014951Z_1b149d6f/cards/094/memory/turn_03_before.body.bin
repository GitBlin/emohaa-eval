ips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0,"emotions":[{"code":"trust","name":"信任","value":5,"sort":3},{"code":"calm","name":"平静","value":5,"sort":4},{"code":"expect","name":"期待","value":4,"sort":2},{"code":"happy","name":"快乐","value":3,"sort":1},{"code":"sadness","name":"悲伤","value":1,"sort":8},{"code":"dislike","name":"厌恶","value":1,"sort":9},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"fear","name":"恐惧","value":0,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af68229f4429d1fd72f8354","courseProgressId":0,"tsGen":1794540073785,"createTime":"2026-11-13 11:21:13","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"01fead20490a468587d18c5fde8f5fcc"}