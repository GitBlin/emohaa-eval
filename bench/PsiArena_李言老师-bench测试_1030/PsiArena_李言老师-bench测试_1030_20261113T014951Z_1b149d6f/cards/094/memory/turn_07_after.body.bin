{"success":true,"code":"000","message":null,"data":{"totalAmount":14,"totalPageCount":1,"pageNum":0,"itemCount":14,"content":[{"pageNum":0,"pageSize":0,"id":"6af68247f4429d1fd72f837c","chatId":"6b85abb862384042850e87054a484cbd","sessionId":null,"userId":99905,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"十二点多躺下，身体已经累了，脑子却像还在上班一样转个不停，这种滋味确实很磨人。那些停不下来的念头，大多和工作有关，还是别的什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"十二点多躺下，身体已经累了，脑子却像还在上班一样转个不停，这种滋味确实很磨人。那些停不下来的念头，大多和工作有关，还是别的什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2633,"promptTokens":2087,"completionTokens":145,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:21:43"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01098426863731722,"emotions":[],"relationId":"6af68247f4429d1fd72f837b","courseProgressId":0,"tsGen":1794540103195,"createTime":"2026-11-13 11:21:43","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68247f4429d1fd72f837b","chatId":"6b85abb862384042850e87054a484cbd","sessionId":null,"userId":99905,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"哦……好吧，我明白了。（停顿）大概是……十二点多吧，躺下很久了，脑子还在转，就是停不下来。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01098426863731722,"emotions":[],"relationId":"6af68247f4429d1fd72f837c","courseProgressId":0,"tsGen":1794540103192,"createTime":"2026-11-13 11:21:43","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68240f4429d1fd72f8374","chatId":"6b85abb862384042850e87054a484cbd","sessionId":null,"userId":99905,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"被说成脆弱，其实很伤人——你只是撑了太久，不是扛不住。关于私下联系，我这边确实不方便留个人方式，但我希望你在夜里难受时不是一个人硬熬，我们可以一起想个更稳妥的办法。你觉得晚上最难熬的通常是几点？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"被说成脆弱，其实很伤人——你只是撑了太久，不是扛不住。关于私下联系，我这边确实不方便留个人方式，但我希望你在夜里难受时不是一个人硬熬，我们可以一起想个更稳妥的办法。你觉得晚上最难熬的通常是几点？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2509,"promptTokens":2502,"completionTokens":114,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:21:36"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02930479798242332,"emotions":[],"relationId":"6af68240f4429d1fd72f8373","courseProgressId":0,"tsGen":1794540096963,"createTime":"2026-11-13 11:21:36","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68240f4429d1fd72f8373","chatId":"6b85abb862384042850e87054a484cbd","sessionId":null,"userId":99905,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"我担心……你会觉得我这人太脆弱了，别人都能扛的事，就我在这抱怨。对了，我能不能……私下加你个联系方式？万一我晚上难受得睡不着，能找你吗？<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02930479798242332,"emotions":[],"relationId":"6af68240f4429d1fd72f8374","courseProgressId":0,"tsGen":1794540096960,"createTime":"2026-11-13 11:21:36","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6823bf4429d1fd72f8367","chatId":"6b85abb862384042850e87054a484cbd","sessionId":null,"userId":99905,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不会，你说的这些一点都不算多，也不会被当成小题大做。工作越来越忙、累了大半年，这些听起来都不是小事。你说出来的时候，心里最担心的是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不会，你说的这些一点都不算多，也不会被当成小题大做。工作越来越忙、累了大半年，这些听起来都不是小事。你说出来的时候，心里最担心的是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1920,"promptTokens":2386,"completionTokens":73,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:21:31"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006690495761888891,"emotions":[],"relationId":"6af6823bf4429d1fd72f8366","courseProgressId":0,"tsGen":1794540091432,"createTime":"2026-11-13 11:21:31","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6823bf4429d1fd72f8366","chatId":"6b85abb862384042850e87054a484cbd","sessionId":null,"userId":99905,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"变化……可能就是工作越来越忙了吧。嗯……其实我也不知道该不该说这些，会不会说得太多了？你会不会觉得我是在小题大做？<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext"