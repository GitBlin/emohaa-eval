:8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af673e0f4429d1fd72f748e","courseProgressId":0,"tsGen":1794536416026,"createTime":"2026-11-13 10:20:16","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673daf4429d1fd72f7481","chatId":"925c34cea1e6436f9fcd6758e656fd48","sessionId":null,"userId":99834,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你分不清，是因为心里那台机器总先判自己有罪——她顾不上，你也容易听成不想理。其实这两者常常同时存在，只是没法从沉默里读出来。要是暂时不问“是哪种”，你心里最怕的答案是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你分不清，是因为心里那台机器总先判自己有罪——她顾不上，你也容易听成不想理。其实这两者常常同时存在，只是没法从沉默里读出来。要是暂时不问“是哪种”，你心里最怕的答案是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2175,"promptTokens":3121,"completionTokens":96,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:20:10"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01405689631154505,"emotions":[],"relationId":"6af673daf4429d1fd72f7480","courseProgressId":0,"tsGen":1794536410766,"createTime":"2026-11-13 10:20:10","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673daf4429d1fd72f7480","chatId":"925c34cea1e6436f9fcd6758e656fd48","sessionId":null,"userId":99834,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"有点……难受，也有点累吧。原来我一直这么对自己。可我又想，她压力大的时候就不说话，我爸妈忙的时候也不理人，这到底是她不想理我，还是她只是顾不上？我分不清。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01405689631154505,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"surprised","name":"惊讶","value":2,"sort":5},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"calm","name":"平静","value":1,"sort":4}],"relationId":"6af673daf4429d1fd72f7481","courseProgressId":0,"tsGen":1794536410763,"createTime":"2026-11-13 10:20:10","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673d6f4429d1fd72f7479","chatId":"925c34cea1e6436f9fcd6758e656fd48","sessionId":null,"userId":99834,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"能察觉到“我一直在这么对自己”，这一下确实会有点不习惯，甚至觉得怪，好像第一次看清自己一直在做的事。这种“怪”不是坏事，说明你看见了它。看清之后，你心里冒出来的第一个感觉是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"能察觉到“我一直在这么对自己”，这一下确实会有点不习惯，甚至觉得怪，好像第一次看清自己一直在做的事。这种“怪”不是坏事，说明你看见了它。看清之后，你心里冒出来的第一个感觉是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2246,"promptTokens":3308,"completionTokens":123,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:20:06"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006690621003807605,"emotions":[],"relationId":"6af673d6f4429d1fd72f7478","courseProgressId":0,"tsGen":1794536406538,"createTime":"2026-11-13 10:20:06","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673d6f4429d1fd72f7478","chatId":"925c34cea1e6436f9fcd6758e656fd48","sessionId":null,"userId":99834,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"你这么一说……好像真是。我还没搞清楚她怎么了，就已经先认定是我的问题了。嗯……这么说出来，感觉有点怪，我好像一直在这么对自己。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006690621003807605,"emotions":[{"code":"calm","name":"平静","value":4,"sort":4},{"code":"surprised","name":"惊讶","value":3,"sort":5},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"fear","name":"恐惧","value":0,"sort":6}],"relationId":"6af673d6f4429d1fd72f7479","courseProgressId":0,"tsGen":1794536406535,"createTime":"2026-11-13 10:20:06","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673cff4429d1fd72f7469","chatId":"925c34cea1e6436f9fcd6758e656fd48","sessionId":null,"userId":99834,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那种不直接骂、却让你自己去想的语气，确实比挨骂还磨人，久而久之你就学会了先审自己。现在她没回消息，你大概也在用同样的方式对自己。你留意到吗，这种“是不是我的错”，往往在你还没弄清楚发生什么之前就来了？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那种不直接骂、却让你自己去想的语气，确实比挨骂还磨人，久而久之你就学会了先审自己。现在她没回消息，你大概也在用同样的方式对自己。你留意到吗，这种“是不是我的错”，往往在你还没弄清楚发生什么之前就来了？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2415,"promptTokens":3233,"completionTokens":137,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:19:59"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.020329897300905272,"emotions":[],"relationId":"6af673cff4429d1fd72f7468","courseProgressId":0,"tsGen":1794536399833,"createTime":"2026-11-13 10:19:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673cff4429d1fd72f7468","chatId":"925c34cea1e6436f9fcd6758e656fd48","sessionId":null,"userId":99834,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"好像……是。从小就习惯了，出了事先想是不是自己的问题。在我家，事情搞砸了，爸妈不会直接骂，但那种“你怎么不早说、你怎么不想想”的语气，比骂还难受。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.020329897300905272,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2}],"relationId":"6af673cff4429d1fd72f7469","courseProgressId":0,"tsGen":1794536399830,"createTime":"2026-11-13 10:19:59","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["不确定","担忧","堵得慌","自责","难受","冒失"],"originalText":["我不太确定该从哪儿说起","晚上老睡不好，脑子里一直在转一些事，停不下来","心里就是堵得慌……就那种被晾在一边的感觉","反复想我是不是哪里做错了","比骂还难受","我自己也觉得有点冒失了"]},"conversation":{"type":"人际关系处理","topic":"来访者因对方未回复消息而产生被忽视感，并反复自我怀疑，追溯至童年与父母互动中被忽略的体验，探讨关系中的不安与自责模式。"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673cbf4429d1fd72f745f","chatId":"925c34cea1e6436f9fcd6758e656fd48","sessionId":null,"userId":99834,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"没吵架却突然冷下来，这种没头没尾的空白最磨人，人就会忍不住往自己身上找原因。听起来你已经在心里把自己审了好几遍，这种自责挺累的。你平时遇到说不清的事，是不是也习惯先怪自己？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"没吵架却突然冷下来，这种没头没尾的空白最磨人，人就会忍不住往自己身上找原因。听起来你已经在心里把自己审了好几遍，这种自责挺累的。你平时遇到说不清的事，是不是也习惯先怪自己？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2734,"promptTokens":2968,"completionTokens":150,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:19:55"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705582454173594,"emotions":[],"relationId":"6af673cbf4429d1fd72f745e","courseProgressId":0,"tsGen":1794536395650,"createTime":"2026-11-13 10:19:55","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673cbf4429d1fd72f745e","chatId":"925c34cea1e6436f9fcd6758e656fd48","sessionId":null,"userId":99834,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最常卡的……就是反复想我是不是哪里做错了。她突然就不怎么理我了，也没吵架，我就一直琢磨，是不是我哪句话说错了，或者我这个人太闷了。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705582454173594,"emotions":[{"code":"fear","name":"恐惧","value":6,"sort":6},{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"surprised","name":"惊讶","value":3,"sort":5},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af673cbf4429d1fd72f745f","courseProgressId":0,"tsGen":1794536395647,"createTime":"2026-11-13 10:19:55","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["不确定","担忧","堵得慌","自责","难受","冒失"],"originalText":["我不太确定该从哪儿说起","晚上老睡不好，脑子里一直在转一些事，停不下来","心里就是堵得慌……就那种被晾在一边的感觉","反复想我是不是哪里做错了","比骂还难受","我自己也觉得有点冒失了"]},"conversation":{"type":"人际关系处理","topic":"来访者因对方未回复消息而产生被忽视感，并反复自我怀疑，追溯至童年与父母互动中被忽略的体验，探讨关系中的不安与自责模式。"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673c7f4429d1fd72f7452","chatId":"925c34cea1e6436f9fcd6758e656fd48","sessionId":null,"userId":99834,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不冒失，想要在难受的时候有人接着，这是很自然的念头，你能直接说出来，反而挺坦诚。我们把这件事记着就好，不用往心里去。刚才说到记下念头，你觉得难受的时候，最常卡在脑子里的会是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不冒失，想要在难受的时候有人接着，这是很自然的念头，你能直接说出来，反而挺坦诚。我们把这件事记着就好，不用往心里去。刚才说到记下念头，你觉得难受的时候，最常卡在脑子里的会是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1867,"promptTokens":2293,"completionTokens":93,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:19:51"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014062131382832181,"emotions":[],"relationId":"6af673c7f4429d1fd72f7451","courseProgressId":0,"tsGen":1794536391219,"createTime":"2026-11-13 10:19:51","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673c7f4429d1fd72f7451","chatId":"925c34cea1e6436f9fcd6758e656fd48","sessionId":null,"userId":99834,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……行吧，我理解。记下来这个办法我可以试试，总比一个人瞎想强。说实话刚才问那个，我自己也觉得有点冒失了。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014062131382832181,"emotions":[{"code":"calm","name":"平静","value":6,"sort":4},{"code":"trust","name":"信任","value":5,"sort":3},{"code":"expect","name":"期待","value":4,"sort":2},{"code":"happy","name":"快乐","value":3,"sort":1},{"code":"sadness","name":"悲伤","value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af673c7f4429d1fd72f7452","courseP