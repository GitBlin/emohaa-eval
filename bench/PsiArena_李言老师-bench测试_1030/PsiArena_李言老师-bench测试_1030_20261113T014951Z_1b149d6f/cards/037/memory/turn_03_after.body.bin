{"success":true,"code":"000","message":null,"data":{"totalAmount":6,"totalPageCount":1,"pageNum":0,"itemCount":6,"content":[{"pageNum":0,"pageSize":0,"id":"6af673b2f4429d1fd72f7423","chatId":"925c34cea1e6436f9fcd6758e656fd48","sessionId":null,"userId":99834,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来那些念头一到晚上就冒出来，搅得你没法安睡，这样确实挺熬人的。你说不太清具体是什么，那我们不急着给它下定义，可以试着回想一下：最近哪一次晚上脑子转得最厉害，当时大概在想什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来那些念头一到晚上就冒出来，搅得你没法安睡，这样确实挺熬人的。你说不太清具体是什么，那我们不急着给它下定义，可以试着回想一下：最近哪一次晚上脑子转得最厉害，当时大概在想什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1513,"promptTokens":1763,"completionTokens":95,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:19:30"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909534071564912,"emotions":[],"relationId":"6af673b2f4429d1fd72f7422","courseProgressId":0,"tsGen":1794536370831,"createTime":"2026-11-13 10:19:30","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673b2f4429d1fd72f7422","chatId":"925c34cea1e6436f9fcd6758e656fd48","sessionId":null,"userId":99834,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……最近确实有点事。就是，晚上老睡不好，脑子里一直在转一些事，停不下来。但要说具体是什么，我也说不太清楚。<第3轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":6,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909