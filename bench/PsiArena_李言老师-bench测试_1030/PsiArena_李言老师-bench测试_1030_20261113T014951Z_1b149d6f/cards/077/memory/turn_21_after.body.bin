dislike","name":"厌恶","value":8,"sort":9},{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67d3bf4429d1fd72f7ed4","courseProgressId":0,"tsGen":1794538811590,"createTime":"2026-11-13 11:00:11","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67d35f4429d1fd72f7ecb","chatId":"ed72f8b71f0641d89ec9a8028e48a65c","sessionId":null,"userId":99884,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你一边说，一边还替他们解释，这份体谅里其实藏着一条很早就学会的规则：得有用，才配被喜欢。听着让人心里发紧。我想问问，如果有一天你不再那么“有用”了，你最怕会发生什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你一边说，一边还替他们解释，这份体谅里其实藏着一条很早就学会的规则：得有用，才配被喜欢。听着让人心里发紧。我想问问，如果有一天你不再那么“有用”了，你最怕会发生什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2242,"promptTokens":2628,"completionTokens":157,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:00:05"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007574675709949695,"emotions":[],"relationId":"6af67d35f4429d1fd72f7eca","courseProgressId":0,"tsGen":1794538805201,"createTime":"2026-11-13 11:00:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67d35f4429d1fd72f7eca","chatId":"ed72f8b71f0641d89ec9a8028e48a65c","sessionId":null,"userId":99884,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"从小吧……考得好才有笑脸，考不好就没人理我。久而久之我就觉得，得争气、得有用，才配被喜欢。说这些好像在怪他们，其实他们也不容易。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007574675709949695,"emotions":[{"code":"sadness","name":"悲伤","value":7,"sort":8},{"code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"trust","name":"信任","value":4,"sort":3},{"code":"calm","name":"平静","value":4,"sort":4},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67d35f4429d1fd72f7ecb","courseProgressId":0,"tsGen":1794538805198,"createTime":"2026-11-13 11:00:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67d2cf4429d1fd72f7ec1","chatId":"ed72f8b71f0641d89ec9a8028e48a65c","sessionId":null,"userId":99884,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"这不叫矫情，是两个真需要同时在拽你：一个想被证明有用，一个想歇下来。它们打架，你才这么累。我更好奇的是，“只有被需要才算有用”这个念头，最早是从哪儿学来的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"这不叫矫情，是两个真需要同时在拽你：一个想被证明有用，一个想歇下来。它们打架，你才这么累。我更好奇的是，“只有被需要才算有用”这个念头，最早是从哪儿学来的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2794,"promptTokens":3261,"completionTokens":243,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:59:56"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.04207843509033291,"emotions":[],"relationId":"6af67d2cf4429d1fd72f7ec0","courseProgressId":0,"tsGen":1794538796171,"createTime":"2026-11-13 10:59:56","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67d2cf4429d1fd72f7ec0","chatId":"ed72f8b71f0641d89ec9a8028e48a65c","sessionId":null,"userId":99884,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"可能……是后者吧。好像只有“我不在就不行”，才显得我有用。可我又累得要死，这不是很矛盾吗，说出来都觉得自己矫情。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.04207843509033291,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67d2cf4429d1fd72f7ec1","courseProgressId":0,"tsGen":1794538796168,"createTime":"2026-11-13 10:59:56","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["疲惫无力","压抑","自责","矛盾","担忧"],"originalText":["就是觉得整个人很累，提不起劲。","慢慢地，好像难受也得自己憋着。","可有时候我真觉得，懂事这两个字快把我压垮了。","真关了我又慌，总觉得科里缺人，病人怎么办，我这样是不是太自私了。","好像只有“我不在就不行”，才显得我有用。可我又累得要死，这不是很矛盾吗"]},"conversation":{"type":"自我认知与成长","topic":"在“懂事”与自我需求之间的矛盾中感到疲惫无力，探索自我价值感与情绪表达"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67d25f4429d1fd72f7eb7","chatId":"ed72f8b71f0641d89ec9a8028e48a65c","sessionId":null,"userId":99884,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你把“想歇一歇”的第一反应变成了“我是不是太自私”，这份责任心像是长在身上了。可你自己都快撑不住了，还在替别人操心。我想问，真关掉手机时，最让你慌的是科里的事，还是那种“我不在就不行”的感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你把“想歇一歇”的第一反应变成了“我是不是太自私”，这份责任心像是长在身上了。可你自己都快撑不住了，还在替别人操心。我想问，真关掉手机时，最让你慌的是科里的事，还是那种“我不在就不行”的感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2871,"promptTokens":3127,"completionTokens":205,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:59:49"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014057658674020616,"emotions":[],"relationId":"6af67d25f4429d1fd72f7eb6","courseProgressId":0,"tsGen":1794538789209,"createTime":"2026-11-13 10:59:49","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67d25f4429d1fd72f7eb6","chatId":"ed72f8b71f0641d89ec9a8028e48a65c","sessionId":null,"userId":99884,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"不懂事一点啊……可能就是关掉手机，谁也别找我，睡到自然醒。可话又说回来，真关了我又慌，总觉得科里缺人，病人怎么办，我这样是不是太自私了。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014057658674