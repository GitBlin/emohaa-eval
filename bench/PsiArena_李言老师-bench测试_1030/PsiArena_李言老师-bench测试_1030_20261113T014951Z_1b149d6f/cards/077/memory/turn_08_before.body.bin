,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"fear","name":"恐惧","value":0,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67cfff4429d1fd72f7e77","courseProgressId":0,"tsGen":1794538751162,"createTime":"2026-11-13 10:59:11","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cf9f4429d1fd72f7e6e","chatId":"ed72f8b71f0641d89ec9a8028e48a65c","sessionId":null,"userId":99884,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来那种累不是睡一觉能缓过来的，而且话到嘴边你又收回去了。我留意到你说“算了”，好像有点不太敢往下讲。要是不急着讲工作本身，先说说那种“提不起劲”的感觉，是从什么时候开始的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来那种累不是睡一觉能缓过来的，而且话到嘴边你又收回去了。我留意到你说“算了”，好像有点不太敢往下讲。要是不急着讲工作本身，先说说那种“提不起劲”的感觉，是从什么时候开始的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1860,"promptTokens":1640,"completionTokens":113,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:59:05"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705499258461193,"emotions":[],"relationId":"6af67cf9f4429d1fd72f7e6d","courseProgressId":0,"tsGen":1794538745065,"createTime":"2026-11-13 10:59:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cf9f4429d1fd72f7e6d","chatId":"ed72f8b71f0641d89ec9a8028e48a65c","sessionId":null,"userId":99884,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……说实话我也说不太清楚，就是觉得整个人很累，提不起劲。工作上的事吧，一想到要回去就……唉，算了，好像也说不出个所以然。<第3轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioCo