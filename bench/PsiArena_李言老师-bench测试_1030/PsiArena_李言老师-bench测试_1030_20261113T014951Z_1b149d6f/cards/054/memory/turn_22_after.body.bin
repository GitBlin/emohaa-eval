"厌恶","value":3,"sort":9},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"fear","name":"恐惧","value":0,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6770af4429d1fd72f792c","courseProgressId":0,"tsGen":1794537226181,"createTime":"2026-11-13 10:33:46","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67705f4429d1fd72f791d","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你从“怕被看见没那么能扛”，走到“哭就哭吧”——这一步不是认输，是终于允许自己也是个人。\n\n那如果你真在他面前哭了，你更希望他做点什么，还是先什么都不说？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你从“怕被看见没那么能扛”，走到“哭就哭吧”——这一步不是认输，是终于允许自己也是个人。\n\n那如果你真在他面前哭了，你更希望他做点什么，还是先什么都不说？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2419,"promptTokens":2663,"completionTokens":150,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:33:41"}],"imgs":null,"regenerations":0,"seqNum":35,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.06752421180550691,"emotions":[],"relationId":"6af67705f4429d1fd72f791c","courseProgressId":0,"tsGen":1794537221595,"createTime":"2026-11-13 10:33:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67705f4429d1fd72f791c","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最坏……大概就是被人看见我其实没那么能扛吧。可说到这儿，我好像也没那么怕了，哭就哭吧，总比一直憋着强。<第17轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":34,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.06752421180550691,"emotions":[{"code":"calm","name":"平静","value":6,"sort":4},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67705f4429d1fd72f791d","courseProgressId":0,"tsGen":1794537221592,"createTime":"2026-11-13 10:33:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67700f4429d1fd72f7917","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"怕哭出来，可能是怕那点撑着的劲儿一松就收不回来。可眼泪也不是软弱，是憋太久的累终于有地方去了。你觉得哭出来最坏会怎样？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"怕哭出来，可能是怕那点撑着的劲儿一松就收不回来。可眼泪也不是软弱，是憋太久的累终于有地方去了。你觉得哭出来最坏会怎样？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1839,"promptTokens":2660,"completionTokens":74,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:33:36"}],"imgs":null,"regenerations":0,"seqNum":33,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02032914572668107,"emotions":[],"relationId":"6af67700f4429d1fd72f7916","courseProgressId":0,"tsGen":1794537216367,"createTime":"2026-11-13 10:33:36","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67700f4429d1fd72f7916","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"先说我撑不住……我好像从来没这么说过。平时都是先说事，情绪憋在后面。这样反过来，听着是软一点，可我怕说着说着，自己先哭出来。<第16轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":32,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02032914572668107,"emotions":[{"code":"fear","name":"恐惧","value":6,"sort":6},{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67700f4429d1fd72f7917","courseProgressId":0,"tsGen":1794537216364,"createTime":"2026-11-13 10:33:36","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676f9f4429d1fd72f790b","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你觉得“太冲”，其实是怕他听成埋怨，可那句话里明明是“我撑不住了”的求助，不是指责。\n\n如果换个顺序，先把“我实在撑不住”说出口，再提送孩子，你觉得听起来会不一样吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你觉得“太冲”，其实是怕他听成埋怨，可那句话里明明是“我撑不住了”的求助，不是指责。\n\n如果换个顺序，先把“我实在撑不住”说出口，再提送孩子，你觉得听起来会不一样吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2041,"promptTokens":3222,"completionTokens":139,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:33:29"}],"imgs":null,"regenerations":0,"seqNum":31,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010985165649237641,"emotions":[],"relationId":"6af676f9f4429d1fd72f790a","courseProgressId":0,"tsGen":1794537209642,"createTime":"2026-11-13 10:33:29","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676f9f4429d1fd72f790a","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"我……我可能得直接说，别绕了。就说“明天早上你送一次，我实在撑不住了”。可这话到嘴边，我又觉得太冲，怕他觉得我在埋怨他。<第15轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":30,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010985165649237641,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af676f9f4429d1fd72f790b","courseProgressId":0,"tsGen":1794537209639,"createTime":"2026-11-13 10:33:29","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676f4f4429d1fd72f78ff","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那句“辛苦了”之所以更堵，是因为它停在嘴上，活儿还在你手上——像被看见了，又被轻轻放回原处。你要的或许不是一句安慰，而是真的有人接过去一件。如果他爸只能听你说，你打算怎么把这层意思讲清楚？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那句“辛苦了”之所以更堵，是因为它停在嘴上，活儿还在你手上——像被看见了，又被轻轻放回原处。你要的或许不是一句安慰，而是真的有人接过去一件。如果他爸只能听你说，你打算怎么把这层意思讲清楚？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2211,"promptTokens":2627,"completionTokens":145,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:33:24"}],"imgs":null,"regenerations":0,"seqNum":29,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02595427103264864,"emotions":[],"relationId":"6af676f4f4429d1fd72f78fe","courseProgressId":0,"tsGen":1794537204113,"createTime":"2026-11-13 10:33:24","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676f4f4429d1fd72f78fe","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"有是有……他偶尔会说“辛苦了”，可说完该我干的还是我干。我也不知道，那句“辛苦了”听着像客套，落不到实处，反而更堵得慌。<第14轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":28,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02595427103264864,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"anger","name":"愤怒","value":4,"sort":7},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"fear","name":"恐惧","value":0,"sort":6}],"relationId":"6af676f4f4429d1fd72f78ff","courseProgressId":0,"tsGen":1794537204110,"createTime":"2026-11-13 10:33:24","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676edf4429d1fd72f78f1","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"这句话之所以扎得这么深，是因为它和你妈那句“就你娇气”是同一个调子——都在说你的辛苦不算数。你怕的其实不是他爸那句话，而是又一次被判定“你没做什么”。\n\n那你有没有哪一次，被他真正看见过、说过一句“你辛苦了”？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"这句话之所以扎得这么深，是因为它和你妈那句“就你娇气”是同一个调子——都在说你的辛苦不算数。你怕的其实不是他爸那句话，而是又一次被判定“你没做什么”。\n\n那你有没有哪一次，被他真正看见过、说过一句“你辛苦了”？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2423,"promptTokens":3391,"completionTokens":177,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:33:17"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0085759745004795,"emotions":[],"relationId":"6af676edf4429d1fd72f78f0","courseProgressId":0,"tsGen":1794537197437,"createTime":"2026-11-13 10:33:17","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consul