rations":0,"seqNum":6,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.029299981431447752,"emotions":[{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af676bdf4429d1fd72f788b","courseProgressId":0,"tsGen":1794537149968,"createTime":"2026-11-13 10:32:29","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676b9f4429d1fd72f787d","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"咨询不是让你单方面交代，更像我们一起看看你带来的事，节奏你可以掌握，不想说的可以不说。你觉得不舒服时，也可以直接告诉我。你希望这次聊点什么，或者想先了解哪方面？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"咨询不是让你单方面交代，更像我们一起看看你带来的事，节奏你可以掌握，不想说的可以不说。你觉得不舒服时，也可以直接告诉我。你希望这次聊点什么，或者想先了解哪方面？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1675,"promptTokens":1643,"completionTokens":84,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:32:25"}],"imgs":null,"regenerations":0,"seqNum":5,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0019266661946552655,"emotions":[],"relationId":"6af676b9f4429d1fd72f787c","courseProgressId":0,"tsGen":1794537145904,"createTime":"2026-11-13 10:32:25","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consult