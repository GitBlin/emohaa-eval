{"success":true,"code":"000","message":null,"data":{"totalAmount":22,"totalPageCount":1,"pageNum":0,"itemCount":22,"content":[{"pageNum":0,"pageSize":0,"id":"6af676e2f4429d1fd72f78dd","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你刚说想交出去，马上又替他把理由想好了——好像“他忙”比“你也累”更值得被照顾。那个“说不过去”，还是你妈那套标准在说话。你有没有真的问过他爸，早上能不能分担一次？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你刚说想交出去，马上又替他把理由想好了——好像“他忙”比“你也累”更值得被照顾。那个“说不过去”，还是你妈那套标准在说话。你有没有真的问过他爸，早上能不能分担一次？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2289,"promptTokens":2621,"completionTokens":161,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:33:06"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.017979498854493677,"emotions":[],"relationId":"6af676e2f4429d1fd72f78dc","courseProgressId":0,"tsGen":1794537186792,"createTime":"2026-11-13 10:33:06","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676e2f4429d1fd72f78dc","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最先想交出去的……大概是早上送孩子这摊事吧。可我又一想，他爸工作忙，我要是连这个都做不好，好像更说不过去了。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.017979498854493677,"emotions":[],"relationId":"6af676e2f4429d1fd72f78dd","courseProgressId":0,"tsGen":1794537186789,"createTime":"2026-11-13 10:33:06","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676def4429d1fd72f78d2","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那句“凭什么非得是我撑”，听着像憋了很久才冒出来的一点不服气。它其实挺珍贵的，说明你心里也知道，这个家不该只压在你一个人身上。那要是真有人能替你分担一点，你最先想交出去的是哪件事？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那句“凭什么非得是我撑”，听着像憋了很久才冒出来的一点不服气。它其实挺珍贵的，说明你心里也知道，这个家不该只压在你一个人身上。那要是真有人能替你分担一点，你最先想交出去的是哪件事？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2061,"promptTokens":3171,"completionTokens":108,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:33:02"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.017977592089147162,"emotions":[],"relationId":"6af676def4429d1fd72f78d1","courseProgressId":0,"tsGen":1794537182138,"createTime":"2026-11-13 10:33:02","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676def4429d1fd72f78d1","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"怕……怕一停下来，这个家就散了。我妈以前总说，当妈的就得撑住，家里才有个样子。可我有时候真想，凭什么非得是我撑啊。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.017977592089147162,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"anger","name":"愤怒","value":3,"sort":7},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af676def4429d1fd72f78d2","courseProgressId":0,"tsGen":1794537182135,"createTime":"2026-11-13 10:33:02","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676d9f4429d1fd72f78cb","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"原来“娇气”这句话，你从小听到大，现在变成你自己在心里说了——累还没出口，就先被自己拦下了。\n\n那如果你真的喊一次累，你最怕接下来会发生什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"原来“娇气”这句话，你从小听到大，现在变成你自己在心里说了——累还没出口，就先被自己拦下了。\n\n那如果你真的喊一次累，你最怕接下来会发生什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2572,"promptTokens":2888,"completionTokens":148,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:32:57"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575524281699444,"emotions":[],"relationId":"6af676d9f4429d1fd72f78ca","courseProgressId":0,"tsGen":1794537177146,"createTime":"2026-11-13 10:32:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676d9f4429d1fd72f78ca","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"像……像我妈吧。小时候我一喊累，她就说“谁不累，就你娇气”。所以我现在也不太敢喊累，喊了好像就是我不够格当妈。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575524281699444,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af676d9f4429d1fd72f78cb","courseProgressId":0,"tsGen":1794537177143,"createTime":"2026-11-13 10:32:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676d4f4429d1fd72f78bf","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"我不觉得这是矫情。那些“鸡毛蒜皮”落下来，你心里是真的沉，不然也不会累到早上心慌。\n\n你习惯把自己的难受说成“太矫情”，这个声音听着像谁呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我不觉得这是矫情。那些“鸡毛蒜皮”落下来，你心里是真的沉，不然也不会累到早上心慌。\n\n你习惯把自己的难受说成“太矫情”，这个声音听着像谁呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2506,"promptTokens":2764,"completionTokens":145,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:32:52"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012426987777962514,"emotions":[],"relationId":"6af676d4f4429d1fd72f78be","courseProgressId":0,"tsGen":1794537172568,"createTime":"2026-11-13 10:32:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676d4f4429d1fd72f78be","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……好像经常吧。家里来客人的时候，看人家孩子懂事，我就觉得自己哪儿哪儿都不行。不过这些事说起来都是鸡毛蒜皮，我是不是太矫情了？<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012426987777962514,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af676d4f4429d1fd72f78bf","courseProgressId":0,"tsGen":1794537172565,"createTime":"2026-11-13 10:32:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"