","value":2,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af676cff4429d1fd72f78b5","courseProgressId":0,"tsGen":1794537167838,"createTime":"2026-11-13 10:32:47","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676caf4429d1fd72f78a8","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听你说“催也不是、不催也不是”，能感到你夹在中间，两头都怕做错；老师那个眼神，好像也不只是眼神，更像是在说你没管好。\n\n那一刻你心里最冒出来的感觉是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听你说“催也不是、不催也不是”，能感到你夹在中间，两头都怕做错；老师那个眼神，好像也不只是眼神，更像是在说你没管好。\n\n那一刻你心里最冒出来的感觉是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1873,"promptTokens":2519,"completionTokens":104,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:32:42"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004068856712751985,"emotions":[],"relationId":"6af676caf4429d1fd72f78a7","courseProgressId":0,"tsGen":1794537162378,"createTime":"2026-11-13 10:32:42","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676caf4429d1fd72f78a7","chatId":"151b9c7eab9a4982a4bae79f1fcf1ac6","sessionId":null,"userId":99854,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最费神的……大概是早上吧。女儿磨磨蹭蹭不肯出门