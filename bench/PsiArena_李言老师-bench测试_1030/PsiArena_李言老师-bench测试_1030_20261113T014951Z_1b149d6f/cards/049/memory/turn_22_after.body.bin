tomMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010983299537541766,"emotions":[{"code":"fear","name":"恐惧","value":8,"sort":6},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67616f4429d1fd72f77b0","courseProgressId":0,"tsGen":1794536982665,"createTime":"2026-11-13 10:29:42","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["担忧","犹豫","害怕","心疼","自我怀疑"],"originalText":["可要说具体是什么事，我又讲不上来，挺乱的。","其实……我有点担心，说了你也会像我爸妈那样，跟我讲一堆道理","我最近老做梦，醒来心里堵得慌，可记不清梦到什么了。","我怕一旦放开就收不住，那不就乱套了吗？","有点……心疼吧。可又觉得她太软弱了，怎么就不能忍一忍。我是不是对自己太狠了？"]},"conversation":{"type":"情绪调节","topic":"来访者难以识别和表达自己的情绪，长期压抑情绪，害怕情绪失控，并探索情绪压抑与童年家庭经历的关系。"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67611f4429d1fd72f779e","chatId":"c3b7b4d0474f402d94cbcb209749ce85","sessionId":null,"userId":99848,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来你一直很努力地想把它想通，可情绪不是靠想明白就能消掉的，越使劲反而越乱。你小时候学会的，大概就是把感受压下去、用道理盖住。那现在，如果不用想明白，只是让那份乱待一会儿，你会觉得害怕吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来你一直很努力地想把它想通，可情绪不是靠想明白就能消掉的，越使劲反而越乱。你小时候学会的，大概就是把感受压下去、用道理盖住。那现在，如果不用想明白，只是让那份乱待一会儿，你会觉得害怕吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2275,"promptTokens":2474,"completionTokens":112,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:29:37"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006692422621993255,"emotions":[],"relationId":"6af67611f4429d1fd72f779d","courseProgressId":0,"tsGen":1794536977306,"createTime":"2026-11-13 10:29:37","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67611f4429d1fd72f779d","chatId":"c3b7b4d0474f402d94cbcb209749ce85","sessionId":null,"userId":99848,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（声音低了些）嗯……好像是。在家里，情绪这东西说出来也没用，我爸妈更看重把事想明白。可有时候我就是想不明白，越想越乱。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006692422621993255,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1}],"relationId":"6af67611f4429d1fd72f779e","courseProgressId":0,"tsGen":1794536977303,"createTime":"2026-11-13 10:29:37","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["担忧","犹豫","害怕","心疼","自我怀疑"],"originalText":["可要说具体是什么事，我又讲不上来，挺乱的。","其实……我有点担心，说了你也会像我爸妈那样，跟我讲一堆道理","我最近老做梦，醒来心里堵得慌，可记不清梦到什么了。","我怕一旦放开就收不住，那不就乱套了吗？","有点……心疼吧。可又觉得她太软弱了，怎么就不能忍一忍。我是不是对自己太狠了？"]},"conversation":{"type":"情绪调节","topic":"来访者难以识别和表达自己的情绪，长期压抑情绪，害怕情绪失控，并探索情绪压抑与童年家庭经历的关系。"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6760cf4429d1fd72f7794","chatId":"c3b7b4d0474f402d94cbcb209749ce85","sessionId":null,"userId":99848,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听你说“没人提”，我心里也沉了一下。一个孩子在那儿害怕，却得像大人一样装作没事，那份怕只能自己咽下去。现在你心里堵着的时候，是不是也常这样，觉得说出来也没人接得住？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听你说“没人提”，我心里也沉了一下。一个孩子在那儿害怕，却得像大人一样装作没事，那份怕只能自己咽下去。现在你心里堵着的时候，是不是也常这样，觉得说出来也没人接得住？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2388,"promptTokens":2899,"completionTokens":152,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:29:32"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006692127571717434,"emotions":[],"relationId":"6af6760cf4429d1fd72f7793","courseProgressId":0,"tsGen":1794536972366,"createTime":"2026-11-13 10:29:32","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6760cf4429d1fd72f7793","chatId":"c3b7b4d0474f402d94cbcb209749ce85","sessionId":null,"userId":99848,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（沉默了一会儿）就是……我记得小时候有一次家里聚会，我爸那时候病着，可大家还是照常吃饭聊天，好像什么都没发生。我坐在那儿特别害怕，但没人提。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuici