,"value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67602f4429d1fd72f777f","courseProgressId":0,"tsGen":1794536962330,"createTime":"2026-11-13 10:29:22","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["担忧","犹豫","害怕","心疼","自我怀疑"],"originalText":["可要说具体是什么事，我又讲不上来，挺乱的。","其实……我有点担心，说了你也会像我爸妈那样，跟我讲一堆道理","我最近老做梦，醒来心里堵得慌，可记不清梦到什么了。","我怕一旦放开就收不住，那不就乱套了吗？","有点……心疼吧。可又觉得她太软弱了，怎么就不能忍一忍。我是不是对自己太狠了？"]},"conversation":{"type":"情绪调节","topic":"来访者难以识别和表达自己的情绪，长期压抑情绪，害怕情绪失控，并探索情绪压抑与童年家庭经历的关系。"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af675fef4429d1fd72f7773","chatId":"c3b7b4d0474f402d94cbcb209749ce85","sessionId":null,"userId":99848,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你愿意说出来，就已经很不容易了，这不过分。那种压着的感觉，虽然讲不清，但它一直在，人也会累。它更像闷闷的沉，还是有点发紧的那种？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你愿意说出来，就已经很不容易了，这不过分。那种压着的感觉，虽然讲不清，但它一直在，人也会累。它更像闷闷的沉，还是有点发紧的那种？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1851,"promptTokens":1990,"completionTokens":97,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:29:18"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909330684665715,"emotions":[],"relationId":"6af675fef4429d1fd72f7772","courseProgressId":0,"tsGen":1794536958180,"createTime":"2026-11-13 10:29:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserI