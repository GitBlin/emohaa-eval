1-13 11:06:27","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67eb3f4429d1fd72f801e","chatId":"35568fae2b32499a9d45ba78ba1900af","sessionId":null,"userId":99889,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是……躺下脑子停不下来，翻来覆去。唉，其实也不光是睡觉的事。对了，我想问一下，我说的话你会保密吧？不会跟我单位或者家里人说吧？<第3轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":6,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01242730167886212,"emotions":[{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67eb3f4429d1fd72f801f","courseProgressId":0,"tsGen":1794539187775,"createTime":"2026-11-13 11:06:27","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67eaff4429d1fd72f801c","chatId":"35568fae2b32499a9d45ba78ba1900af","sessionId":null,"userId":99889,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"会有点不确定挺正常的，咨询不是我说你听，更多是一起看看你身上发生了什么。你说最近睡不好，是躺下很难入睡，还是睡着了容易醒？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"content