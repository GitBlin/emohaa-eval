promptTokens":1779,"completionTokens":135,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:42:26"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010984731483844355,"emotions":[],"relationId":"6af67912f4429d1fd72f7b40","courseProgressId":0,"tsGen":1794537746446,"createTime":"2026-11-13 10:42:26","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67912f4429d1fd72f7b40","chatId":"a6652573b2df4a55a7a53de1228006ae","sessionId":null,"userId":99863,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"可能都有吧。我平时不太爱跟人说这些，怕别人觉得我矫情……而且，有些事说出来，别人也未必懂。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010984731483844355,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"happy","name":"快乐","value":2,"sort":1},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":1,"sort":7}],"relationId":"6af67912f4429d1fd72f7b41","courseProgressId":0,"tsGen":1794537746443,"createTime":"2026-11-13 10:42:26","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6790ef4429d1fd72f7b3c","chatId":"a6652573b2df4a55a7a53de1228006ae","sessi