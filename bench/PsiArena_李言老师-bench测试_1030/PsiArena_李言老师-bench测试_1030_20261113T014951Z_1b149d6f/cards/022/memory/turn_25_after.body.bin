y","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af670fcf4429d1fd72f6fd0","courseProgressId":0,"tsGen":1794535676852,"createTime":"2026-11-13 10:07:56","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af670f8f4429d1fd72f6fc3","chatId":"ae4f9d2ecc2e4881b5a79d83bbe0135c","sessionId":null,"userId":99803,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那就从最模糊的那一点开始吧，不用说得有条理。最近一次觉得心里堵得慌，是什么时候，当时你在做什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那就从最模糊的那一点开始吧，不用说得有条理。最近一次觉得心里堵得慌，是什么时候，当时你在做什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1624,"promptTokens":1887,"completionTokens":69,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:07:52"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0052183384280468596,"emotions":[],"relationId":"6af670f8f4429d1fd72f6fc2","courseProgressId":0,"tsGen":1794535672223,"createTime":"2026-11-13 10:07:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af670f8f4429d1fd72f6fc2","chatId":"ae4f9d2ecc2e4881b5a79d83bbe0135c","sessionId":null,"userId":99803,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"可能……都有吧。有些事一想起来就烦，我就赶紧想别的去了。而且说真的，我也不知道从哪儿说起，感觉乱七八糟的。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,