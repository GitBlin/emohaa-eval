{"success":true,"code":"000","message":null,"data":{"totalAmount":6,"totalPageCount":1,"pageNum":0,"itemCount":6,"content":[{"pageNum":0,"pageSize":0,"id":"6af670f4f4429d1fd72f6fb9","chatId":"ae4f9d2ecc2e4881b5a79d83bbe0135c","sessionId":null,"userId":99803,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"累和堵都是真的，不是矫情。小事堆久了也会压人，这很正常。你说“讲不上来”，是那些事太零碎，还是不太敢去碰它们？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"累和堵都是真的，不是矫情。小事堆久了也会压人，这很正常。你说“讲不上来”，是那些事太零碎，还是不太敢去碰它们？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1722,"promptTokens":1773,"completionTokens":80,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:07:48"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008572840694116204,"emotions":[],"relationId":"6af670f4f4429d1fd72f6fb8","courseProgressId":0,"tsGen":1794535668328,"createTime":"2026-11-13 10:07:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af670f4f4429d1fd72f6fb8","chatId":"ae4f9d2ecc2e4881b5a79d83bbe0135c","sessionId":null,"userId":99803,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最近……唉，我也说不太清楚。就是总觉得很累，心里堵得慌，但要说具体是哪件事，我又讲不上来。好像都是些小事，可堆在一起就……我也知道这样挺矫情的。<第3轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":6,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008572840694116204,"emotions":[],"relationId":"6af670f4f