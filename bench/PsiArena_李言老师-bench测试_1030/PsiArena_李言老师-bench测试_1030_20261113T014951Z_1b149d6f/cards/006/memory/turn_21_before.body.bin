rust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af66dabf4429d1fd72f68c3","courseProgressId":0,"tsGen":1794534827657,"createTime":"2026-11-13 09:53:47","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66da8f4429d1fd72f68b9","chatId":"9e0ec675f5ca4d0d803fdbe99bb5dade","sessionId":null,"userId":99787,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"每天装作没看见，回家又不想说话，那股劲儿好像一直憋着没处去。家里人说你脾气变了，他们看到的是什么样的变化？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"每天装作没看见，回家又不想说话，那股劲儿好像一直憋着没处去。家里人说你脾气变了，他们看到的是什么样的变化？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1782,"promptTokens":2350,"completionTokens":94,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:53:44"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.042074210186013365,"emotions":[],"relationId":"6af66da8f4429d1fd72f68b8","courseProgressId":0,"tsGen":1794534824108,"createTime":"2026-11-13 09:53:44","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66da8f4429d1fd72f68b8","chatId":"9e0ec675f5ca4d0d803fdbe99bb5dade","sessionId":null,"userId":99787,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"放下？谈不上放下。就是每天照常去上班，装作没看见，回家也不想说话。时间长了，人也变得闷闷的，家里人都说我脾气变了。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.042074210186013365,"emotions":[{"code":"sadness","name":"悲伤","value":7,"sort":8},{"code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"calm","name":"平静","value":5,"sort":4},{"code":"anger","name":"愤怒","value":3,"sort":7},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af66da8f4429d1fd72f68b9","courseProgressId":0,"tsGen":1794534824105,"createTime":"2026-11-13 09:53:44","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66da4f4429d1fd72f68b4","chatId":"9e0ec675f5ca4d0d803fdbe99bb5dade","sessionId":null,"userId":99787,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听你说“反映过，没人当回事”，我心里有点发沉——那种认真了却落空的感觉，确实很消耗人。你说自己可能太较真，我倒觉得，更值得留意的是那份“说了也没用”之后的无力。反映之后，你心里是怎么放下、或者怎么带着这件事去上班的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听你说“反映过，没人当回事”，我心里有点发沉——那种认真了却落空的感觉，确实很消耗人。你说自己可能太较真，我倒觉得，更值得留意的是那份“说了也没用”之后的无力。反映之后，你心里是怎么放下、或者怎么带着这件事去上班的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2562,"promptTokens":2091,"completionTokens":172,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:53:40"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00590965