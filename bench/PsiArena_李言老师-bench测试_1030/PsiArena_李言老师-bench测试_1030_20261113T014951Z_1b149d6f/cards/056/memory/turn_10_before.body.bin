{"success":true,"code":"000","message":null,"data":{"totalAmount":18,"totalPageCount":1,"pageNum":0,"itemCount":18,"content":[{"pageNum":0,"pageSize":0,"id":"6af6778af4429d1fd72f7992","chatId":"b9413ba7e5884f7893c428899d1ad7de","sessionId":null,"userId":99856,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那张被放在一边的奖状，你记了这么久，说明那一刻真的很失落。慢慢地，好像就变成了“我得有用、得做出点什么，才会被看见”。你有没有发现，现在在家里插不上话时，心里冒出来的也是类似的感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那张被放在一边的奖状，你记了这么久，说明那一刻真的很失落。慢慢地，好像就变成了“我得有用、得做出点什么，才会被看见”。你有没有发现，现在在家里插不上话时，心里冒出来的也是类似的感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2050,"promptTokens":2921,"completionTokens":122,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:35:54"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007574004067474465,"emotions":[],"relationId":"6af6778af4429d1fd72f7991","courseProgressId":0,"tsGen":1794537354579,"createTime":"2026-11-13 10:35:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6778af4429d1fd72f7991","chatId":"b9413ba7e5884f7893c428899d1ad7de","sessionId":null,"userId":99856,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"可能是小时候吧。我记得有一次拿了奖状回家，他们看了一眼就放一边了，说忙。后来我就觉得，得做点“有用”的事，他们才会看我一眼。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007574004067474465,"emotions":[],"relationId":"6af6778af4429d1fd72f7992","courseProgressId":0,"tsGen":1794537354576,"createTime":"2026-11-13 10:35:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67786f4429d1fd72f798c","chatId":"b9413ba7e5884f7893c428899d1ad7de","sessionId":null,"userId":99856,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你能把这些说出来，已经很不容易了。你反复用“矫情”说自己，可我听到的是一个一直在忍、怕给别人添麻烦的人。这种自我怀疑，是从什么时候开始跟着你的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你能把这些说出来，已经很不容易了。你反复用“矫情”说自己，可我听到的是一个一直在忍、怕给别人添麻烦的人。这种自我怀疑，是从什么时候开始跟着你的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1755,"promptTokens":2349,"completionTokens":92,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:35:50"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012429470905189798,"emotions":[],"relationId":"6af67786f4429d1fd72f798b","courseProgressId":0,"tsGen":1794537350588,"createTime":"2026-11-13 10:35:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67786f4429d1fd72f798b","chatId":"b9413ba7e5884f7893c428899d1ad7de","sessionId":null,"userId":99856,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"跟谁说啊……其实没怎么跟人说。我丈夫也不太聊这些，我怕他觉得我事多。有时候就想，是不是我自己太矫情了。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012429470905189798,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67786f4429d1fd72f798c","courseProgressId":0,"tsGen":1794537350585,"createTime":"2026-11-13 10:35:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67781f4429d1fd72f7986","chatId":"b9413ba7e5884f7893c428899d1ad7de","sessionId":null,"userId":99856,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不乱，我跟得上，你说的这些挺清楚的。你一边说心里堵，一边又替家里说话，这份体谅很不容易。只是体谅别人和照顾自己的感受，其实可以同时存在。你平时有不舒服的时候，一般会跟谁说呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不乱，我跟得上，你说的这些挺清楚的。你一边说心里堵，一边又替家里说话，这份体谅很不容易。只是体谅别人和照顾自己的感受，其实可以同时存在。你平时有不舒服的时候，一般会跟谁说呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1950,"promptTokens":2219,"completionTokens":106,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:35:45"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219426643055025,"emotions":[],"relationId":"6af67781f4429d1fd72f7985","courseProgressId":0,"tsGen":1794537345409,"createTime":"2026-11-13 10:35:45","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67781f4429d1fd72f7985","chatId":"b9413ba7e5884f7893c428899d1ad7de","sessionId":null,"userId":99856,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"挺多的吧……不过我也不想说家里太多不好，毕竟他们也不容易。那个，我是不是说得太乱了？<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219426643055025,"emotions":[{"code":"calm","name":"平静","value":5,"sort":4},{"code":"trust","name":"信任","value":4,"sort":3},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"fear","name":"恐惧","value":0,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67781f4429d1fd72f7986","courseProgressId":0,"tsGen":1794537345406,"createTime":"2026-11-13 10:35:45","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6777df4429d1fd72f7981","chatId":"b9413ba7e5884f7893c428899d1ad7de","sessionId":null,"userId":99856,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"插不上话的时候，人很容易觉得自己在那一刻是“多余的”，这种在意并不小题大做。你嘴上说没什么，心里却堵着，说明它对你有些分量。那种被晾在一边的感觉，你以前在家里别的场合也遇到过吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"插不上话的时候，人很容易觉得自己在那一刻是“多余的”，这种在意并不小题大做。你嘴上说没什么，心里却堵着，说明它对你有些分量。那种被晾在一边的感觉，你以前在家里别的场合也遇到过吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2390,"promptTokens":2104,"completionTokens":155,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:35:41"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909063060552752,"emotions":[],"relationId":"6af6777df4429d1fd72f7980","courseProgressId":0,"tsGen":1794537341694,"createTime":"2026-11-13 10:35:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6777df4429d1fd72f7980","chatId":"b9413ba7e5884f7893c428899d1ad7de","sessionId":null,"userId":99856,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是吃饭的时候吧……我妈一直在说我弟的事，我插不上话。其实也没什么大不了的，我也不知道自己干嘛这么在意。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909063060552752,"emotions":[{"code":"calm","name":"平静","value":5,"sort":4},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"fear","name":"恐惧","value":0,"sort":6}],"relationId":"6af6777df4429d1fd72f7981","courseProgressId":0,"tsGen":1794537341691,"createTime":"2026-11-13 10:35:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67776f4429d1fd72f797e","chatId":"b9413ba7e5884f7893c428899d1ad7de","sessionId":null,"userId":99856,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你提到“从小就这样”，又特意说到回家之后更堵，我留意到“家”这个环境好像让这种感觉变重了。听起来不是偶然的。在家的这段时间，有没有哪个具体的时刻或场景，让你觉得堵得最厉害？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你提到“从小就这样”，又特意说到回家之后更堵，我留意到“家”这个环境好像让这种感觉变重了。听起来不是偶然的。在家的这段时间，有没有哪个具体的时刻或场景，让你觉得堵得最厉害？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2528,"promptTokens":1865,"completionTokens":189,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:35:34"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00857463322828159,"emotions":[],"relationId":"6af67776f4429d1fd72f797d","courseProgressId":0,"tsGen":1794537334462,"createTime":"2026-11-13 10:35:34","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67776f4429d1fd72f797d","chatId":"b9413ba7e5884f7893c428899d1ad7de","sessionId":null,"userId":99856,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……好像很久了，从小就这样吧。不过最近更明显一点，就是放假回家之后，心里特别堵。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00857463322828159,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67776f4429d1fd72f797e","courseProgressId":0,"tsGen":1794537334459,"createTime":"2026-11-13 10:35:34","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67770f4429d1fd72f797c","chatId":"b9413ba7e5884f7893c428899d1ad7de","sessionId":null,"userId":99856,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听得出来，那种“怪怪的”感觉让你挺难受的，又说不清从哪儿来——这其实很常见，情绪有时比原因先到。家里的事你不想细说也没关系，我们可以从感觉本身聊起。这种感觉大概是什么时候开始变得明显的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听得出来，那种“怪怪的”感觉让你挺难受的，又说不清从哪儿来——这其实很常见，情绪有时比原因先到。家里的事你不想细说也没关系，我们可以从感觉本身聊起。这种感觉大概是什么时候开始变得明显的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2222,"promptTokens":1862,"completionTokens":176,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:35:28"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009703788257353664,"emotions":[],"relationId":"6af67770f4429d1fd72f797b","courseProgressId":0,"tsGen":1794537328741,"createTime":"2026-11-13 10:35:28","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67770f4429d1fd72f797b","chatId":"b9413ba7e5884f7893c428899d1ad7de","sessionId":null,"userId":99856,"orgId":3721,"botId":1030,"isGreeting":fal