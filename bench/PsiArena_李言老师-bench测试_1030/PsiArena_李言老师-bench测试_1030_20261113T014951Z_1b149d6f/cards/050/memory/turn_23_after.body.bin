糟地混在一起？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"五点醒来，天还黑着，人却清醒得难受，那种滋味确实很熬人。先别硬逼自己睡回去，醒来后可以开盏小灯、做点安静的事，让身体松一松。你醒着的时候，脑子里转的多是同一件事，还是各种念头乱糟糟地混在一起？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2712,"promptTokens":1856,"completionTokens":219,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:29:10"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006690621560670085,"emotions":[],"relationId":"6af675f6f4429d1fd72f7758","courseProgressId":0,"tsGen":1794536950952,"createTime":"2026-11-13 10:29:10","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af675f6f4429d1fd72f7758","chatId":"ec1f309f2c874a9c95e57e42a9a599c6","sessionId":null,"userId":99849,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"凌晨吧……每天五点就醒了，醒了就睡不着，脑子里乱七八糟的。其实白天晚上都差不多，我也说不好哪一刻最难受。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006690621560670085,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"s