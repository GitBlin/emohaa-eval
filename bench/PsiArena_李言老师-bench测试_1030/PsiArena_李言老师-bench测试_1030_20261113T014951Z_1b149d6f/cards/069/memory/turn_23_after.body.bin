name":"厌恶","value":5,"sort":9},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67a33f4429d1fd72f7ccc","courseProgressId":0,"tsGen":1794538035559,"createTime":"2026-11-13 10:47:15","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67a2ff4429d1fd72f7cc9","chatId":"0126c66c77b5433983a4a506f7a476e1","sessionId":null,"userId":99874,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不怪。紧张的时候，人会不自觉地找点能控制的事做，洗手、换衣服，像是在把某种说不清的“脏”或不安冲掉。做完那一下，你心里是稍微松一点，还是反而更紧？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不怪。紧张的时候，人会不自觉地找点能控制的事做，洗手、换衣服，像是在把某种说不清的“脏”或不安冲掉。做完那一下，你心里是稍微松一点，还是反而更紧？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2548,"promptTokens":3149,"completionTokens":158,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:47:11"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014058356945476882,"emotions":[],"relationId":"6af67a2ff4429d1fd72f7cc8","courseProgressId":0,"tsGen":1794538031010,"createTime":"2026-11-13 10:47:11","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67a2ff4429d1fd72f7cc8","chatId":"0126c66c77b5433983a4a506f7a476e1","sessionId":null,"userId":99874,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"胸口有点闷，手也有点凉。嗯……其实我平时紧张的时候，就会忍不住一直洗手、换衣服，好像这样能干净点。我知道这听着挺怪。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014058356945476882,"emotions":[{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67a2ff4429d1fd72f7cc9","courseProgressId":0,"tsGen":1794538031007,"createTime":"2026-11-13 10:47:11","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67a29f4429d1fd72f7cc0","chatId":"0126c66c77b5433983a4a506f7a476e1","sessionId":null,"userId":99874,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不矛盾，这是很真实的心情。一个人可以同时让你害怕、也让你记得他的好，这两份感受都是真的，不用非选一个。你能这样诚实地说出来，已经很难得了。那说到这些的时候，你身体上有什么感觉吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不矛盾，这是很真实的心情。一个人可以同时让你害怕、也让你记得他的好，这两份感受都是真的，不用非选一个。你能这样诚实地说出来，已经很难得了。那说到这些的时候，你身体上有什么感觉吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1998,"promptTokens":3151,"completionTokens":92,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:47:05"}],"imgs":null,"regenerat