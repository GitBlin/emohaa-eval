":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af68276f4429d1fd72f83d4","courseProgressId":0,"tsGen":1794540150916,"createTime":"2026-11-13 11:22:30","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68272f4429d1fd72f83d0","chatId":"c43876ce1b234887981d794ca1444699","sessionId":null,"userId":99909,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听着有点心酸——家人在身边，可真正说上话的时候却很少，还要被拿去比较。久了就学会把话咽回去，这其实是你在保护自己。在家里，有没有哪一刻你觉得稍微被看见过一点？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听着有点心酸——家人在身边，可真正说上话的时候却很少，还要被拿去比较。久了就学会把话咽回去，这其实是你在保护自己。在家里，有没有哪一刻你觉得稍微被看见过一点？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2028,"promptTokens":3012,"completionTokens":109,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:22:26"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007576815065162184,"emotions":[],"relationId":"6af68272f4429d1fd72f83cf","courseProgressId":0,"tsGen":1794540146680,"createTime":"2026-11-13 11:22:26","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68272f4429d1fd72f83cf","chatId":"c43876ce1b234887981d794ca1444699","sessionId":null,"userId":99909,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"希望……别急着评价我吧。我爸妈总爱拿我和别人比，说多了我就更不想讲了。在家里好像也没什么人认真聊这些，大家都各忙各的。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":n