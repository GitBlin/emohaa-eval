diaTime":null,"interceptContent":null,"contents":[{"content":"能感觉到你一边想弄清楚，一边又担心自己是不是把问题放大了。其实“怕想太多”这个念头本身，也挺值得说说的。晚上一个人的时候，那种堵着的感觉更像什么——是空落落的，还是有什么事反复冒出来？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1969,"promptTokens":1856,"completionTokens":130,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:44:44"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.015901757854004373,"emotions":[],"relationId":"6af6799cf4429d1fd72f7c0f","courseProgressId":0,"tsGen":1794537884525,"createTime":"2026-11-13 10:44:44","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6799cf4429d1fd72f7c0f","chatId":"032d324a7b3d462f99341f70f4c13a0f","sessionId":null,"userId":99871,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"可能是这几天吧……我也说不上具体哪天。就是晚上一个人的时候特别明显，白天忙起来还好。其实我也怕自己是不是想太多了。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.015901757854004373,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6799cf4429d1fd72f7c10","courseProgressId":0,"tsGen":1794537884522,"createTime":"2026-11-13 10:44:44