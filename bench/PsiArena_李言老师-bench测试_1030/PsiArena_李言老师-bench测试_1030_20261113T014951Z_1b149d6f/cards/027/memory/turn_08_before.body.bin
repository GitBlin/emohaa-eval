{"success":true,"code":"000","message":null,"data":{"totalAmount":14,"totalPageCount":1,"pageNum":0,"itemCount":14,"content":[{"pageNum":0,"pageSize":0,"id":"6af671b6f4429d1fd72f70fa","chatId":"6188f1033080475d9d383954cc5e256a","sessionId":null,"userId":99808,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"被最亲近的人打断，心里不舒服是很自然的，这不是敏感，更像是一种“我又没被听见”的熟悉感被触发了。你当时没说完的那句话，是想跟她讲什么呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"被最亲近的人打断，心里不舒服是很自然的，这不是敏感，更像是一种“我又没被听见”的熟悉感被触发了。你当时没说完的那句话，是想跟她讲什么呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1923,"promptTokens":2247,"completionTokens":98,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:11:02"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009703161317181868,"emotions":[],"relationId":"6af671b6f4429d1fd72f70f9","courseProgressId":0,"tsGen":1794535862846,"createTime":"2026-11-13 10:11:02","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af671b6f4429d1fd72f70f9","chatId":"6188f1033080475d9d383954cc5e256a","sessionId":null,"userId":99808,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最近……唉，其实也没什么大事。就是我妈又说我工作上的事，我还没说完她就打断了。我是不是有点太敏感了？你会不会也觉得我是在小题大做？<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009703161317181868,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af671b6f4429d1fd72f70fa","courseProgressId":0,"tsGen":1794535862843,"createTime":"2026-11-13 10:11:02","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af671b1f4429d1fd72f70f4","chatId":"6188f1033080475d9d383954cc5e256a","sessionId":null,"userId":99808,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“乱”也没关系，不用现在就理清楚，能说出来一点已经不容易了。很多时候心里的事本来就是一团，边讲边看反而会慢慢浮出线索。要是愿意，我们可以先从最近一次让你有“说了也白说”的感觉说起，可以吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“乱”也没关系，不用现在就理清楚，能说出来一点已经不容易了。很多时候心里的事本来就是一团，边讲边看反而会慢慢浮出线索。要是愿意，我们可以先从最近一次让你有“说了也白说”的感觉说起，可以吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2010,"promptTokens":1991,"completionTokens":114,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:10:57"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005910745773827464,"emotions":[],"relationId":"6af671b1f4429d1fd72f70f3","courseProgressId":0,"tsGen":1794535857666,"createTime":"2026-11-13 10:10:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af671b1f4429d1fd72f70f3","chatId":"6188f1033080475d9d383954cc5e256a","sessionId":null,"userId":99808,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"……好像一直都是这样吧。我也讲不太明白，就是那种，说了也没人在意的感觉。算了，这个说起来挺乱的。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005910745773827464,"emotions":[],"relationId":"6af671b1f4429d1fd72f70f4","courseProgressId":0,"tsGen":1794535857663,"createTime":"2026-11-13 10:10:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af671adf4429d1fd72f70e6","chatId":"6188f1033080475d9d383954cc5e256a","sessionId":null,"userId":99808,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"说了半天却没人真听进去，那种感觉确实挺累的，久了也会让人怀疑开口还有没有意义。在家里，是从什么时候开始让你觉得说了也白说的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"说了半天却没人真听进去，那种感觉确实挺累的，久了也会让人怀疑开口还有没有意义。在家里，是从什么时候开始让你觉得说了也白说的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2138,"promptTokens":2005,"completionTokens":119,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:10:53"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01590320566248778,"emotions":[],"relationId":"6af671adf4429d1fd72f70e5","courseProgressId":0,"tsGen":1794535853748,"createTime":"2026-11-13 10:10:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"cons