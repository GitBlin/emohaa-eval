ag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67883f4429d1fd72f7ab4","chatId":"f05605ee3efe44e0a6ca35a4837bfe21","sessionId":null,"userId":99860,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"话到嘴边又咽回去，那种感觉其实挺不好受的，像有个东西卡在那儿，最后只能自己吞下去。不用急着回忆细节，我们慢慢来——那次你想说的时候，心里大概是在担心什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"话到嘴边又咽回去，那种感觉其实挺不好受的，像有个东西卡在那儿，最后只能自己吞下去。不用急着回忆细节，我们慢慢来——那次你想说的时候，心里大概是在担心什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2359,"promptTokens":3338,"completionTokens":142,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:40:03"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006689988232664114,"emotions":[],"relationId":"6af67883f4429d1fd72f7ab3","courseProgressId":0,"tsGen":1794537603009,"createTime":"2026-11-13 10:40:03","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67883f4429d1fd72f7ab3","chatId":"f05605ee3efe44e0a6ca35a4837bfe21","sessionId":null,"userId":99860,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（摇头，又迟疑）有一次吧……好像是想说什么，话到嘴边又咽回去了。（皱眉）我记不清了，反正最后没说。<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":26,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006689988232664114,"emotions":[{"code":"calm","name":"平静","value":3,"sort":4},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67883f4429d1fd72f7ab4","courseProgressId":0,"tsGen":1794537603006,"createTime":"2026-11-13 10:40:03","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6787ef4429d1fd72f7ab2","chatId":"f05605ee3efe44e0a6ca35a4837bfe21","sessionId":null,"userId":99860,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"奶奶和姑姑是真心对你好，可她们那句“别添乱”，又像在悄悄告诉你：你的需要得先让路。这大概就是你学会忍的地方吧。那在她们面前，你有没有哪次真的没忍住，说了点什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"奶奶和姑姑是真心对你好，可她们那句“别添乱”，又像在悄悄告诉你：你的需要得先让路。这大概就是你学会忍的地方吧。那在她们面前，你有没有哪次真的没忍住，说了点什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2425,"promptTokens":2592,"completionTokens":144,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:39:58"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575904535701083,"emotions":[],"relationId":"6af6787ef4429d1fd72f7ab1","courseProgressId":0,"tsGen":1794537598649,"createTime":"2026-11-13 10:39:58","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6787ef4429d1fd72f7ab1","chatId":"f05605ee3efe44e0a6ca35a4837bfe21","sessionId":null,"userId":99860,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（想了很久，有点走神）我奶奶和姑姑……她们对我挺好的，可她们也总说“你爸妈忙，别添乱”。（苦笑一下）<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575904535701083,"emotions":[],"relationId":"6af6787ef4429d1fd72f7ab2","courseProgressId":0,"tsGen":1794537598647,"createTime":"2026-11-13 10:39:58","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["烦闷","压抑","担忧","不安","委屈","自我抑制"],"originalText":["有时候听到我妈在那边忙来忙去的声音，我就特别烦，也不知道烦什么。","胸口吧，闷闷的。","说了也没用，反正他们忙。","我怕一开口，对方觉得我事多。","好像从小就是这样，忍忍就过去了。","她们也总说“你爸妈忙，别添乱”。"]},"conversation":{"type":"人际关系处理","topic":"家庭沟通与情绪压抑：来访者习惯隐藏自己的需求，担心表达后被嫌“事多”，这与父母忙碌、家人常提醒“别添乱”的互动经历有关。"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67879f4429d1fd72f7aae","chatId":"f05605ee3efe44e0a6ca35a4837bfe21","sessionId":null,"userId":99860,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“忍忍就过去了”——这句话你说得很顺，像是很早就学会的。我想轻轻问一句：你第一次学会这样忍的时候，身边有没有人，本来是可以帮你说句话的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“忍忍就过去了”——这句话你说得很顺，像是很早就学会的。我想轻轻问一句：你第一次学会这样忍的时候，身边有没有人，本来是可以帮你说句话的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2495,"promptTokens":2505,"completionTokens":164,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:39:53"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isS