厌恶","value":5,"sort":9},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66d1bf4429d1fd72f6821","courseProgressId":0,"tsGen":1794534683829,"createTime":"2026-11-13 09:51:23","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66d16f4429d1fd72f6817","chatId":"a2587589dc9242dbb9ad8dae071e797b","sessionId":null,"userId":99782,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你心里其实是想凑过去的，只是那个“会不够好”的预感先一步把你拉住了。想靠近人，本来就是很自然的愿望。如果真走过去，你最怕发生什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你心里其实是想凑过去的，只是那个“会不够好”的预感先一步把你拉住了。想靠近人，本来就是很自然的愿望。如果真走过去，你最怕发生什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2100,"promptTokens":2628,"completionTokens":91,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:51:18"}],"imgs":null,"regenerations":0,"seqNum":39,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218081397979743,"emotions":[],"relationId":"6af66d16f4429d1fd72f6816","courseProgressId":0,"tsGen":1794534678841,"createTime":"2026-11-13 09:51:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66d16f4429d1fd72f6816","chatId":"a2587589dc9242dbb9ad8dae071e797b","sessionId":null,"userId":99782,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（点头）是那种预感吧。一进门，看到他们聊得热闹，我就自动绷起来了。（犹豫）其实有时候……我也想凑过去。<第19轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":38,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218081397979743,"emotions":[{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"expect","name":"期待","value":3,"sort":2},{"code":"happy","name":"快乐","value":2,"sort":1},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66d16f4429d1fd72f6817","courseProgressId":0,"tsGen":1794534678839,"createTime":"2026-11-13 09:51:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66d12f4429d1fd72f680f","chatId":"a2587589dc9242dbb9ad8dae071e797b","sessionId":null,"userId":99782,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那点轻松一进教室就没了，听着像被什么一下收走了。是教室里的某个具体东西让它消失的，比如同学的目光、课业，还是那种“又得开始绷着”的预感？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那点轻松一进教室就没了，听着像被什么一下收走了。是教室里的某个具体东西让它消失的，比如同学的目光、课业，还是那种“又得开始绷着”的预感？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1842,"promptTokens":2638,"completionTokens":84,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:51:14"}],"imgs":null,"regenerations":0,"seqNum":37,"responseSource":"agent:llm","isSuicide":false,"isSui