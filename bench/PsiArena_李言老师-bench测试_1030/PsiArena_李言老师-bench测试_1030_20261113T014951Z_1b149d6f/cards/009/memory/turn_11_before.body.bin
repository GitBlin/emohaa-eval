{"success":true,"code":"000","message":null,"data":{"totalAmount":20,"totalPageCount":1,"pageNum":0,"itemCount":20,"content":[{"pageNum":0,"pageSize":0,"id":"6af66e75f4429d1fd72f6ae7","chatId":"e7621015373846ddbcecbfeb34d1d262","sessionId":null,"userId":99790,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你说“丢人”，可我听到的更像心疼——你看着妈妈累成那样，也看着自己慢慢走进去。像她不是失败，那是你从小最熟悉的活法。倒是你小时候那句“我以后不要这样”，现在还在你心里吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你说“丢人”，可我听到的更像心疼——你看着妈妈累成那样，也看着自己慢慢走进去。像她不是失败，那是你从小最熟悉的活法。倒是你小时候那句“我以后不要这样”，现在还在你心里吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2261,"promptTokens":2979,"completionTokens":127,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:57:09"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02032567503230775,"emotions":[],"relationId":"6af66e75f4429d1fd72f6ae6","courseProgressId":0,"tsGen":1794535029161,"createTime":"2026-11-13 09:57:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e75f4429d1fd72f6ae6","chatId":"e7621015373846ddbcecbfeb34d1d262","sessionId":null,"userId":99790,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"没有……好像真没有。我妈就是那种什么都答应的人，累得不行也不说。我小时候想过，我以后不要这样，可现在……唉，说出来有点丢人，我好像越来越像她了。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicid