ents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575660188384179,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"trust","name":"信任","value":4,"sort":3},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"happy","name":"快乐","value":2,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af66e6bf4429d1fd72f6ac0","courseProgressId":0,"tsGen":1794535019293,"createTime":"2026-11-13 09:56:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e66f4429d1fd72f6aa2","chatId":"e7621015373846ddbcecbfeb34d1d262","sessionId":null,"userId":99790,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你的担心很正常，这些确实该先问清楚。我们聊的内容我会保密，不会跟你的同事或认识的人提起。只有一种情况例外——如果你有伤害自己或他人的风险，我需要联系能保护你的人，那时我也会先跟你说明。这样讲，你会不会放心一些？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你的担心很正常，这些确实该先问清楚。我们聊的内容我会保密，不会跟你的同事或认识的人提起。只有一种情况例外——如果你有伤害自己或他人的风险，我需要联系能保护你的人，那时我也会先跟你说明。这样讲，你会不会放心一些？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2059,"promptTokens":2706,"completionTokens":111,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:56:54"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575370886373364,"emotions":[],"relationId":"6af66e66f4429d1fd72f6aa1","courseProgressId":0,"tsGen":1794535014267,"createTime":"2026-11-13 09:56:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e66f4429d1fd72f6aa1","chatId":"e7621015373846ddbcecbfeb34d1d262","sessionId":null,"userId":99790,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"好……那我想问一下，我们聊的这些，你会跟别人说吗？我就是有点担心，被认识的人知道。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575370886373364,"emotions":[{"code":"fear","name":"恐惧","value":6,"sort":6},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"sadness","name":"悲伤","value":1,"sort":8},{"code":"dislike","name":"厌恶","value":1,"sort":9},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66e66f4429d1fd72f6aa2","courseProgressId":0,"tsGen":1794535014263,"createTime":"2026-11-13 09:56:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e62f4429d1fd72f6a88","chatId":"e7621015373846ddbcecbfeb34d1d262","sessionId":null,"userId":99790,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"谢谢你直接告诉我，是我问得太急了，抱歉。在这里你不需要按我的节奏来，家里的事想说多少、什么时候说，都由你决定。我不会觉得你敏感——你愿意把这些讲出来，本身就需要勇气。那我们先回到你觉得安全的范围内，好吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"谢谢你直接告诉我，是我问得太急了，抱歉。在这里你不需要按我的节奏来，家里的事想说多少、什么时候说，都由你决定。我不会觉得你敏感——你愿意把这些讲出来，本身就需要勇气。那我们先回到你觉得安全的范围内，好吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2026,"promptTokens":1968,"completionTokens":104,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:56:50"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004609039477538234,"emotions":[],"relationId":"6af66e62f4429d1fd72f6a87","courseProgressId":0,"tsGen":1794535010174,"createTime":"2026-11-13 09:56:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e62f4429d1fd72f6a87","chatId":"e7621015373846ddbcecbfeb34d1d262","sessionId":null,"userId":99790,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……你问得有点快。我们才刚开始聊，我还没想好要不要说家里的事。而且我不太确定，你会不会也觉得我太敏感了。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004609039477538234,"emotions":[{"code":"calm","name":"平静","value":3,"sort":4},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"sadness","name":"悲伤","value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66e62f4429d1fd72f6a88","courseProgressId":0,"tsGen":1794535010171,"createTime":"2026-11-13 09:56:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sour