4,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":1,"sort":5}],"relationId":"6af67123f4429d1fd72f702e","courseProgressId":0,"tsGen":1794535715520,"createTime":"2026-11-13 10:08:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6711ff4429d1fd72f7024","chatId":"0c37f8e6e664458c8e3671e96ff38d2a","sessionId":null,"userId":99802,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那个“愣了一下”挺珍贵的——一个跟了你这么多年的“默认”，今天第一次被你自己看见了。我想问的是：这个“都是我的错”的默认，最早是从哪儿来的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那个“愣了一下”挺珍贵的——一个跟了你这么多年的“默认”，今天第一次被你自己看见了。我想问的是：这个“都是我的错”的默认，最早是从哪儿来的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":3082,"promptTokens":2588,"completionTokens":129,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:08:31"}],"imgs":null,"regenerations":0,"seqNum":35,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01242915211814877,"emotions":[],"relationId":"6af6711ff4429d1fd72f7023","courseProgressId":0,"tsGen":1794535711409,"createTime":"2026-11-13 10:08:31","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6711ff4429d1fd72f7023","chatId":"0c37f8e6e664458c8e3671e96ff38d2a","sessionId":null,"userId":99802,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"……听你这么一说，我愣了一下。好像我从来没想过这个角度，一直默认就是我的错。可她那样，可能真的只是累了。