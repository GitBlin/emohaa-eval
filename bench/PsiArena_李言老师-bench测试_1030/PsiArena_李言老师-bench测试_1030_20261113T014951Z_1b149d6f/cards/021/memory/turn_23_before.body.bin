nTokens":114,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:07:43"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010985704493484828,"emotions":[],"relationId":"6af670eff4429d1fd72f6fa9","courseProgressId":0,"tsGen":1794535663834,"createTime":"2026-11-13 10:07:43","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af670eff4429d1fd72f6fa9","chatId":"0c37f8e6e664458c8e3671e96ff38d2a","sessionId":null,"userId":99802,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……可能是吧。平时我不太愿意让人看出来我状态不好，总觉得说了也没用，还显得自己不够……不够撑得住。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010985704493484828,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af670eff4429d1fd72f6faa","courseProgressId":0,"tsGen":1794535663831,"createTime":"2026-11-13 10:07:43","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af670ebf4429d1fd72f6f9e","chatId":"0c37f8e6e664458c8e3671e96ff38d2a","sessionId":null,"userId":99802,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不会，我反而觉得你刚才说得挺真实的——“抓不住”本身就是一种状态，不是你的表达有问题。倒是你这一问让我有点在意：这种怕自己说得不够清楚的担心，是只在咨询里出现，平时跟人相处时也会有吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不会，我反而觉得你刚才说得挺真实的——“抓不住”本身就是一种状态，不是你的表达有问题。倒是你这一问让我有点在意：这种怕自己说得不够清楚的担心，是只在咨询里出现，平时跟人相处时也会有吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2424,"promptTokens":1985,"completionTokens":137,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:07:39"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012429322888683253,"emotions":[],"relationId":"6af670ebf4429d1fd72f6f9d","courseProgressId":0,"tsGen":1794535659382,"createTime":"2026-11-13 10:07:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af670ebf4429d1fd72f6f9d","chatId":"0c37f8e6e664458c8e3671e96ff38d2a","sessionId":null,"userId":99802,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"说不上来……好像先是一种感觉，闷闷的。念头倒是有，但很乱，抓不住。嗯……你们咨询师会不会觉得我这样说话太含糊了？<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012429322888683253,"emotions":[{"code":"calm","name":"平静","value":3,"sort":4},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af670ebf4429d1fd72f6f9e","courseProgressId":0,"tsGen":1794535659379,"createTime":"2026-11-13 10:07:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af670e7f4429d1fd72f6f98","chatId":"0c37f8e6e664458c8e3671e96ff38d2a","sessionId":null,"userId":99802,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"晚上醒来、脑子停不下来，那种“心里堵着却说不清”的感觉确实挺消耗人的。我们可以先不急着找原因，试着留意一下：你半夜醒过来的时候，脑子里最先冒出来的，通常是个念头，还是一种感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"晚上醒来、脑子停不下来，那种“心里堵着却说不清”的感觉确实挺消耗人的。我们可以先不急着找原因，试着留意一下：你半夜醒过来的时候，脑子里最先冒出来的，通常是个念头，还是一种感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2080,"promptTokens":1855,"completionTokens":129,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:07:35"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007574385556476095,"emotions":[],"relationId":"6af670e7f4429d1fd72f6f97","courseProgressId":0,"tsGen":1794535655021,"createTime":"2026-11-13 10:07:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af670e7f4429d1fd72f6f97","chatId":"0c37f8e6e664458c8e3671e96ff38d2a","sessionId":null,"userId":99802,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"睡眠吧……晚上老是醒，醒了就胡思乱想。不过我也说不上来具体在想什么，就是心里堵得慌。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>"