{"success":true,"code":"000","message":null,"data":{"totalAmount":14,"totalPageCount":1,"pageNum":0,"itemCount":14,"content":[{"pageNum":0,"pageSize":0,"id":"6af6702af4429d1fd72f6e6b","chatId":"c1e217068aab498e99eae5cd2b1b088a","sessionId":null,"userId":99797,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听你这么说，我心里有点沉。一边是“要维护家里”，一边是“憋着难受”，这两股劲一直在拉扯你。那种“说出来就是背叛”的感觉，更像是从小被反复教出来的，不是你自己想太多。这份顾全体面的要求，平时是谁最常提醒你的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听你这么说，我心里有点沉。一边是“要维护家里”，一边是“憋着难受”，这两股劲一直在拉扯你。那种“说出来就是背叛”的感觉，更像是从小被反复教出来的，不是你自己想太多。这份顾全体面的要求，平时是谁最常提醒你的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":3202,"promptTokens":2101,"completionTokens":238,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:04:26"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0052190673230785856,"emotions":[],"relationId":"6af6702af4429d1fd72f6e6a","courseProgressId":0,"tsGen":1794535466057,"createTime":"2026-11-13 10:04:26","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6702af4429d1fd72f6e6a","chatId":"c1e217068aab498e99eae5cd2b1b088a","sessionId":null,"userId":99797,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是……觉得家丑不可外扬吧。我从小就被教育要维护家里的体面，说出来好像是在背叛家里人一样。可憋在心里又特别难受。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0052190673230785856,"emotions":[],"relationId":"6af6702af4429d1fd72f6e6b","courseProgressId":0,"tsGen":1794535466054,"createTime":"2026-11-13 10:04:26","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67024f4429d1fd72f6e5c","chatId":"c1e217068aab498e99eae5cd2b1b088a","sessionId":null,"userId":99797,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"家里的事本来就容易让人觉得“说出来不太好”，这份犹豫我理解，也不代表你说错了什么。在这里，你可以慢慢来，不用一次讲透。如果愿意，能不能先说说，是哪种“不太好”的感觉让你卡住了？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"家里的事本来就容易让人觉得“说出来不太好”，这份犹豫我理解，也不代表你说错了什么。在这里，你可以慢慢来，不用一次讲透。如果愿意，能不能先说说，是哪种“不太好”的感觉让你卡住了？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1855,"promptTokens":2539,"completionTokens":76,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:04:20"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575749775239853,"emotions":[],"relationId":"6af67024f4429d1fd72f6e5b","courseProgressId":0,"tsGen":1794535460790,"createTime":"2026-11-13 10:04:20","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67024f4429d1fd72f6e5b","chatId":"c1e217068aab498e99eae5cd2b1b088a","sessionId":null,"userId":99797,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最放不下的……唉，我也不太知道怎么说清楚。就是跟父母有关的一些事，让我心里很乱，可我又觉得说出来好像不太好。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575749775239853,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67024f4429d1fd72f6e5c","courseProgressId":0,"tsGen":1794535460787,"createTime":"2026-11-13 10:04:20","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67020f4429d1fd72f6e53","chatId":"c1e217068aab498e99eae5cd2b1b088a","sessionId":null,"userId":99797,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你的担心很正常。咨询内容我会替你保密，不会随便告诉别人；只有在涉及人身安全这类特殊情况时，我才会和你商量怎么处理。至于“是不是想太多”，先别急着责怪自己，心慌和睡不好都是真实的反应。家里那件事，现在最让你放不下的是哪一部分？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你的担心很正常。咨询内容我会替你保密，不会随便告诉别人；只有在涉及人身安全这类特殊情况时，我才会和你商量怎么处理。至于“是不是想太多”，先别急着责怪自己，心慌和睡不好都是真实的反应。家里那件事，现在最让你放不下的是哪一部分？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2256,"promptTokens":2382,"completionTokens":111,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:04:16"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010982701570839214,"emotions":[],"relationId":"6af67020f4429d1fd72f6e52","courseProgressId":0,"tsGen":17