{"success":true,"code":"000","message":null,"data":{"totalAmount":20,"totalPageCount":1,"pageNum":0,"itemCount":20,"content":[{"pageNum":0,"pageSize":0,"id":"6af676caf4429d1fd72f78aa","chatId":"0b5c12c0bef04170886d8d8cdf35d048","sessionId":null,"userId":99852,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你刚说的那句挺关键——身体一直在给你信号，而你习惯先问“应该”，很少问“现在怎么样”。这不是奇怪，是太久没被允许照顾自己了。那今晚躺下脑子转的时候，通常都在想些什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你刚说的那句挺关键——身体一直在给你信号，而你习惯先问“应该”，很少问“现在怎么样”。这不是奇怪，是太久没被允许照顾自己了。那今晚躺下脑子转的时候，通常都在想些什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2007,"promptTokens":3190,"completionTokens":86,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:32:42"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005908218593249166,"emotions":[],"relationId":"6af676caf4429d1fd72f78a9","courseProgressId":0,"tsGen":1794537162418,"createTime":"2026-11-13 10:32:42","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676caf4429d1fd72f78a9","chatId":"0b5c12c0bef04170886d8d8cdf35d048","sessionId":null,"userId":99852,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"累的时候……肩膀和脖子是僵的，晚上躺下脑子还在转，睡不着。说起来有点奇怪，我好像很少去想身体怎么样，光顾着想自己“应该”怎么样。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005908218593249166,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"surprised","name":"惊讶","value":3,"sort":5},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"anger","name":"愤怒","value":1,"sort":7}],"relationId":"6af676caf4429d1fd72f78aa","courseProgressId":0,"tsGen":1794537162415,"createTime":"2026-11-13 10:32:42","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676c6f4429d1fd72f789f","chatId":"0b5c12c0bef04170886d8d8cdf35d048","sessionId":null,"userId":99852,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“太没用”这三个字，听起来更像是从小到大被反复说出来的，而不是你自己心里长出来的。你已经很努力在分清了。那如果暂时把“够不够努力”放到一边，只说身体的感受——你累的时候，身体是什么样子的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“太没用”这三个字，听起来更像是从小到大被反复说出来的，而不是你自己心里长出来的。你已经很努力在分清了。那如果暂时把“够不够努力”放到一边，只说身体的感受——你累的时候，身体是什么样子的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1885,"promptTokens":2882,"completionTokens":87,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:32:38"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02929608283981206,"emotions":[],"relationId":"6af676c6f4429d1fd72f789e","courseProgressId":0,"tsGen":1794537158113,"createTime":"2026-11-13 10:32:38","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676c6f4429d1fd72f789e","chatId":"0b5c12c0bef04170886d8d8cdf35d048","sessionId":null,"userId":99852,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"挺难受的……好像我的感受根本不算数。其实我也知道他们不是故意的，从小家里就这样，做什么都得做到最好，做不到就是不够努力。久了我也分不清，到底是真累，还是我自己太没用。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02929608283981206,"emotions":[{"code":"sadness","name":"悲伤","value":8,"sort":8},{"code":"dislike","name":"厌恶","value":8,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af676c6f4429d1fd72f789f","courseProgressId":0,"tsGen":1794537158110,"createTime":"2026-11-13 10:32:38","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676c2f4429d1fd72f7897","chatId":"0b5c12c0bef04170886d8d8cdf35d048","sessionId":null,"userId":99852,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“说了也没用，还显得我矫情”——这句话听着像是被堵回去太多次后，你自己也慢慢这么评价自己了。那种没劲被说成矫情，心里是什么滋味？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“说了也没用，还显得我矫情”——这句话听着像是被堵回去太多次后，你自己也慢慢这么评价自己了。那种没劲被说成矫情，心里是什么滋味？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2281,"promptTokens":2780,"completionTokens":131,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:32:34"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218819450868312,"emotions":[],"relationId":"6af676c2f4429d1fd72f7896","courseProgressId":0,"tsGen":1794537154304,"createTime":"2026-11-13 10:32:34","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676c2f4429d1fd72f7896","chatId":"0b5c12c0bef04170886d8d8cdf35d048","sessionId":null,"userId":99852,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"他们啊……大概就是“年轻人哪有那么多累的”，要么就开始讲他们当年多辛苦。所以后来我就不太说了，说了也没用，还显得我矫情。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218819450868312,"emotions":[{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"fear","name":"恐惧","value":0,"sort":6}],"relationId":"6af676c2f4429d1fd72f7897","courseProgressId":0,"tsGen":1794537154301,"createTime":"2026-11-13 10:32:34","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676bef4429d1fd72f788d","chatId":"0b5c12c0bef04170886d8d8cdf35d048","se