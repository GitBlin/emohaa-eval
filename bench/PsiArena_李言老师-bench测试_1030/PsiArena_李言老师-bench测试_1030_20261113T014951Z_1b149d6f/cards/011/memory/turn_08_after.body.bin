{"success":true,"code":"000","message":null,"data":{"totalAmount":16,"totalPageCount":1,"pageNum":0,"itemCount":16,"content":[{"pageNum":0,"pageSize":0,"id":"6af66e84f4429d1fd72f6b1f","chatId":"b07d100c541948a08c7b004cd5ff4d21","sessionId":null,"userId":99792,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你不太放心交给别人，好像孩子的事必须自己盯着才安心。这份“得我来”的背后，也许不只是较真，还藏着一份怕出错、怕被说不称职的紧张。你觉得，如果你真的松手一次，心里最担心会发生什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你不太放心交给别人，好像孩子的事必须自己盯着才安心。这份“得我来”的背后，也许不只是较真，还藏着一份怕出错、怕被说不称职的紧张。你觉得，如果你真的松手一次，心里最担心会发生什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2493,"promptTokens":2251,"completionTokens":169,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:57:24"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02297333742078785,"emotions":[],"relationId":"6af66e84f4429d1fd72f6b1e","courseProgressId":0,"tsGen":1794535044544,"createTime":"2026-11-13 09:57:24","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e84f4429d1fd72f6b1e","chatId":"b07d100c541948a08c7b004cd5ff4d21","sessionId":null,"userId":99792,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"有人是有的……家里人会搭把手。但说实话，我好像也不太放心交给别人，总觉得孩子的事得我自己来。可能是我太较真了吧。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02297333742078785,"emotions":[],"relationId":"6af66e84f4429d1fd72f6b1f","courseProgressId":0,"tsGen":1794535044541,"createTime":"2026-11-13 09:57:24","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e7ff4429d1fd72f6b0e","chatId":"b07d100c541948a08c7b004cd5ff4d21","sessionId":null,"userId":99792,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"孩子出生之后，这种感觉就一直在，轻重起伏——听起来像是从那时候起，你身上多了一份一直没卸下的东西。那段日子，你身边有人能替你分担一点吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"孩子出生之后，这种感觉就一直在，轻重起伏——听起来像是从那时候起，你身上多了一份一直没卸下的东西。那段日子，你身边有人能替你分担一点吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1835,"promptTokens":2664,"completionTokens":73,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:57:19"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014060806142419575,"emotions":[],"relationId":"6af66e7ff4429d1fd72f6b0d","courseProgressId":0,"tsGen":1794535039175,"createTime":"2026-11-13 09:57:19","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e7ff4429d1fd72f6b0d","chatId":"b07d100c541948a08c7b004cd5ff4d21","sessionId":null,"userId":99792,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"好像……有一阵子了。我也说不太清楚是从什么时候开始的，反正孩子出生以后，这种感觉就一直在，有时候轻一点，有时候特别重。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014060806142419575,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66e7ff4429d1fd72f6b0e","courseProgressId":0,"tsGen":1794535039172,"createTime":"2026-11-13 09:57:19","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e7af4429d1fd72f6b02","chatId":"b07d100c541948a08c7b004cd5ff4d21","sessionId":null,"userId":99792,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那份累，好像不只是身体的累，更像是心里一直绷着，还得装作没事。你怕说出来让家里担心，又怕他们觉得你不够好，于是那些话就只能自己扛着。这种扛着的感觉，是不是很久了？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那份累，好像不只是身体的累，更像是心里一直绷着，还得装作没事。你怕说出来让家里担心，又怕他们觉得你不够好，于是那些话就只能自己扛着。这种扛着的感觉，是不是很久了？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2269,"promptTokens":2542,"completionTokens":124,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:57:14"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.022968841788936878,"emotions":[],"relationId":"6af66e7af4429d1fd72f6b01","courseProgressId":0,"tsGen":1794535034707,"createTime":"2026-11-13 09:57:14","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e7af4429d1fd72f6b01","chatId":"b07d100c541948a08c7b004cd5ff4d21","sessionId":null,"userId":99792,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……算是有吧。其实我也不是想瞒着谁，就是有些话在家里说出来，好像只会让他们更担心，或者觉得我不够好。我最近就是很累，说不上来的那种累。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.022968841788936878,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66e7af4429d1fd72f6b02","courseProgressId":0,"tsGen":1794535034704,"createTime":"2026-11-13 09:57:14","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e75f4429d1fd72f6aec","chatId":"b07d100c541948a08c7b004cd5ff4d21","sessionId":null,"userId":99792,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"我不会随便找家里人，这点你可以放心。只有当你可能伤到自己或别人，我才会和你一起商量怎么找人帮忙，不会绕开你。你这么在意这件事，是不是心里有些话特别不想让家里知道？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我不会随便找家里人，这点你可以放心。只有当你可能伤到自己或别人，我才会和你一起商量怎么找人帮忙，不会绕开你。你这么在意这件事，是不是心里有些话特别不想让家里知道？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1879,"promptTokens":2417,"completionTokens":65,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:57:09"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575258762385176,"emotions":[],"relationId":"6af66e75f4429d1fd72f6aeb","courseProgressId":0,"tsGen":1794535029841,"createTime":"2026-11-13 09:57:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66e75f4429d1fd72f6aeb","chatId":"b07d100c541948a08c7b004cd5ff4d21","sessionId":null,"userId":99792,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……可能是吧，我好像总是先怪自己。那个……你说的安全情况，是指什么？会不会我哪天说了什么，你就得告诉家里人？<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575258762385176,"emotions":[{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66e75f4429d1fd72f6aec","courseProgressId":0,"tsGen":1794535029838,"createTime":"2026-11-13 09:57:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":nu