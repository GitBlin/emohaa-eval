"surprised","name":"惊讶","value":2,"sort":5},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66f66f4429d1fd72f6d0a","courseProgressId":0,"tsGen":1794535270192,"createTime":"2026-11-13 10:01:10","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f5ef4429d1fd72f6cfc","chatId":"0ebc28c526834ffb81b9c82f767dbf2a","sessionId":null,"userId":99794,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"我没有觉得你不适合谈结婚。你一直担心我会怎么看，像是心里早有个声音在说你“不够好”。那个声音，是从什么时候开始跟着你的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我没有觉得你不适合谈结婚。你一直担心我会怎么看，像是心里早有个声音在说你“不够好”。那个声音，是从什么时候开始跟着你的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1907,"promptTokens":2697,"completionTokens":72,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:01:02"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.015898753030518492,"emotions":[],"relationId":"6af66f5ef4429d1fd72f6cfb","courseProgressId":0,"tsGen":1794535262083,"createTime":"2026-11-13 10:01:02","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66f5ef4429d1fd72f6cfb","chatId":"0ebc28c526834ffb81b9c82f767dbf2a","sessionId":null,"userId":99794,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"你这么一问，我有点愣住……可能两个都怕吧。其实我更怕的是，我是不是根本不知道自己想要什么。还有，我总忍不住想，你会不会觉得我这种人不太适合谈结婚？<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoC