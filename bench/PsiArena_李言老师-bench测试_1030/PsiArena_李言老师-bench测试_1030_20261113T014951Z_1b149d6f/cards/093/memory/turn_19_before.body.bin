快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af68191f4429d1fd72f82c0","courseProgressId":0,"tsGen":1794539921804,"createTime":"2026-11-13 11:18:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6818df4429d1fd72f82b8","chatId":"a34dccaf2ba24436a65c848a039db1a5","sessionId":null,"userId":99900,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不乱，我听着挺清楚的。你从“晚上睡不着”讲到上学时那种“跟别人不太一样”，再讲到爸妈催相亲——它其实是连着的。被催着去相亲的时候，你心里最先冒出来的是什么感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不乱，我听着挺清楚的。你从“晚上睡不着”讲到上学时那种“跟别人不太一样”，再讲到爸妈催相亲——它其实是连着的。被催着去相亲的时候，你心里最先冒出来的是什么感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2115,"promptTokens":2320,"completionTokens":87,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:18:37"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010982811288484325,"emotions":[],"relationId":"6af6818df4429d1fd72f82b7","courseProgressId":0,"tsGen":1794539917007,"createTime":"2026-11-13 11:18:37","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6818df4429d1fd72f82b7","chatId":"a34dccaf2ba24436a65c848a039db1a5","sessionId":null,"userId":99900,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"很久了吧……可能从上学那会儿就有。现在爸妈又老催我去相亲，那种感觉就更明显了。……我是不是说得有点乱？<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,