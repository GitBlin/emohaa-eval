499277634147,"emotions":[{"code":"sadness","name":"悲伤","value":8,"sort":8},{"code":"dislike","name":"厌恶","value":8,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af68017f4429d1fd72f8153","courseProgressId":0,"tsGen":1794539543051,"createTime":"2026-11-13 11:12:23","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68010f4429d1fd72f8149","chatId":"b582eb9c7b7e4f0685454a813ea90bed","sessionId":null,"userId":99895,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"我不会这么看。题做错、考不好，背后有方法、状态、难度很多因素，不是一句“没尽力”就能盖过去的。倒是那句“你是不是没尽力”，好像一直留在了你心里。它响起来的时候，你心里是什么感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我不会这么看。题做错、考不好，背后有方法、状态、难度很多因素，不是一句“没尽力”就能盖过去的。倒是那句“你是不是没尽力”，好像一直留在了你心里。它响起来的时候，你心里是什么感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1864,"promptTokens":2614,"completionTokens":95,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:12:16"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0066914225307887045,"emotions":[],"relationId":"6af68010f4429d1fd72f8148","courseProgressId":0,"tsGen":1794539536798,"createTime":"2026-11-13 11:12:16","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68010f4429d1fd72f8148"