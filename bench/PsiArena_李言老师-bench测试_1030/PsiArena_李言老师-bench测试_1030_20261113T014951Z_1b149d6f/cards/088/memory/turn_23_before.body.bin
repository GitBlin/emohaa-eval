courseProgressId":0,"tsGen":1794539553716,"createTime":"2026-11-13 11:12:33","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68021f4429d1fd72f8166","chatId":"b582eb9c7b7e4f0685454a813ea90bed","sessionId":null,"userId":99895,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最怕他们嘴上不说，但眼神里那种失望……好像我一下子就不值得了。同学那边也是，我怕他们觉得我其实很普通。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012427533661582727,"emotions":[{"code":"fear","name":"恐惧","value":8,"sort":6},{"code":"sadness","name":"悲伤","value":7,"sort":8},{"code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af68021f4429d1fd72f8167","courseProgressId":0,"tsGen":1794539553713,"createTime":"2026-11-13 11:12:33","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6801cf4429d1fd72f815d","chatId":"b582eb9c7b7e4f0685454a813ea90bed","sessionId":null,"userId":99895,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听你这么说，好像“被夸”这件事一直和分数绑在一起——成绩成了你被看见的条件。久而久之，你也会用这个标准来量自己。那如果有一天成绩不理想，你最担心别人会怎么看你？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听你这么说，好像“被夸”这件事一直和分数绑在一起——成绩成了你被看见的条件。久而久之，你也会用这个标准来量自己。那如果有一天成绩不理想，你最担心别人会怎么看你？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2354,"promptTokens":2967,"completionTokens":134,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:12:28"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705965314307553,"emotions":[],"relationId":"6af6801cf4429d1fd72f815c","courseProgressId":0,"tsGen":1794539548393,"createTime":"2026-11-13 11:12:28","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6801cf4429d1fd72f815c","chatId":"b582eb9c7b7e4f0685454a813ea90bed","sessionId":null,"userId":99895,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"应该是我爸妈吧。他们都是大学生，家里亲戚聊天也总说谁家孩子考了多少分、拿了什么奖。我听着就觉得，好像只有成绩好，我才是值得被夸的。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705965314307553,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af6801cf4429d1fd72f815d","courseProgressId":0,"tsGen":1794539548390,"createTim