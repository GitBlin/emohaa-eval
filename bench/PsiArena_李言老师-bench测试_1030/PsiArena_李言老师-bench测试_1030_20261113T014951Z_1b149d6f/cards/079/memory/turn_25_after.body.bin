icideConf":0.012427531879068709,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67dd6f4429d1fd72f7f50","courseProgressId":0,"tsGen":1794538966048,"createTime":"2026-11-13 11:02:46","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67dd1f4429d1fd72f7f48","chatId":"f2f76316c3a2472b8ad294a6783ecbf2","sessionId":null,"userId":99886,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你连“没想清楚”都要先跟我确认一下，好像怕自己不够格坐在这里。带着不确定来，本身就是一种在想，不用先备好答案。那我问一句：那些跑来跑去、忙到很晚的日子里，有没有哪件事让你觉得，这个还是值得做的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你连“没想清楚”都要先跟我确认一下，好像怕自己不够格坐在这里。带着不确定来，本身就是一种在想，不用先备好答案。那我问一句：那些跑来跑去、忙到很晚的日子里，有没有哪件事让你觉得，这个还是值得做的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":3508,"promptTokens":2441,"completionTokens":254,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:02:41"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575277312973766,"emotions":[],"relationId":"6af67dd1f4429d1fd72f7f47","courseProgressId":0,"tsGen":1794538961296,"createTime":"2026-11-13 11:02:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67dd1f4429d1fd72f7f47","chatId":"f2f76316c3a2472b8ad294a6783ecbf2","sessionId":null,"userId":99886,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是……事情很杂，又好像谁都能做。我每天跑来跑去，忙到很晚，可回头想想，不知道忙出了什么。唔……我这么问可能有点怪，你会不会觉得我根本没想清楚就来咨询了？<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575277312973766,"emotions":[{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67dd1f4429d1fd72f7f48","courseProgressId":0,"tsGen":1794538961293,"createTime":"2026-11-13 11:02:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67dcbf4429d1fd72f7f3f","chatId":"f2f76316c3a2472b8ad294a6783ecbf2","sessionId":null,"userId":99886,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“可能是我自己想太多了”这句话，你好像很自然地就把原因归到自己身上了。不过一两年都没劲，光靠“想太多”好像解释不了。换工作之后，是工作里哪一部分最让你觉得耗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“可能是我自己想太多了”这句话，你好像很自然地就把原因归到自己身上了。不过一两年都没劲，光靠“想太多”好像解释不了。换工作之后，是工作里哪一部分最让你觉得耗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1788,"promptTokens":1872,"completionTokens":113,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:02:35"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004069188307619069,"emotions":[],"relationId":"6af67dcbf4429d1fd72f7f3e","courseProgressId":0,"tsGen":1794538955054,"createTime":"2026-11-13 11:02:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67dcbf4429d1fd72f7f3e","chatId":"f2f76316c3a2472b8ad294a6783ecbf2","sessionId":null,"userId":99886,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"大概……从换了现在这份工作之后吧，有一两年了？我也记不太清，反正就是慢慢变成这样。可能是我自己想太多了。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004069188307619069,"emotions":[{"code":"calm","name":"平静","value":3,"sort":4},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67dcbf4429d1fd72f7f3f","courseProgressId":0,"tsGen":1794538955051,"createTime":"2026-11-13 11:02:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67dc5f4429d1fd72f7f39","chatId"