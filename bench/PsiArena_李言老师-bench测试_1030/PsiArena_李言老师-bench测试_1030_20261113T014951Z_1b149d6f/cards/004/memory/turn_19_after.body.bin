ll,"interceptContent":null,"contents":[{"content":"你不想让爸妈觉得你麻烦，所以连“我怕”都咽回去了——这份懂事里其实藏着不少委屈。你一个人把害怕收着，是怕他们担心，还是怕他们嫌你事多？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1821,"promptTokens":2211,"completionTokens":90,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:53:38"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008576850930993151,"emotions":[],"relationId":"6af66da2f4429d1fd72f68ab","courseProgressId":0,"tsGen":1794534818935,"createTime":"2026-11-13 09:53:38","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66da2f4429d1fd72f68ab","chatId":"90a616d9144344afa975afe9bbded144","sessionId":null,"userId":99785,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（低头）嗯……我爸妈一直在外面打工，很少回来。我不想让他们觉得我麻烦，也不敢跟他们说我怕。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008576850930993151,"emotions":[{"code":"sadness","name":"悲伤","value":7,"sort":8},{"code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"fear","name":"恐惧","value":6,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66da2f4429d1fd72f68ac","courseProgressId":0,"tsGen":1794534818932,"createTime":"2026-11-13 09:53:38","delFlag":0,"emotionTendency":null,"sourcePro