1030,"isGreeting":false,"role":"user","content":"会……胸口有点闷，呼吸也变浅了。有时候手心都出汗。嗯……其实我也不知道为什么会这样，就是控制不住。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.053389275304090676,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"sadness","name":"悲伤","value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67318f4429d1fd72f7314","courseProgressId":0,"tsGen":1794536216408,"createTime":"2026-11-13 10:16:56","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67315f4429d1fd72f7308","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"这种紧张和慌，不是你想太多，是身体先替你反应了。说不清也很正常，那些念头常常是一团模糊的东西，硬要描述反而更难。\n\n那种慌上来的时候，你身体上有没有哪儿跟着变化，比如胸口发紧、心跳变快？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"这种紧张和慌，不是你想太多，是身体先替你反应了。说不清也很正常，那些念头常常是一团模糊的东西，硬要描述反而更难。\n\n那种慌上来的时候，你身体上有没有哪儿跟着变化，比如胸口发紧、心跳变快？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2267,"promptTokens":2407,"completionTokens":158,"responseSource":"agent:llm","censorData":{"labels":