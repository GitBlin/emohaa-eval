ue":6,"sort":9},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67339f4429d1fd72f7371","courseProgressId":0,"tsGen":1794536249832,"createTime":"2026-11-13 10:17:29","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67335f4429d1fd72f7369","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"跟男朋友在一起时那种“话到嘴边先咽回去”，很像你小时候在妈妈面前做的同一个动作——提前避免被否定。越怕他觉得你不对劲，他反而越难真正认识你。你有没有想过，如果他真的看到你那些“不该有的念头”，你最怕他怎么样？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"跟男朋友在一起时那种“话到嘴边先咽回去”，很像你小时候在妈妈面前做的同一个动作——提前避免被否定。越怕他觉得你不对劲，他反而越难真正认识你。你有没有想过，如果他真的看到你那些“不该有的念头”，你最怕他怎么样？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2526,"promptTokens":2586,"completionTokens":179,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:17:25"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608123383683947,"emotions":[],"relationId":"6af67335f4429d1fd72f7368","courseProgressId":0,"tsGen":1794536245342,"createTime":"2026-11-13 10:17:25","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67335f4429d1fd72f7368","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最明显的……应该还是男朋友吧。跟他在一起，我总先看他的脸色，想说的话到嘴边就先咽回去了。我太怕他觉得我不对劲了。<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":26,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608123383683947,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67335f4429d1fd72f7369","courseProgressId":0,"tsGen":1794536245339,"createTime":"2026-11-13 10:17:25","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67330f4429d1fd72f735c","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你描述得很清楚——不是没有好奇，而是羞愧总是抢先一步，把它按回去。时间久了，这个动作变成了习惯，连做别的事都先掂量别人怎么想。这种“先看别人”的模式，最近在哪些关系里最容易被触发？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你描述得很清楚——不是没有好奇，而是羞愧总是抢先一步，把它按回去。时间久了，这个动作变成了习惯，连做别的事都先掂量别人怎么想。这种“先看别人”的模式，最近在哪些关系里最容易被触发？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2502,"promptTokens":3283,"completionTokens":175,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:17:20"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014061431813460172,"emotions":[],"relationId":"6af67330f4429d1fd72f735b","courseProgressId":0,"tsGen":1794536240527,"createTime":"2026-11-13 10:17:20","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67330f4429d1fd72f735b","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"好像总是羞愧先冒出来，好奇还没来得及展开，我就先把自己按下去了。久了都成习惯了，做别的事也这样，总要先掂量别人怎么想。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014061431813460172,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"surprised","name":"惊讶","value":1,"sort":5}],"relationId":"6af67330f4429d1fd72f735c","courseProgressId":0,"tsGen":1794536240524,"createTime":"2026-11-13 10:17:20","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6732cf4429d1fd72f7352","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"两边拉扯的感觉，听着就很累，一边想靠近，一边又觉得不该。这种拉扯在你身上，通常哪一边会更先冒出来——是好奇，还是那份羞愧？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"两边拉扯的感觉，听着就很累，一边想靠近，一边又觉得不该。这种拉扯在你身上，通常哪一边会更先冒出来——是好奇，还是那份羞愧？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1898,"promptTokens":2584,"completionTokens":89,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:17:16"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005910258152577317,"emotions":[],"relationId":"6af6732cf4429d1fd72f7351","courseProgressId":0,"tsGen":1794536236294,"createTime":"2026-11-13 10:17:16","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6732cf4429d1fd72f7351","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"可能是……大学的时候吧。接触到一些跟我家里完全不一样的说法，我当时又好奇又觉得羞愧，好像两边都在拉扯我。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005910258152577317,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"expect","name":"期待","value":4,"sort":2},{"code":"surprised","name":"惊讶","value":3,"sort":5},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6732cf4429d1fd72f7352","courseProgressId":0,"tsGen":1794536236291,"createTime":"2026-11-13 10:17:16","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67328f4429d1fd72f7346","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"分不清，恰恰说明这个声音跟了你太久，久到已经长进你自己的语气里了。你第一次隐约觉得“这好像不全是我的想法”，是在什么情境下？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"分不清，恰恰说明这个声音跟了你太久，久到已经长进你自己的语气里了。你第一次隐约觉得“这好像不全是我的想法”，是在什么情境下？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2147,"promptTokens":3046,"completionTokens":108,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:17:12"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909916391206175,"emotions":[],"relationId":"6af67328f4429d1fd72f7345","courseProgressId":0,"tsGen":1794536232651,"createTime":"2026-11-13 10:17:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67328f4429d1fd72f7345","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"像……我妈吧。她从来没明说过，但那种眼神、那种态度，我好像一直都知道她在想什么。奇怪的是，有时候我都分不清那到底是她的声音，还是我自己的了。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909916391206175,"emotions":[{"code":"trust","name":"信任","value":6,"sort":3},{"code":"calm","name":"平静","value":5,"sort":4},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"surprised","name":"惊讶","value":2,"sort":5},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67328f4429d1fd72f7346","courseProgressId":0,"tsGen":1794536232649,"createTime":"2026-11-13 10:17:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67324f4429d1fd72f733b","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来，那个“女孩子不该有这种想法”的声音，很早就跟着你了，甚至不像你自己的判断，更像家里某种没明说的规矩。它冒出来的时候，是像谁在说话呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来，那个“女孩子不该有这种想法”的声音，很早就跟着你了，甚至不像你自己的判断，更像家里某种没明说的规矩。它冒出来的时候，是像谁在说话呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2076,"promptTokens":2226,"completionTokens":113,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:17:08"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909302539044472,"emotions":[],"relationId":"6af67324f4429d1fd72f733a","courseProgressId":0,"tsGen":1794536228547,"createTime":"2026-11-13 10:17:08","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67324f4429d1fd72f733a","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……就是那种很暧昧的时候吧。明明气氛到了，我心里却冒出些别的念头，然后就特别紧张，怕他看出来。我从小家里就不谈这些，好像女孩子有那种想法就是不对的。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909302539044472,"emotions":[{"code":"fear","name":"恐惧","value":6,"sort":6},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67324f4429d1fd72f733b","courseProgressId":0,"tsGen":1794536228544,"createTime":"2026-11-13 10:17:08","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67320f4429d1fd72f7328","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"从小就不敢让人看到真实想法，现在在男朋友面前尤其明显——那种怕被看穿的感觉，靠得越近反而越紧绷，是这样吗？能说说那种感觉最强烈的时候，通常是在做什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"从小就不敢让人看到真实想法，现在在男朋友面前尤其明显——那种怕被看穿的感觉，靠得越近反而越紧绷，是这样吗？能说说那种感觉最强烈的时候，通常是在做什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2381,"promptTokens":2251,"completionTokens":97,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:17:04"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007574890767961627,"emotions":[],"relationId":"6af67320f4429d1fd72f7327","courseProgressId":0,"tsGen":1794536224849,"createTime":"2026-11-13 10:17:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67320f4429d1fd72f7327","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……好像一直都有吧，从小就不太敢让人看到自己真实的想法。最近……最近是跟男朋友在一起的时候，那种感觉特别明显。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007574890767961627,"emotions":[{"code":"fear","name":"恐惧","value":6,"sort":6},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67320f4429d1fd72f7328","courseProgressId":0,"tsGen":1794536224846,"createTime":"2026-11-13 10:17:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consul