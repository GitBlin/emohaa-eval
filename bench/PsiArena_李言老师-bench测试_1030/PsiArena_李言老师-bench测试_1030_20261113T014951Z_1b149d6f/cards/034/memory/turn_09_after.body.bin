{"success":true,"code":"000","message":null,"data":{"totalAmount":18,"totalPageCount":1,"pageNum":0,"itemCount":18,"content":[{"pageNum":0,"pageSize":0,"id":"6af67324f4429d1fd72f733b","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来，那个“女孩子不该有这种想法”的声音，很早就跟着你了，甚至不像你自己的判断，更像家里某种没明说的规矩。它冒出来的时候，是像谁在说话呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来，那个“女孩子不该有这种想法”的声音，很早就跟着你了，甚至不像你自己的判断，更像家里某种没明说的规矩。它冒出来的时候，是像谁在说话呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2076,"promptTokens":2226,"completionTokens":113,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:17:08"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909302539044472,"emotions":[],"relationId":"6af67324f4429d1fd72f733a","courseProgressId":0,"tsGen":1794536228547,"createTime":"2026-11-13 10:17:08","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67324f4429d1fd72f733a","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……就是那种很暧昧的时候吧。明明气氛到了，我心里却冒出些别的念头，然后就特别紧张，怕他看出来。我从小家里就不谈这些，好像女孩子有那种想法就是不对的。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909302539044472,"emotions":[],"relationId":"6af67324f4429d1fd72f733b","courseProgressId":0,"tsGen":1794536228544,"createTime":"2026-11-13 10:17:08","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67320f4429d1fd72f7328","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"从小就不敢让人看到真实想法，现在在男朋友面前尤其明显——那种怕被看穿的感觉，靠得越近反而越紧绷，是这样吗？能说说那种感觉最强烈的时候，通常是在做什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"从小就不敢让人看到真实想法，现在在男朋友面前尤其明显——那种怕被看穿的感觉，靠得越近反而越紧绷，是这样吗？能说说那种感觉最强烈的时候，通常是在做什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2381,"promptTokens":2251,"completionTokens":97,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:17:04"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007574890767961627,"emotions":[],"relationId":"6af67320f4429d1fd72f7327","courseProgressId":0,"tsGen":1794536224849,"createTime":"2026-11-13 10:17:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67320f4429d1fd72f7327","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……好像一直都有吧，从小就不太敢让人看到自己真实的想法。最近……最近是跟男朋友在一起的时候，那种感觉特别明显。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007574890767961627,"emotions":[{"code":"fear","name":"恐惧","value":6,"sort":6},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67320f4429d1fd72f7328","courseProgressId":0,"tsGen":1794536224846,"createTime":"2026-11-13 10:17:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6731cf4429d1fd72f731e","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你能主动问出来，说明你很在意边界，这本身就值得尊重。聊这些不会越界，你随时可以停在不想说的地方，节奏由你掌握。那种“怕被看穿”的感觉，是从什么时候开始跟着你的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你能主动问出来，说明你很在意边界，这本身就值得尊重。聊这些不会越界，你随时可以停在不想说的地方，节奏由你掌握。那种“怕被看穿”的感觉，是从什么时候开始跟着你的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1882,"promptTokens":2673,"completionTokens":94,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:17:00"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608661901246446,"emotions":[],"relationId":"6af6731cf4429d1fd72f731d","courseProgressId":0,"tsGen":1794536220340,"createTime":"2026-11-13 10:17:00","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6731cf4429d1fd72f731d","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"一般……是跟人靠得比较近的时候吧，特别是那种，嗯，比较私密的场合。说起来有点不好意思……你平时会跟来访者聊这些很私人的事吗？会不会觉得越界了？<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608661901246446,"emotions":[{"code":"calm","name":"平静","value":5,"sort":4},{"code":"trust","name":"信任","value":4,"sort":3},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"sadness","name":"悲伤","value":1,"sort":8},{"code":"dislike","name":"厌恶","value":1,"sort":9},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6731cf4429d1fd72f731e","courseProgressId":0,"tsGen":1794536220337,"createTime":"2026-11-13 10:17:00","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67318f4429d1fd72f7314","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"胸口闷、呼吸变浅、手心出汗，这些都是身体在紧张时的真实反应，不是你“控制不住”的毛病。很多人越想把它们压下去，反而越明显。\n\n我有点好奇，这种身体反应，通常是在什么情境下更容易出现？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"胸口闷、呼吸变浅、手心出汗，这些都是身体在紧张时的真实反应，不是你“控制不住”的毛病。很多人越想把它们压下去，反而越明显。\n\n我有点好奇，这种身体反应，通常是在什么情境下更容易出现？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1926,"promptTokens":2532,"completionTokens":90,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:16:56"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.053389275304090676,"emotions":[],"relationId":"6af67318f4429d1fd72f7313","courseProgressId":0,"tsGen":1794536216411,"createTime":"2026-11-13 10:16:56","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67318f4429d1fd72f7313","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"会……胸口有点闷，呼吸也变浅了。有时候手心都出汗。嗯……其实我也不知道为什么会这样，就是控制不住。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.053389275304090676,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"sadness","name":"悲伤","value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67318f4429d1fd72f7314","courseProgressId":0,"tsGen":1794536216408,"createTime":"2026-11-13 10:16:56","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67315f4429d1fd72f7308","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"这种紧张和慌，不是你想太多，是身体先替你反应了。说不清也很正常，那些念头常常是一团模糊的东西，硬要描述反而更难。\n\n那种慌上来的时候，你身体上有没有哪儿跟着变化，比如胸口发紧、心跳变快？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"这种紧张和慌，不是你想太多，是身体先替你反应了。说不清也很正常，那些念头常常是一团模糊的东西，硬要描述反而更难。\n\n那种慌上来的时候，你身体上有没有哪儿跟着变化，比如胸口发紧、心跳变快？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2267,"promptTokens":2407,"completionTokens":158,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:16:53"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575028069095967,"emotions":[],"relationId":"6af67315f4429d1fd72f7307","courseProgressId":0,"tsGen":1794536213027,"createTime":"2026-11-13 10:16:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67315f4429d1fd72f7307","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是……紧张，还有点慌。那些念头一冒出来，我就觉得自己是不是有问题，心里特别不舒服。但具体是什么，我又说不太清楚。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575028069095967,"emotions":[{"code":"fear","name":"恐惧","value":6,"sort":6},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67315f4429d1fd72f7308","courseProgressId":0,"tsGen":1794536213024,"createTime":"2026-11-13 10:16:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67310f4429d1fd72f72fc","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"我不会因为一个人有某个念头就觉得他不正常。念头本身不等于你是什么样的人，更值得聊的，是它出现时你有多难受。那些想法冒出来的时候，你心里最常跟着的感觉是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我不会因为一个人有某个念头就觉得他不正常。念头本身不等于你是什么样的人，更值得聊的，是它出现时你有多难受。那些想法冒出来的时候，你心里最常跟着的感觉是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2135,"promptTokens":1866,"completionTokens":145,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:16:48"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012429156278432918,"emotions":[],"relationId":"6af67310f4429d1fd72f72fb","courseProgressId":0,"tsGen":1794536208979,"createTime":"2026-11-13 10:16:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67310f4429d1fd72f72fb","chatId":"a49338a5a79b448b85b29e25feb0fb5a","sessionId":null,"userId":99815,"orgId":3721,"botId":1030,"isGreetin