lm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:26:34"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00857664220021362,"emotions":[],"relationId":"6af6755af4429d1fd72f76ba","courseProgressId":0,"tsGen":1794536794321,"createTime":"2026-11-13 10:26:34","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6755af4429d1fd72f76ba","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（苦笑）基本都是“我哪里没做好”吧。很少会觉得没事，好像总得挑出点毛病才安心。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00857664220021362,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af6755af4429d1fd72f76bb","courseProgressId":0,"tsGen":1794536794318,"createTime":"2026-11-13 10:26:34","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67556f4429d1fd72f76b0","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"白天的事到了晚上还在心里一遍遍过，像是在给自己做检查，难怪躺下也歇不下来。这种反复回想的最后，你通常会得出什么结论——是“还好没事”，还是多半落在“我哪里没做好”上？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"白天的事到了晚上还在心里一遍遍过，像是在给自己做检查，难怪躺下也歇不下来。这种反复回想的最后，你通常会得出什么结论——是“还好没事”，还是多半落在“我哪里没做好”上？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2309,"promptTokens":3285,"completionTokens":133,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:26:30"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010985263285719868,"emotions":[],"relationId":"6af67556f4429d1fd72f76af","courseProgressId":0,"tsGen":1794536790675,"createTime":"2026-11-13 10:26:30","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67556f4429d1fd72f76af","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……不全是工作。有时候是白天说过的话、做过的事，翻来覆去地想，哪句是不是说错了。挺累的，可就是停不下来。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010985263285719868,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67556f4429d1fd72f76b0","courseProgressId":0,"tsGen":1794536790672,"createTime":"2026-11-13 10:26:30","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67552f4429d1fd72f76a1","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来身体已经在替心里说话了——肩膀发紧、躺下也停不下来，都是那根弦绷太久留下的痕迹。这些反应你一个人扛了挺久吧。晚上脑子停不下来的时候，转的多是工作上的事，还是别的什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来身体已经在替心里说话了——肩膀发紧、躺下也停不下来，都是那根弦绷太久留下的痕迹。这些反应你一个人扛了挺久吧。晚上脑子停不下来的时候，转的多是工作上的事，还是别的什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1626,"promptTokens":2483,"completionTokens":105,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:26:26"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00970596465325569,"emotions":[],"relationId":"6af67552f4429d1fd72f76a0","courseProgressId":0,"tsGen":1794536786025,"createTime":"2026-11-13 10:26:26","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67552f4429d1fd72f76a0","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（下意识揉了揉肩膀）肩膀老是发紧，晚上躺下也睡不踏实，脑子停不下来。以前没太在意，这么一说好像一直都在。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoC