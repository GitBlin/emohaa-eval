value":7,"sort":6},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67565f4429d1fd72f76ce","courseProgressId":0,"tsGen":1794536805559,"createTime":"2026-11-13 10:26:45","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67561f4429d1fd72f76c6","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来，“一定还有问题”已经变成一种默认的预感了——好像只有找到错处，心里才踏实。可这样一来，你几乎不给自己“过关”的机会。如果试着允许一次“这次真的没事”，你最担心会发生什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来，“一定还有问题”已经变成一种默认的预感了——好像只有找到错处，心里才踏实。可这样一来，你几乎不给自己“过关”的机会。如果试着允许一次“这次真的没事”，你最担心会发生什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2271,"promptTokens":3261,"completionTokens":145,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:26:41"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218925757661327,"emotions":[],"relationId":"6af67561f4429d1fd72f76c5","courseProgressId":0,"tsGen":1794536801770,"createTime":"2026-11-13 10:26:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67561f4429d1fd72f76c5","chatId":"5a19697e83354261be1c0f8880e44c9e","session