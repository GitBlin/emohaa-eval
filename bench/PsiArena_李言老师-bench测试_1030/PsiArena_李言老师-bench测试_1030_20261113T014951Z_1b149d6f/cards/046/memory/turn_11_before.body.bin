{"success":true,"code":"000","message":null,"data":{"totalAmount":20,"totalPageCount":1,"pageNum":0,"itemCount":20,"content":[{"pageNum":0,"pageSize":0,"id":"6af67552f4429d1fd72f76a1","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来身体已经在替心里说话了——肩膀发紧、躺下也停不下来，都是那根弦绷太久留下的痕迹。这些反应你一个人扛了挺久吧。晚上脑子停不下来的时候，转的多是工作上的事，还是别的什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来身体已经在替心里说话了——肩膀发紧、躺下也停不下来，都是那根弦绷太久留下的痕迹。这些反应你一个人扛了挺久吧。晚上脑子停不下来的时候，转的多是工作上的事，还是别的什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1626,"promptTokens":2483,"completionTokens":105,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:26:26"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00970596465325569,"emotions":[],"relationId":"6af67552f4429d1fd72f76a0","courseProgressId":0,"tsGen":1794536786025,"createTime":"2026-11-13 10:26:26","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67552f4429d1fd72f76a0","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（下意识揉了揉肩膀）肩膀老是发紧，晚上躺下也睡不踏实，脑子停不下来。以前没太在意，这么一说好像一直都在。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00970596465325569,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67552f4429d1fd72f76a1","courseProgressId":0,"tsGen":1794536786022,"createTime":"2026-11-13 10:26:26","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6754af4429d1fd72f7699","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“再努力一点”本来是想把事情做好，可它反而让那根弦绷得更紧，越紧越容易乱——像走进一个绕不出去的圈。你硬扛的时候，身体上一般会有什么感觉，比如肩膀、胸口或者睡眠？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“再努力一点”本来是想把事情做好，可它反而让那根弦绷得更紧，越紧越容易乱——像走进一个绕不出去的圈。你硬扛的时候，身体上一般会有什么感觉，比如肩膀、胸口或者睡眠？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2558,"promptTokens":3036,"completionTokens":152,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:26:18"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.022969841610054973,"emotions":[],"relationId":"6af6754af4429d1fd72f7698","courseProgressId":0,"tsGen":1794536778785,"createTime":"2026-11-13 10:26:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6754af4429d1fd72f7698","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"还能怎么办，就硬扛着呗，告诉自己再努力一点就好了。可有时候越这么想，心里越烦，反而更做不好事。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.022969841610054973,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af6754af4429d1fd72f7699","courseProgressId":0,"tsGen":1794536778783,"createTime":"2026-11-13 10:26:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67546f4429d1fd72f768f","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"原来那句话最早是从家里来的，只是说得久了，就慢慢变成你自己在心里重复的声音了。这个声音一直要求你“不能让人看笑话”，确实很难松下来。那它在你心里响起的时候，你一般会怎么应对？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"原来那句话最早是从家里来的，只是说得久了，就慢慢变成你自己在心里重复的声音了。这个声音一直要求你“不能让人看笑话”，确实很难松下来。那它在你心里响起的时候，你一般会怎么应对？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2265,"promptTokens":2234,"completionTokens":134,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:26:14"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008576915542535358,"emotions":[],"relationId":"6af67546f4429d1fd72f768e","courseProgressId":0,"tsGen":1794536774044,"createTime":"2026-11-13 10:26:14","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67546f4429d1fd72f768e","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（停顿了一下）好像……是我自己老这么想。家里从小就说要争气、不能让人看笑话，可能听多了就变成自己的声音了。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008576915542535358,"emotions":[{"code":"calm","name":"平静","value":5,"sort":4},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67546f4429d1fd72f768f","courseProgressId":0,"tsGen":1794536774041,"createTime":"2026-11-13 10:26:14","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67541f4429d1fd72f7684","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“没出息”这个评价，听起来是你对自己挺严厉的。可一个人在意家里人和领导怎么看自己，其实很常见，跟年龄没多大关系。我想知道，这种“不该还这样”的评判，平时是你自己心里冒出来的，还是谁常对你这么说？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“没出息”这个评价，听起来是你对自己挺严厉的。可一个人在意家里人和领导怎么看自己，其实很常见，跟年龄没多大关系。我想知道，这种“不该还这样”的评判，平时是你自己心里冒出来的，还是谁常对你这么说？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2026,"promptTokens":2105,"completionTokens":95,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:26:09"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691780837635704,"emotions":[],"relationId":"6af67541f4429d1fd72f7683","courseProgressId":0,"tsGen":1794536769140,"createTime":"2026-11-13 10:26:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67541f4429d1fd72f7683","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"唔……主要是家里人吧，还有领导。哎，这么说出来感觉自己挺没出息的，都这么大人了还老想着这些。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691780837635704,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67541f4429d1fd72f7684","courseProgressId":0,"tsGen":1794536769138,"createTime":"2026-11-13 10:26:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6753cf4429d1fd72f767c","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"会怕别人失望，说明你心里很在意那些关系，这不是“想太多”，更像是你把别人的感受放在了很前面。你说的“别人”，主要是谁呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"会怕别人失望，说明你心里很在意那些关系，这不是“想太多”，更像是你把别人的感受放在了很前面。你说的“别人”，主要是谁呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1833,"promptTokens":2588,"completionTokens":90,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:26:04"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007576188401610928,"emotions":[],"relationId":"6af6753cf4429d1fd72f767b","courseProgressId":0,"tsGen":1794536764536,"createTime":"2026-11-13 10:26:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6753cf4429d1fd72f767b","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"出错……就觉得别人会失望吧。唉，可能我想太多了。其实我也不确定，是不是自己太敏感。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007576188401610928,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6753cf4429d1fd72f767c","courseProgressId":0,"tsGen":1794536764533,"createTime":"2026-11-13 10:26:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67537f4429d1fd72f766a","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“不能出错”这几个字挺重的，像给自己定了一条只能满分、不许扣分的规矩。也许让你慌的不是数字本身，而是出错背后会意味着什么。你自己心里，出错最怕带来什么后果？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“不能出错”这几个字挺重的，像给自己定了一条只能满分、不许扣分的规矩。也许让你慌的不是数字本身，而是出错背后会意味着什么。你自己心里，出错最怕带来什么后果？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1894,"promptTokens":2480,"completionTokens":97,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:25:59"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219053008987387,"emotions":[],"relationId":"6af67537f4429d1fd72f7669","courseProgressId":0,"tsGen":1794536759531,"createTime":"2026-11-13 10:25:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67537f4429d1fd72f7669","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……大多是在工作的时候吧，尤其是考核那阵，盯着数字看，心里就发慌。可具体怕什么，我也讲不清楚，好像就是……不能出错。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219053008987387,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"sadness","name":"悲伤","value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67537f4429d1fd72f766a","courseProgressId":0,"tsGen":1794536759529,"createTime":"2026-11-13 10:25:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67533f4429d1fd72f7662","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不奇怪，很多人都是先感觉到情绪，才慢慢找到它在指向什么。说不上来，不代表它不存在，只是还没找到合适的词。我们换个方式，最近那种烦躁冒上来的时候，通常是在做什么事，或者身边有谁？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不奇怪，很多人都是先感觉到情绪，才慢慢找到它在指向什么。说不上来，不代表它不存在，只是还没找到合适的词。我们换个方式，最近那种烦躁冒上来的时候，通常是在做什么事，或者身边有谁？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1655,"promptTokens":1888,"completionTokens":90,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:25:55"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0066916563939103495,"emotions":[],"relationId":"6af67533f4429d1fd72f7661","courseProgressId":0,"tsGen":1794536755451,"createTime":"2026-11-13 10:25:55","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67533f4429d1fd72f7661","chatId":"5a19697e83354261be1c0f8880e44c9e","sessionId":null,"userId":99845,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"我……也不知道该说哪块。就是希望别老这么焦虑吧。可你要问我具体在焦虑什么，我又说不上来，是不是挺奇怪的？<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0066916563939103495,"emotions":[{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"sadness","name":"悲伤","value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67533f4429d1fd72f7662","courseProgressId":0,"tsGen":1794536755449,"createTime":"