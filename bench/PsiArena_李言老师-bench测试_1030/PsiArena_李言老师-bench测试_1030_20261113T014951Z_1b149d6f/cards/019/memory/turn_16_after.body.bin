","isSuicide":false,"isSuicideConf":0.00669156396646982,"emotions":[{"code":"sadness","name":"悲伤","value":7,"sort":8},{"code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"fear","name":"恐惧","value":6,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6705bf4429d1fd72f6eec","courseProgressId":0,"tsGen":1794535515136,"createTime":"2026-11-13 10:05:15","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67053f4429d1fd72f6ede","chatId":"82f85e0ab1a2440b85417aff91e47578","sessionId":null,"userId":99800,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"被人从头看到脚，还得听着那句“你都二十八了”，难怪那块东西会更沉。好像这场见面不只是见一个人，更像在替爸妈交一份答卷。被这样看着的时候，你心里最先冒出来的是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"被人从头看到脚，还得听着那句“你都二十八了”，难怪那块东西会更沉。好像这场见面不只是见一个人，更像在替爸妈交一份答卷。被这样看着的时候，你心里最先冒出来的是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2015,"promptTokens":2336,"completionTokens":86,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:07"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.015902299949196848,"emotions":[],"relationId":"6af67053f4429d1fd72f6edd","courseProgressId":0,"tsGen":1794535507548,"createTime":"2026-11-13 10:05:07","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67053f4429d1fd72f6edd","chatId":"82f85e0ab1a2440b85417aff91e47578","sessionId":null,"userId":99800,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"都有吧。见面本身就已经够难受了，坐在那儿被人从头看到脚……而且我总感觉，这事背后压着的是我爸妈那句“你都二十八了”。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.015902299949196848,"emotions":[],"relationId":"6af67053f4429d1fd72f6ede","courseProgressId":0,"tsGen":1794535507545,"createTime":"2026-11-13 10:05:07","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6704ff4429d1fd72f6ed1","chatId":"82f85e0ab1a2440b85417aff91e47578","sessionId":null,"userId":99800,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"原来那块沉，还跟周末的相亲连在一起。一提起它就更沉了，是担心见面本身，还是担心这件事背后的什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"原来那块沉，还跟周末的相亲连在一起。一提起它就更沉了，是担心见面本身，还是担心这件事背后的什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2087,"promptTokens":2820,"completionTokens":71,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:03"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218721564005943,"emotions":[],"relationId":"6af6704ff4429d1fd72f6ed0","courseProgressId":0,"tsGen":1794535503383,"createTime":"2026-11-13 10:05:03","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"co