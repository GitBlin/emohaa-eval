{"success":true,"code":"000","message":null,"data":{"totalAmount":32,"totalPageCount":1,"pageNum":0,"itemCount":32,"content":[{"pageNum":0,"pageSize":0,"id":"6af67077f4429d1fd72f6f33","chatId":"82f85e0ab1a2440b85417aff91e47578","sessionId":null,"userId":99800,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那个乱乱的屋子、周末只想躺着的你，听起来并不糟，只是从没被允许拿出来见人。你把它藏起来，像是认定它一露面就会被扣分。要是真有人看见了这样的你，你最怕他心里冒出什么念头？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那个乱乱的屋子、周末只想躺着的你，听起来并不糟，只是从没被允许拿出来见人。你把它藏起来，像是认定它一露面就会被扣分。要是真有人看见了这样的你，你最怕他心里冒出什么念头？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2448,"promptTokens":3304,"completionTokens":144,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:43"}],"imgs":null,"regenerations":0,"seqNum":33,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010985804479739843,"emotions":[],"relationId":"6af67077f4429d1fd72f6f32","courseProgressId":0,"tsGen":1794535543717,"createTime":"2026-11-13 10:05:43","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67077f4429d1fd72f6f32","chatId":"82f85e0ab1a2440b85417aff91e47578","sessionId":null,"userId":99800,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（想了会儿）大概就是平时那个有点随意的我吧，家里乱乱的，周末只想躺着。这些在相亲那种场合，好像都不能拿出来见人。<第16轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":32,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010985804479739843,"emotions":[],"relationId":"6af67077f4429d1fd72f6f33","courseProgressId":0,"tsGen":1794535543714,"createTime":"2026-11-13 10:05:43","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67073f4429d1fd72f6f28","chatId":"82f85e0ab1a2440b85417aff91e47578","sessionId":null,"userId":99800,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"绷起来、想赶紧圆场——听起来你早就练熟了这套动作，快得自己都没察觉。你说一放松就“露馅”，我好奇的是，你怕露出来的那部分，到底是什么样子？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"绷起来、想赶紧圆场——听起来你早就练熟了这套动作，快得自己都没察觉。你说一放松就“露馅”，我好奇的是，你怕露出来的那部分，到底是什么样子？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2092,"promptTokens":2602,"completionTokens":117,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:39"}],"imgs":null,"regenerations":0,"seqNum":31,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608853014232149,"emotions":[],"relationId":"6af67073f4429d1fd72f6f27","courseProgressId":0,"tsGen":1794535539106,"createTime":"2026-11-13 10:05:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67073f4429d1fd72f6f27","chatId":"82f85e0ab1a2440b85417aff91e47578","sessionId":null,"userId":99800,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是整个人绷起来，肩膀发紧，想赶紧找句话把场面圆过去。好像一放松，就会露馅。<第15轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":30,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608853014232149,"emotions":[{"code":"fear","name":"恐惧","value":6,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7},{"code":"sadness","name":"悲伤","value":0,"sort":8},{"code":"dislike","name":"厌恶","value":0,"sort":9}],"relationId":"6af67073f4429d1fd72f6f28","courseProgressId":0,"tsGen":1794535539104,"createTime":"2026-11-13 10:05:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6706ef4429d1fd72f6f1d","chatId":"82f85e0ab1a2440b85417aff91e47578","sessionId":null,"userId":99800,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"从小被教成“别让人挑毛病”，久了就会把别人的尺子当成自己的。你为自己想一点就觉得错，其实是那把尺子在心里响。这种“错”的感觉冒出来时，身体上是什么样？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"从小被教成“别让人挑毛病”，久了就会把别人的尺子当成自己的。你为自己想一点就觉得错，其实是那把尺子在心里响。这种“错”的感觉冒出来时，身体上是什么样？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1698,"promptTokens":3180,"completionTokens":95,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:34"}],"imgs":null,"regenerations":0,"seqNum":29,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0075765923034174275,"emotions":[],"relationId":"6af6706ef4429d1fd72f6f1c","courseProgressId":0,"tsGen":1794535534689,"createTime":"2026-11-13 10:05:34","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6706ef4429d1fd72f6f1c","chatId":"82f85e0ab1a2440b85417aff91e47578","sessionId":null,"userId":99800,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（顿了一下）没人直接这么说，可我自己就这么觉得。家里从小讲的就是稳定、别让人挑毛病，我为自己想一点，好像就错了。<第14轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":28,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0075765923034174275,"emotions":[],"relationId":"6af6706ef4429d1fd72f6f1d","courseProgressId":0,"tsGen":1794535534686,"createTime":"2026-11-13 10:05:34","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6706af4429d1fd72f6f13","chatId":"82f85e0ab1a2440b85417aff91e47578","sessionId":null,"userId":99800,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“自私”这个词，你用得挺重的。只是不想再被当成面试一样打量，这更像是在护着自己，而不是自私。这个罪名，是你自己定的，还是也有人这样说过你？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“自私”这个词，你用得挺重的。只是不想再被当成面试一样打量，这更像是在护着自己，而不是自私。这个罪名，是你自己定的，还是也有人这样说过你？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2831,"promptTokens":2614,"completionTokens":131,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:30"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219656876673287,"emotions":[],"relationId":"6af6706af4429d1fd72f6f12","courseProgressId":0,"tsGen":1794535530259,"createTime":"2026-11-13 10:05:30","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6706af4429d1fd72f6f12","chatId":"82f85e0ab1a2440b85417aff91e47578","sessionId":null,"userId":99800,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（声音低下去）我想说……我不想再为了让他们安心，去坐那一场场像面试一样的相亲了。说完又觉得自己挺自私的。<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":26,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219656876673287,"emotions":[],"relationId":"6af6706af4429d1fd72f6f13","courseProgressId":0,"tsGen":1794535530256,"createTime":"2026-11-13 10:05:30","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67065f4429d1fd72f6f05","chatId":"82f85e0ab1a2440b85417aff91e47578","sessionId":null,"userId":99800,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"委屈是真的，它不需要先通过“懂事”这一关才算数。你怕说出来显得不懂事，可这份怕，好像又让你把委屈一个人咽下去了。如果在这儿不用懂事，你最想说的那句委屈是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"委屈是真的，它不需要先通过“懂事”这一关才算数。你怕说出来显得不懂事，可这份怕，好像又让你把委屈一个人咽下去了。如果在这儿不用懂事，你最想说的那句委屈是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1906,"promptTokens":3299,"completionTokens":76,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:25"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007576496122508123,"emotions":[],"relationId":"6af67065f4429d1fd72f6f04","courseProgressId":0,"tsGen":1794535525080,"createTime":"2026-11-13 10:05:25","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67065f4429d1fd72f6f04","chatId":"82f85e0ab1a2440b85417aff91e47578","sessionId":null,"userId":99800,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（沉默了一下）就是……委屈吧。好像我这个人怎么做都不够，得先让她们满意才行。其实挺怕承认的，怕一说出来就显得我不懂事。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007576496122508123,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67065f4429d1fd72f6f05","courseProgressId":0,"tsGen":1794535525077,"createTime":"2026-11-13 10:05:25","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67060f4429d1fd72f6ef7","chatId":"82f85e0ab1a2440b85417aff91e47578","sessionId":null,"userId":99800,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你一边说那话往心里钻，一边又替她解释“也是为我好”。好像难受刚冒头，你就得赶紧把它按回去。如果把“为我好”先放一边，那句话本身，你听着是什么感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你一边说那话往心里钻，一边又替她解释“也是为我好”。好像难受刚冒头，你就得赶紧把它按回去。如果把“为我好”先放一边，那句话本身，你听着是什么感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2521,"promptTokens":3262,"completionTokens":143,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:20"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909551635108855,"emotions":[],"relationId":"6af67060f4429d1fd72f6ef6","courseProgressId":0,"tsGen":1794535520529,"createTime":"2026-11-13 10:05:20","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67060f4429d1fd72f6ef6","chatId":"82f85e0ab1a2440b85417aff91e47578","sessionId":null,"userId":99800,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"语气……好像是我妈。她不会直接骂我，就是那种“你这样人家能看上吗”的口气。说出来有点难受，她其实也是为我好，可那话就是往心里钻。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909551635108855,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67060f4429d1fd72f6ef7","c