enerations":0,"seqNum":36,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010984989497707215,"emotions":[{"code":"calm","name":"平静","value":5,"sort":4},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"happy","name":"快乐","value":2,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67080f4429d1fd72f6f48","courseProgressId":0,"tsGen":1794535552731,"createTime":"2026-11-13 10:05:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6707bf4429d1fd72f6f3e","chatId":"82f85e0ab1a2440b85417aff91e47578","sessionId":null,"userId":99800,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"能自己听出“这其实是我心里的声音”，这一步不容易——那把尺子拿久了，就以为是自己的了。现在认出来，你心里是松了一点，还是反而更沉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"能自己听出“这其实是我心里的声音”，这一步不容易——那把尺子拿久了，就以为是自己的了。现在认出来，你心里是松了一点，还是反而更沉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2045,"promptTokens":3307,"completionTokens":110,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:47"}],"imgs":null,"regenerations":0,"seqNum":35,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008576497025109675,"emotions":[],"relationId":"6af6707bf4429d1fd72f6f3d","courseProgressId":0,"tsGen":1794535547922,"createTime":"2026-11-13 10:05:47","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNu