l,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575768498023669,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67cf3f4429d1fd72f7e69","courseProgressId":0,"tsGen":1794538739319,"createTime":"2026-11-13 10:58:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cedf4429d1fd72f7e5b","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你答应的时候，心里其实已经很不情愿了吧？那不是没用，是你太怕让别人失望了。拒绝不了，往往背后有个更早的原因。你还记得自己是从什么时候开始，觉得“说不”是件很危险的事吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你答应的时候，心里其实已经很不情愿了吧？那不是没用，是你太怕让别人失望了。拒绝不了，往往背后有个更早的原因。你还记得自己是从什么时候开始，觉得“说不”是件很危险的事吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1771,"promptTokens":2241,"completionTokens":105,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:58:53"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.03731323535341415,"emotions":[],"relationId":"6af67cedf4429d1fd72f7e5a","courseProgressId":0,"tsGen":1794538733378,"createTime":"2026-11-13 10:58:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBo