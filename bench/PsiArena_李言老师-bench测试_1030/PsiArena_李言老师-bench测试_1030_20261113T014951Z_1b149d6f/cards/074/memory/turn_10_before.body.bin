{"success":true,"code":"000","message":null,"data":{"totalAmount":18,"totalPageCount":1,"pageNum":0,"itemCount":18,"content":[{"pageNum":0,"pageSize":0,"id":"6af67cf9f4429d1fd72f7e71","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你刚说到一个挺关键的点：一停下来就发慌，好像是从小被要求着长大的那套标准，现在还留在你身体里。那这种“被落下”的慌，具体是什么样子？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你刚说到一个挺关键的点：一停下来就发慌，好像是从小被要求着长大的那套标准，现在还留在你身体里。那这种“被落下”的慌，具体是什么样子？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2184,"promptTokens":2372,"completionTokens":108,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:59:05"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705103442570001,"emotions":[],"relationId":"6af67cf9f4429d1fd72f7e70","courseProgressId":0,"tsGen":1794538745134,"createTime":"2026-11-13 10:59:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cf9f4429d1fd72f7e70","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"好像……是那种不敢停下来的感觉更多一点。事情多还能熬，可一停下来我就觉得心里发慌，好像不努力就会被落下。这种感觉……可能真的跟我爸妈从小要求我有关吧。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705103442570001,"emotio