{"success":true,"code":"000","message":null,"data":{"totalAmount":10,"totalPageCount":1,"pageNum":0,"itemCount":10,"content":[{"pageNum":0,"pageSize":0,"id":"6af67ce2f4429d1fd72f7e4b","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"怕被说矫情，这种感觉我懂——很多人开口前都会先替别人评判自己一遍。在我这儿，你说的累和难受都不会被当成矫情。你平时一般会怎么把这些感觉压下去？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"怕被说矫情，这种感觉我懂——很多人开口前都会先替别人评判自己一遍。在我这儿，你说的累和难受都不会被当成矫情。你平时一般会怎么把这些感觉压下去？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1618,"promptTokens":1999,"completionTokens":85,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:58:42"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00757598109990417,"emotions":[],"relationId":"6af67ce2f4429d1fd72f7e4a","courseProgressId":0,"tsGen":1794538722602,"createTime":"2026-11-13 10:58:42","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ce2f4429d1fd72f7e4a","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"我也说不清……可能就是怕太正式了，我更不知道从哪开口。我平时也不太会跟别人说自己这些，怕人家觉得我矫情。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00757598109990417,"emotions":[],"relation