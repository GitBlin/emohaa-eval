nerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705501865298087,"emotions":[{"code":"calm","name":"平静","value":4,"sort":4},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"expect","name":"期待","value":3,"sort":2},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67cddf4429d1fd72f7e49","courseProgressId":0,"tsGen":1794538717867,"createTime":"2026-11-13 10:58:37","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cd8f4429d1fd72f7e45","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"大概是这样：前期我们多聊聊你最近的状态，慢慢看清“累”是从哪儿来的；中间会一起找些可以试的办法；最后再回头看看走过的路。听起来你说不清的那种累，已经持续一阵子了？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"大概是这样：前期我们多聊聊你最近的状态，慢慢看清“累”是从哪儿来的；中间会一起找些可以试的办法；最后再回头看看走过的路。听起来你说不清的那种累，已经持续一阵子了？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1917,"promptTokens":1751,"completionTokens":85,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:58:32"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012429153902318186,"emotions":[],"relationId":"6af67cd8f4429d1fd72f7e44","courseProgressId":0,"tsGen":1794538712367,"createTime":"2026-11-13 10:58:32","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"cons