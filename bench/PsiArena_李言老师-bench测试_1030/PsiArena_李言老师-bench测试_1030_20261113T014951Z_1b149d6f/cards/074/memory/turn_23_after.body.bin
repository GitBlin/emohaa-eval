rations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0066909759595579375,"emotions":[],"relationId":"6af67d0cf4429d1fd72f7e8d","courseProgressId":0,"tsGen":1794538764267,"createTime":"2026-11-13 10:59:24","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67d0cf4429d1fd72f7e8d","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最怕的……大概是别人觉得我不好吧。怕同事觉得我偷懒，怕领导觉得我不够上进。好像我少做一点，就成了个不合格的人。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0066909759595579375,"emotions":[{"code":"fear","name":"恐惧","value":8,"sort":6},{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67d0cf4429d1fd72f7e8e","courseProgressId":0,"tsGen":1794538764264,"createTime":"2026-11-13 10:59:24","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["疲惫","焦虑","自我否定","担忧","压抑"],"originalText":["就是每天回家都觉得没力气，也说不上具体哪件事","一停下来我就觉得心里发慌，好像不努力就会被落下","我是不是特别没用啊，连拒绝都不敢","怕同事觉得我偷懒，怕领导觉得我不够上进","就是忍着呗，加班做完就好了"]},"conversation":{"type":"自我认知与成长","topic":"探索过度自我要求、害怕他人负面评价以及尝试调整人际边界的心理困扰"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67d05f4429d1fd72f7e82","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你听上去很清楚地看到，这股劲头从刚工作就跟着你了——它其实一直在保护你，让你不被觉得“不行”，代价就是你从来没被允许停下来。如果哪天你真的少做一点，你心里最先冒出来的担心会是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你听上去很清楚地看到，这股劲头从刚工作就跟着你了——它其实一直在保护你，让你不被觉得“不行”，代价就是你从来没被允许停下来。如果哪天你真的少做一点，你心里最先冒出来的担心会是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2375,"promptTokens":3242,"completionTokens":139,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:59:17"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010983300203279533,"emotions":[],"relationId":"6af67d05f4429d1fd72f7e81","courseProgressId":0,"tsGen":1794538757929,"createTime":"2026-11-13 10:59:17","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67d05f4429d1fd72f7e81","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"会的……尤其是晚上一个人待着的时候。我有时候会想，我是不是从刚工作那会儿就把这种劲头带进来了，总想着多做点，别让人觉得我不行。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010983300203279533,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","va