,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你刚说到一个挺关键的点：一停下来就发慌，好像是从小被要求着长大的那套标准，现在还留在你身体里。那这种“被落下”的慌，具体是什么样子？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2184,"promptTokens":2372,"completionTokens":108,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:59:05"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705103442570001,"emotions":[],"relationId":"6af67cf9f4429d1fd72f7e70","courseProgressId":0,"tsGen":1794538745134,"createTime":"2026-11-13 10:59:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cf9f4429d1fd72f7e70","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"好像……是那种不敢停下来的感觉更多一点。事情多还能熬，可一停下来我就觉得心里发慌，好像不努力就会被落下。这种感觉……可能真的跟我爸妈从小要求我有关吧。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705103442570001,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67cf9f4429d1fd72f7e71","courseProgressId":0,"tsGen":1794538745131,"createTime":"2026-11-13 10:59:05","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["疲惫","焦虑","自我否定","担忧","压抑"],"originalText":["就是每天回家都觉得没力气，也说不上具体哪件事","一停下来我就觉得心里发慌，好像不努力就会被落下","我是不是特别没用啊，连拒绝都不敢","怕同事觉得我偷懒，怕领导觉得我不够上进","就是忍着呗，加班做完就好了"]},"conversation":{"type":"自我认知与成长","topic":"探索过度自我要求、害怕他人负面评价以及尝试调整人际边界的心理困扰"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cf3f4429d1fd72f7e69","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你觉得说小时候这些没多大用，我明白——眼下工作确实更压人。那我们先从工作谈起。让你喘不过气的，是事情本身太多，还是那种一直不敢停下来的感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你觉得说小时候这些没多大用，我明白——眼下工作确实更压人。那我们先从工作谈起。让你喘不过气的，是事情本身太多，还是那种一直不敢停下来的感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1837,"promptTokens":2892,"completionTokens":86,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:58:59"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575768498023669,"emotions":[],"relationId":"6af67cf3f4429d1fd72f7e68","courseProgressId":0,"tsGen":1794538739322,"createTime":"2026-11-13 10:58:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cf3f4429d1fd72f7e68","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"这个……我不太确定，可能从小就这样吧，我爸妈对我要求挺高的。不过现在说这些好像也没什么用，主要还是工作上的事让我喘不过气。<第8轮:让你的回答保持简短，限制每次回