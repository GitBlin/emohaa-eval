e":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67ce7f4429d1fd72f7e50","courseProgressId":0,"tsGen":1794538727870,"createTime":"2026-11-13 10:58:47","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ce2f4429d1fd72f7e4b","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"怕被说矫情，这种感觉我懂——很多人开口前都会先替别人评判自己一遍。在我这儿，你说的累和难受都不会被当成矫情。你平时一般会怎么把这些感觉压下去？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"怕被说矫情，这种感觉我懂——很多人开口前都会先替别人评判自己一遍。在我这儿，你说的累和难受都不会被当成矫情。你平时一般会怎么把这些感觉压下去？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1618,"promptTokens":1999,"completionTokens":85,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:58:42"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00757598109990417,"emotions":[],"relationId":"6af67ce2f4429d1fd72f7e4a","courseProgressId":0,"tsGen":1794538722602,"createTime":"2026-11-13 10:58:42","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ce2f4429d1fd72f7e4a","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"我也说不清……可能就是怕太正式了，我更不知道从哪开口。我平时也不太会跟别人说自己这些，怕人家觉得我矫情。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00757598109990417,"emotions":[{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67ce2f4429d1fd72f7e4b","courseProgressId":0,"tsGen":1794538722599,"createTime":"2026-11-13 10:58:42","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cddf4429d1fd72f7e49","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"朋友式的轻松感我可以给你，聊天不用端着；只是我不会替你做决定，也不会只说好听的。你希望我像朋友那样，是更想有人随意听你说说，还是怕太正式了讲不出口？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"朋友式的轻松感我可以给你，聊天不用端着；只是我不会替你做决定，也不会只说好听的。你希望我像朋友那样，是更想有人随意听你说说，还是怕太正式了讲不出口？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1903,"promptTokens":1876,"completionTokens":105,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:58:37"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705501865298087,"emotions":[],"relationId":"6af67cddf4429d1fd72f7e48","courseProgressId":0,"tsGen":1794538717870,"createTime":"2026-11-13 10:58:37","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cddf4429d1fd72f7e48","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……是有一阵子了，就是每天回家都觉得没力气，也说不上具体哪件事。对了，我能不能……就是随便问问，你会不会像朋友那样跟我聊？<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705501865298087,"emotions":[{"code":"calm","name":"平静","value":4,"sort":4},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"expect","name":"期待","value":3,"sort":2},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67cddf4429d1fd72f7e49","courseProgressId":0,"tsGen":1794538717867,"createTime":"2026-11-13 10:58:37","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cd8f4429d1fd72f7e45","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"大概是这样：前期我们多聊聊你最近的状态，慢慢看清“累”是从哪儿来的；中间会一起找些可以试的办法；最后再回头看看走过的路。听起来你说不清的那种累，已经持续一阵子了？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"conte