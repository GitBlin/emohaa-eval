ode":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67cf9f4429d1fd72f7e71","courseProgressId":0,"tsGen":1794538745131,"createTime":"2026-11-13 10:59:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cf3f4429d1fd72f7e69","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你觉得说小时候这些没多大用，我明白——眼下工作确实更压人。那我们先从工作谈起。让你喘不过气的，是事情本身太多，还是那种一直不敢停下来的感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你觉得说小时候这些没多大用，我明白——眼下工作确实更压人。那我们先从工作谈起。让你喘不过气的，是事情本身太多，还是那种一直不敢停下来的感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1837,"promptTokens":2892,"completionTokens":86,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:58:59"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575768498023669,"emotions":[],"relationId":"6af67cf3f4429d1fd72f7e68","courseProgressId":0,"tsGen":1794538739322,"createTime":"2026-11-13 10:58:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cf3f4429d1fd72f7e68","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"这个……我不太确定，可能从小就这样吧，我爸妈对我要求挺高的。不过现在说这些好像也没什么用，主要还是工作上的事让我喘不过气。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575768498023669,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67cf3f4429d1fd72f7e69","courseProgressId":0,"tsGen":1794538739319,"createTime":"2026-11-13 10:58:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cedf4429d1fd72f7e5b","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你答应的时候，心里其实已经很不情愿了吧？那不是没用，是你太怕让别人失望了。拒绝不了，往往背后有个更早的原因。你还记得自己是从什么时候开始，觉得“说不”是件很危险的事吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你答应的时候，心里其实已经很不情愿了吧？那不是没用，是你太怕让别人失望了。拒绝不了，往往背后有个更早的原因。你还记得自己是从什么时候开始，觉得“说不”是件很危险的事吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1771,"promptTokens":2241,"completionTokens":105,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:58:53"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.03731323535341415,"emotions":[],"relationId":"6af67cedf4429d1fd72f7e5a","courseProgressId":0,"tsGen":1794538733378,"createTime":"2026-11-13 10:58:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cedf4429d1fd72f7e5a","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"有……昨天快下班的时候，同事又让我帮她弄个表格，我自己手上的事都没做完，可我还是答应了。我是不是特别没用啊，连拒绝都不敢。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.03731323535341415,"emotions":[{"code":"sadness","name":"悲伤","value":7,"sort":8},{"code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"fear","name":"恐惧","value":6,"sort":6},{"code":"anger","name":"愤怒","value":3,"sort":7},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67cedf4429d1fd72f7e5b","courseProgressId":0,"tsGen":1794538733375,"createTime":"2026-11-13 10:58:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ce7f4429d1fd72f7e50","chatId":"13fcea270ce141058054507305fb862d","sessionId":null,"userId":99881,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来你一直在靠