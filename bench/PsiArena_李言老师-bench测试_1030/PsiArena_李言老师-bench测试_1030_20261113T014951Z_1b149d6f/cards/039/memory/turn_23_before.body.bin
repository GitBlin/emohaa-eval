ency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673e6f4429d1fd72f7499","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（低头，声音变小）有件事我一直不敢提……四年前，我谈过一个男朋友，后来……出了点事。我爸妈到现在都不知道，要是知道了，他们肯定接受不了。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012429449428768346,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"surprised","name":"惊讶","value":2,"sort":5},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af673e6f4429d1fd72f749a","courseProgressId":0,"tsGen":1794536422354,"createTime":"2026-11-13 10:20:22","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673e1f4429d1fd72f7490","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那个眼神像是从小一直跟着你，让你很早就学会了怎么才不算让人失望。这份小心翼翼，也难怪你会带进现在的关系里。你还记得那时候，家里有哪件事让你特别怕他们失望吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那个眼神像是从小一直跟着你，让你很早就学会了怎么才不算让人失望。这份小心翼翼，也难怪你会带进现在的关系里。你还记得那时候，家里有哪件事让你特别怕他们失望吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2480,"promptTokens":3084,"completionTokens":135,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:20:17"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691846702259869,"emotions":[],"relationId":"6af673e1f4429d1fd72f748f","courseProgressId":0,"tsGen":1794536417892,"createTime":"2026-11-13 10:20:17","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673e1f4429d1fd72f748f","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最早……可能是家里吧。我爸妈都是那种很讲规矩的人，从小我就知道，有些事做了就是丢人。他们不是凶，可那种“别让我们失望”的眼神，我到现在都记得。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691846702259869,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af673e1f4429d1fd72f7490","courseProgressId":0,"tsGen":1794536417890,"createTime":"2026-11-13 10:20:17","delFlag":0,"emotionTendency":null,"sourceProductType":nu