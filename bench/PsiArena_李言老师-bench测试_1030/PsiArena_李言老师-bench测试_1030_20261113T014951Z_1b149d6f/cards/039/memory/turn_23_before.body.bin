"name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af673cff4429d1fd72f7466","courseProgressId":0,"tsGen":1794536399229,"createTime":"2026-11-13 10:19:59","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["不安","担心","慌乱","自我怀疑"],"originalText":["最近确实有件事一直压着我，可我也不太说得清，就是跟男朋友相处的时候，心里老是不安。","有时候他对我越好，我反而越慌。","就是心里堵得慌，觉得自己好像配不上。","老是觉得自己做错了什么"]},"conversation":{"type":"人际关系处理","topic":"与男朋友相处中的不安与自我怀疑"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673cbf4429d1fd72f745c","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听你这么说，好像他对你越好，那份不安反而越重，像是不太敢接住别人的好。这种“配不上”的感觉，是只在他这儿出现，还是以前在别的关系里也有过？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听你这么说，好像他对你越好，那份不安反而越重，像是不太敢接住别人的好。这种“配不上”的感觉，是只在他这儿出现，还是以前在别的关系里也有过？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1844,"promptTokens":1891,"completionTokens":106,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:19:55"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012426363002559304,"emotions":[],"relationId":"6af673cbf4429d1fd72f745b","courseProgressId":0,"tsGen":1794536395082,"createTime":"2026-11-13 10:19:55","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673cbf4429d1fd72f745b","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……其实也说不准，有时候他对我越好，我反而越慌。可能是……唉，我也不知道该怎么讲清楚，就是心里堵得慌，觉得自己好像配不上。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012426363002559304,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af673cbf4429d1fd72f745c","courseProgressId":0,"tsGen":1794536395079,"createTime":"2026-11-13 10:19:55","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["不安","担心","慌乱","自我怀疑"],"originalText":["最近确实有件事一直压着我，可我也不太说得清，就是跟男朋友相处的时候，心里老是不安。","有时候他对我越好，我反而越慌。","就是心里堵得慌，觉得自己好像配不上。","老是觉得自己做错了什么"]},"conversation":{"type":"人际关系处理","topic":"与男朋友相处中的不安与自我怀疑"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673c7f4429d1fd72f7455","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"保密这块你可以放心，你说的话我会认真守住，不会随意往外讲。不过如果你提到危及安全的情况，我会和你商量怎么处理。听起来，跟男朋友相处时那种不安一直跟着你，能说说那种感觉通常在什么时候冒出来吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"保密这块你可以放心，你说的话我会认真守住，不会随意往外讲。不过如果你提到危及安全的情况，我会和你商量怎么处理。听起来，跟男朋友相处时那种不安一直跟