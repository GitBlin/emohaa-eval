alm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67412f4429d1fd72f74ec","courseProgressId":0,"tsGen":1794536466334,"createTime":"2026-11-13 10:21:06","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6740af4429d1fd72f74de","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"好，我不急着推你做决定，先陪你把这份怕看清楚。你能说清楚自己需要什么，这本身就是在照顾自己。那这份“怕”出现的时候，你身上最先有反应的是哪儿？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"好，我不急着推你做决定，先陪你把这份怕看清楚。你能说清楚自己需要什么，这本身就是在照顾自己。那这份“怕”出现的时候，你身上最先有反应的是哪儿？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1670,"promptTokens":3222,"completionTokens":103,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:20:58"}],"imgs":null,"regenerations":0,"seqNum":37,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691619362983186,"emotions":[],"relationId":"6af6740af4429d1fd72f74dd","courseProgressId":0,"tsGen":1794536458276,"createTime":"2026-11-13 10:20:58","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6740af4429d1fd72f74dd","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……我希望你别急着告诉我该不该跟男朋友说。我自己都还没想明白。可能……我需要有人陪我先把这份怕看清楚，再决定要不要开口。<第18轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":nul