{"success":true,"code":"000","message":null,"data":{"totalAmount":20,"totalPageCount":1,"pageNum":0,"itemCount":20,"content":[{"pageNum":0,"pageSize":0,"id":"6af673e6f4429d1fd72f749a","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"谢谢你愿意把这件事说出来，这一定需要很大的勇气。你能讲到这儿，我不会追问细节，也不会因此觉得你不好。现在说出来之后，你心里是什么感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"谢谢你愿意把这件事说出来，这一定需要很大的勇气。你能讲到这儿，我不会追问细节，也不会因此觉得你不好。现在说出来之后，你心里是什么感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2812,"promptTokens":3093,"completionTokens":178,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:20:22"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012429449428768346,"emotions":[],"relationId":"6af673e6f4429d1fd72f7499","courseProgressId":0,"tsGen":1794536422357,"createTime":"2026-11-13 10:20:22","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673e6f4429d1fd72f7499","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（低头，声音变小）有件事我一直不敢提……四年前，我谈过一个男朋友，后来……出了点事。我爸妈到现在都不知道，要是知道了，他们肯定接受不了。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012429449428768346,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"surprised","name":"惊讶","value":2,"sort":5},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af673e6f4429d1fd72f749a","courseProgressId":0,"tsGen":1794536422354,"createTime":"2026-11-13 10:20:22","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673e1f4429d1fd72f7490","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那个眼神像是从小一直跟着你，让你很早就学会了怎么才不算让人失望。这份小心翼翼，也难怪你会带进现在的关系里。你还记得那时候，家里有哪件事让你特别怕他们失望吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那个眼神像是从小一直跟着你，让你很早就学会了怎么才不算让人失望。这份小心翼翼，也难怪你会带进现在的关系里。你还记得那时候，家里有哪件事让你特别怕他们失望吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2480,"promptTokens":3084,"completionTokens":135,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:20:17"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691846702259869,"emotions":[],"relationId":"6af673e1f4429d1fd72f748f","courseProgressId":0,"tsGen":1794536417892,"createTime":"2026-11-13 10:20:17","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673e1f4429d1fd72f748f","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最早……可能是家里吧。我爸妈都是那种很讲规矩的人，从小我就知道，有些事做了就是丢人。他们不是凶，可那种“别让我们失望”的眼神，我到现在都记得。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691846702259869,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af673e1f4429d1fd72f7490","courseProgressId":0,"tsGen":1794536417890,"createTime":"2026-11-13 10:20:17","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673ddf4429d1fd72f7486","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"能停在这儿，说明你很在意别人怎么看你，连我也一样。我不会因为你说什么就评判你，你愿意说多少就是多少。只是这份“说出来就会被觉得不好”的担心，好像一直都在，它最早是从哪儿来的，你还记得吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"能停在这儿，说明你很在意别人怎么看你，连我也一样。我不会因为你说什么就评判你，你愿意说多少就是多少。只是这份“说出来就会被觉得不好”的担心，好像一直都在，它最早是从哪儿来的，你还记得吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2128,"promptTokens":2784,"completionTokens":122,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:20:13"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00970695295994184,"emotions":[],"relationId":"6af673ddf4429d1fd72f7485","courseProgressId":0,"tsGen":1794536413669,"createTime":"2026-11-13 10:20:13","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673ddf4429d1fd72f7485","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"我……（停顿）这个我还没准备好说。能不能先让我缓缓，我怕说出来，连你也会觉得我不好。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00970695295994184,"emotions":[{"code":"fear","name":"恐惧","value":6,"sort":6},{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af673ddf4429d1fd72f7486","courseProgressId":0,"tsGen":1794536413667,"createTime":"2026-11-13 10:20:13","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673d9f4429d1fd72f747c","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那种憋着的感觉，像是怕他一靠近就看见你不愿被看见的部分。他眼神一变，你心里大概就会更确认“果然我不够好”。你憋着的那些事，最怕他看见的是哪一面？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那种憋着的感觉，像是怕他一靠近就看见你不愿被看见的部分。他眼神一变，你心里大概就会更确认“果然我不够好”。你憋着的那些事，最怕他看见的是哪一面？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2055,"promptTokens":2671,"completionTokens":114,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:20:09"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909462709655159,"emotions":[],"relationId":"6af673d9f4429d1fd72f747b","courseProgressId":0,"tsGen":1794536409513,"createTime":"2026-11-13 10:20:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673d9f4429d1fd72f747b","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"你这么一说……好像还真是。我平时就特别怕别人觉得我不够好。所以有些事，我一直憋着，不敢跟男朋友讲，怕他看我的眼神会变。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909462709655159,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"surprised","name":"惊讶","value":2,"sort":5},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af673d9f4429d1fd72f747c","courseProgressId":0,"tsGen":1794536409510,"createTime":"2026-11-13 10:20:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673d5f4429d1fd72f7471","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"时长没有固定标准，快慢都由你来定，我不会催你，说到哪儿算哪儿，哪怕停一停也没关系。你担心说不到点子上，这种紧张本身，是不是也像平时怕自己做错什么的感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"时长没有固定标准，快慢都由你来定，我不会催你，说到哪儿算哪儿，哪怕停一停也没关系。你担心说不到点子上，这种紧张本身，是不是也像平时怕自己做错什么的感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1887,"promptTokens":2546,"completionTokens":71,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:20:05"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0066921029094203464,"emotions":[],"relationId":"6af673d5f4429d1fd72f7470","courseProgressId":0,"tsGen":1794536405486,"createTime":"2026-11-13 10:20:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673d5f4429d1fd72f7470","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是……唉，说到这个我就有点乱。要不先等等，我想先了解下，这种咨询一般要谈多久？我怕自己说不到点子上，会不会被你催着往下走？<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0066921029094203464,"emotions":[{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"sadness","name":"悲伤","value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af673d5f4429d1fd72f7471","courseProgressId":0,"tsGen":1794536405484,"createTime":"2026-11-13 10:20:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673cff4429d1fd72f7466","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"这样的感受其实并不少见，很多人都会在关系里反复怀疑是不是自己的错。你不是什么奇怪的人。只是我更好奇，你说的“做错了什么”，最近一次是在什么事情上冒出来的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"这样的感受其实并不少见，很多人都会在关系里反复怀疑是不是自己的错。你不是什么奇怪的人。只是我更好奇，你说的“做错了什么”，最近一次是在什么事情上冒出来的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1874,"promptTokens":2017,"completionTokens":95,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:19:59"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014059522348941637,"emotions":[],"relationId":"6af673cff4429d1fd72f7465","courseProgressId":0,"tsGen":1794536399232,"createTime":"2026-11-13 10:19:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673cff4429d1fd72f7465","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"以前……可能也有吧，我不太想翻那些旧事。对了，我想问一下，像你接触过的那些来访者，会不会有人像我这样，老是觉得自己做错了什么？<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014059522348941637,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af673cff4429d1fd72f7466","courseProgressId":0,"tsGen":1794536399229,"createTime":"2026-11-13 10:19:59","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["不安","担心","慌乱","自我怀疑"],"originalText":["最近确实有件事一直压着我，可我也不太说得清，就是跟男朋友相处的时候，心里老是不安。","有时候他对我越好，我反而越慌。","就是心里堵得慌，觉得自己好像配不上。","老是觉得自己做错了什么"]},"conversation":{"type":"人际关系处理","topic":"与男朋友相处中的不安与自我怀疑"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673cbf4429d1fd72f745c","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听你这么说，好像他对你越好，那份不安反而越重，像是不太敢接住别人的好。这种“配不上”的感觉，是只在他这儿出现，还是以前在别的关系里也有过？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听你这么说，好像他对你越好，那份不安反而越重，像是不太敢接住别人的好。这种“配不上”的感觉，是只在他这儿出现，还是以前在别的关系里也有过？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1844,"promptTokens":1891,"completionTokens":106,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:19:55"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012426363002559304,"emotions":[],"relationId":"6af673cbf4429d1fd72f745b","courseProgressId":0,"tsGen":1794536395082,"createTime":"2026-11-13 10:19:55","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af673cbf4429d1fd72f745b","chatId":"1e84352fe4b94800b920ec53fd9445a8","sessionId":null,"userId":99836,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……其实也说不准，有时候他对我越好，我反而越慌。可能是……唉，我也不知道该怎么讲清楚，就是心里堵得慌，觉得自己好像配不上。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012426363002559304,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"expect","name":"期待",