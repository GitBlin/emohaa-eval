{"success":true,"code":"000","message":null,"data":{"totalAmount":16,"totalPageCount":1,"pageNum":0,"itemCount":16,"content":[{"pageNum":0,"pageSize":0,"id":"6af67c1af4429d1fd72f7daa","chatId":"9a2eb9341ced418a97d00254d0deee56","sessionId":null,"userId":99880,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“说了也没用”，还有怕被说矫情——听着像是你早就学会了把心事自己扛。你心里会不会也有点希望，有个人能真的懂，而不是劝你别多想？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“说了也没用”，还有怕被说矫情——听着像是你早就学会了把心事自己扛。你心里会不会也有点希望，有个人能真的懂，而不是劝你别多想？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2147,"promptTokens":2235,"completionTokens":89,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:55:22"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010983727288995146,"emotions":[],"relationId":"6af67c1af4429d1fd72f7da9","courseProgressId":0,"tsGen":1794538522498,"createTime":"2026-11-13 10:55:22","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67c1af4429d1fd72f7da9","chatId":"9a2eb9341ced418a97d00254d0deee56","sessionId":null,"userId":99880,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"怕她追问，也怕她……觉得我矫情吧。反正说了也解决不了，她还会跟着操心。有些事，跟她说了也没用。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010983727288995146,"emotions":[{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67c1af4429d1fd72f7daa","courseProgressId":0,"tsGen":1794538522495,"createTime":"2026-11-13 10:55:22","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67c16f4429d1fd72f7da0","chatId":"9a2eb9341ced418a97d00254d0deee56","sessionId":null,"userId":99880,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你一句“挺好的”就把累全咽回去了，好像说了真话，反而要应付更多追问。那我有点想知道，如果你当时说“其实我很累”，你怕接下来会发生什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你一句“挺好的”就把累全咽回去了，好像说了真话，反而要应付更多追问。那我有点想知道，如果你当时说“其实我很累”，你怕接下来会发生什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2123,"promptTokens":2640,"completionTokens":114,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:55:18"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575165839246145,"emotions":[],"relationId":"6af67c16f4429d1fd72f7d9f","courseProgressId":0,"tsGen":1794538518195,"createTime":"2026-11-13 10:55:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67c16f4429d1fd72f7d9f","chatId":"9a2eb9341ced418a97d00254d0deee56","sessionId":null,"userId":99880,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最近一次……好像是我妈打电话来，问我工作怎么样。我其实特别累，但最后只说“挺好的”。说了她也不会懂，反而要问东问西。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575165839246145,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"calm","name":"平静","value":4,"sort":4},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67c16f4429d1fd72f7da0","courseProgressId":0,"tsGen":1794538518192,"createTime":"2026-11-13 10:55:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67c11f4429d1fd72f7d96","chatId":"9a2eb9341ced418a97d00254d0deee56","sessionId":null,"userId":99880,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"在家里也先把话咽回去，久了会挺憋的。你说“也没什么大事”，可我听着，那些没说出口的话好像并不轻。能想起最近一次吗——话到嘴边，你最后没说的是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"在家里也先把话咽回去，久了会挺憋的。你说“也没什么大事”，可我听着，那些没说出口的话好像并不轻。能想起最近一次吗——话到嘴边，你最后没说的是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2254,"promptTokens":2524,"completionTokens":95,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:55:13"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218693357371744,"emotions":[],"relationId":"6af67c11f4429d1fd72f7d95","courseProgressId":0,"tsGen":1794538513784,"createTime":"2026-11-13 10:55:13","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67c11f4429d1fd72f7d95","chatId":"9a2eb9341ced418a97d00254d0deee56","sessionId":null,"userId":99880,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"好像是……习惯了。在家里也是，话到嘴边先咽回去，怕说了让爸妈不高兴。其实也没什么大事，就是……唉，我也说不明白。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218693357371744,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67c11f4429d1fd72f7d96","courseProgressId":0,"tsGen":1794538513781,"createTime":"2026-11-13 10:55:13","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67c0df4429d1fd72f7d90","chatId":"9a2eb9341ced418a97d00254d0deee56","sessionId":null,"userId":99880,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"合适的，这个时间本来就是留给你的，你多来聊不算占用。倒是你连着两次先担心会不会麻烦我，我想多了解一点——在生活里，你是不是也常这样，话还没说出口，先替别人考虑好了？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"合适的，这个时间本来就是留给你的，你多来聊不算占用。倒是你连着两次先担心会不会麻烦我，我想多了解一点——在生活里，你是不是也常这样，话还没说出口，先替别人考虑好了？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1887,"promptTokens":2404,"completionTokens":113,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:55:09"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008574289712473631,"emotions":[],"relationId":"6af67c0df4429d1fd72f7d8f","courseProgressId":0,"tsGen":1794538509252,"createTime":"2026-11-13 10:55:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67c0df4429d1fd72f7d8f","chatId":"9a2eb9341ced418a97d00254d0deee56","sessionId":null,"userId":99880,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……可能是吧。我好像习惯了先想想会不会麻烦别人。那个……如果我以后想多找你聊，会不会不太合适？我怕占用你太多时间。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008574289712473631,"emotions":[{"code":"expect","name":"期待","value":4,"sort":2},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"sadness","name":"悲伤","value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67c0df4429d1fd72f7d90","courseProgressId":0,"tsGen":1794538509249,"createTime":"2026-11-13 10:55:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67c09f4429d1fd72f7d8b","chatId":"9a2eb9341ced418a97d00254d0deee56","sessionId":null,"userId":99880,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不会烦，真的。在我这儿你说什么都行，说乱了、说重复了都没关系，我不会嫌你。\n\n不过我有点好奇，你刚才先想到问这个，是不是平时说话时，常担心自己给别人添麻烦？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不会烦，真的。在我这儿你说什么都行，说乱了、说重复了都没关系，我不会嫌你。\n\n不过我有点好奇，你刚才先想到问这个，是不是平时说话时，常担心自己给别人添麻烦？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2210,"promptTokens":1876,"completionTokens":137,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:55:05"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575369867591222,"emotions":[],"relationId":"6af67c09f4429d1fd72f7d8a","courseProgressId":0,"tsGen":1794538505344,"createTime":"2026-11-13 10:55:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67c09f4429d1fd72f7d8a","chatId":"9a2eb9341ced418a97d00254d0deee56","sessionId":null,"userId":99880,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是……一些乱七八糟的事，说不太清楚。有时候越想越难受，但也不知道到底在难受什么。嗯……我可以问一下吗，如果我说的话让你觉得烦，你会直接告诉我吗？<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,