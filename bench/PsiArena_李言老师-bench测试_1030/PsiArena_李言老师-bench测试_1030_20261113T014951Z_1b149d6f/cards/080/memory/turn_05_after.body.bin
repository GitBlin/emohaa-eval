{"success":true,"code":"000","message":null,"data":{"totalAmount":10,"totalPageCount":1,"pageNum":0,"itemCount":10,"content":[{"pageNum":0,"pageSize":0,"id":"6af67de1f4429d1fd72f7f5e","chatId":"2338dff4e893467693dcdb0acf975331","sessionId":null,"userId":99887,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"被这样看待确实不好受，你愿意说出来，已经不容易了。听起来你连自己都在怀疑是不是“想太多”，这种堵着的感觉，可能比事情本身更磨人。你说做什么都不太专心，那种堵，更像烦、像委屈，还是说不上来的闷？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"被这样看待确实不好受，你愿意说出来，已经不容易了。听起来你连自己都在怀疑是不是“想太多”，这种堵着的感觉，可能比事情本身更磨人。你说做什么都不太专心，那种堵，更像烦、像委屈，还是说不上来的闷？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2087,"promptTokens":1981,"completionTokens":142,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:02:57"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575186394325417,"emotions":[],"relationId":"6af67de1f4429d1fd72f7f5d","courseProgressId":0,"tsGen":1794538977600,"createTime":"2026-11-13 11:02:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67de1f4429d1fd72f7f5d","chatId":"2338dff4e893467693dcdb0acf975331","sessionId":null,"userId":99887,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"怕被当成那种…小心眼、想太多的男人吧。其实我也说不清楚自己为什么这么难受，就是最近心里一直堵着，做什么都不太专心。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"i