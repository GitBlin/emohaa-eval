":5,"sort":5},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66dc2f4429d1fd72f68f5","courseProgressId":0,"tsGen":1794534850860,"createTime":"2026-11-13 09:54:10","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66dbef4429d1fd72f68ea","chatId":"96aa8a736e884051974a117ba4f543a9","sessionId":null,"userId":99786,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“怕丢脸”这三个字压了这么多年，累是应该的。你一直在替家里活成别人眼里的样子，自己的感受反倒排到了最后。那份累里，有没有一部分是从来没被人问过“你想要什么”？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“怕丢脸”这三个字压了这么多年，累是应该的。你一直在替家里活成别人眼里的样子，自己的感受反倒排到了最后。那份累里，有没有一部分是从来没被人问过“你想要什么”？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1986,"promptTokens":2600,"completionTokens":96,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:54:06"}],"imgs":null,"regenerations":0,"seqNum":29,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.020329893516837057,"emotions":[],"relationId":"6af66dbef4429d1fd72f68e9","courseProgressId":0,"tsGen":1794534846744,"createTime":"2026-11-13 09:54:06","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66dbef4429d1fd72f68e9","chatId":"96aa8a736e884051974a117ba4f543a9","sessionId":null,"userId":99786,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（沉默了一下）……你这么一说，好像还真是。我从小就怕给家里丢脸，成绩要好，人也要讨人喜欢。可是这样活着，真的好累啊。<第14轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":28,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.020329893516837057,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66dbef4429d1fd72f68ea","courseProgressId":0,"tsGen":1794534846741,"createTime":"2026-11-13 09:54:06","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66dbaf4429d1fd72f68e0","chatId":"96aa8a736e884051974a117ba4f543a9","sessionId":null,"userId":99786,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来，家里虽然温和，但那句“别人怎么看我们家”一直悬在空气里。这种在意，久了会变成你心里的一把尺子——不光要做好，还得被人看见做好。你小时候是不是也隐隐觉得自己在替家里“撑面子”？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来，家里虽然温和，但那句“别人怎么看我们家”一直悬在空气里。这种在意，久了会变成你心里的一把尺子——不光要做好，还得被人看见做好。你小时候是不是也隐隐觉得自己在替家里“撑面子”？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2706,"promptTokens":3304,"completionTokens":140,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:54:02"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219375875105815,"emotions":[],"relationId":"6af66dbaf4429d1fd72f68df","courseProgressId":0,"tsGen":1794534842807,"createTime":"2026-11-13 09:54:02","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66dbaf4429d1fd72f68df","chatId":"96aa8a736e884051974a117ba4f543a9","sessionId":null,"userId":99786,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"更像提醒吧，就是那种“你得会处关系，不然以后吃亏”。家里说话都挺温和的，但你能感觉到，他们很在意别人怎么看我们家。<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":26,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219375875105815,"emotions":[{"code":"calm","name":"平静","value":6,"sort":4},{"code":"trust","name":"信任","value":4,"sort":3},{"code":"expect","name":"期待","value":3,"sort":2},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"sadness","name":"悲伤","value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66dbaf4429d1fd72f68e0","courseProgressId":0,"tsGen":1794534842804,"createTime":"2026-11-13 09:54:02","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66db6f4429d1fd72f68d6","chatId":"96aa8a736e884051974a117ba4f543a9","sessionId":null,"userId":99786,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"有可能。当“多跟人打交道”变成一句要求，关系就有点像任务了——你要做好，才不算出错。这样一来，别人的回应自然就成了打分的标准。你爸妈说这话时，是鼓励的语气，还是更像在提醒你别落后？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"有可能。当“多跟人打交道”变成一句要求，关系就有点像任务了——你要做好，才不算出错。这样一来，别人的回应自然就成了打分的标准。你爸妈说这话时，是鼓励的语气，还是更像在提醒你别落后？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2541,"promptTokens":3241,"completionTokens":140,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:53:58"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.017980978385316614,"emotions":[],"relationId":"6af66db6f4429d1fd72f68d5","courseProgressId":0,"tsGen":1794534838029,"createTime":"2026-11-13 09:53:58","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66db6f4429d1fd72f68d5","chatId":"96aa8a736e884051974a117ba4f543a9","sessionId":null,"userId":99786,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"胸口发紧，手心冒汗，坐也不是站也不是。就那种……非得做点什么才行的感觉。对了，我爸妈从小就让我多跟人打交道，说人脉重要，这会不会也有关系？<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.017980978385316614,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"sadness","name":"悲伤","value":1,"sort":8},{"code":"dislike","name":"厌恶","value":1,"sort":9},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"calm","name":"平静","value":0,"sort":4}],"relationId":"6af66db6f4429d1fd72f68d6","courseProgressId":0,"tsGen":1794534838026,"createTime":"2026-11-13 09:53:58","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66db1f4429d1fd72f68d0","chatId":"96aa8a736e884051974a117ba4f543a9","sessionId":null,"userId":99786,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那种“不发就要断”的紧绷，确实很难扛住，事后后悔也很正常——你不是没自制力，是那根弦绷得太久了。我想知道，弦快断的那一刻，你身体上是什么感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那种“不发就要断”的紧绷，确实很难扛住，事后后悔也很正常——你不是没自制力，是那根弦绷得太久了。我想知道，弦快断的那一刻，你身体上是什么感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2503,"promptTokens":3203,"completionTokens":134,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:53:53"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.025952213903978713,"emotions":[],"relationId":"6af66db1f4429d1fd72f68cf","courseProgressId":0,"tsGen":1794534833572,"createTime":"2026-11-13 09:53:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66db1f4429d1fd72f68cf","chatId":"96aa8a736e884051974a117ba4f543a9","sessionId":null,"userId":99786,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"说实话……更慌了。发完就后悔，觉得自己怎么又没忍住。可当时就是控制不住，好像不发出去，心里那根弦就要断了。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.025952213903978713,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af66db1f4429d1fd72f68d0","courseProgressId":0,"tsGen":1794534833569,"createTime":"2026-11-13 09:53:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66dacf4429d1fd72f68c8","chatId":"96aa8a736e884051974a117ba4f543a9","sessionId":null,"userId":99786,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你发现了吗，越想越觉得自己有问题，就越想再发一条去确认——可这条消息其实是想让对方替你证明“你没问题”。这种确认，往往只能缓一会儿。你回想一下，补发之后，心里是踏实了，还是更慌了？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你发现了吗，越想越觉得自己有问题，就越想再发一条去确认——可这条消息其实是想让对方替你证明“你没问题”。这种确认，往往只能缓一会儿。你回想一下，补发之后，心里是踏实了，还是更慌了？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2307,"promptTokens":3074,"completionTokens":128,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:53:48"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.020328294749646175,"emotions":[],"relationId":"6af66dacf4429d1fd72f68c7","courseProgressId":0,"tsGen":1794534828860,"createTime":"2026-11-13 09:53:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66dacf4429d1fd72f68c7","chatId":"96aa8a736e884051974a117ba4f543a9","sessionId":null,"userId":99786,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就会开始乱想，是不是我哪句话说错了，是不是我太烦人了。越想越觉得自己有问题，然后就特别想再发一条去确认。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.020328294749646175,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66dacf4429d1fd72f68c8","courseProgressId":0,"tsGen":1794534828857,"createTime":"2026-11-13 09:53:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66da8f4429d1fd72f68be","chatId":"96aa8a736e884051974a117ba4f543a9","sessionId":null,"userId":99786,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你这句话说得很关键——好像别人的回复，慢慢变成了判断你“有没有做错”的依据。等的不只是消息，更像在等一句“你没问题”。那如果那条消息一直不来，你心里通常会怎么给自己下结论？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你这句话说得很关键——好像别人的回复，慢慢变成了判断你“有没有做错”的依据。等的不只是消息，更像在等一句“你没问题”。那如果那条消息一直不来，你心里通常会怎么给自己下结论？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2644,"promptTokens":2957,"completionTokens":178,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:53:44"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01405897796352888,"emotions":[],"relationId":"6af66da8f4429d1fd72f68bd","courseProgressId":0,"tsGen":1794534824785,"createTime":"2026-11-13 09:53:44","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66da8f4429d1fd72f68bd","chatId":"96aa8a736e884051974a117ba4f543a9","sessionId":null,"userId":99786,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"像……挺像的。小时候等爸妈，现在等消息，都是那种悬着心的感觉。而且我发现，好像得有人回我，我才觉得自己没做错什么似的。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01405897796352888,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"expect","name":"期待","value":6,"sort":2},{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66da8f4429d1fd72f68be","courseProgressId":0,"tsGen":1794534824782,"createTime":"2026-11-13 09:53:44","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66da3f4429d1fd72f68b1","chatId":"96aa8a736e884051974a117ba4f543a9","sessionId":null,"userId":99786,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你愿意说出来，一点不怪。一个人等着、等着，等成了习惯，长大后就会落在别人身上。不过童年的猜测不一定就是答案，你觉得现在这种“等”的滋味，和那时候比，像吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你愿意说出来，一点不怪。一个人等着、等着，等成了习惯，长大后就会落在别人身上。不过童年的猜测不一定就是答案，你觉得现在这种“等”的滋味，和那时候比，像吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2033,"promptTokens":2722,"completionTokens":88,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:53:39"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010983296874282223,"emotions":[],"relationId":"6af66da3f4429d1fd72f68b0","courseProgressId":0,"tsGen":1794534819621,"createTime":"2026-11-13 09:53:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66da3f4429d1fd72f68b0","chatId":"96aa8a736e884051974a117ba4f543a9","sessionId":null,"userId":99786,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"这个……我得想想。好像从小就有吧，我爸妈工作忙，我总是一个人待着等他们回家。不过我也不确定是不是这个原因，说出来感觉有点怪。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010983296874282223,"emotions":[{"code":"calm","name":"平静","value":4,"sort":4},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af66da3f4429d1fd72f68b1","courseProgressId":0,"tsGen":1794534819618,"createTime":"2026-11-13 09:53:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af66d9ef4429d1fd72f68a1","chatId":"96aa8a736e884051974a117ba4f543a9","sessionId":null,"userId":99786,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你用了“太依赖”这个词，听起来对自己有点严厉。在意别人在不在乎你，本身不是错，只是当它变成唯一确认自己的方式时，才会让人慌。你觉得，这种怕被丢下的感觉，是从什么时候开始有的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你用了“太依赖”这个词，听起来对自己有点严厉。在意别人在不在乎你，本身不是错，只是当它变成唯一确认自己的方式时，才会让人慌。你觉得，这种怕被丢下的感觉，是从什么时候开始有的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2209,"promptTokens":2593,"completionTokens":108,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 09:53:34"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007574976155159738,"emotions":[],"relationId":"6af66d9ef4429d1fd72f68a0","courseProgressId":0,"tsGen":1794534814640,"createTime":"2026-11-13 09:53:34","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"page