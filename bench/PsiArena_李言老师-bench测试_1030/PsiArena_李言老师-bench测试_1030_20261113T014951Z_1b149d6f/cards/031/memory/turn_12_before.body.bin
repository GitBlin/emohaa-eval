value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6726df4429d1fd72f720f","courseProgressId":0,"tsGen":1794536045350,"createTime":"2026-11-13 10:14:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67268f4429d1fd72f7207","chatId":"2c00d6c09d034cb2a7f1c5a1d8c58ef3","sessionId":null,"userId":99812,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“可能是我自己想太多”——你这句话说得挺快的，像是先把责任揽回自己身上。可绷着的感觉是真的，不会因为“想太多”就消失。你愿意说说，跟她待着的时候，那种绷是身体上的紧，还是脑子里一直在转？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“可能是我自己想太多”——你这句话说得挺快的，像是先把责任揽回自己身上。可绷着的感觉是真的，不会因为“想太多”就消失。你愿意说说，跟她待着的时候，那种绷是身体上的紧，还是脑子里一直在转？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2337,"promptTokens":2611,"completionTokens":137,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:14:00"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00590942952337078,"emotions":[],"relationId":"6af67268f4429d1fd72f7206","courseProgressId":0,"tsGen":1794536040581,"createTime":"2026-11-13 10:14:00","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67268f4429d1fd72f7206","chatId":"2c00d6c09d034cb2a7f1c5a1d8c58ef3","sessionId":null,"userId":99812,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……你说得好像有点道理。特别明显的时候……有吧，就是有个女生，跟她待一块的时候我整个人都是