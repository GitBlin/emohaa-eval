},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af676c0f4429d1fd72f7890","courseProgressId":0,"tsGen":1794537152804,"createTime":"2026-11-13 10:32:32","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676bcf4429d1fd72f7884","chatId":"89f364b9982f4b3d87fc167e01149e2a","sessionId":null,"userId":99853,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"好，那我们就先不聊她。你说心里乱、说不上具体为什么，这种乱往往先有感觉、后有说法。它最近有没有在某个时刻特别明显，比如一个人待着的时候，或者临睡前？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"好，那我们就先不聊她。你说心里乱、说不上具体为什么，这种乱往往先有感觉、后有说法。它最近有没有在某个时刻特别明显，比如一个人待着的时候，或者临睡前？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1804,"promptTokens":1947,"completionTokens":100,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:32:28"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007574002038228425,"emotions":[],"relationId":"6af676bcf4429d1fd72f7883","courseProgressId":0,"tsGen":1794537148670,"createTime":"2026-11-13 10:32:28","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af676bcf4429d1fd72f7883","chatId":"89f364b9982f4b3d87fc167e01149e2a","sessionId":null,"userId":99853,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是她总能说出一堆道理，好像我哪里都不对……（停顿）算了，可能我也不该这么说她。其实我今天来，也不是想说我妈，就是最近心里挺乱的，说不上来具体为什么。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"