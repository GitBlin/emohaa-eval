{"success":true,"code":"000","message":null,"data":{"totalAmount":28,"totalPageCount":1,"pageNum":0,"itemCount":28,"content":[{"pageNum":0,"pageSize":0,"id":"6af67e47f4429d1fd72f7fea","chatId":"9a45d607cc9945d48bd3a66191fd34f9","sessionId":null,"userId":99888,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"追了这么久，追得那么熟练，可方向一直是别人给的——难怪一问“想去哪”就卡住了。这不怪你，只是从来没人问过你。撇开别人的目光，哪怕一件很小的事，有没有什么是你自己真心想做的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"追了这么久，追得那么熟练，可方向一直是别人给的——难怪一问“想去哪”就卡住了。这不怪你，只是从来没人问过你。撇开别人的目光，哪怕一件很小的事，有没有什么是你自己真心想做的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2214,"promptTokens":3318,"completionTokens":121,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:04:39"}],"imgs":null,"regenerations":0,"seqNum":29,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575972067552052,"emotions":[],"relationId":"6af67e47f4429d1fd72f7fe9","courseProgressId":0,"tsGen":1794539079712,"createTime":"2026-11-13 11:04:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67e47f4429d1fd72f7fe9","chatId":"9a45d607cc9945d48bd3a66191fd34f9","sessionId":null,"userId":99888,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"我……没太想过这个。好像一直在追，追工作、追那些书，但真问我想去哪，我一时还真说不上来。<第14轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":28,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0075759720675520