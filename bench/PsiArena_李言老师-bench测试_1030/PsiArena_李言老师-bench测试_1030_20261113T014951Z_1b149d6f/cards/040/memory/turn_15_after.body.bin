rue,"label":"","evaluate":"","takingTime":2097,"promptTokens":2587,"completionTokens":117,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:22:18"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008576309409271182,"emotions":[],"relationId":"6af6745af4429d1fd72f7527","courseProgressId":0,"tsGen":1794536538340,"createTime":"2026-11-13 10:22:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6745af4429d1fd72f7527","chatId":"c72b1783f3784061bc26107e58a19a32","sessionId":null,"userId":99837,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"都憋着呗……有时候写代码写到半夜，脑子里全是这些。也有时候，就变成对那个人特别上心，好像把话都放他身上了。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008576309409271182,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af6745af4429d1fd72f7528","courseProgressId":0,"tsGen":1794536538337,"createTime":"2026-11-13 10:22:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67456f4429d1fd