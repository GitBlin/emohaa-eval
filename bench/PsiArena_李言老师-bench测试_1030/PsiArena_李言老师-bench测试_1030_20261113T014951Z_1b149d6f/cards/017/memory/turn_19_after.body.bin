{"success":true,"code":"000","message":null,"data":{"totalAmount":38,"totalPageCount":1,"pageNum":0,"itemCount":38,"content":[{"pageNum":0,"pageSize":0,"id":"6af6707cf4429d1fd72f6f40","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"怕说乱，其实是怕那股憋了很久的东西一下子涌出来。可以先在心里把那一句排好，其余的乱了就乱了，他要听的是你，不是措辞。要不要现在先小声说一遍给自己听听？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"怕说乱，其实是怕那股憋了很久的东西一下子涌出来。可以先在心里把那一句排好，其余的乱了就乱了，他要听的是你，不是措辞。要不要现在先小声说一遍给自己听听？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2030,"promptTokens":2631,"completionTokens":108,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:48"}],"imgs":null,"regenerations":0,"seqNum":39,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008574530072902849,"emotions":[],"relationId":"6af6707cf4429d1fd72f6f3f","courseProgressId":0,"tsGen":1794535548580,"createTime":"2026-11-13 10:05:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6707cf4429d1fd72f6f3f","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（想了一下）晚上吧，吃完饭收拾完，两个人坐着的时候。（又有点担心）可我怕一开口就控制不住，说得乱七八糟的。<第19轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":38,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008574530072902849,"emotions":[],"relationId":"6af6707cf4429d1fd72f6f40","courseProgressId":0,"tsGen":1794535548577,"createTime":"2026-11-13 10:05:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67078f4429d1fd72f6f35","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"行，这一句不重，也不需要他马上做什么，只是让他知道你的真实分量。你能想到先从这一句开始，已经很稳了。要不要一起想想，这话在什么时机说，你会更容易开口？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"行，这一句不重，也不需要他马上做什么，只是让他知道你的真实分量。你能想到先从这一句开始，已经很稳了。要不要一起想想，这话在什么时机说，你会更容易开口？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1834,"promptTokens":3337,"completionTokens":80,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:44"}],"imgs":null,"regenerations":0,"seqNum":37,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008576556537409286,"emotions":[],"relationId":"6af67078f4429d1fd72f6f34","courseProgressId":0,"tsGen":1794535544501,"createTime":"2026-11-13 10:05:44","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67078f4429d1fd72f6f34","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（想了想）要不……先跟我丈夫说吧，就说这事我一个人扛着有点沉。（有点不确定）不用一次说太多，就这一句，你觉得行吗？<第18轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":36,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008576556537409286,"emotions":[{"code":"trust","name":"信任","value":4,"sort":3},{"code":"expect","name":"期待","value":3,"sort":2},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"sadness","name":"悲伤","value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67078f4429d1fd72f6f35","courseProgressId":0,"tsGen":1794535544498,"createTime":"2026-11-13 10:05:44","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67074f4429d1fd72f6f2b","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"当然可以，而且你刚才那句问话，其实就已经没在堵自己了。下次那个“说了也没用”的念头冒出来时，或许可以先停一秒，问问自己：这是我猜的，还是真的试过？你想从哪件小事开始试着说出来？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"当然可以，而且你刚才那句问话，其实就已经没在堵自己了。下次那个“说了也没用”的念头冒出来时，或许可以先停一秒，问问自己：这是我猜的，还是真的试过？你想从哪件小事开始试着说出来？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2236,"promptTokens":3332,"completionTokens":129,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:40"}],"imgs":null,"regenerations":0,"seqNum":35,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.017973672736872656,"emotions":[],"relationId":"6af67074f4429d1fd72f6f2a","courseProgressId":0,"tsGen":1794535540321,"createTime":"2026-11-13 10:05:40","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67074f4429d1fd72f6f2a","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"有点酸，也有点气吧。（停了一下）原来这些年，好多难受是我自己先拦下来的。那……我是不是可以试着不那么先堵自己？<第17轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":34,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.017973672736872656,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"expect","name":"期待","value":4,"sort":2},{"code":"anger","name":"愤怒","value":4,"sort":7},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"surprised","name":"惊讶","value":3,"sort":5},{"code":"happy","name":"快乐","value":2,"sort":1},{"code":"fear","name":"恐惧","value":2,"sort":6}],"relationId":"6af67074f4429d1fd72f6f2b","courseProgressId":0,"tsGen":1794535540318,"createTime":"2026-11-13 10:05:40","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6706ff4429d1fd72f6f22","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那句“谁不累”，像给你上了一把锁，之后你就学会了先替别人把话堵上。现在看清这一点，你心里是什么感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那句“谁不累”，像给你上了一把锁，之后你就学会了先替别人把话堵上。现在看清这一点，你心里是什么感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2486,"promptTokens":3324,"completionTokens":140,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:35"}],"imgs":null,"regenerations":0,"seqNum":33,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010984675899804362,"emotions":[],"relationId":"6af6706ff4429d1fd72f6f21","courseProgressId":0,"tsGen":1794535535969,"createTime":"2026-11-13 10:05:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6706ff4429d1fd72f6f21","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（怔了怔）好像……真没怎么试过。（慢慢地说）小时候说过一次累，我妈就说“谁不累”，从那以后我就不太说了。原来我一直是自己先替他们把话堵死了。<第16轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":32,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010984675899804362,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"surprised","name":"惊讶","value":2,"sort":5},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"anger","name":"愤怒","value":1,"sort":7}],"relationId":"6af6706ff4429d1fd72f6f22","courseProgressId":0,"tsGen":1794535535966,"createTime":"2026-11-13 10:05:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6706af4429d1fd72f6f15","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那句“娶了我这么个人”你没说完，但听着挺扎心的。你好像已经先替他们想好了答案：不会懂、会觉得你事多。这种“说了也没用”的感觉，是以前真的试过，还是从小就这么猜的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那句“娶了我这么个人”你没说完，但听着挺扎心的。你好像已经先替他们想好了答案：不会懂、会觉得你事多。这种“说了也没用”的感觉，是以前真的试过，还是从小就这么猜的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2708,"promptTokens":2614,"completionTokens":151,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:30"}],"imgs":null,"regenerations":0,"seqNum":31,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008574406417096253,"emotions":[],"relationId":"6af6706af4429d1fd72f6f14","courseProgressId":0,"tsGen":1794535530804,"createTime":"2026-11-13 10:05:30","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6706af4429d1fd72f6f14","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（想了想）我爸妈吧……他们一直觉得我让他们省心。（停顿）还有我丈夫，我怕他觉得，娶了我这么个……（没说完，苦笑了一下）其实说了他们也不会懂，可能还觉得我事多。<第15轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":30,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008574406417096253,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6706af4429d1fd72f6f15","courseProgressId":0,"tsGen":1794535530801,"createTime":"2026-11-13 10:05:30","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67065f4429d1fd72f6f08","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"原来“扛不住”这三个字，对你来说不只是累，更像是要把“懂事的你”这个人设推翻。可那个一直撑着的样子，也是别人一点点教出来的。要是真的说出口，你怕谁会失望？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"原来“扛不住”这三个字，对你来说不只是累，更像是要把“懂事的你”这个人设推翻。可那个一直撑着的样子，也是别人一点点教出来的。要是真的说出口，你怕谁会失望？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2088,"promptTokens":2587,"completionTokens":121,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:25"}],"imgs":null,"regenerations":0,"seqNum":29,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02930644376829118,"emotions":[],"relationId":"6af67065f4429d1fd72f6f07","courseProgressId":0,"tsGen":1794535525553,"createTime":"2026-11-13 10:05:25","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67065f4429d1fd72f6f07","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（犹豫）最难的是……承认我扛不住吧。（声音很轻）我从小就被说懂事、能扛，好像一开口说不行，就不是原来的我了。<第14轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":28,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02930644376829118,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67065f4429d1fd72f6f08","courseProgressId":0,"tsGen":1794535525550,"createTime":"2026-11-13 10:05:25","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67060f4429d1fd72f6efa","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"怕被说矫情，就把这些话全咽回去了，一个人憋着确实累。也许不用讲得多重，只说一句“这事我一个人扛得有点沉，想跟你一起想想”，就够了。你觉得这话最难说出口的，是哪一部分？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"怕被说矫情，就把这些话全咽回去了，一个人憋着确实累。也许不用讲得多重，只说一句“这事我一个人扛得有点沉，想跟你一起想想”，就够了。你觉得这话最难说出口的，是哪一部分？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2903,"promptTokens":2592,"completionTokens":198,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:20"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005910319606102463,"emotions":[],"relationId":"6af67060f4429d1fd72f6ef9","courseProgressId":0,"tsGen":1794535520954,"createTime":"2026-11-13 10:05:20","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67060f4429d1fd72f6ef9","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（沉默了一会儿）我也不知道……可能我就是想听他说一句“这事咱们一起想办法”，而不是“你决定就好”。（低下头）可我又没跟他讲过这些，我怕说了显得我太矫情。<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":26,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005910319606102463,"emotions":[],"relationId":"6af67060f4429d1fd72f6efa","courseProgressId":0,"tsGen":1794535520951,"createTime":"2026-11-13 10:05:20","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6705bf4429d1fd72f6eef","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"他说“尊重你”，听着是体谅，可你心里却像被撂下了——决定要你一个人做，担子也一个人扛。那你其实更希望他怎么回应你呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"他说“尊重你”，听着是体谅，可你心里却像被撂下了——决定要你一个人做，担子也一个人扛。那你其实更希望他怎么回应你呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2590,"promptTokens":3278,"completionTokens":129,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:15"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01098214102837658,"emotions":[],"relationId":"6af6705bf4429d1fd72f6eee","courseProgressId":0,"tsGen":1794535515297,"createTime":"2026-11-13 10:05:15","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6705bf4429d1fd72f6eee","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"跟丈夫说过……他说尊重我的选择，不逼我。（语气有点复杂）可他说得越轻松，我反而越不知道该怎么办，好像这担子全落我一个人身上了。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01098214102837658,"emotions":[],"relationId":"6af6705bf4429d1fd72f6eef","courseProgressId":0,"tsGen":1794535515295,"createTime":"2026-11-13 10:05:15","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67056f4429d1fd72f6ee0","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听到检查结果，还把它和那句“我不够好”连在一起，这份重量确实不轻。可身体的检查结果是一件事，你这个人好不好是另一件事，这两件被绑在一起了。这个结果出来的时候，你是一个人扛着的吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听到检查结果，还把它和那句“我不够好”连在一起，这份重量确实不轻。可身体的检查结果是一件事，你这个人好不好是另一件事，这两件被绑在一起了。这个结果出来的时候，你是一个人扛着的吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2706,"promptTokens":3294,"completionTokens":151,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:10"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007573135353061269,"emotions":[],"relationId":"6af67056f4429d1fd72f6edf","courseProgressId":0,"tsGen":1794535510116,"createTime":"2026-11-13 10:05:10","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67056f4429d1fd72f6edf","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（愣了一下）好像……都有吧。其实她不说，我心里那个声音也在。（苦笑）而且最近检查结果出来，说怀孕有点困难，我就更觉得是不是真应了那句话——我不够好。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007573135353061269,"emotions":[{"code":"sadness","name":"悲伤","value":7,"sort":8},{"code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"surprised","name":"惊讶","value":3,"sort":5},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1}],"relationId":"6af67056f4429d1fd72f6ee0","courseProgressId":0,"tsGen":1794535510113,"createTime":"2026-11-13 10:05:10","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67051f4429d1fd72f6ed5","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"“独苗不能断”这种话，听着像在说家事，落到你心里却变成了“我没用”。可这中间其实隔了一步——是那些话，还是你早就有的那个念头，让你这么难受？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"“独苗不能断”这种话，听着像在说家事，落到你心里却变成了“我没用”。可这中间其实隔了一步——是那些话，还是你早就有的那个念头，让你这么难受？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1954,"promptTokens":3144,"completionTokens":91,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:05"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575012368871921,"emotions":[],"relationId":"6af67051f4429d1fd72f6ed4","courseProgressId":0,"tsGen":1794535505083,"createTime":"2026-11-13 10:05:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67051f4429d1fd72f6ed4","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（抿了抿嘴）她倒没明说什么难听的，就是老在我面前念叨谁家又添孙子了，说什么“独苗不能断”……（声音有点发紧）我听着，就觉得自己好像很没用。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575012368871921,"emotions":[],"relationId":"6af67051f4429d1fd72f6ed5","courseProgressId":0,"tsGen":1794535505080,"createTime":"2026-11-13 10:05:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6704cf4429d1fd72f6ec8","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"从小就得先看爸妈满不满意，好像你早就习惯了把自己放在后面。结婚后婆婆那些话，是不是也踩在同一个地方？她说的哪一句，最让你心里过不去？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"从小就得先看爸妈满不满意，好像你早就习惯了把自己放在后面。结婚后婆婆那些话，是不是也踩在同一个地方？她说的哪一句，最让你心里过不去？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2545,"promptTokens":3033,"completionTokens":132,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:05:00"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00590815211941482,"emotions":[],"relationId":"6af6704cf4429d1fd72f6ec7","courseProgressId":0,"tsGen":1794535500249,"createTime":"2026-11-13 10:05:00","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6704cf4429d1fd72f6ec7","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"这个……（想了很久）可能从小就有吧。在我家，做什么都得先想着爸妈怎么看，他们满意不满意。（顿了顿）结婚以后就更明显了，我丈夫是独子，他妈那些话……唉。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00590815211941482,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af6704cf4429d1fd72f6ec8","courseProgressId":0,"tsGen":1794535500247,"createTime":"2026-11-13 10:05:00","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67046f4429d1fd72f6ebd","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那个念头一冒出来，好像就把别人的追问变成了对自己的审判。可这个“是不是我有问题”的想法，是从什么时候开始跟着你的呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那个念头一冒出来，好像就把别人的追问变成了对自己的审判。可这个“是不是我有问题”的想法，是从什么时候开始跟着你的呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1872,"promptTokens":2808,"completionTokens":73,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:04:54"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.033075902171891894,"emotions":[],"relationId":"6af67046f4429d1fd72f6ebb","courseProgressId":0,"tsGen":1794535494957,"createTime":"2026-11-13 10:04:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67046f4429d1fd72f6ebb","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最难受的……（停顿，声音低下去）好像是我自己也有点觉得，是不是我真的哪里有问题。他们一问，我就更躲不开这个念头了。<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.033075902171891894,"emotions":[{"code":"sadness","name":"悲伤","value":7,"sort":8},{"code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67046f4429d1fd72f6ebd","courseProgressId":0,"tsGen":1794535494954,"createTime":"2026-11-13 10:04:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67042f4429d1fd72f6eb6","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听你这么说，好像这些话压在心里挺久了，说出来又觉得没意思、没人真懂。那种“算了”的感觉，是不是也挺熟悉的？我想知道，当别人这么问的时候，你心里最难受的是哪一点？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听你这么说，好像这些话压在心里挺久了，说出来又觉得没意思、没人真懂。那种“算了”的感觉，是不是也挺熟悉的？我想知道，当别人这么问的时候，你心里最难受的是哪一点？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2376,"promptTokens":2686,"completionTokens":124,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:04:50"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005908988529531972,"emotions":[],"relationId":"6af67042f4429d1fd72f6eb5","courseProgressId":0,"tsGen":1794535490745,"createTime":"2026-11-13 10:04:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67042f4429d1fd72f6eb5","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（叹了口气）还能是什么，就是问什么时候要孩子呗，说年纪不小了之类的。（语气有点烦躁）这些话听着就烦，我又不是不想，可……算了，说这个也没用。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005908988529531972,"emotions":[],"relationId":"6af67042f4429d1fd72f6eb6","courseProgressId":0,"tsGen":1794535490743,"createTime":"2026-11-13 10:04:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6703df4429d1fd72f6e9e","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"白天累、晚上睡不好，周围人还老问这问那，想躲着不出门，这种心情我能理解。他们问的，一般是些什么问题呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"白天累、晚上睡不好，周围人还老问这问那，想躲着不出门，这种心情我能理解。他们问的，一般是些什么问题呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2250,"promptTokens":2564,"completionTokens":115,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:04:45"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.015901139844636907,"emotions":[],"relationId":"6af6703df4429d1fd72f6e9d","courseProgressId":0,"tsGen":1794535485297,"createTime":"2026-11-13 10:04:45","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6703df4429d1fd72f6e9d","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就……躺着，翻来覆去也睡不着。（沉默了几秒）其实白天也累，周围人老问那些问题，我有时候都不想出门。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.015901139844636907,"emotions":[],"relationId":"6af6703df4429d1fd72f6e9e","courseProgressId":0,"tsGen":1794535485294,"createTime":"2026-11-13 10:04:45","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67038f4429d1fd72f6e8f","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"晚上一个人待着的时候，那种难受就突然冒出来了，还说不清是什么。听起来挺孤单的。那种时候你一般会做点什么，还是就那么待着？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"晚上一个人待着的时候，那种难受就突然冒出来了，还说不清是什么。听起来挺孤单的。那种时候你一般会做点什么，还是就那么待着？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1575,"promptTokens":1999,"completionTokens":62,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:04:40"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705250218174855,"emotions":[],"relationId":"6af67038f4429d1fd72f6e8e","courseProgressId":0,"tsGen":1794535480238,"createTime":"2026-11-13 10:04:40","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67038f4429d1fd72f6e8e","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……那还好。（稍微放松了一点，又低下头）其实我也不知道从哪说起，就是有时候晚上一个人待着，突然就特别难受，说不上来为什么。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009705250218174855,"emotions":[],"relationId":"6af67038f4429d1fd72f6e8f","courseProgressId":0,"tsGen":1794535480235,"createTime":"2026-11-13 10:04:40","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67034f4429d1fd72f6e89","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你问这个很自然，该问的。我们聊的内容我都会保密，不会告诉你丈夫或其他人；只有涉及你或他人的安全风险时，我才会按专业要求处理，那种情况我会先跟你说明。这样讲，你会不会安心一点？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你问这个很自然，该问的。我们聊的内容我都会保密，不会告诉你丈夫或其他人；只有涉及你或他人的安全风险时，我才会按专业要求处理，那种情况我会先跟你说明。这样讲，你会不会安心一点？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1630,"promptTokens":1871,"completionTokens":71,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:04:36"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008572784254448008,"emotions":[],"relationId":"6af67034f4429d1fd72f6e88","courseProgressId":0,"tsGen":1794535476078,"createTime":"2026-11-13 10:04:36","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67034f4429d1fd72f6e88","chatId":"0469f474c3834547bb8debf54a746243","sessionId":null,"userId":99798,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"这个……我也说不太好，可能最近事情比较多吧。（犹豫了一下）对了，我想问下，我跟你说的这些，你不会告诉别人吧？<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008572784254448008,"emotions":[{"code":"calm","name":"平静","value":4,"sort":4},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67034f4429d1fd72f6e89","courseProgressId":0,"tsGen":1794535476075,"createTime":"2026-1