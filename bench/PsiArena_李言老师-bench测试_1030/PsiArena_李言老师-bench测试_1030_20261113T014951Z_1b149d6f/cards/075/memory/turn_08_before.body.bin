{"success":true,"code":"000","message":null,"data":{"totalAmount":14,"totalPageCount":1,"pageNum":0,"itemCount":14,"content":[{"pageNum":0,"pageSize":0,"id":"6af67cf3f4429d1fd72f7e67","chatId":"0ec6c067382a49b8bdc7e55a419b0b79","sessionId":null,"userId":99882,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"送外卖确实累，风里来雨里去，还得应付各种各样的人，回到家大概只想瘫着。你说“这样下去有什么意思”，我听着像是累之外，还有点空。这份空，是最近才有，还是干这行之前就有？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"送外卖确实累，风里来雨里去，还得应付各种各样的人，回到家大概只想瘫着。你说“这样下去有什么意思”，我听着像是累之外，还有点空。这份空，是最近才有，还是干这行之前就有？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1772,"promptTokens":2285,"completionTokens":122,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:58:59"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014057105113568474,"emotions":[],"relationId":"6af67cf3f4429d1fd72f7e66","courseProgressId":0,"tsGen":1794538739297,"createTime":"2026-11-13 10:58:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cf3f4429d1fd72f7e66","chatId":"0ec6c067382a49b8bdc7e55a419b0b79","sessionId":null,"userId":99882,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最近……就是又换了个活儿，送外卖的，跑起来累得要命，还得跟各种人打交道。我干着干着就觉得，这样下去到底有什么意思呢。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014057105113568474,"emotions":[],"relationId":"6af67cf3f4429d1fd72f7e67","courseProgressId":0,"tsGen":1794538739294,"createTime":"2026-11-13 10:58:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cedf4429d1fd72f7e5d","chatId":"0ec6c067382a49b8bdc7e55a419b0b79","sessionId":null,"userId":99882,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"说不清楚也没关系，有些感受本来就像雾，慢慢才看清轮廓。我留意到你刚才说“又好像最近才特别厉害”——那最近这段时间，是发生了什么，让这种感觉变重了吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"说不清楚也没关系，有些感受本来就像雾，慢慢才看清轮廓。我留意到你刚才说“又好像最近才特别厉害”——那最近这段时间，是发生了什么，让这种感觉变重了吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1975,"promptTokens":2164,"completionTokens":96,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:58:53"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00591063952667079,"emotions":[],"relationId":"6af67cedf4429d1fd72f7e5c","courseProgressId":0,"tsGen":1794538733594,"createTime":"2026-11-13 10:58:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cedf4429d1fd72f7e5c","chatId":"0ec6c067382a49b8bdc7e55a419b0b79","sessionId":null,"userId":99882,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"谢谢你这么说……其实我也不太确定，好像很久了，又好像最近才特别厉害。嗯……我也不知道该怎么讲清楚。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00591063952667079,"emotions":[{"code":"calm","name":"平静","value":3,"sort":4},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67cedf4429d1fd72f7e5d","courseProgressId":0,"tsGen":1794538733592,"createTime":"2026-11-13 10:58:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ce8f4429d1fd72f7e53","chatId":"0ec6c067382a49b8bdc7e55a419b0b79","sessionId":null,"userId":99882,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不会，我一点也不觉得你麻烦。你愿意把这些说出来，已经很不容易了。倒是那句“我是不是挺没用”，我听着有点心疼——这个念头，是最近才常冒出来，还是其实已经跟着你挺久了？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不会，我一点也不觉得你麻烦。你愿意把这些说出来，已经很不容易了。倒是那句“我是不是挺没用”，我听着有点心疼——这个念头，是最近才常冒出来，还是其实已经跟着你挺久了？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1833,"promptTokens":2050,"completionTokens":119,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:58:48"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02930141616602577,"emotions":[],"relationId":"6af67ce8f4429d1fd72f7e52","courseProgressId":0,"tsGen":1794538728072,"createTime":"2026-11-13 10:58:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ce8f4429d1fd72f7e52","chatId":"0ec6c067382a49b8bdc7e55a419b0b79","sessionId":null,"userId":99882,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是乱想……想工作的事，想以后怎么办，越想越烦。有时候也会想，我是不是挺没用的。对了，你会不会觉得我这样的人挺麻烦的？<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02930141616602577,"emotions":[{"code":"fear","name":"恐惧","value":6,"sort":6},{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"anger","name":"愤怒","value":5,"sort":7},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67ce8f4429d1fd72f7e53","courseProgressId":0,"tsGen":1794538728069,"createTime":"2026-11-13 10:58:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ce2f4429d1fd72f7e4e","chatId":"0ec6c067382a49b8bdc7e55a419b0b79","sessionId":null,"userId":99882,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那种一直压着、到夜里更明显的感觉，确实很耗人。白天有事忙着还好，一躺下安静了，它就冒出来。我想多了解一点——晚上睡不着的时候，你脑子里通常在想些什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那种一直压着、到夜里更明显的感觉，确实很耗人。白天有事忙着还好，一躺下安静了，它就冒出来。我想多了解一点——晚上睡不着的时候，你脑子里通常在想些什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1700,"promptTokens":1922,"completionTokens":103,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:58:42"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008574167882608374,"emotions":[],"relationId":"6af67ce2f4429d1fd72f7e4d","courseProgressId":0,"tsGen":1794538722644,"createTime":"2026-11-13 10:58:42","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ce2f4429d1fd72f7e4d","chatId":"0ec6c067382a49b8bdc7e55a419b0b79","sessionId":null,"userId":99882,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"好像是……一直压着的那种吧。有时候晚上躺着就特别明显，翻来覆去睡不着。不过具体为什么，我也讲不上来，就是觉得心里堵得慌。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008574167882608374,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67ce2f4429d1fd72f7e4e","courseProgressId":0,"tsGen":1794538722641,"createTime":"2026-11-13 10:58:42","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cddf4429d1fd72f7e47","chatId":"0ec6c067382a49b8bdc7e55a419b0b79","sessionId":null,"userId":99882,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你的担心很正常，我先说清楚：这里说的话我会保密，不会随便告诉别人。只有涉及你或别人的安全风险时，我才会和你商量怎么处理。你说难受却说不清原因，这种感觉本身就挺磨人的——最近这种难受，更像是一直压着，还是一阵一阵冒出来的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你的担心很正常，我先说清楚：这里说的话我会保密，不会随便告诉别人。只有涉及你或别人的安全风险时，我才会和你商量怎么处理。你说难受却说不清原因，这种感觉本身就挺磨人的——最近这种难受，更像是一直压着，还是一阵一阵冒出来的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1817,"promptTokens":1785,"completionTokens":89,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:58:37"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02297150860623899,"emotions":[],"relationId":"6af67cddf4429d1fd72f7e46","courseProgressId":0,"tsGen":1794538717614,"createTime":"2026-11-13 10:58:37","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cddf4429d1fd72f7e46","chatId":"0ec6c067382a49b8bdc7e55a419b0b79","sessionId":null,"userId":99882,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……那我先问个事，就是我在这儿说的话，你会不会告诉别人啊？我有点怕。至于聊完想怎么样……我也说不上来，就是最近老觉得难受，可又说不太清楚为什么。<第3轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":6,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02297150860623899,"emotions":[{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"sadne