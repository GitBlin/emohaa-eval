null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不会，我一点也不觉得你麻烦。你愿意把这些说出来，已经很不容易了。倒是那句“我是不是挺没用”，我听着有点心疼——这个念头，是最近才常冒出来，还是其实已经跟着你挺久了？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1833,"promptTokens":2050,"completionTokens":119,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:58:48"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02930141616602577,"emotions":[],"relationId":"6af67ce8f4429d1fd72f7e52","courseProgressId":0,"tsGen":1794538728072,"createTime":"2026-11-13 10:58:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ce8f4429d1fd72f7e52","chatId":"0ec6c067382a49b8bdc7e55a419b0b79","sessionId":null,"userId":99882,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是乱想……想工作的事，想以后怎么办，越想越烦。有时候也会想，我是不是挺没用的。对了，你会不会觉得我这样的人挺麻烦的？<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02930141616602577,"emotions":[{"code":"fear","name":"恐惧","value":6,"sort":6},{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"anger","name":"愤怒","value":5,"sort":7},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af67ce8f4429d1fd72f7e53","courseProgressId":0,"tsGen":1794538728069,"createTime":"2026-1