阵冒出来的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1817,"promptTokens":1785,"completionTokens":89,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:58:37"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02297150860623899,"emotions":[],"relationId":"6af67cddf4429d1fd72f7e46","courseProgressId":0,"tsGen":1794538717614,"createTime":"2026-11-13 10:58:37","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cddf4429d1fd72f7e46","chatId":"0ec6c067382a49b8bdc7e55a419b0b79","sessionId":null,"userId":99882,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……那我先问个事，就是我在这儿说的话，你会不会告诉别人啊？我有点怕。至于聊完想怎么样……我也说不上来，就是最近老觉得难受，可又说不太清楚为什么。<第3轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":6,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02297150860623899,"emotions":[{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af67cddf4429d1fd72f7e47","courseProgressId":0,"tsGen":1794538717611,"createTime":"2026-11-13 10:58:37","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["担忧","失望","不自信","焦虑","压抑","自我否定"],"originalText":["我有点怕。","就是最近老觉得难受，可又说不太清楚为什么。","就是觉得心里堵得慌。","我是不是挺没用的。","这样下去到底有什么意思呢。","我怕她觉得我在找借口。","就觉得自己好像真的哪儿都不如别人。","我连基础都没有。","我怕自己练两天就坚持不下去了。"]},"conversation":{"type":"自我认知与成长","topic":"来访者因职业方向不清、自我否定及家人评价而困扰，在咨询中探索自身感受、尝试设定小目标并建立初步行动信心。"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cd7f4429d1fd72f7e43","chatId":"0ec6c067382a49b8bdc7e55a419b0b79","sessionId":null,"userId":99882,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不用紧张，这里没有固定流程。一般就是你愿意说什么就说什么，我陪你一起听、一起看，不会逼你讲不想讲的。节奏由你来定。那我们先从轻松的来——你希望这次聊完后，自己心里能松一点，还是想弄清楚某件具体的事？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不用紧张，这里没有固定流程。一般就是你愿意说什么就说什么，我陪你一起听、一起看，不会逼你讲不想讲的。节奏由你来定。那我们先从轻松的来——你希望这次聊完后，自己心里能松一点，还是想弄清楚某件具体的事？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2016,"promptTokens":1633,"completionTokens":86,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:58:31"}],"imgs":null,"regenerations":0,"seqNum":5,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004609044492719795,"emotions":[],"relationId":"6af67cd7f4429d1fd72f7e42","courseProgressId":0,"tsGen":1794538711672,"createTime":"2026-11-13 10:58:31","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cd7f4429d1fd72f7e42","chatId":"0ec6c067382a49b8bdc7e55a419b0b79","sessionId":null,"userId":99882,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……你好。那个，我想先问一下，这种咨询一般是怎么进行的？我就是不太了解，心里有点没底。<第2轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,