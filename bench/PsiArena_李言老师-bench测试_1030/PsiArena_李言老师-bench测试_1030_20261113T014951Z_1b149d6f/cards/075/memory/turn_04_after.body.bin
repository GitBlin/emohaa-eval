{"success":true,"code":"000","message":null,"data":{"totalAmount":8,"totalPageCount":1,"pageNum":0,"itemCount":8,"content":[{"pageNum":0,"pageSize":0,"id":"6af67ce2f4429d1fd72f7e4e","chatId":"0ec6c067382a49b8bdc7e55a419b0b79","sessionId":null,"userId":99882,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"那种一直压着、到夜里更明显的感觉，确实很耗人。白天有事忙着还好，一躺下安静了，它就冒出来。我想多了解一点——晚上睡不着的时候，你脑子里通常在想些什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那种一直压着、到夜里更明显的感觉，确实很耗人。白天有事忙着还好，一躺下安静了，它就冒出来。我想多了解一点——晚上睡不着的时候，你脑子里通常在想些什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1700,"promptTokens":1922,"completionTokens":103,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:58:42"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008574167882608374,"emotions":[],"relationId":"6af67ce2f4429d1fd72f7e4d","courseProgressId":0,"tsGen":1794538722644,"createTime":"2026-11-13 10:58:42","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67ce2f4429d1fd72f7e4d","chatId":"0ec6c067382a49b8bdc7e55a419b0b79","sessionId":null,"userId":99882,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"好像是……一直压着的那种吧。有时候晚上躺着就特别明显，翻来覆去睡不着。不过具体为什么，我也讲不上来，就是觉得心里堵得慌。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008574167882608374,"emotions":[],"relationId":"6af67ce2f4429d1fd72f7e4e","courseProgressId":0,"tsGen":1794538722641,"createTime":"2026-11-13 10:58:42","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cddf4429d1fd72f7e47","chatId":"0ec6c067382a49b8bdc7e55a419b0b79","sessionId":null,"userId":99882,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"你的担心很正常，我先说清楚：这里说的话我会保密，不会随便告诉别人。只有涉及你或别人的安全风险时，我才会和你商量怎么处理。你说难受却说不清原因，这种感觉本身就挺磨人的——最近这种难受，更像是一直压着，还是一阵一阵冒出来的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你的担心很正常，我先说清楚：这里说的话我会保密，不会随便告诉别人。只有涉及你或别人的安全风险时，我才会和你商量怎么处理。你说难受却说不清原因，这种感觉本身就挺磨人的——最近这种难受，更像是一直压着，还是一阵一阵冒出来的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1817,"promptTokens":1785,"completionTokens":89,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:58:37"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02297150860623899,"emotions":[],"relationId":"6af67cddf4429d1fd72f7e46","courseProgressId":0,"tsGen":1794538717614,"createTime":"2026-11-13 10:58:37","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af67cddf4429d1fd72f7e46","chatId":"0ec6c067382a49b8bdc7e55a419b0b79","sessionId":null,"userId":99882,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"嗯……那我先问个事，就是我在这儿说的话，你会不会告诉别人啊？我有点怕。至于聊完想怎么样……我也说不上来，就是最近老觉得难受，可又说不太清楚为什么。<第3轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMes