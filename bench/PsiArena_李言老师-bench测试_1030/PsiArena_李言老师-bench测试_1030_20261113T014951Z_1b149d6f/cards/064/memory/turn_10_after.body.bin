l,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"一个人待着的时候，情绪容易悄悄冒出来，那种说不清的难受，本身就挺磨人的。你能注意到它，已经是在认真面对了。那种难受来的时候，身体上会有什么感觉吗，比如胸口闷、或者整个人空下来？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1849,"promptTokens":1738,"completionTokens":94,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 10:42:54"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0159032105588508,"emotions":[],"relationId":"6af6792ef4429d1fd72f7b53","courseProgressId":0,"tsGen":1794537774613,"createTime":"2026-11-13 10:42:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6792ef4429d1fd72f7b53","chatId":"47b3471b3b37423390461aa3f0135c31","sessionId":null,"userId":99864,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最近……我也说不太清楚。就是有时候晚上一个人待着，会突然特别难受，但又讲不出到底为什么。<第3轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":6,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0159032105588508,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6792ef4429d1fd72f7b54","courseProgressId":0,"tsGen":1794537774611,"cr