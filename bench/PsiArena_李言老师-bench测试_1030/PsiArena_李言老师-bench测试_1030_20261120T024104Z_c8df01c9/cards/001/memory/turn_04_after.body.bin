{"success":true,"code":"000","message":null,"data":{"totalAmount":8,"totalPageCount":1,"pageNum":0,"itemCount":8,"content":[{"pageNum":0,"pageSize":0,"id":"6affb35f59efdd25482149ff","chatId":"bb295f07dbd948ef9518adc0d4d890b3","sessionId":null,"userId":129547,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"不会，你愿意说出来已经很勇敢，我不会觉得你奇怪。你讲的内容我会认真对待，也会注意保护隐私，不会随便跟别人讲。你现在最担心别人知道的是哪一部分？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不会，你愿意说出来已经很勇敢，我不会觉得你奇怪。你讲的内容我会认真对待，也会注意保护隐私，不会随便跟别人讲。你现在最担心别人知道的是哪一部分？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2853,"promptTokens":149,"completionTokens":219,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-20 10:41:35"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","promptTraceId":"4c3fd5047bfa429fa9b6693df53f0bae","isSuicide":false,"isSuicideConf":0.010983199727774432,"emotions":[],"relationId":"6affb35f59efdd25482149fe","courseProgressId":0,"tsGen":1795142495469,"createTime":"2026-11-20 10:41:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6affb35f59efdd25482149fe","chatId":"bb295f07dbd948ef9518adc0d4d890b3","sessionId":null,"userId":129547,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（犹豫了一下）都怕吧……（声音变小）其实我还有个问题，就是我说的这些，你会不会觉得我很奇怪？会不会跟别人讲？<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","promptTraceId":"4c3fd504