erUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来你一直在努力符合“讲道理”的期待，连难过都要收着，这一定很累。你愿意说说，最近一次“怕自己不够好”是在什么情境下出现的吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2959,"promptTokens":154,"completionTokens":298,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-20 10:59:01"}],"imgs":null,"regenerations":0,"seqNum":29,"responseSource":"agent:llm","promptTraceId":"b242728f54a64abda8dfa0402d7330e6","isSuicide":false,"isSuicideConf":0.010985284753494246,"emotions":[],"relationId":"6affb775d2fb32051dbd2047","courseProgressId":0,"tsGen":1795143541312,"createTime":"2026-11-20 10:59:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6affb775d2fb32051dbd2047","chatId":"15f7a3b1b2e9444a9a1d7ec2f909934c","sessionId":null,"userId":129607,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"（想了很久）可能是小学吧。我爸妈都是老师，家里说话都讲道理，可越是这样，我越怕自己不够好。（苦笑）连难过都不敢太明显。<第14轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":28,"responseSource":"agent:llm","promptTraceId":"b242728f54a64abda8dfa0402d7330e6","isSuicide":false,"isSuicideConf":0.010985284753494246,"emotions":[],"relationId":"6affb775d2fb32051dbd2048","courseProgressId":0,"tsGen":1795143541309,"createTime":"2026-11-20 10:59:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6affb76bd2fb32051dbd200f","chatId":"15f7a3b1b2e9444a9a1d7ec2f909934c","sessionId":null,"userId":129607,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"咨询结束后的空落，和一直怕让爸妈失望的紧绷，似乎都在说明你习惯先照顾别人的感受。那种“不能让他们失望”的念头，最早是从什么时候开始变得这么重的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"咨询结束后的空落，和一直怕让爸妈失望的紧绷，似乎都在说明你习惯先照顾别人的感受。那种“不能让他们失望”的念头，最早是从什么时候开始变得这么重的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2012,"promptTokens":151,"completionTokens":141,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-20 10:58:51"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","promptTraceId":"2aec49d8632e4685b5e41f7ec2c2b759","isSuicide":false,"isSuicideConf":0.012427533613914677,"emotions":[],"relationId":"6affb76bd2fb32051dbd200e","courseProgressId":0,"tsGen":1795143531885,"createTime":"2026-11-20 10:58:51","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6affb76bd2fb32051dbd200e","chatId":"15f7a3b1b2e9444a9a1d7ec2f909934c","sessionId":null,"userId":129607,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"可能是咨询结束以后吧，走出这个房间，就特别空。（犹豫）还有……在家里，我爸妈其实对我挺好的，但从小我就觉得，不能让他们失望。<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":26,"responseSource":"agent:llm","promptTraceId":"2aec49d8632e4685b5e41f7ec2c2b759","isSuicide":false,"isSuicideConf":0.012427533613914677,"emotions":[],"relationId":"6affb76bd2fb32051dbd200f","courseProgressId":0,"tsGen":1795143531882,"createTime":"2026-11-20 10:58:51","delFlag":0,"emotionTendency":null,"sourceProductType":null,"s