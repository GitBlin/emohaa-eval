{"success":true,"code":"000","message":null,"data":{"totalAmount":20,"totalPageCount":1,"pageNum":0,"itemCount":20,"content":[{"pageNum":0,"pageSize":0,"id":"6affb59559efdd25482152ed","chatId":"913fa5a93d484090a673d827178d18b5","sessionId":null,"userId":129579,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来你本来想分享换工作的心情，却被工资和“稳不稳定”堵住了，难怪不想再说。你当时最希望她先回应你的哪一部分感受？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来你本来想分享换工作的心情，却被工资和“稳不稳定”堵住了，难怪不想再说。你当时最希望她先回应你的哪一部分感受？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2349,"promptTokens":154,"completionTokens":171,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-20 10:51:01"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","promptTraceId":"aa725528465c4968be3954c66546ae1a","isSuicide":false,"isSuicideConf":0.0075760291220511485,"emotions":[],"relationId":"6affb59559efdd25482152ec","courseProgressId":0,"tsGen":1795143061934,"createTime":"2026-11-20 10:51:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6affb59559efdd25482152ec","chatId":"913fa5a93d484090a673d827178d18b5","sessionId":null,"userId":129579,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是……前段时间我换工作，其实我挺想跟她说的，结果她第一句就是问我工资多少、稳不稳定，还说表姐多稳当。我当时就不想说了。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","promptTraceId":"aa725528465c4968be3954c66546ae1a","isSuicide":false,"isSuicideConf":0.0075760291220511485,"emotions":[],"relationId":"6affb59559efdd25482152ed","courseProgressId":0,"tsGen":1795143061932,"createTime":"2026-11-20 10:51:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6affb58d59efdd25482152c5","chatId":"913fa5a93d484090a673d827178d18b5","sessionId":null,"userId":129579,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"我听见了。那种每句话都先在脑子里过一遍妈妈会怎么反应的感觉，确实会让人很累，也容易把自己的声音压小。你愿意说说，最近哪一次你特别希望被听见、却没能说出口吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我听见了。那种每句话都先在脑子里过一遍妈妈会怎么反应的感觉，确实会让人很累，也容易把自己的声音压小。你愿意说说，最近哪一次你特别希望被听见、却没能说出口吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2346,"promptTokens":150,"completionTokens":209,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-20 10:50:53"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","promptTraceId":"efd9b0a320b142bebbf05dd6ab822f1e","isSuicide":false,"isSuicideConf":0.010984299402678489,"emotions":[],"relationId":"6affb58c59efdd25482152c4","courseProgressId":0,"tsGen":1795143053002,"createTime":"2026-11-20 10:50:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6affb58c59efdd25482152c4","chatId":"913fa5a93d484090a673d827178d18b5","sessionId":null,"userId":129579,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"我想被听见吧……虽然说出来有点难。其实我从小就知道，在我家，说什么都得先想想我妈会怎么反应。你懂那种感觉吗？<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":nul