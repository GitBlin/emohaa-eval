customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","promptTraceId":"5202a47cce224ca1b1ecf40408c631c9","isSuicide":false,"isSuicideConf":0.015901758900825395,"emotions":[],"relationId":"6affb6c1d2fb32051dbd1d1b","courseProgressId":0,"tsGen":1795143361237,"createTime":"2026-11-20 10:56:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6affb6bad2fb32051dbd1cee","chatId":"f693151450f64b0b897186383167ec80","sessionId":null,"userId":129601,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来你既想躲开又怕推开他，这种拧巴一定很累。那件一直压着的事，愿意先从它让你最觉得自己“不够好”的那个瞬间说起吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来你既想躲开又怕推开他，这种拧巴一定很累。那件一直压着的事，愿意先从它让你最觉得自己“不够好”的那个瞬间说起吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2940,"promptTokens":163,"completionTokens":249,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-20 10:55:54"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","promptTraceId":"44368b121c0541338420ba692c610918","isSuicide":false,"isSuicideConf":0.012426987960768387,"emotions":[],"relationId":"6affb6bad2fb32051dbd1ced","courseProgressId":0,"tsGen":1795143354029,"createTime":"2026-11-20 10:55:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6affb6bad2fb32051dbd1ced","chatId":"f693151450f64b0b897186383167ec80","sessionId":null,"userId":129601,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最想躲开吧，就是突然不想说话，想找借口走掉。可我又不想真的推开他……所以就很拧巴。其实我心里有件事，一直压着，可能跟这个“不够好”有关。<第9轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","promptTraceId":"44368b121c0541338420ba692c610918","isSuicide":false,"isSuicideConf":0.012426987960768387,"emotions":[],"relationId":"6affb6bad2fb32051dbd1cee","courseProgressId":0,"tsGen":1795143354024,"createTime":"2026-11-20 10:55:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6affb6b1d2fb32051dbd1cc2","chatId":"f693151450f64b0b897186383167ec80","sessionId":null,"userId":129601,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来你被“不够好”的感觉压着，却又很难说清它从哪来，这本身就很让人无力。先不急着证明配不配，我想知道：这种感觉最强烈时，你通常最想做什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来你被“不够好”的感觉压着，却又很难说清它从哪来，这本身就很让人无力。先不急着证明配不配，我想知道：这种感觉最强烈时，你通常最想做什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":3045,"promptTokens":149,"completionTokens":264,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-20 10:55:45"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","promptTraceId":"40514b47023d4a5184e960521201e0c7","isSuicide":false,"isSuicideConf":0.014062118823692614,"emotions":[],"relationId":"6affb6b1d2fb32051dbd1cc1","courseProgressId":0,"tsGen":1795143345574,"createTime":"2026-11-20 10:55:45","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSi