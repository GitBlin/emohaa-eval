{"success":true,"code":"000","message":null,"data":{"totalAmount":32,"totalPageCount":1,"pageNum":0,"itemCount":32,"content":[{"pageNum":0,"pageSize":0,"id":"6affb744d2fb32051dbd1f0a","chatId":"875a8eff40074f89ba17d289d18936e8","sessionId":null,"userId":129606,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来你一直在硬撑，怕被说影响学习，连难受都要藏起来。情绪不是错，也不该被否定。你最难受的时候，通常会怎么熬过去？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来你一直在硬撑，怕被说影响学习，连难受都要藏起来。情绪不是错，也不该被否定。你最难受的时候，通常会怎么熬过去？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2708,"promptTokens":151,"completionTokens":210,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-20 10:58:12"}],"imgs":null,"regenerations":0,"seqNum":33,"responseSource":"agent:llm","promptTraceId":"9991d454d7264cceb0c082638ac6d086","isSuicide":false,"isSuicideConf":0.02929885365055708,"emotions":[],"relationId":"6affb744d2fb32051dbd1f09","courseProgressId":0,"tsGen":1795143492620,"createTime":"2026-11-20 10:58:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6affb744d2fb32051dbd1f09","chatId":"875a8eff40074f89ba17d289d18936e8","sessionId":null,"userId":129606,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是最近吧，明明心里很难受，还要在爸妈面前装没事，不然他们又说我影响学习。我有时候觉得，我是不是根本就不该有这些情绪。<第16轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":32,"responseSource":"agent:llm","promptTraceId":"9991d454d7264cceb0c082638ac6d086","isSuicide":false,"isSuicideConf":0.02929885365055708,"emotions":[],"relationId":"6affb744d2fb32051dbd1f0a","courseProgressId":0,"tsGen":1795143492617,"createTime":"2026-11-20 10:58:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6affb738d2fb32051dbd1ec4","chatId":"875a8eff40074f89ba17d289d18936e8","sessionId":null,"userId":129606,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来你总在照顾别人的感受，却很少有人接住你的难过，这一定很孤单。家里只看成绩、让你别想太多，也会让你更不敢表达吧？最近一次你为了别人委屈自己，是什么时候？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来你总在照顾别人的感受，却很少有人接住你的难过，这一定很孤单。家里只看成绩、让你别想太多，也会让你更不敢表达吧？最近一次你为了别人委屈自己，是什么时候？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2889,"promptTokens":157,"completionTokens":226,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-20 10:58:00"}],"imgs":null,"regenerations":0,"seqNum":31,"responseSource":"agent:llm","promptTraceId":"6810d10e56df4c7c954234a76ccbcbea","isSuicide":false,"isSuicideConf":0.009707133613509434,"emotions":[],"relationId":"6affb738d2fb32051dbd1ec3","courseProgressId":0,"tsGen":1795143480819,"createTime":"2026-11-20 10:58:00","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6affb738d2fb32051dbd1ec3","chatId":"875a8eff40074f89ba17d289d18936e8","sessionId":null,"userId":129606,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"最难受的是……我好像总是太把别人当回事，最后只剩自己一个人。可能跟我家里也有关吧，他们只在乎我成绩，我难过的时候，他们就说别想那么多。<第15轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderCon