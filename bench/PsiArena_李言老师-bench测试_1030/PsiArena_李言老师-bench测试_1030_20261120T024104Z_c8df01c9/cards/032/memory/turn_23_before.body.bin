59efdd25482154d9","courseProgressId":0,"tsGen":1795143232361,"createTime":"2026-11-20 10:53:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6affb64059efdd25482154d9","chatId":"5daf3433cdfc44e59ef05ee8c9666ff0","sessionId":null,"userId":129586,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"可能是怕自己看轻自己吧。他不回，我就开始想是不是我不值得被在乎……这种感觉挺可怕的。可我也不想总把问题都推到他身上。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","promptTraceId":"ef53f5e920554bac925581508cb6f003","isSuicide":false,"isSuicideConf":0.014061428921723837,"emotions":[],"relationId":"6affb64059efdd25482154da","courseProgressId":0,"tsGen":1795143232359,"createTime":"2026-11-20 10:53:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6affb63a59efdd25482154c9","chatId":"5daf3433cdfc44e59ef05ee8c9666ff0","sessionId":null,"userId":129586,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"能感觉到你既想让他知道在意，又怕这份在意被看成依赖。表达需要不等于黏人，关键是说完后你还能不能照顾自己的感受。你更怕的是他不回应，还是怕自己因此看轻自己？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"能感觉到你既想让他知道在意，又怕这份在意被看成依赖。表达需要不等于黏人，关键是说完后你还能不能照顾自己的感受。你更怕的是他不回应，还是怕自己因此看轻自己？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2805,"promptTokens":147,"completionTokens":261,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime