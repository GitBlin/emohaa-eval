ab30982174ac41d798ac5a790f8d573a","isSuicide":false,"isSuicideConf":0.007575276143078579,"emotions":[],"relationId":"6affb64d59efdd2548215524","courseProgressId":0,"tsGen":1795143245700,"createTime":"2026-11-20 10:54:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6affb64659efdd25482154f1","chatId":"5daf3433cdfc44e59ef05ee8c9666ff0","sessionId":null,"userId":129586,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"这种不安反复出现，让你一边想翻记录找证据，一边又觉得自己傻，挺内耗的。你愿意说说，这种“怕自己不重要”的感觉，最早是什么时候出现的吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"这种不安反复出现，让你一边想翻记录找证据，一边又觉得自己傻，挺内耗的。你愿意说说，这种“怕自己不重要”的感觉，最早是什么时候出现的吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2791,"promptTokens":151,"completionTokens":249,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-20 10:53:58"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","promptTraceId":"cb2ee862656f410ab8bfbd7c898a056c","isSuicide":false,"isSuicideConf":0.017983412495509866,"emotions":[],"relationId":"6affb64659efdd25482154f0","courseProgressId":0,"tsGen":1795143238127,"createTime":"2026-11-20 10:53:58","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6affb64659efdd25482154f0","chatId":"5daf3433cdfc44e59ef05ee8c9666ff0","sessionId":null,"userId":129586,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"就是“他是不是觉得我不重要”。然后我会翻以前的聊天记录，想找证据……有时候又觉得这样挺傻的。其实这种不安好像也不是第一次了。<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderCo