{"success":true,"code":"000","message":null,"data":{"totalAmount":8,"totalPageCount":1,"pageNum":0,"itemCount":8,"content":[{"pageNum":0,"pageSize":0,"id":"6affb51959efdd2548215109","chatId":"552eea40dfa348e6b22489f972fe7352","sessionId":null,"userId":129575,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"我不会简单觉得你“太敏感”，更想了解这些情绪波动背后发生了什么。你提到有时能撑住、有时莫名想发火，这种变化通常在什么情境下更明显？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我不会简单觉得你“太敏感”，更想了解这些情绪波动背后发生了什么。你提到有时能撑住、有时莫名想发火，这种变化通常在什么情境下更明显？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1943,"promptTokens":159,"completionTokens":146,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-20 10:48:57"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","promptTraceId":"ebf57d1dc674403fb8458602abd004f9","isSuicide":false,"isSuicideConf":0.014058357616479483,"emotions":[],"relationId":"6affb51959efdd2548215108","courseProgressId":0,"tsGen":1795142937821,"createTime":"2026-11-20 10:48:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6affb51959efdd2548215108","chatId":"552eea40dfa348e6b22489f972fe7352","sessionId":null,"userId":129575,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"有段时间了吧……可能几年了，断断续续的。有时候觉得自己能撑住，有时候又莫名其妙地想发火。对了，你们咨询师会不会也像别人一样，觉得是我太敏感？<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","promptTraceId":"ebf5