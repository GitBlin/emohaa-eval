dd2548214a28","chatId":"6141809fc6cc4ad6b15af426231342fb","sessionId":null,"userId":129546,"orgId":3721,"botId":1030,"isGreeting":false,"role":"role","content":"听起来你很想稳一点，但一紧张就藏不住，这让你有点挫败。最近一次没控制住时，你身体最先出现什么感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来你很想稳一点，但一紧张就藏不住，这让你有点挫败。最近一次没控制住时，你身体最先出现什么感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2611,"promptTokens":151,"completionTokens":238,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-20 10:41:41"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","promptTraceId":"a279eb8bbb7f4a819e87c9e0d704d341","isSuicide":false,"isSuicideConf":0.008574252061851728,"emotions":[],"relationId":"6affb36559efdd2548214a27","courseProgressId":0,"tsGen":1795142501762,"createTime":"2026-11-20 10:41:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6affb36559efdd2548214a27","chatId":"6141809fc6cc4ad6b15af426231342fb","sessionId":null,"userId":129546,"orgId":3721,"botId":1030,"isGreeting":false,"role":"user","content":"可能是同事吧……还有我爸妈。他们老说在外面要稳一点，别什么都写在脸上。可我一紧张就更控制不住，唉，我也说不上来。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","promptTraceId":"a279eb8bbb7f4a819e87c9e0d704d341","isSuicide":false,"isSuicideConf":0.008574252061851728,"emotions":[],"relationId":"6affb36559efdd2548214a28","courseProgressId":0,"tsGen":1795142501760,"createTime":"2026-11-20 10:41