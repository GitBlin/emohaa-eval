nt":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00522012503582944,"emotions":[],"relationId":"6af3e2ebd6006945d2803dc8","courseProgressId":0,"tsGen":1794368235553,"createTime":"2026-11-11 11:37:15","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"9ffa379523bb48c99478f1854b7ad674"}