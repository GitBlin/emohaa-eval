l,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575643939590939,"emotions":[],"relationId":"6af3e1ecd6006945d2800e09","courseProgressId":0,"tsGen":1794367980592,"createTime":"2026-11-11 11:33:00","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"197c6f5ccb2244b0bdeac479b3d9b39a"}