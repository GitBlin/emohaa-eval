ull,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005911068418438151,"emotions":[],"relationId":"6af3e1dfd6006945d2800bb4","courseProgressId":0,"tsGen":1794367967665,"createTime":"2026-11-11 11:32:47","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"b45c7add631e446fa5208743d6324b09"}