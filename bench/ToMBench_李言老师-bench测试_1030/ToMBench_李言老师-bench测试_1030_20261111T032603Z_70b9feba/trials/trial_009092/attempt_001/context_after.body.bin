":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008577484653403024,"emotions":[],"relationId":"6af3e27dd6006945d28029e3","courseProgressId":0,"tsGen":1794368125523,"createTime":"2026-11-11 11:35:25","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"77625c3b83a2448999756a6d8392190b"}