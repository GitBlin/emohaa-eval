t":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0019262210859912275,"emotions":[],"relationId":"6af3e251d6006945d28021e3","courseProgressId":0,"tsGen":1794368081408,"createTime":"2026-11-11 11:34:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"2163f31032aa448f95013240b582607f"}