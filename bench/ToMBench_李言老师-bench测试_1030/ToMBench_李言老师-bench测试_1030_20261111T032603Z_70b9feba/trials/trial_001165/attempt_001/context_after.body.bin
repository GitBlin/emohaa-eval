l,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014063624150605832,"emotions":[],"relationId":"6af3e094d6006945d27fc6e8","courseProgressId":0,"tsGen":1794367636253,"createTime":"2026-11-11 11:27:16","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"41372bfcd2d04d0bb8214be2293418d0"}