ull,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002800283079872555,"emotions":[],"relationId":"6af3e18bd6006945d27ffb1a","courseProgressId":0,"tsGen":1794367883129,"createTime":"2026-11-11 11:31:23","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"a2eba2d557a4446fa69a77e023b2f841"}