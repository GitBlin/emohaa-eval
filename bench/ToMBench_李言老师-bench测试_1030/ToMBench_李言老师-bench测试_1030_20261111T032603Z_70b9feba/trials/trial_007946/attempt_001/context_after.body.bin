Content":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012429303724388108,"emotions":[],"relationId":"6af3e230d6006945d2801b8e","courseProgressId":0,"tsGen":1794368048714,"createTime":"2026-11-11 11:34:08","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"ad6d143436d04427bd3ba54881d8f017"}