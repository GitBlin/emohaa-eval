,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0028004560726141805,"emotions":[],"relationId":"6af3e141d6006945d27febee","courseProgressId":0,"tsGen":1794367809703,"createTime":"2026-11-11 11:30:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"74a20a8f2e5e4b1887ada65e1ee54378"}