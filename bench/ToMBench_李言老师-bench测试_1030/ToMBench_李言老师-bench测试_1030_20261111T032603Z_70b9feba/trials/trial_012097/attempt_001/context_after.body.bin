inderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608748172417455,"emotions":[],"relationId":"6af3e359d6006945d2804f66","courseProgressId":0,"tsGen":1794368345066,"createTime":"2026-11-11 11:39:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"590bef4a5b2043c3afc918a90f69801d"}