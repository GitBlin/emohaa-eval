":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575612219428666,"emotions":[],"relationId":"6af3e0bdd6006945d27fcfb8","courseProgressId":0,"tsGen":1794367677383,"createTime":"2026-11-11 11:27:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"608a864010204ee6aaa6a4a9d3315b59"}