l,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0059095338035481835,"emotions":[],"relationId":"6af3e083d6006945d27fc31c","courseProgressId":0,"tsGen":1794367619558,"createTime":"2026-11-11 11:26:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"ab5b8388284d47fbb53c5712d7cd9df1"}