ioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608846247726548,"emotions":[],"relationId":"6af3e127d6006945d27fe6d3","courseProgressId":0,"tsGen":1794367783758,"createTime":"2026-11-11 11:29:43","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"a862618d440a4f20808a91fd7b9e50b6"}