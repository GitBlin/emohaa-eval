Context":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009708477770841793,"emotions":[],"relationId":"6af3e0bed6006945d27fcfee","courseProgressId":0,"tsGen":1794367678332,"createTime":"2026-11-11 11:27:58","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"aee2e7b37e134f4997ac9e2405dd7180"}