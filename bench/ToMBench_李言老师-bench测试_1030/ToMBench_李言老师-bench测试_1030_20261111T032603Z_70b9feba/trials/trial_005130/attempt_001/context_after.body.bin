l,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007577239699102878,"emotions":[],"relationId":"6af3e181d6006945d27ff94a","courseProgressId":0,"tsGen":1794367873954,"createTime":"2026-11-11 11:31:13","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"d2232ab649e34f24b4fb7f5785bad3a1"}