或支持。","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608748070289795,"emotions":[],"relationId":"6af3e05cd6006945d27fba50","courseProgressId":0,"tsGen":1794367580990,"createTime":"2026-11-11 11:26:20","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"29f120e2476c42fcb2bdf77cd6f0c6b5"}