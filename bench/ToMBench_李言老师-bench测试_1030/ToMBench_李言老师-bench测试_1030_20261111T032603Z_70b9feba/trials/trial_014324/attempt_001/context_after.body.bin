ull,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004069453314288204,"emotions":[],"relationId":"6af3e3fdd6006945d2806b44","courseProgressId":0,"tsGen":1794368509904,"createTime":"2026-11-11 11:41:49","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"ccfbffa322e14cf2bd91878bfe3967a0"}