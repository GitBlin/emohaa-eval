nt":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004069363150817878,"emotions":[],"relationId":"6af3e31fd6006945d280460b","courseProgressId":0,"tsGen":1794368287329,"createTime":"2026-11-11 11:38:07","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"7f8ad0e9b75a4ddb8b0cd807989d8d0a"}