xt":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608889875205952,"emotions":[],"relationId":"6af3e40fd6006945d2806e57","courseProgressId":0,"tsGen":1794368527078,"createTime":"2026-11-11 11:42:07","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"8be7a87c7e764f548a7420de8fe83135"}