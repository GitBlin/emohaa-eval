CoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010984587664281113,"emotions":[],"relationId":"6af3e243d6006945d2801f60","courseProgressId":0,"tsGen":1794368067497,"createTime":"2026-11-11 11:34:27","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"00b81956628c4b91900fd01d4c8db383"}