l,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0024717611139265564,"emotions":[],"relationId":"6af3e1f8d6006945d2801057","courseProgressId":0,"tsGen":1794367992722,"createTime":"2026-11-11 11:33:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"63b65017660343458d7f14ac08bb37c5"}