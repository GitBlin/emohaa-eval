derContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002800358903692943,"emotions":[],"relationId":"6af3e28dd6006945d2802ceb","courseProgressId":0,"tsGen":1794368141576,"createTime":"2026-11-11 11:35:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"298d9bcf55fe48708aeba01445cbad39"}