ideoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002472179797712364,"emotions":[],"relationId":"6af3e261d6006945d28024e2","courseProgressId":0,"tsGen":1794368097869,"createTime":"2026-11-11 11:34:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"53522e3783aa48c8b67d2539604cd032"}