xt":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0031721148755280435,"emotions":[],"relationId":"6af3e322d6006945d2804687","courseProgressId":0,"tsGen":1794368290038,"createTime":"2026-11-11 11:38:10","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"13ba15ba01fb43c9a87170183bcf467d"}