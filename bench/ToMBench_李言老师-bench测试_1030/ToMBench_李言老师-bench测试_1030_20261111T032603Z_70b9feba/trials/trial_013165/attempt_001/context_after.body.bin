Context":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0021824304648014495,"emotions":[],"relationId":"6af3e3aad6006945d2805c59","courseProgressId":0,"tsGen":1794368426379,"createTime":"2026-11-11 11:40:26","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"be49307f86464388965e6ac6b0e2705b"}