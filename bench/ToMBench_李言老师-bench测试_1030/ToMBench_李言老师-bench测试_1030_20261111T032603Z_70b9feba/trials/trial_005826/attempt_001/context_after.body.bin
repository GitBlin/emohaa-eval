ideoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004069314015443167,"emotions":[],"relationId":"6af3e1acd6006945d28001d9","courseProgressId":0,"tsGen":1794367916645,"createTime":"2026-11-11 11:31:56","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"011b6dfa944b4c22b9d0c6c44b6ed8ca"}