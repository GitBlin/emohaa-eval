edia":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0013248488994151626,"emotions":[],"relationId":"6af3e16ad6006945d27ff499","courseProgressId":0,"tsGen":1794367850790,"createTime":"2026-11-11 11:30:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"a099c9e877ab4cf0a3dcbdb3815184af"}