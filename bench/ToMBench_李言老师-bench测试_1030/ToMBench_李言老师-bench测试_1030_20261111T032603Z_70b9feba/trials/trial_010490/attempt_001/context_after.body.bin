:null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009708477341052532,"emotions":[],"relationId":"6af3e2ddd6006945d2803b67","courseProgressId":0,"tsGen":1794368221938,"createTime":"2026-11-11 11:37:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"2a92e5dad7594be482f0d80bbdbb6129"}