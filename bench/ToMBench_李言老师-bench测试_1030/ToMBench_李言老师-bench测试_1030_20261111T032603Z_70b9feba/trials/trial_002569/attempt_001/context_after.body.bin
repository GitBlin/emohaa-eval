nt":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691500112745001,"emotions":[],"relationId":"6af3e0e7d6006945d27fd920","courseProgressId":0,"tsGen":1794367719319,"createTime":"2026-11-11 11:28:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"f710770cb44f41399dec290aee61c078"}