t":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0024722067687202517,"emotions":[],"relationId":"6af3e3cad6006945d280619d","courseProgressId":0,"tsGen":1794368458498,"createTime":"2026-11-11 11:40:58","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"0c9e2b765911464baf3efb667eea97c3"}