l,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00460874933510064,"emotions":[],"relationId":"6af3e28bd6006945d2802c95","courseProgressId":0,"tsGen":1794368139418,"createTime":"2026-11-11 11:35:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"23ac31f101dd4615be4d1f167203e253"}