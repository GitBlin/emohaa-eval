inderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012428990847824384,"emotions":[],"relationId":"6af3e270d6006945d2802796","courseProgressId":0,"tsGen":1794368112723,"createTime":"2026-11-11 11:35:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"8ec2b4e503754f2a8f5751d68f37d283"}