:null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0035936027414893473,"emotions":[],"relationId":"6af3e2a8d6006945d28031b9","courseProgressId":0,"tsGen":1794368168553,"createTime":"2026-11-11 11:36:08","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"2203812112364a55a60f6fb3c617e71c"}