tent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0035929186962515187,"emotions":[],"relationId":"6af3e140d6006945d27febc3","courseProgressId":0,"tsGen":1794367808862,"createTime":"2026-11-11 11:30:08","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"1585c4f7f49b473b927f1f61dfb0704a"}