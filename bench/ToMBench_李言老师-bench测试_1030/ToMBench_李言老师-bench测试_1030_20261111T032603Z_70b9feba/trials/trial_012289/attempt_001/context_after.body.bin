tent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0028004562598419333,"emotions":[],"relationId":"6af3e368d6006945d28051f7","courseProgressId":0,"tsGen":1794368360664,"createTime":"2026-11-11 11:39:20","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"2ed903b210e94f65b8268c5018f84a1d"}