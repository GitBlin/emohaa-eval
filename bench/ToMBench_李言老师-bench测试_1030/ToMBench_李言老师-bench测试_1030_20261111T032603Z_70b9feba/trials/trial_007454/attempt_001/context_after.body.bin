l,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007577239923211134,"emotions":[],"relationId":"6af3e211d6006945d2801573","courseProgressId":0,"tsGen":1794368017328,"createTime":"2026-11-11 11:33:37","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"1c68ffebdca94d57830931874e1c01c2"}