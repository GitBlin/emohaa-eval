没在工作。","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008577483766375986,"emotions":[],"relationId":"6af3e058d6006945d27fb944","courseProgressId":0,"tsGen":1794367576332,"createTime":"2026-11-11 11:26:16","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"d481b6c1cc8046ff8dcab8d8e43789ca"}