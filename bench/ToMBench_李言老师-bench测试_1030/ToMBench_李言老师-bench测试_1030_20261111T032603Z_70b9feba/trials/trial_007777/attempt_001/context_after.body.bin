null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.003593603248375377,"emotions":[],"relationId":"6af3e226d6006945d280196b","courseProgressId":0,"tsGen":1794368038021,"createTime":"2026-11-11 11:33:58","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"3c8fd3254b6b40098820c90de2a59ad3"}