inderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0075772430607274135,"emotions":[],"relationId":"6af3e12ed6006945d27fe82e","courseProgressId":0,"tsGen":1794367790644,"createTime":"2026-11-11 11:29:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"40197e936df9427dbf5c7bb5d37f0366"}