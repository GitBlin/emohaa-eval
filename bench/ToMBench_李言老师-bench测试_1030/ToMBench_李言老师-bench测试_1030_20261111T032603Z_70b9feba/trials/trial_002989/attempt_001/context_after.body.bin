Context":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691658451104241,"emotions":[],"relationId":"6af3e100d6006945d27fde9f","courseProgressId":0,"tsGen":1794367744659,"createTime":"2026-11-11 11:29:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"ec1c38d7928f4a6796d18b87bb1c5f1f"}