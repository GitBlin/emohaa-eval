t":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691412563533849,"emotions":[],"relationId":"6af3e066d6006945d27fbc9a","courseProgressId":0,"tsGen":1794367590773,"createTime":"2026-11-11 11:26:30","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"1c7e1a3670754f639c3e73c1812859f3"}