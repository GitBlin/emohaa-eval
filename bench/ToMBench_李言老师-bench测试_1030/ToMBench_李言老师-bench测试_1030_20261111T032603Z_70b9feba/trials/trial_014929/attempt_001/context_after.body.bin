l,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009708476481474066,"emotions":[],"relationId":"6af3e429d6006945d280730a","courseProgressId":0,"tsGen":1794368553408,"createTime":"2026-11-11 11:42:33","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"063ae6fe3b3945cd87d9e6490ceb8e36"}