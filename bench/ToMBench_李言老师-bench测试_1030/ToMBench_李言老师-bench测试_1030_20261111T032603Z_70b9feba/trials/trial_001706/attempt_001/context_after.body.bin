geContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219002405299413,"emotions":[],"relationId":"6af3e0b3d6006945d27fcdcf","courseProgressId":0,"tsGen":1794367667871,"createTime":"2026-11-11 11:27:47","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"8a232f1c872f40efb3d3610b3251a09a"}