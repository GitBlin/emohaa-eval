,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006692851617731241,"emotions":[],"relationId":"6af3e0b1d6006945d27fcd4c","courseProgressId":0,"tsGen":1794367665703,"createTime":"2026-11-11 11:27:45","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"9d2066ed48da43ceaefa131c7f22b554"}