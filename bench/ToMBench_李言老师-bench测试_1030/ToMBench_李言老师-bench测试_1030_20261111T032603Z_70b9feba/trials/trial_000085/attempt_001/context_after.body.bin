tent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.015906387979758903,"emotions":[],"relationId":"6af3e054d6006945d27fb894","courseProgressId":0,"tsGen":1794367572963,"createTime":"2026-11-11 11:26:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"3e4ad2a081de48a9a19598bab428e54b"}