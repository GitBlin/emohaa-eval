l,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.003592873398871583,"emotions":[],"relationId":"6af3e095d6006945d27fc728","courseProgressId":0,"tsGen":1794367637433,"createTime":"2026-11-11 11:27:17","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"cb9206b97e334ba2b5e6d68b7311ace8"}