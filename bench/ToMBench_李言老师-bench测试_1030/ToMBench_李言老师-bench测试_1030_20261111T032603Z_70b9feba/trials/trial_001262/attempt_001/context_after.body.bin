l,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005220126506047221,"emotions":[],"relationId":"6af3e099d6006945d27fc820","courseProgressId":0,"tsGen":1794367641916,"createTime":"2026-11-11 11:27:21","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"bb8c0b1f4a894e39878f1a44af4eb3e7"}