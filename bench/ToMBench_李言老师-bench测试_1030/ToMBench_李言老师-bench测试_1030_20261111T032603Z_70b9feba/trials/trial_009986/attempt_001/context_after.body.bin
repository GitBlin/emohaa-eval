l,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005909534416157866,"emotions":[],"relationId":"6af3e2bbd6006945d2803523","courseProgressId":0,"tsGen":1794368187152,"createTime":"2026-11-11 11:36:27","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"d34109f8f32b4e9f97308d46cc34b5f8"}