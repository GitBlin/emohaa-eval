t":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014061286459869819,"emotions":[],"relationId":"6af3e161d6006945d27ff293","courseProgressId":0,"tsGen":1794367841599,"createTime":"2026-11-11 11:30:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"3924b9c790a54e1c98b5f6831305be1d"}