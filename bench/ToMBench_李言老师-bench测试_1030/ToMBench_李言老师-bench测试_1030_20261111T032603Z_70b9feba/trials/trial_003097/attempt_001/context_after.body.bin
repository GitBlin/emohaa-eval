":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218852137988658,"emotions":[],"relationId":"6af3e107d6006945d27fdffb","courseProgressId":0,"tsGen":1794367751082,"createTime":"2026-11-11 11:29:11","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"f5301cc1e3124306911671a15875078f"}