inderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0035929593072188495,"emotions":[],"relationId":"6af3e2f7d6006945d2803fcf","courseProgressId":0,"tsGen":1794368247695,"createTime":"2026-11-11 11:37:27","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"a0badd6eced04b04bbb4b56876dd1f0d"}