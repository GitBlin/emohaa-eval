l,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002182392452627698,"emotions":[],"relationId":"6af3e0abd6006945d27fcbe2","courseProgressId":0,"tsGen":1794367659273,"createTime":"2026-11-11 11:27:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"e78b9495e4bb46f49425774e329ef438"}