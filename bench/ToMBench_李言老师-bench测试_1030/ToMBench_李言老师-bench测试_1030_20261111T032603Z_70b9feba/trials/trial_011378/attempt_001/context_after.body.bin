l,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.003593601807752111,"emotions":[],"relationId":"6af3e321d6006945d2804663","courseProgressId":0,"tsGen":1794368289097,"createTime":"2026-11-11 11:38:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"5aa40139466742c891ac8e4980d396c3"}