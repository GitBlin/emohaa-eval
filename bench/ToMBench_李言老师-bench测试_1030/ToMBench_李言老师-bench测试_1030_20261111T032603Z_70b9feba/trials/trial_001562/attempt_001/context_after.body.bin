erContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.017981878686662692,"emotions":[],"relationId":"6af3e0acd6006945d27fcc0f","courseProgressId":0,"tsGen":1794367660162,"createTime":"2026-11-11 11:27:40","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"eb9caf9b853044f2b6faa003bb3f3c71"}