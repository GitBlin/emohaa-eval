l,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010986940687560063,"emotions":[],"relationId":"6af3e0ccd6006945d27fd314","courseProgressId":0,"tsGen":1794367692690,"createTime":"2026-11-11 11:28:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"4032b0e7036e4e77a19e2225c2588c12"}