ull,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608695740568342,"emotions":[],"relationId":"6af3e123d6006945d27fe5f9","courseProgressId":0,"tsGen":1794367779613,"createTime":"2026-11-11 11:29:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"7d20b506a0c94618a19823b94b6fb8b3"}