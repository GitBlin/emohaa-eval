erContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002800358487118423,"emotions":[],"relationId":"6af3e28cd6006945d2802ccb","courseProgressId":0,"tsGen":1794368140590,"createTime":"2026-11-11 11:35:40","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"934015a4f9344b9491a23a07b0e01a74"}