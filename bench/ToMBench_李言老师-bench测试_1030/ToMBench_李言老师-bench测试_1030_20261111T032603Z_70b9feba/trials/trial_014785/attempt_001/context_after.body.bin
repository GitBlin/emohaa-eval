Content":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0031726828424851897,"emotions":[],"relationId":"6af3e41ed6006945d280711e","courseProgressId":0,"tsGen":1794368542491,"createTime":"2026-11-11 11:42:22","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"d04c475a5a1f4ca0b275ff4a809dba36"}