Context":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002800283641793436,"emotions":[],"relationId":"6af3e0c7d6006945d27fd215","courseProgressId":0,"tsGen":1794367687831,"createTime":"2026-11-11 11:28:07","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"6d2783bbd7574389bf65eadd21e2b5fc"}