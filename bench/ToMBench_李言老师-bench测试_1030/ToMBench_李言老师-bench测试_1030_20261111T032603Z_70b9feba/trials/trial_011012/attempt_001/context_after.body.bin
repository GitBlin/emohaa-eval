l,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004609572726345088,"emotions":[],"relationId":"6af3e305d6006945d2804201","courseProgressId":0,"tsGen":1794368261287,"createTime":"2026-11-11 11:37:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"4a667289d95f4398991bb2232b3e954f"}