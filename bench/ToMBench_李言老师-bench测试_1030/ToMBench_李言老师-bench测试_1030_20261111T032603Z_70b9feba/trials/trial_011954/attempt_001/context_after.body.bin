l,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007577242164294059,"emotions":[],"relationId":"6af3e34dd6006945d2804d99","courseProgressId":0,"tsGen":1794368333523,"createTime":"2026-11-11 11:38:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"820c296764514de591653932ade1a3b2"}