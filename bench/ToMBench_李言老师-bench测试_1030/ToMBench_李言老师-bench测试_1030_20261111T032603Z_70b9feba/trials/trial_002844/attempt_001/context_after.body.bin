Content":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009708477914104884,"emotions":[],"relationId":"6af3e0f7d6006945d27fdcb0","courseProgressId":0,"tsGen":1794367735337,"createTime":"2026-11-11 11:28:55","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"ea6b8371b3a24ad08995da25d74f0d32"}