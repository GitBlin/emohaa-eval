null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608970007054383,"emotions":[],"relationId":"6af3e17cd6006945d27ff834","courseProgressId":0,"tsGen":1794367868437,"createTime":"2026-11-11 11:31:08","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"13b452b27d214710bf2ef5db5558ec83"}