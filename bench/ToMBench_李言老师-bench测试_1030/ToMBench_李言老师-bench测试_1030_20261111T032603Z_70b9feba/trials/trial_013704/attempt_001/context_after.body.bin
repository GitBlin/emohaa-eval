:null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.015901143023120852,"emotions":[],"relationId":"6af3e3d4d6006945d2806359","courseProgressId":0,"tsGen":1794368468622,"createTime":"2026-11-11 11:41:08","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"1137fb6f0e6045dd8bd62719c5d85f8d"}