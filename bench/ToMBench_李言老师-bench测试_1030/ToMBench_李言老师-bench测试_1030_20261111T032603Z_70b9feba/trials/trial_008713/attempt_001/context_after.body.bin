ageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0046095727263450875,"emotions":[],"relationId":"6af3e264d6006945d2802555","courseProgressId":0,"tsGen":1794368100173,"createTime":"2026-11-11 11:35:00","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"83b18c7993784fff98e295e3e4d390ef"}