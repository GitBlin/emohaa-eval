nt":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608930048977249,"emotions":[],"relationId":"6af3e190d6006945d27ffc2d","courseProgressId":0,"tsGen":1794367888176,"createTime":"2026-11-11 11:31:28","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"12c21665c4134c7991bdc804f717cc94"}