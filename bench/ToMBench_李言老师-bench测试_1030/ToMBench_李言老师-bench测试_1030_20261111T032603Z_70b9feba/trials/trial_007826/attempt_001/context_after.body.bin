inderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0019263082759570142,"emotions":[],"relationId":"6af3e229d6006945d2801a22","courseProgressId":0,"tsGen":1794368041875,"createTime":"2026-11-11 11:34:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"b24a9b5853884e8daaf9353172cecbaf"}