ull,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005911068374657587,"emotions":[],"relationId":"6af3e2a1d6006945d2803088","courseProgressId":0,"tsGen":1794368161899,"createTime":"2026-11-11 11:36:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"e47a4fa9bb304eee92629ae26987c98c"}