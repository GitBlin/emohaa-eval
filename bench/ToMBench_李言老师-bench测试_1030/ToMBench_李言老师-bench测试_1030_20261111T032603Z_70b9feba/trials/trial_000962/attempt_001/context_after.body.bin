l,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.003171856208100027,"emotions":[],"relationId":"6af3e088d6006945d27fc42f","courseProgressId":0,"tsGen":1794367624324,"createTime":"2026-11-11 11:27:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"0ef3e8ad04e64e39b6ce7f8de393be14"}