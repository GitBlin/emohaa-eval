nt":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002800455947795685,"emotions":[],"relationId":"6af3e075d6006945d27fbfd3","courseProgressId":0,"tsGen":1794367605002,"createTime":"2026-11-11 11:26:45","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"0fb1a18fa0b64bf69c202c5f193498cf"}