ioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002472278045233428,"emotions":[],"relationId":"6af3e15dd6006945d27ff1a5","courseProgressId":0,"tsGen":1794367837073,"createTime":"2026-11-11 11:30:37","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"857321c3e97942c7997886f4f4328a57"}