xt":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0013248784161723449,"emotions":[],"relationId":"6af3e469d6006945d2807cf9","courseProgressId":0,"tsGen":1794368617621,"createTime":"2026-11-11 11:43:37","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"6a55bac87fbe4f8baf28a1824eefe497"}