:null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.003592918482907101,"emotions":[],"relationId":"6af3e33ed6006945d2804b1b","courseProgressId":0,"tsGen":1794368318033,"createTime":"2026-11-11 11:38:38","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"92358f4457a14723bc2e5cd57907ee59"}