tent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608797320063908,"emotions":[],"relationId":"6af3e25dd6006945d2802409","courseProgressId":0,"tsGen":1794368093036,"createTime":"2026-11-11 11:34:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"7afd47a7ff144ca8999c5be40c77f915"}