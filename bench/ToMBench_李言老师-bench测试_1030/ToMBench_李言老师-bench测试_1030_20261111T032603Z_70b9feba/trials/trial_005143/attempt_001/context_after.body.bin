inderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002800321579596996,"emotions":[],"relationId":"6af3e182d6006945d27ff969","courseProgressId":0,"tsGen":1794367874649,"createTime":"2026-11-11 11:31:14","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"047d28f4d6b74fc4a4a1104d14ab8c95"}