null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014063626630011204,"emotions":[],"relationId":"6af3e2ddd6006945d2803b35","courseProgressId":0,"tsGen":1794368221053,"createTime":"2026-11-11 11:37:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"38fd1710a244485c921bd1a9888bd270"}