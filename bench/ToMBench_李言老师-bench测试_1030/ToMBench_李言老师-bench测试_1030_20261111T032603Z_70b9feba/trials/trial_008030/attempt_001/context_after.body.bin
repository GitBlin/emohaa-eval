audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007577239811157005,"emotions":[],"relationId":"6af3e236d6006945d2801c9c","courseProgressId":0,"tsGen":1794368054129,"createTime":"2026-11-11 11:34:14","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"ddfa2e90a5914d9f9d79302934cff593"}