eContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002800510603775386,"emotions":[],"relationId":"6af3e0f9d6006945d27fdd3c","courseProgressId":0,"tsGen":1794367737956,"createTime":"2026-11-11 11:28:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"a65e28ac364f414caccfcc25c80422dc"}