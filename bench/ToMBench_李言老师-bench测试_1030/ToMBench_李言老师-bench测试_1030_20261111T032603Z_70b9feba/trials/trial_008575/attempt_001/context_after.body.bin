null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.003172378530180647,"emotions":[],"relationId":"6af3e25ad6006945d2802371","courseProgressId":0,"tsGen":1794368090164,"createTime":"2026-11-11 11:34:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"a25ed2ba0e9d4a22b99c52bd43897d27"}