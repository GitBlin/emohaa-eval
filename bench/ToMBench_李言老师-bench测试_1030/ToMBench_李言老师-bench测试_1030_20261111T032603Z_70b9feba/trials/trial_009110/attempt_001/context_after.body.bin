Content":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575644825359425,"emotions":[],"relationId":"6af3e27ed6006945d2802a0f","courseProgressId":0,"tsGen":1794368126201,"createTime":"2026-11-11 11:35:26","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"06d582c9df444a1dbc75c20a587fd41e"}