derContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00522012515189925,"emotions":[],"relationId":"6af3e11cd6006945d27fe4a0","courseProgressId":0,"tsGen":1794367772903,"createTime":"2026-11-11 11:29:32","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"44c3aeb2fb964cfcaaf9bec4381e7ad4"}