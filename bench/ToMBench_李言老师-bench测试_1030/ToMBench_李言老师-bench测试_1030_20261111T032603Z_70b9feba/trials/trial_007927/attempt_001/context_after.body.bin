inderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0019264662263103038,"emotions":[],"relationId":"6af3e230d6006945d2801b66","courseProgressId":0,"tsGen":1794368048056,"createTime":"2026-11-11 11:34:08","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"117e837d2ec741c5b657c93f952acec7"}