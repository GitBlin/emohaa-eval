:null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608748583284413,"emotions":[],"relationId":"6af3e2c5d6006945d2803725","courseProgressId":0,"tsGen":1794368197918,"createTime":"2026-11-11 11:36:37","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"2d1d9ba2569b4f44971b967ab57edcfc"}