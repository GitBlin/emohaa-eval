l,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009708474332528234,"emotions":[],"relationId":"6af3e185d6006945d27ff9f4","courseProgressId":0,"tsGen":1794367877358,"createTime":"2026-11-11 11:31:17","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"9e0cab321453463b9db581e92400b08e"}