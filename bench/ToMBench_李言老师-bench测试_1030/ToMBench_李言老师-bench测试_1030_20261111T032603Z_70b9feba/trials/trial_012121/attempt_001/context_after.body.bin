tent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006691731294442458,"emotions":[],"relationId":"6af3e35bd6006945d2804fa9","courseProgressId":0,"tsGen":1794368347070,"createTime":"2026-11-11 11:39:07","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"23b9a0caf71e42b8991a21d707d2126b"}