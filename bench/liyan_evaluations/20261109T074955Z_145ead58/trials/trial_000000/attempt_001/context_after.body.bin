nt":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005220126157837709,"emotions":[],"relationId":"6af17b2420a9a0180232a4e6","courseProgressId":0,"tsGen":1794210596979,"createTime":"2026-11-09 15:49:56","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"c1985a678a734482b3a6bff2b7efbf8b"}