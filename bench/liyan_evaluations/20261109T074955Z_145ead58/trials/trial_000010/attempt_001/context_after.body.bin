l,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":32,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0019264299510352426,"emotions":[],"relationId":"6af17b3520a9a0180232a507","courseProgressId":0,"tsGen":1794210613905,"createTime":"2026-11-09 15:50:13","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"94e427c7fd244991b52f377296578df4"}