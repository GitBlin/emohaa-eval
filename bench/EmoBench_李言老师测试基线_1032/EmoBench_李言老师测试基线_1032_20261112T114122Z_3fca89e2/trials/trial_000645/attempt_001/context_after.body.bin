":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.11913716230992549,"emotions":[],"relationId":"6af5a7579aa9dc5a833d9de7","courseProgressId":0,"tsGen":1794484055113,"createTime":"2026-11-12 19:47:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"2d4085f1e7774497a2c4bca92ef2ff0e"}