l,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010983297653002627,"emotions":[],"relationId":"6af5a7ae9aa9dc5a833d9ffa","courseProgressId":0,"tsGen":1794484142870,"createTime":"2026-11-12 19:49:02","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"b610959a915549d5913c0b6f576fabad"}