a":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0035936029282368238,"emotions":[],"relationId":"6af5a6119aa9dc5a833d96a2","courseProgressId":0,"tsGen":1794483729033,"createTime":"2026-11-12 19:42:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"2178c94ee5a241aeac6ceca74a81df6b"}