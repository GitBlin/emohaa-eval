她不能来而感到内疚\nD) 她也希望能毕业","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007574990155490726,"emotions":[],"relationId":"6af5a5ef9aa9dc5a833d9587","courseProgressId":0,"tsGen":1794483695988,"createTime":"2026-11-12 19:41:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"9704a6357c574443bf8e05af84a8310b"}