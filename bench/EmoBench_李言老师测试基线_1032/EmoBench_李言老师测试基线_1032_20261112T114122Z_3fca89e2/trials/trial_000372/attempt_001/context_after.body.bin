更高的工资感到激动\nD) 他不想在获得更少工资和假期的情况下还要承担更多的责任","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009704335937157655,"emotions":[],"relationId":"6af5a6979aa9dc5a833d9933","courseProgressId":0,"tsGen":1794483863851,"createTime":"2026-11-12 19:44:23","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"7d486d9dff2644ffb9bca0ab57cbca49"}