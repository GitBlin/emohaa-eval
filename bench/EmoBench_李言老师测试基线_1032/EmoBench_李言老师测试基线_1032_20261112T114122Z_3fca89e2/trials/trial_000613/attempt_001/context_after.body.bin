a":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0031721156469510453,"emotions":[],"relationId":"6af5a75a9aa9dc5a833d9df6","courseProgressId":0,"tsGen":1794484058681,"createTime":"2026-11-12 19:47:38","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"2bed47215b8345648df346f2f8b0916d"}