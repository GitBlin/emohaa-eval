hips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004069313018805478,"emotions":[],"relationId":"6af5a7819aa9dc5a833d9ec9","courseProgressId":0,"tsGen":1794484097016,"createTime":"2026-11-12 19:48:17","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"180b1e49bd084a1c923bb4b7dc06c3f0"}