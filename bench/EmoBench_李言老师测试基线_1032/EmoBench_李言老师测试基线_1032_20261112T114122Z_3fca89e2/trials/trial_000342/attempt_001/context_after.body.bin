妈妈的烹饪","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002800054163742108,"emotions":[],"relationId":"6af5a7059aa9dc5a833d9bbe","courseProgressId":0,"tsGen":1794483973017,"createTime":"2026-11-12 19:46:13","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"bb5c1a8b5bb34b64b7ba428ff1a0e417"}