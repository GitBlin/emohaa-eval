茵迪差点毁了布莱尔的生日惊喜\nB) 印度开始了一场并不有趣的对话\nC) 布莱尔对他们的惊喜计划似乎并不关心\nD) 简不喜欢布莱尔的房间","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608033507557833,"emotions":[],"relationId":"6af5a6cf9aa9dc5a833d9aa8","courseProgressId":0,"tsGen":1794483919871,"createTime":"2026-11-12 19:45:19","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"a1bbff8365174ff59f6a74671a1b05ad"}