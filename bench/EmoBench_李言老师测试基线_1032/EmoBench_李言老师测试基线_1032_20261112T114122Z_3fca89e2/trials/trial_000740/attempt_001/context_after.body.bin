a":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0035926677730848885,"emotions":[],"relationId":"6af5a76c9aa9dc5a833d9e51","courseProgressId":0,"tsGen":1794484076732,"createTime":"2026-11-12 19:47:56","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"d98445cf9eca4d21bb92d8f4519e0636"}