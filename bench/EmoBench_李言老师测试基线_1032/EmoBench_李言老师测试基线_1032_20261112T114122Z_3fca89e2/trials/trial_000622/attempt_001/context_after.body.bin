l,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0040687774729865865,"emotions":[],"relationId":"6af5a6f09aa9dc5a833d9b53","courseProgressId":0,"tsGen":1794483952282,"createTime":"2026-11-12 19:45:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"8ef696969e4a431da590118ac624f2e1"}