mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":4,"responseSource":"agent:llm","promptTraceId":"3aa0cc8907d34ea8add2e16677f79006","isSuicide":false,"isSuicideConf":8.04076304733685E-4,"emotions":[{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2}],"relationId":"6b041f616438f403db4d1c75","courseProgressId":0,"tsGen":1795432289277,"createTime":"2026-11-23 19:11:29","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b041f566438f403db4d1c52","chatId":"43787af5e00f4eab9c1674a3ae6cb999","sessionId":null,"userId":130607,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"That sounds like a lot to carry, especially when it’s costing you sleep. What’s been happening this week?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"That sounds like a lot to carry, especially when it’s costing you sleep. What’s been happening this week?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":9288,"promptTokens":316,"completionTokens":93,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-23 19:11:18"}],"imgs":null,"regenerations":0,"seqNum":3,"responseSource":"agent:llm","promptTraceId":"415625c345524b6e976a2c2fdcd3d082","isSuicide":false,"isSuicideConf":0.020331633023708277,"emotions":[],"relation