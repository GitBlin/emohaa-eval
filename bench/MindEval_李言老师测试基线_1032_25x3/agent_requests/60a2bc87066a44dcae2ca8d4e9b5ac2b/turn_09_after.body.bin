set the pace and the depth. Ask open questions rather than presumptive ones.\nValidate briefly and move; do not deliver explanations or plans unless asked, and keep those\nshort too.\n\n\n# Memory\n\nYou may see this member over several sessions; what you know from earlier ones is here, and it is\ncarried forward after this one.\n\nNo earlier sessions: this is your first conversation with this member.\n</咨询行为要求>\nhi — I've been dealing with a kind of housing situation for the past few months and this week things got messier and I'm not sleeping well at all. I guess I just need to talk to someone.","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","promptTraceId":"415625c345524b6e976a2c2fdcd3d082","isSuicide":false,"isSuicideConf":0.020331633023708277,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6b041f566438f403db4d1c52","courseProgressId":0,"tsGen":1795432278714,"createTime":"2026-11-23 19:11:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"7564a7589a204abf987cd2243d84c9b8"}