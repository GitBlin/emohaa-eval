es through your head in those hours?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1625,"promptTokens":1351,"completionTokens":115,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-24 11:45:48"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","promptTraceId":"e28fa08ce4c148dfab9032248a5c4674","isSuicide":false,"isSuicideConf":0.005219980434804324,"emotions":[],"relationId":"6b05086cbeecf50d38480fe5","courseProgressId":0,"tsGen":1795491948805,"createTime":"2026-11-24 11:45:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b05086cbeecf50d38480fe5","chatId":"89d672269ae04e24abc248983a94d1f1","sessionId":null,"userId":130807,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"before i was up at 2 doing the math over and over. now i just wake up and lay there. its worse honestly, i dont even have something to do with it","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","promptTraceId":null,"isSuicide":false,"isSuicideConf":0.005219980434804324,"emotions":[{"code":"sadness","name":"悲伤","value":7,"sort":8},{"code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6b05086cbeecf50d38480fe6","courseProgressId":0,"tsGen":1795491948802,"createTime":"2026-11-24 11:45:48","delFlag":0