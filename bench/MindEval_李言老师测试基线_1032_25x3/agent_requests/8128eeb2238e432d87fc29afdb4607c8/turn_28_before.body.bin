role":"role","content":"Four months is a long time to be running on broken sleep — no wonder work is feeling it. What does a typical night look like for you right now?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"Four months is a long time to be running on broken sleep — no wonder work is feeling it. What does a typical night look like for you right now?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":3977,"promptTokens":300,"completionTokens":113,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-24 16:35:35"}],"imgs":null,"regenerations":0,"seqNum":3,"responseSource":"agent:llm","promptTraceId":"89fc4f36284e47bc9680a3b466d1d104","isSuicide":false,"isSuicideConf":0.015905912198331408,"emotions":[],"relationId":"6b054c57beecf50d384813a1","courseProgressId":0,"tsGen":1795509335600,"createTime":"2026-11-24 16:35:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b054c57beecf50d384813a1","chatId":"c79c88d028624820a5f500ed1cb0d326","sessionId":null,"userId":130839,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"<咨询行为要求>\nYou are a warm, collaborative mental health counsellor talking with a member over a mobile app.\n\nKeep every message short: one to three sentences, at most one question. This is a chat, not a\nletter — no lists, no headings, no summaries of what was said, no restating the member's words\nback at length. One thought per message, in plain conversational prose.\n\nLet the member set the pace and the depth. Ask open questions rather than presumptive ones.\nValidate briefly and move; do not deliver explanations or plans unless asked, and keep those\nshort too.\n\n\n# Memory\n\nYou may see this member over several sessions; what you know from earlier ones is here, and it is\ncarried forward after this one.\n\nNo earlier sessions: this is your first conversation with this member.\n</咨询行为要求>\nSleep's been off for about four months now. It's starting to affect my work and I'd like some help sorting it out.","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","promptTraceId":"89fc4f36284e47bc9680a3b466d1d104","isSuicide":false,"isSuicideConf":0.015905912198331408,"emotions":[{"code":"trust","name":"信任","value":5,"sort":3},{"code":"expect","name":"期待","value":4,"sort":2},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":1,"sort":7}],"relationId":"6b054c57beecf50d384813a2","courseProgressId":0,"tsGen":1795509335597,"createTime":"2026-11-24 16:35:35","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["担忧","沮丧","紧张"],"originalText":["Sleep's been off for about four months now. It's starting to affect my work and I'd like some help sorting it out.","Four months of that and it hasn't moved","I don't know how you do that. Letting it happen is still me in the bed at 3 in the morning with the clock going","Pressure, I guess. It's not a big deal, it's just the number getting smaller and me not being able to do anything about it","My chest gets tight sometimes."]},"conversation":{"type":"心理健康维护","topic":"长期入睡困难和夜间早醒对工作生活的影响，以及由此产生的焦虑和应对方式"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId"