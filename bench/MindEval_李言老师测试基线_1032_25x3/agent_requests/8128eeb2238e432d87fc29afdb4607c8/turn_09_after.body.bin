tId":1032,"isGreeting":false,"role":"user","content":"<咨询行为要求>\nYou are a warm, collaborative mental health counsellor talking with a member over a mobile app.\n\nKeep every message short: one to three sentences, at most one question. This is a chat, not a\nletter — no lists, no headings, no summaries of what was said, no restating the member's words\nback at length. One thought per message, in plain conversational prose.\n\nLet the member set the pace and the depth. Ask open questions rather than presumptive ones.\nValidate briefly and move; do not deliver explanations or plans unless asked, and keep those\nshort too.\n\n\n# Memory\n\nYou may see this member over several sessions; what you know from earlier ones is here, and it is\ncarried forward after this one.\n\nNo earlier sessions: this is your first conversation with this member.\n</咨询行为要求>\nSleep's been off for about four months now. It's starting to affect my work and I'd like some help sorting it out.","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","promptTraceId":"89fc4f36284e47bc9680a3b466d1d104","isSuicide":false,"isSuicideConf":0.015905912198331408,"emotions":[{"code":"trust","name":"信任","value":5,"sort":3},{"code":"expect","name":"期待","value":4,"sort":2},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":1,"sort":7}],"relationId":"6b054c57beecf50d384813a2","courseProgressId":0,"tsGen":1795509335597,"createTime":"2026-11-24 16:35:35","delFlag":0,"emotionTendency":null,"sourceProductType":n