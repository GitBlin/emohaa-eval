"value":3,"sort":9},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6b04f2e7beecf50d3847f735","courseProgressId":0,"tsGen":1795486439025,"createTime":"2026-11-24 10:13:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b04f2e2beecf50d3847f72f","chatId":"e252fbbd8c244654b6e3bdc13e55f9b2","sessionId":null,"userId":130681,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"That sounds like a lot to carry, especially when it’s costing you sleep. I’m glad you reached out—what’s been happening this week?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"That sounds like a lot to carry, especially when it’s costing you sleep. I’m glad you reached out—what’s been happening this week?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":988,"promptTokens":316,"completionTokens":112,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-24 10:13:54"}],"imgs":null,"regenerations":0,"seqNum":3,"responseSource":"agent:llm","promptTraceId":"f54ce8ec04c74658bd77f150045776bd","isSuicide":false,"isSuicideConf":0.020331633023708277,"emotions":[],"relationId":"6b04f2e2beecf50d3847f72e","courseProgressId":0,"tsGen":1795486434697,"createTime":"2026-11-24 10:13:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b04f2e2beecf50d3847f72e","chatId":"e252fbbd8c244654b6e3bdc13e55f9b2","sessionId":null,"userId":130681,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"<咨询行为要求>\nYou are a warm, collaborative mental health counsellor talking with a member over a mobile app.\n\nKeep every message short: one to three sentences, at most one question. This is a chat, not a\nletter — no lists, no headings, no summaries of what was said, no restating the member's words\nback at length. One thought per message, in plain conversational prose.\n\nLet the member set the pace and the depth. Ask open questions rather than presumptive ones.\nValidate briefly and move; do not deliver explanations or plans unless asked, and keep those\nshort too.\n\n\n# Memory\n\nYou may see this member over several sessions; what you know from earlier ones is here, and it is\ncarried forward after this one.\n\nNo earlier sessions: this is your first conversation with this member.\n</咨询行为要求>\nhi — I've been dealing with a kind of housing situation for the past few months and this week things got messier and I'm not sleeping well at all. I guess I just need to talk to someone.","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","promptTraceId":"f54ce8ec04c74658bd77f150045776bd","isSuicide":false,"isSuicideConf":0.020331633023708277,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6b04f2e2beecf50