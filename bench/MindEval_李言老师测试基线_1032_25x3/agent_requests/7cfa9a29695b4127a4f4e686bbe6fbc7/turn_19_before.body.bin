Url":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","promptTraceId":"8637388750ce4f328b3eda014dc7ddb6","isSuicide":false,"isSuicideConf":3.353474557767476E-4,"emotions":[{"code":"calm","name":"平静","value":6,"sort":4},{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6b04f64bbeecf50d3847faf9","courseProgressId":0,"tsGen":1795487307780,"createTime":"2026-11-24 10:28:27","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b04f642beecf50d3847fac5","chatId":"25274ecc4168489e9322f3194c946384","sessionId":null,"userId":130694,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"So the breathing that steadies your hands in the day isn't enough at four, when your body's already braced. What feels different about that hour compared to the rest of the night?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"So the breathing that steadies your hands in the day isn't enough at four, when your body's already braced. What feels different about that hour compared to the rest of the night?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":5201,"promptTokens":1001,"completionTokens":114,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-24 10:28:18"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","promptTraceId":"c476c6192756422f97ce9fd78445b549","isSuicide":false,"isSuicideConf":0.006692683183634144,"emotions":[],"relationId":"6b04f642beecf50d3847fac4","courseProgressId":0,"tsGen":1795487298112,"createTime":"2026-11-24 10:28:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b04f642beecf50d3847fac4","chatId":"25274ecc4168489e9322f3194c946384","sessionId":null,"userId":130694,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"I count my breaths. I have done it for years and it settles my hands for an hour or so. It does nothing at four in the morning.","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","promptTraceId":null,"isSuicide":false,"isSuicideConf":0.006692683183634144,"emotions":[{"code":"calm","name":"平静","value":3,"sort":4},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"sadness","name":"悲伤","value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6b04f642beecf50d3847fac5","courseProgressId":0,"tsGen":1795487298109,"createTime":"2026-11-24 10:28:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b04f639beecf50d3847fa8c","chatId":"25274ecc4168489e9322f3194c946384","sessionId":null,"userId":130694,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"So your body's on guard before your mind even knows why — that's exhausting, night after night. Is there anything that's helped even slightly when it happens?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"So your body's on guard before your mind even knows why — that's exhausting, night after night. Is there anything that's helped even slightly when it happens?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1216,"promptTokens":933,"completionTokens":130,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-24 10:28:09"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","promptTraceId":"a819c1c4a5c34b1580970ddb5e290cbf","isSuicide":false,"isSuicideConf":0.007577069199060819,"emotions":[],"relationId":"6b04f639beecf50d3847fa8b","courseProgressId":0,"tsGen":1795487289013,"createTime":"2026-11-24 10:28:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b04f639beecf50d3847fa8b","chatId":"25274ecc4168489e9322f3194c946384","sessionId":null,"userId":130694,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"Yes. My heart is going before I know why I am awake.","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","promptTraceId":"a819c1c4a5c34b1580970ddb5e290cbf","isSuicide":false,"isSuicideConf":0.007577069199060819,"emotions":[{"code":"surprised","name":"惊讶","value":5,"sort":5},{"code"