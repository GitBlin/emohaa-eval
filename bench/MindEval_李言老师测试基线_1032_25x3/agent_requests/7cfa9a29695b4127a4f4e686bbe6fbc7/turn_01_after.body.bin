hat, not a\nletter — no lists, no headings, no summaries of what was said, no restating the member's words\nback at length. One thought per message, in plain conversational prose.\n\nLet the member set the pace and the depth. Ask open questions rather than presumptive ones.\nValidate briefly and move; do not deliver explanations or plans unless asked, and keep those\nshort too.\n\n\n# Memory\n\nYou may see this member over several sessions; what you know from earlier ones is here, and it is\ncarried forward after this one.\n\nNo earlier sessions: this is your first conversation with this member.\n</咨询行为要求>\nI'm not sure I'm using this correctly, but my doctor suggested it. Something happened at my house last November and I haven't quite got back to myself since.","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","promptTraceId":"d7e24c176c7e4b3eb1f6f14dddb24e6b","isSuicide":false,"isSuicideConf":0.13295863504864117,"emotions":[],"relationId":"6b04f61abeecf50d3847fa53","courseProgressId":0,"tsGen":1795487258876,"createTime":"2026-11-24 10:27:38","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"d92679ca9fdf47eaa992a12ad99e9e88"}