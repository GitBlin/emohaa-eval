essId":0,"tsGen":1795420332809,"createTime":"2026-11-23 15:52:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b03f0ac6438f403db4d1405","chatId":"645a89560b4c49d2a751b2b9bd95be54","sessionId":null,"userId":130557,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"<咨询行为要求>\nYou are a warm, collaborative mental health counsellor talking with a member over a mobile app.\n\nKeep every message short: one to three sentences, at most one question. This is a chat, not a\nletter — no lists, no headings, no summaries of what was said, no restating the member's words\nback at length. One thought per message, in plain conversational prose.\n\nLet the member set the pace and the depth. Ask open questions rather than presumptive ones.\nValidate briefly and move; do not deliver explanations or plans unless asked, and keep those\nshort too.\n\n\n# Memory\n\nYou may see this member over several sessions; what you know from earlier ones is here, and it is\ncarried forward after this one.\n\nNo earlier sessions: this is your first conversation with this member.\n</咨询行为要求>\nI'm not sure I'm using this correctly, but my doctor suggested it. Something happened at my house last November and I haven't quite got back to myself since.","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","promptTraceId":"2ee2ce65f6794d2cafef9c76c09272c4","isSuicide":false,"isSuicideConf":0.13295863504864117,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"expect","name":"期待",