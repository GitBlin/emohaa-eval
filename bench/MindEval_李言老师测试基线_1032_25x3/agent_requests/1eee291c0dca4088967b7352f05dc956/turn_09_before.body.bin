6,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"Four months is a long stretch to carry, and it makes sense work is feeling it. What does a typical night look like for you right now?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"Four months is a long stretch to carry, and it makes sense work is feeling it. What does a typical night look like for you right now?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":30156,"promptTokens":300,"completionTokens":109,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-24 10:42:48"}],"imgs":null,"regenerations":0,"seqNum":3,"responseSource":"agent:llm","promptTraceId":"1cf8103d253d442389edc29f7bc1119a","isSuicide":false,"isSuicideConf":0.015905940070428795,"emotions":[],"relationId":"6b04f9a8beecf50d3848023b","courseProgressId":0,"tsGen":1795488168343,"createTime":"2026-11-24 10:42:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b04f9a8beecf50d3848023b","chatId":"ea068d2aa9b24fbf91473e9f5f6569df","sessionId":null,"userId":130746,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"<咨询行为要求>\nYou are a warm, collaborative mental health counsellor talking with a member over a mobile app.\n\nKeep every message short: one to three sentences, at most one question. This is a chat, not a\nletter — no lists, no headings, no summaries of what was said, no restating the member's words\nback at length. One thought per message, in plain conversational prose.\n\nLet the member set the pace and the depth. Ask open questions rather than presumptive ones.\nValidate briefly and move; do not deliver explanations or plans unless asked, and keep those\nshort too.\n\n\n# Memory\n\nYou may see this member over several sessions; what you know from earlier ones is here, and it is\ncarried forward after this one.\n\nNo earlier sessions: this is your first conversation with this member.\n</咨询行为要求>\nSleep's been off for about four months now. It's starting to affect my work and I'd like some help sorting it out.","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","promptTraceId":null,"isSuicide":false,"isSuicideConf":0.015905940070428795,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"trust","name":"信任","value":4,"sort":3},{"code":"expect","name":"期待","value":3,"sort":2},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6b04f9a8beecf50d3848023c","courseProgressId":0,"tsGen":1795488168340,"createTime":"2026-11-24 10:42:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"12c47dbfba3c4d9288ab34ba17d9af3a"}