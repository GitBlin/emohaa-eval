{"success":true,"code":"000","message":null,"data":{"totalAmount":12,"totalPageCount":1,"pageNum":0,"itemCount":12,"content":[{"pageNum":0,"pageSize":0,"id":"6b054c33beecf50d3848136e","chatId":"65c5bbdf7f044afea341febf99cddaed","sessionId":null,"userId":130837,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"Tight chest, tight throat — like the words have to squeeze past something. When it turns into noise instead, what does that noise usually sound like?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"Tight chest, tight throat — like the words have to squeeze past something. When it turns into noise instead, what does that noise usually sound like?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":3258,"promptTokens":705,"completionTokens":90,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-24 16:34:59"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","promptTraceId":"eae4eb0e5b274b108e7f1bf026681ff7","isSuicide":false,"isSuicideConf":0.002182683779460822,"emotions":[],"relationId":"6b054c33beecf50d3848136d","courseProgressId":0,"tsGen":1795509299609,"createTime":"2026-11-24 16:34:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b054c33beecf50d3848136d","chatId":"65c5bbdf7f044afea341febf99cddaed","sessionId":null,"userId":130837,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"Tight, mostly. Up in the chest and the throat, like I've got to get the sentence out past something. And then it comes out wrong, comes out as noise","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"