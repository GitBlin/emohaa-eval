{"success":true,"code":"000","message":null,"data":{"totalAmount":30,"totalPageCount":1,"pageNum":0,"itemCount":30,"content":[{"pageNum":0,"pageSize":0,"id":"6b054c41beecf50d3848137f","chatId":"ab3dd92fd686434f8b341ee53e038925","sessionId":null,"userId":130830,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"Having your voice go in front of someone who's known you thirty years might feel like being seen in a way you've been avoiding. What do you imagine he'd do if he heard it break?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"Having your voice go in front of someone who's known you thirty years might feel like being seen in a way you've been avoiding. What do you imagine he'd do if he heard it break?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2312,"promptTokens":1452,"completionTokens":69,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-24 16:35:13"}],"imgs":null,"regenerations":0,"seqNum":31,"responseSource":"agent:llm","promptTraceId":"abcfb86fb66f464c81968d4bdf1d5d1e","isSuicide":false,"isSuicideConf":0.003172625474897799,"emotions":[],"relationId":"6b054c41beecf50d3848137e","courseProgressId":0,"tsGen":1795509313868,"createTime":"2026-11-24 16:35:13","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b054c41beecf50d3848137e","chatId":"ab3dd92fd686434f8b341ee53e038925","sessionId":null,"userId":130830,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"I would have to hear myself say it to someone who has known me thirty years. I am not sure I can get the words out without my voice going, and then he would hear that too.","options":null,"imageContent":null,"audi