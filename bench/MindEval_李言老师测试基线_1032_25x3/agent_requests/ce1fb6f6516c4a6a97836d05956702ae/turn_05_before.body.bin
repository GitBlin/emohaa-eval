{"success":true,"code":"000","message":null,"data":{"totalAmount":8,"totalPageCount":1,"pageNum":0,"itemCount":8,"content":[{"pageNum":0,"pageSize":0,"id":"6b054bc5beecf50d38481295","chatId":"ab3dd92fd686434f8b341ee53e038925","sessionId":null,"userId":130830,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"That third check sounds like the point where sleep starts to slip away. What's going through your mind when you get up that last time?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"That third check sounds like the point where sleep starts to slip away. What's going through your mind when you get up that last time?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":5853,"promptTokens":549,"completionTokens":78,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-24 16:33:09"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","promptTraceId":"a1d849aa86b74b72bb733410be558e47","isSuicide":false,"isSuicideConf":0.0019267126394425227,"emotions":[],"relationId":"6b054bc5beecf50d38481294","courseProgressId":0,"tsGen":1795509189008,"createTime":"2026-11-24 16:33:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b054bc5beecf50d38481294","chatId":"ab3dd92fd686434f8b341ee53e038925","sessionId":null,"userId":130830,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"I go and check the front door. Then I come back and count my breaths, and some nights I get back to sleep and some nights I do not. Lately there is a third check before I give up on it.","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","promptTraceId":"a1d849aa86b74b72bb733410be558e47","isSuicide":false,"isSuicideConf":0.0019267126394425227,"emotions":[{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6b054bc5beecf50d38481295","courseProgressId":0,"tsGen":1795509189005,"createTime":"2026-11-24 16:33:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b054bb9beecf50d38481284","chatId":"ab3dd92fd686434f8b341ee53e038925","sessionId":null,"userId":130830,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"Four in the morning sounds like it comes with its own gravity — your body back in that chair before you're even awake. What do you usually do in those early hours?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"Four in the morning sounds like it comes with its own gravity — your body back in that chair before you're even awake. What do you usually do in those early hours?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":4310,"promptTokens":464,"completionTokens":79,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-24 16:32:57"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","promptTraceId":"4fe76d8e16c7421f9610f4dcca6c8062","isSuicide":false,"isSuicideConf":2.30504846596275E-4,"emotions":[],"relationId":"6b054bb9beecf50d38481283","courseProgressId":0,"tsGen":1795509177513,"createTime":"2026-11-24 16:32:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b054bb9beecf50d38481283","chatId":"ab3dd92fd686434f8b341ee53e038925","sessionId":null,"userId":130830,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"I wake at four most mornings and I am back in that chair. And a doorbell is a whole different thing now, it is not a doorbell anymore.","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":6,"responseSource":"agent:llm","promptTraceId":"4fe76d8e16c7421f9610f4dcca6c8062","isSuicide":false,"isSuicideConf":2.30504846596275E-4,"emotions":[{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"surprised","name":"惊讶","value":2,"sort":5},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6b054bb9beecf50d38481284","courseProgressId":0,"tsGen":1795509177511,"createTime":"2026-11-24 16:32:57","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b054baebeecf50d3848126b","chatId":"ab3dd92fd686434f8b341ee53e038925","sessionId":null,"userId":130830,"orgId":3721,"botI