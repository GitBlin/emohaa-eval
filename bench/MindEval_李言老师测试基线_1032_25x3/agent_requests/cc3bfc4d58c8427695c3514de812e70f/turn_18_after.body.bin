ll,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"\"After April\" — something changed then. Do you want to say what happened in April?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1861,"promptTokens":1583,"completionTokens":64,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-23 16:10:51"}],"imgs":null,"regenerations":0,"seqNum":29,"responseSource":"agent:llm","promptTraceId":"00ccab03b407429f8110c1f985bdaaea","isSuicide":false,"isSuicideConf":0.05340022140006478,"emotions":[],"relationId":"6b03f50b6438f403db4d188e","courseProgressId":0,"tsGen":1795421451529,"createTime":"2026-11-23 16:10:51","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b03f50b6438f403db4d188e","chatId":"d705939f227d47b8992c70b76eb80355","sessionId":null,"userId":130579,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"on hospice its mostly the families. you stand there holding somebodys hand while their daughter asks you if its close and you have to know how to say it. I used to be good at that part. after april I wasnt","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":28,"responseSource":"agent:llm","promptTraceId":null,"isSuicide":false,"isSuicideConf":0.05340022140006478,"emotions":[{"code":"sadness","name":"悲伤","value":8,"sort":8},{"code":"dislike","name":"厌恶","value":8,"sort":9},{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6b03f50b6438f403db4d188f","courseProgressId":0,"tsGen":1795421451526,"createTime":"2026-11-23 16:10:51","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b03f4fe6438f403db4d187e","chatId":"d705939f227d47b8992c70b76eb80355","sessionId":null,"userId":130579,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"That's a heavy thing to carry — the charting worry lands right on someone's mother. And you left hospice without telling anyone why. What made you step away from it?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"That's a heavy thing to carry — the charting worry lands right on someone's mother. And you left hospice without telling anyone why. What made you step away from it?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":3090,"promptTokens":1496,"completionTokens":83,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-23 16:10:38"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","promptTraceId":"1edac3710c0e4e8f8ea15188411410f5","isSuicide":false,"isSuicideConf":0.10668844027888373,"emotions":[],"relationId":"6b03f4fe6438f403db4d187d","courseProgressId":0,"tsGen":1795421438804,"createTime":"2026-11-23 16:10:38","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b03f4fe6438f403db4d187d","chatId":"d705939f227d47b8992c70b76eb80355","sessionId":null,"userId":130579,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"the charting. I did the bare minimum on three of them and told myself it counts. the school thing I can push to the back but if something goes wrong on my hall because I wrote it sloppy, thats someones mother\n\nI traded off hospice when I came back. I didnt tell anyone why, I just said I needed a change","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":26,"responseSource":"agent:llm","promptTraceId":"1edac3710c0e4e8f8ea15188411410f5","isSuicide":false,"isSuicideConf":0.10668844027888373,"emotions":[{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6b03f4fe6438f403db4d187e","courseProgressId":0,"tsGen":1795421438801,"createTime":"2026-11-23 16:10:38","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b03f4f36438f403db4d1868","chatId":"d705939f227d47b8992c70b76eb80355","sessionId":null,"userId":130579,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"So the three a.m. thing isn't only the school tab — it's charting, and a promise to the charge nurse. Which one is actually keeping you up?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"So the three a.m. thing isn't only the school tab — it's charting, and a promise to the charge nurse. Which one is actually keeping you up?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":4331,"promptTokens":1387,"completionTokens":148,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-23 16:10:27"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","promptTraceId":"ed134cdcbd8b44a39fb53446ea1c4129","isSuicide":false,"isSuicideConf":1.7952573427441784E-4,"emotions":[],"relationId":"6b03f4f36438f403db4d1867","courseProgressId":0,"tsGen":1795421427664,"createTime":"2026-11-23 16:10:27","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b03f4f36438f403db4d1867","chatId":"d705939f227d47b8992c70b76eb80355","sessionId":null,"userId":130579,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"at three im usually up anyway. I made sinigang sunday night at eleven, thats when it started, and then I couldnt sleep so I was on the floor with the laptop and it was the charting. I told the charge nurse id have it squared away by friday","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","promptTraceId":"ed134cdcbd8b44a39fb53446ea1c4129","isSuicide":false,"isSuicideConf":1.7952573427441784E-4,"emotions":[{"code":"calm","name":"平静","value":4,"sort":4},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"sadness","name":"悲伤","value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6b03f4f36438f403db4d1868","courseProgressId":0,"tsGen":1795421427661,"createTime":"2026-11-23 16:10:27","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b03f4e96438f403db4d1858","chatId":"d705939f227d47b8992c70b76eb80355","sessionId":null,"userId":130579,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"Three in the morning is when it gets loudest — the tab doesn't need the phone to be open. What does it say to you at that hour?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"Three in the morning is when it gets loudest — the tab doesn't need the phone to be open. What does it say to you at that hour?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":7740,"promptTokens":1293,"completionTokens":58,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-23 16:10:17"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","promptTraceId":"0648e223b67140d792b1408c34165294","isSuicide":false,"isSuicideConf":0.0031726211087219525,"emotions":[],"relationId":"6b03f4e96438f403db4d1857","courseProgressId":0,"tsGen":1795421417638,"createTime":"2026-11-23 16:10:17","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b03f4e96438f403db4d1857","chatId":"d705939f227d47b8992c70b76eb80355","sessionId":null,"userId":130579,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"like theres a tab thats always open in my head too. even when im not looking at it. I flip my phone over at dinner and its still there, just underneath, and then by three in the morning im thinking about it","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","promptTraceId":null,"isSuicide":false,"isSuicideConf":0.0031726211087219525,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6b03f4e96438f403db4d1858","courseProgressId":0,"tsGen":1795421417636,"createTime":"2026-11-23 16:10:17","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b03f4d76438f403db4d184f","chatId":"d705939f227d47b8992c70b76eb80355","sessionId":null,"userId":130579,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"Everybody nice, and then the form never sent — so in some way it's still open. What's it like having it sit unfinished like that?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"Everybody nice, and then the form never sent — so in some way it's still open. What's it like having it sit unfinished like that?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":3601,"promptTokens":1212,"completionTokens":73,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-23 16:09:59"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","promptTraceId":"7e56a6e5d34845b48a6210d1e86664b8","isSuicide":false,"isSuicideConf":0.09534626671673174,"emotions":[],"relationId":"6b03f4d76438f403db4d184e","courseProgressId":0,"tsGen":1795421399091,"createTime":"2026-11-23 16:09:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b03f4d76438f403db4d184e","chatId":"d705939f227d47b8992c70b76eb80355","sessionId":null,"userId":130579,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"it started in june. by then it was may and we were still doing the novena and I was cooking for fifty people every night. first class I sat in the parking lot and thought I cant do this now and I emailed the instructor the next morning. he was nice too. everybody was nice about it\n\nthen I never sent the withdrawal form. just stopped going","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","promptTraceId":"7e56a6e5d34845b48a6210d1e86664b8","isSuicide":false,"isSuicideConf":0.09534626671673174,"emotions":[{"code":"trust","name":"信任","value":5,"sort":3},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"happy","name":"快乐","value":2,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":1,"sort":7}],"relationId":"6b03f4d76438f403db4d184f","courseProgressId":0,"tsGen":1795421399087,"createTime":"2026-11-23 16:09:59","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["不安","自我怀疑","担忧","失落"],"originalText":["I don't know what to do with that, like I'm waiting for the other shoe to drop","like checking if im still me","I havent saved it or anything. I keep going back to it though, like I need the reminder","if I open it im going to want to sign up. and then im going to be the person who withdrew twice and everyone in the family knows it","then I never sent the withdrawal form. just stopped going"]},"conversation":{"type":"自我认知与成长","topic":"用户在自我反思中探讨自己反复放弃学业的行为模式，并面对是否重新开始的抉择与身份认同困惑。"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b03f4ce6438f403db4d1840","chatId":"d705939f227d47b8992c70b76eb80355","sessionId":null,"userId":130579,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"That first one wasn't a failure — Marisol got sick, and you made the only choice there was. Then this spring you went back and did it anyway. What happened with the summer one?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"That first one wasn't a failure — Marisol got sick, and you made the only choice there was. Then this spring you went back and did it anyway. What happened with the summer one?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":3977,"promptTokens":1093,"completionTokens":124,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-23 16:09:50"}],"imgs":null,"regenerations":0,"seqNum":19,"responseSource":"agent:llm","promptTraceId":"fab6d90b7e1c45379e9f34bb3ba4fc04","isSuicide":false,"isSuicideConf":7.09660774733633E-4,"emotions":[],"relationId":"6b03f4ce6438f403db4d183e","courseProgressId":0,"tsGen":1795421390310,"createTime":"2026-11-23 16:09:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b03f4ce6438f403db4d183e","chatId":"d705939f227d47b8992c70b76eb80355","sessionId":null,"userId":130579,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"the first one was years ago, before the kids were out of the house. I signed up for the prereqs and then Marisol got sick that spring and there was no version of that where I went to class on tuesday nights. I told the office lady I was withdrawing and she was so nice about it, thats the part I remember. she said well see you next time, and I said yes, and then it was years\n\nthen this spring I finally did it. paid the fees and everything. registered in april, the summer one","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":18,"responseSource":"agent:llm","promptTraceId":"fab6d90b7e1c45379e9f34bb3ba4fc04","isSuicide":false,"isSuicideConf":7.09660774733633E-4,"emotions":[{"code":"trust","name":"信任","value":6,"sort":3},{"code":"expect","name":"期待","value":5,"sort":2},{"code":"calm","name":"平静","value":5,"sort":4},{"code":"happy","name":"快乐","value":4,"sort":1},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6b03f4ce6438f403db4d1840","courseProgressId":0,"tsGen":1795421390307,"createTime":"2026-11-23 16:09:50","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["不安","自我怀疑","担忧","失落"],"originalText":["I don't know what to do with that, like I'm waiting for the other shoe to drop","like checking if im still me","I havent saved it or anything. I keep going back to it though, like I need the reminder","if I open it im going to want to sign up. and then im going to be the person who withdrew twice and everyone in the family knows it","then I never sent the withdrawal form. just stopped going"]},"conversation":{"type":"自我认知与成长","topic":"用户在自我反思中探讨自己反复放弃学业的行为模式，并面对是否重新开始的抉择与身份认同困惑。"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b03f4c26438f403db4d1826","chatId":"d705939f227d47b8992c70b76eb80355","sessionId":null,"userId":130579,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"So it's not the page itself — it's that wanting to sign up feels like setting up a third withdrawal. What happened the two times you withdrew?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"So it's not the page itself — it's that wanting to sign up feels like setting up a third withdrawal. What happened the two times you withdrew?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":3521,"promptTokens":948,"completionTokens":83,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-23 16:09:38"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","promptTraceId":"140350a4314a40d2b63130b52aa62158","isSuicide":false,"isSuicideConf":0.0011694918643147187,"emotions":[],"relationId":"6b03f4c26438f403db4d1825","courseProgressId":0,"tsGen":1795421378540,"createTime":"2026-11-23 16:09:38","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b03f4c26438f403db4d1825","chatId":"d705939f227d47b8992c70b76eb80355","sessionId":null,"userId":130579,"