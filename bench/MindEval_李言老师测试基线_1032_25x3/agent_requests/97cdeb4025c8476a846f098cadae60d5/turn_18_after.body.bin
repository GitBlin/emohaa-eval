age":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","promptTraceId":null,"isSuicide":false,"isSuicideConf":5.527721262506355E-4,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6b04fcddbeecf50d3848074e","courseProgressId":0,"tsGen":1795488989125,"createTime":"2026-11-24 10:56:29","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b04fcd5beecf50d38480746","chatId":"5719d9eba9b44612b3b6036a25ac8689","sessionId":null,"userId":130763,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"Dressed and ready at two in the morning — that's the same reflex as finding something to do before anyone notices. What would it be like to just sit here in the work clothes for a minute?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"Dressed and ready at two in the morning — that's the same reflex as finding something to do before anyone notices. What would it be like to just sit here in the work clothes for a minute?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":4496,"promptTokens":1273,"completionTokens":126,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-24 10:56:21"}],"imgs":null,"regenerations":0,"seqNum