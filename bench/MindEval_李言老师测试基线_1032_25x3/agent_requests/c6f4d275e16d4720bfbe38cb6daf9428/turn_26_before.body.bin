hielding her from the truth. It’s also been shielding you from being seen not having it together. Three weeks is a long time to maintain that by yourself.\n\nWhat’s the dorm story costing you the most right now — the lying, or the fact that it means she can’t actually help?","options":null,"isShow":true,"label":"","evaluate":"","takingTime":4194,"promptTokens":1491,"completionTokens":321,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-24 10:19:24"}],"imgs":null,"regenerations":0,"seqNum":39,"responseSource":"agent:llm","promptTraceId":"f99d6c1afb344722873b155efc97604a","isSuicide":false,"isSuicideConf":3.799759575636817E-4,"emotions":[],"relationId":"6b04f42cbeecf50d3847f886","courseProgressId":0,"tsGen":1795486764891,"createTime":"2026-11-24 10:19:24","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b04f42cbeecf50d3847f886","chatId":"76ef734bb8a848eeb92ace8cee951874","sessionId":null,"userId":130685,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"she hasnt seen me in like three weeks. shes not giving me approval for anything, she thinks im in a dorm","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":38,"responseSource":"agent:llm","promptTraceId":"f99d6c1afb344722873b155efc97604a","isSuicide":false,"isSuicideConf":3.799759575636817E-4,"emotions":[{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"