r","content":"People have their own lives, it's a book club not a wedding. I doubt it's keeping anyone up at night except me","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","promptTraceId":null,"isSuicide":false,"isSuicideConf":1.0889540999070459E-4,"emotions":[{"code":"calm","name":"平静","value":4,"sort":4},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"anger","name":"愤怒","value":3,"sort":7},{"code":"fear","name":"恐惧","value":2,"sort":6},{"code":"sadness","name":"悲伤","value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6b04f47fbeecf50d3847f8d0","courseProgressId":0,"tsGen":1795486847522,"createTime":"2026-11-24 10:20:47","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6b04f47cbeecf50d3847f8cb","chatId":"20ce6cfd8b114007bdfdf3fbbfa9b954","sessionId":null,"userId":130687,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"Polite can sting more than annoyed—it leaves you feeling like you're the one who keeps letting people down. What do you imagine they're thinking when you cancel?","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"Polite can sting more than annoyed—it leaves you feeling like you're the one who keeps letting people down. What do you imagine they're thinking when you cancel?","options":null,"isShow":true,"label":"","e