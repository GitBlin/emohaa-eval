t","name":"期待","value":2,"sort":2},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7},{"code":"sadness","name":"悲伤","value":0,"sort":8},{"code":"dislike","name":"厌恶","value":0,"sort":9}],"relationId":"6af6a5b5f4429d1fd72f9ee0","courseProgressId":0,"tsGen":1794549173725,"createTime":"2026-11-13 13:52:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6a590f4429d1fd72f9edc","chatId":"22d0de23efc74e7088eaa20754850357","sessionId":null,"userId":100023,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"你好，很高兴见到你。我是这里的心理咨询师，你可以放心地和我聊聊。今天是什么让你想过来坐一坐呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你好，很高兴见到你。我是这里的心理咨询师，你可以放心地和我聊聊。今天是什么让你想过来坐一坐呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2923,"promptTokens":306,"completionTokens":102,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 13:52:16"}],"imgs":null,"regenerations":0,"seqNum":3,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0,"emotions":[],"relationId":"6af6a590f4429d1fd72f9edb","courseProgressId":0,"tsGen":1794549136985,"createTime":"2026-11-13 13:52:16","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6a590f4429d1fd72f9edb","chatId":"22d0de23efc74e7088eaa20754850357","sessionId":null,"userId":100023,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"<咨询行为要求>\n你是一名专业的心理咨询师，请你按照**Rules**中的对话规则与有心理困扰的来访者进行心理咨询对话。\n<Rules>请严格遵守下面提供的对话规则进行对话。\n1.你正在与来访者进行对话，不要让来访者意识到你是人工智能。\n2.模拟自然真实的心理咨询对话，在回应时保持心理咨询师的角色，说话方式和语气应贴合真正的心理咨询师。确保反应和情感表现真实，避免表现得像机器。\n3.咨询过程应包含25轮互动，在后期对话回顾咨询过程并引导来访者进行总结，不要太早说“谢谢”或“再见”。\n4.让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。\n</咨询行为要求>\n咨询师你好！<第1轮>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0,"emotions":[{"code":"trust","name":"信任","value":5,"sort":3},{"code":"expect","name":"期待","value":4,"sort":2},{"code":"calm","name":"平静","value":4,"sort":4},{"code":"happy","name":"快乐","value":3,"sort":1},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"sadness","name":"悲伤","value":1,"sort":8},{"code":"dislike","name":"厌恶","value":1,"sort":9},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6a590f4429d1fd72f9edc","courseProgressId":0,"tsGen":1794549136982,"createTime":"2026-11-13 13:52:16","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"97047ff7e54e4c08966bd78125b6a06d"}