179,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:47:18"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01590044299349486,"emotions":[],"relationId":"6af68846f4429d1fd72f8845","courseProgressId":0,"tsGen":1794541638010,"createTime":"2026-11-13 11:47:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68846f4429d1fd72f8845","chatId":"2d2add166552469a8e36d543992eea8a","sessionId":null,"userId":99924,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"有人帮忙……我老公下班会抱一会儿，但我总觉得不好意思开口，好像我不该这么没用。你说这不是我做错什么，可我有时候真的会想，是不是我太矫情了？<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01590044299349486,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af68846f4429d1fd72f8846","courseProgressId":0,"tsGen":1794541638007,"createTime":"2026-11-13 11:47:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6883cf4429d1fd72f883f","chatId":"2d2add166552469a8e36d543992eea8a","sessionId":null,"user