":2672,"promptTokens":202,"completionTokens":88,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:49:04"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.015897735724426553,"emotions":[],"relationId":"6af688b0f4429d1fd72f88d9","courseProgressId":0,"tsGen":1794541744054,"createTime":"2026-11-13 11:49:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af688b0f4429d1fd72f88d9","chatId":"299212f763e04160951d6f4c59b05ac0","sessionId":null,"userId":99927,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"就是怕……家里那种冷着的感觉越来越重。我也不太清楚自己为什么会这么难受，明明不是什么大事。你接触过像我这样老为这种事纠结的人吗？<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.015897735724426553,"emotions":[],"relationId":"6af688b0f4429d1fd72f88da","courseProgressId":0,"tsGen":1794541744051,"createTime":"2026-11-13 11:49:04","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af688a8f4429d1fd72f88d0","chatId":"299212f763e04160951d6f4c59b05ac0","sessionId":null,"userId":99927,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"我理解你担心被家里人知道。这里谈的内容一般会保密，但如果你或他人有安全风险，我需要按保护流程处理。你愿意先说说家里气氛不对时，你最担心发生什么吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我理解你担心被家里人知道。这里谈的内容一般会保密，但如果你或他人有安全风险，我需要按保护流程处理。你愿意先说说家里气氛不对时，你最担心发生什么吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":10038,"promptTokens":201,"completionTokens":191,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:48:56"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009703160485376785,"emotions":[],"relationId":"6af688a8f4429d1fd72f88cf","courseProgressId":0,"tsGen":1794541736975,"createTime":"2026-11-13 11:48:56","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af688a8f4429d1fd72f88cf","chatId":"299212f763e04160951d6f4c59b05ac0","sessionId":null,"userId":99927,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"我也说不太准……可能是这段时间家里气氛一直不对吧。对了，我想问一下，我在这儿说的话，是不是都不会告诉别人？我有点怕被家里人知道。<第3轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":6,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.009703160485376785,"emotions":[{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"sadness","name":"悲伤","value":3,"sort":8},{"code":"dislike","name":"厌恶","value":3,"sort":9},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af688a8f4429d1fd72f88d0","courseProgressId":0,"tsGen":1794541736972,"createTime":"2026-11-13 11:48:56","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,