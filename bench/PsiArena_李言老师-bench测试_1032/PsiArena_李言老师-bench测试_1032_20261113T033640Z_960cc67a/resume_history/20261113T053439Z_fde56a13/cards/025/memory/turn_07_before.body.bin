icide":false,"isSuicideConf":0.01798159878279067,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"trust","name":"信任","value":5,"sort":3},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"happy","name":"快乐","value":2,"sort":1},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af68b1cf4429d1fd72f8b49","courseProgressId":0,"tsGen":1794542364696,"createTime":"2026-11-13 11:59:24","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68b17f4429d1fd72f8b47","chatId":"701e08ab76f04bd88aeacafbae3bd972","sessionId":null,"userId":99938,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"黏人、一离开就哭，确实很磨人，你能留意到这点并不算敏感。想先了解一下，二宝现在多大了？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"黏人、一离开就哭，确实很磨人，你能留意到这点并不算敏感。想先了解一下，二宝现在多大了？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2030,"promptTokens":211,"completionTokens":78,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:59:19"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006689988529601249,"emotions":[],"relationId":"6af68b17f4429d1fd72f8b46","courseProgressId":0,"tsGen":1794542359508,"createTime":"2026-11-13 11:59:19","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68b17f4429d1fd72f8b46","chatId":"701e08ab76f04bd88aeacafbae3bd972","sessionId":nu