{"success":true,"code":"000","message":null,"data":{"totalAmount":6,"totalPageCount":1,"pageNum":0,"itemCount":6,"content":[{"pageNum":0,"pageSize":0,"id":"6af68eb5f4429d1fd72f8f45","chatId":"eb1896bf095c402f8cf6b86188d77814","sessionId":null,"userId":99958,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"这种空落落、提不起劲的感觉确实让人难受，先不用急着弄清楚原因。它大概持续多久了？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"这种空落落、提不起劲的感觉确实让人难受，先不用急着弄清楚原因。它大概持续多久了？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2600,"promptTokens":193,"completionTokens":180,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 12:14:45"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575596741976207,"emotions":[],"relationId":"6af68eb5f4429d1fd72f8f44","courseProgressId":0,"tsGen":1794543285945,"createTime":"2026-11-13 12:14:45","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68eb5f4429d1fd72f8f44","chatId":"eb1896bf095c402f8cf6b86188d77814","sessionId":null,"userId":99958,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"嗯……说实话我也说不太清楚。就是最近总觉得心里空落落的，做什么都没劲，可又讲不明白到底怎么回事。<第3轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":6,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575596741976207,"emotions":[],"relationId":"6af68eb5f4429d1fd72f8f45","courseProgressId":0,"tsGen":17945432