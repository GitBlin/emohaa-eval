d22a","sessionId":null,"userId":99928,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"我……其实也不是什么特别的话。我就是想让他知道，我不是在跟他吵，我是害怕。他越不说话，我就越慌，越慌就越想抓住点什么。<第10轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":20,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007576047910960793,"emotions":[{"code":"fear","name":"恐惧","value":8,"sort":6},{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af688d3f4429d1fd72f890b","courseProgressId":0,"tsGen":1794541779445,"createTime":"2026-11-13 11:49:39","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["担忧不安","难受失落","疲惫无力","害怕慌乱","自我怀疑","委屈卑微"],"originalText":["我就是有点担心被评判。","就是有时候觉得特别难受，可又讲不明白到底为什么。","家里特别安静，我一下子就觉得心里空落落的。","就是觉得特别累，累到不想再解释了。","他越不说话，我就越慌，越慌就越想抓住点什么。","可我又不知道，是不是真的都是我的问题。","说出来好像很卑微。","没回应的时候我会想很多，越想越觉得自己像在唱独角戏。"]},"conversation":{"type":"人际关系处理","topic":"婚姻关系中的沟通困扰与情绪压力，包括害怕伴侣沉默无回应、自我怀疑，以及原生家庭争吵模式对当前关系的影响。"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af688ccf4429d1fd72f8901","chatId":"3c7244e5329042869a825e0d2241d22a","sessionId":null,"userId":99928,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"吵架后反复回想，很容易把责任都揽到自己身上。敏感不一定是错，也许只是你更在意这段关系。你愿意说说，当时你最希望他能听懂你哪句话吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":