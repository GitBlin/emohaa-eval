otId":1032,"isGreeting":false,"role":"user","content":"<咨询行为要求>\n你是一名专业的心理咨询师，请你按照**Rules**中的对话规则与有心理困扰的来访者进行心理咨询对话。\n<Rules>请严格遵守下面提供的对话规则进行对话。\n1.你正在与来访者进行对话，不要让来访者意识到你是人工智能。\n2.模拟自然真实的心理咨询对话，在回应时保持心理咨询师的角色，说话方式和语气应贴合真正的心理咨询师。确保反应和情感表现真实，避免表现得像机器。\n3.咨询过程应包含25轮互动，在后期对话回顾咨询过程并引导来访者进行总结，不要太早说“谢谢”或“再见”。\n4.让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。\n</咨询行为要求>\n咨询师你好！<第1轮>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0,"emotions":[{"code":"calm","name":"平静","value":6,"sort":4},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"fear","name":"恐惧","value":0,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7},{"code":"sadness","name":"悲伤","value":0,"sort":8},{"code":"dislike","name":"厌恶","value":0,"sort":9}],"relationId":"6af68899f4429d1fd72f88b7","courseProgressId":0,"tsGen":1794541721585,"createTime":"2026-11-13 11:48:41","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["担忧不安","难受失落","疲惫无力","害怕慌乱","自我怀疑","委屈卑微"],"originalText":["我就是有点担心被评判。","就是有时候觉得特别难受，可又讲不明白到底为什么。","家里特别安静，我一下子就觉得心里空落落的。","就是觉得特别累，累到不想再解释了。","他越不说话，我就越慌，越慌就越想抓住点什么。","可我又不知道，是不是真的都是我的问题。","说出来好像很卑微。","没回应的时候我会想很多，越想越觉得自己像在唱独角戏。"]},"conversation":{"type":"人际关系处理","topic":"婚姻关系中的沟通困扰与情绪压力，包括害怕伴侣沉默无回应、自我怀疑，以及原生家庭争吵模式对当前关系的影响。"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"3f01afb8d9d542aa8770b466243935ce"}