{"success":true,"code":"000","message":null,"data":{"totalAmount":26,"totalPageCount":1,"pageNum":0,"itemCount":26,"content":[{"pageNum":0,"pageSize":0,"id":"6af6a3b4f4429d1fd72f9e0e","chatId":"a06cc8d68eeb4150a6ee27b0396aee2f","sessionId":null,"userId":100019,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"你夹在妈妈的期待和自己的感受之间，确实很累。那种“让所有人满意”的念头，常常最先压垮的是自己。如果暂时把妈妈的看法放一边，你心里真正想要的家庭生活是什么样子？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"你夹在妈妈的期待和自己的感受之间，确实很累。那种“让所有人满意”的念头，常常最先压垮的是自己。如果暂时把妈妈的看法放一边，你心里真正想要的家庭生活是什么样子？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1775,"promptTokens":206,"completionTokens":111,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 13:44:20"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575415574818352,"emotions":[],"relationId":"6af6a3b4f4429d1fd72f9e0d","courseProgressId":0,"tsGen":1794548660818,"createTime":"2026-11-13 13:44:20","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6a3b4f4429d1fd72f9e0d","chatId":"a06cc8d68eeb4150a6ee27b0396aee2f","sessionId":null,"userId":100019,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"最怕……让我妈失望吧。她那一辈子都觉得家庭完整才算过得好。可我又觉得，我好像也在让她失望，也在让公婆失望，最后连自己都失望。<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":26,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00857541557