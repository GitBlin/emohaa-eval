tomMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来你难受的不只是检查结果，还有那种“不能辜负他家里”的压力；丈夫不怪你，反而让你把责任都揽到自己身上。这个“对不起他家里”的念头，最常在什么时候冒出来？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1830,"promptTokens":201,"completionTokens":159,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 13:43:53"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.04207651438207471,"emotions":[],"relationId":"6af6a399f4429d1fd72f9dff","courseProgressId":0,"tsGen":1794548633230,"createTime":"2026-11-13 13:43:53","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6a399f4429d1fd72f9dff","chatId":"a06cc8d68eeb4150a6ee27b0396aee2f","sessionId":null,"userId":100019,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"就是前阵子去医院做检查，结果出来以后，我一个人在走廊坐了很久。其实我丈夫也没怪我，可我反而更难受，好像对不起他家里似的。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.04207651438207471,"emotions":[{"code":"sadness","name":"悲伤","value":7,"sort":8},{"code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"trust","name":"信任","value":5,"sort":3},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1}],"relationId":"6af6a399f4429d1fd72f9e00","courseProgressId":0,"tsGen":1794548633227,"createTime