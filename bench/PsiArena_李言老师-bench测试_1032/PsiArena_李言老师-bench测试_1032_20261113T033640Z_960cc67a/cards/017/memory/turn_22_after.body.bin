nt:llm","isSuicide":false,"isSuicideConf":0.00970675131681506,"emotions":[],"relationId":"6af6a3d7f4429d1fd72f9e2e","courseProgressId":0,"tsGen":1794548695374,"createTime":"2026-11-13 13:44:55","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6a3d1f4429d1fd72f9e29","chatId":"a06cc8d68eeb4150a6ee27b0396aee2f","sessionId":null,"userId":100019,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"我听见了，你不是不想努力，是被“来不及”压得喘不过气，这份害怕很真实。我先不急着给办法。听你这么说，我也有点心疼，怕自己没接住你。你愿意说说，“来不及”最常在什么时候压过来吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我听见了，你不是不想努力，是被“来不及”压得喘不过气，这份害怕很真实。我先不急着给办法。听你这么说，我也有点心疼，怕自己没接住你。你愿意说说，“来不及”最常在什么时候压过来吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2870,"promptTokens":203,"completionTokens":337,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 13:44:49"}],"imgs":null,"regenerations":0,"seqNum":41,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004609311850482258,"emotions":[],"relationId":"6af6a3d1f4429d1fd72f9e28","courseProgressId":0,"tsGen":1794548689591,"createTime":"2026-11-13 13:44:49","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6a3d1f4429d1fd72f9e28","chatId":"a06cc8d68eeb4150a6ee27b0396aee2f","sessionId":null,"userId":100019,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"我希望他先听懂我害怕，不是急着给方案。我想跟他说，我不是不想努力，只是被“来不及”压得喘不过气，也希望他能说说他自己的感受。<第20轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"ch