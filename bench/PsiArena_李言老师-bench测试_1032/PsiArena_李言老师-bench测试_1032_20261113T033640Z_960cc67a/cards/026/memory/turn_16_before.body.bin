":6},{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"calm","name":"平静","value":0,"sort":4},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6a689f4429d1fd72f9f55","courseProgressId":0,"tsGen":1794549385278,"createTime":"2026-11-13 13:56:25","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6a683f4429d1fd72f9f51","chatId":"fab14654a9b04c7f94edc5d3a5de7ada","sessionId":null,"userId":100027,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"能感觉到你既后悔又着急，那句“又这样”一出口，关系就绷紧了。先不急着解决作业，我想知道：她回房后，你最担心她心里怎么想？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"能感觉到你既后悔又着急，那句“又这样”一出口，关系就绷紧了。先不急着解决作业，我想知道：她回房后，你最担心她心里怎么想？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":6353,"promptTokens":215,"completionTokens":201,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 13:56:19"}],"imgs":null,"regenerations":0,"seqNum":29,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0035920572160883916,"emotions":[],"relationId":"6af6a683f4429d1fd72f9f50","courseProgressId":0,"tsGen":1794549379119,"createTime":"2026-11-13 13:56:19","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6a683f4429d1fd72f9f50","chatId":"fab14654a9b04c7f94edc5d3a5de7ada","sessionId":null,"userId":100027,"orgId":3721,"botId":1032,"isGreeting":false,"