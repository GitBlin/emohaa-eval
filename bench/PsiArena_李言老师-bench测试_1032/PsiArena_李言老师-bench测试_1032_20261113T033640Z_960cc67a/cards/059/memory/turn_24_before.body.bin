:null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af691fef4429d1fd72f92f5","chatId":"43e62d6218cb4f74b50b896809d348ee","sessionId":null,"userId":99972,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"<咨询行为要求>\n你是一名专业的心理咨询师，请你按照**Rules**中的对话规则与有心理困扰的来访者进行心理咨询对话。\n<Rules>请严格遵守下面提供的对话规则进行对话。\n1.你正在与来访者进行对话，不要让来访者意识到你是人工智能。\n2.模拟自然真实的心理咨询对话，在回应时保持心理咨询师的角色，说话方式和语气应贴合真正的心理咨询师。确保反应和情感表现真实，避免表现得像机器。\n3.咨询过程应包含25轮互动，在后期对话回顾咨询过程并引导来访者进行总结，不要太早说“谢谢”或“再见”。\n4.让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。\n</咨询行为要求>\n咨询师你好！<第1轮>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0,"emotions":[{"code":"trust","name":"信任","value":7,"sort":3},{"code":"expect","name":"期待","value":6,"sort":2},{"code":"calm","name":"平静","value":6,"sort":4},{"code":"happy","name":"快乐","value":5,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"fear","name":"恐惧","value":0,"sort":6},{"code":"anger","name":"愤怒","value":0,"sort":7},{"code":"sadness","name":"悲伤","value":0,"sort":8},{"code":"dislike","name":"厌恶","value":0,"sort":9}],"relationId":"6af691fef4429d1fd72f92f6","courseProgressId":0,"tsGen":1794544126585,"createTime":"2026-11-13 12:28:46","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["焦虑","担忧","自我怀疑","委屈","不安","害怕被否定"],"originalText":["就是最近老觉得心里堵得慌，也说不上具体为什么。","心跳会快一点，手心也有点出汗。","我这样来咨询是不是有点浪费你时间？","当时就是觉得委屈，好像我这个人本身就有问题。","我每次听到都觉得自己好像哪里不合格。","应该是怕说错话吧……被拒绝还能接受，说错话就更像是我这个人不行。"]},"conversation":{"type":"焦虑和恐惧","topic":"来访者因社交发言、与女友沟通及家庭互动中的评价压力而产生紧张、担忧和自我怀疑，表现为心跳加快、手心出汗、反复揣测他人反应，并害怕说错话或被否定。"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"0600c1642f354f4bb79df78dd