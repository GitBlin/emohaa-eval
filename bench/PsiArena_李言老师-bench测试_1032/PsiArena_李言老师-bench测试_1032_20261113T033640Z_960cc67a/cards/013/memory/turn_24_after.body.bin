},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af68910f4429d1fd72f8953","courseProgressId":0,"tsGen":1794541840835,"createTime":"2026-11-13 11:50:40","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6890af4429d1fd72f894c","chatId":"502285dd18394277ac9abb42f25c01d9","sessionId":null,"userId":99926,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"听起来你心里有两股力量在拉扯：一边不想让爸妈失望，一边又不想一直替他们活。这种不甘心其实挺重要的。如果暂时把爸妈的期待放一边，你自己最想要的是什么样的关系？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来你心里有两股力量在拉扯：一边不想让爸妈失望，一边又不想一直替他们活。这种不甘心其实挺重要的。如果暂时把爸妈的期待放一边，你自己最想要的是什么样的关系？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2610,"promptTokens":200,"completionTokens":92,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:50:34"}],"imgs":null,"regenerations":0,"seqNum":35,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014058974319876712,"emotions":[],"relationId":"6af6890af4429d1fd72f894b","courseProgressId":0,"tsGen":1794541834035,"createTime":"2026-11-13 11:50:34","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6890af4429d1fd72f894b","chatId":"502285dd18394277ac9abb42f25c01d9","sessionId":null,"userId":99926,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"最怕让我爸妈失望吧……他们一直觉得我该选个安稳的人。可这么一想，我又觉得有点不甘心，好像我一直在替他们活。<第17轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":nu