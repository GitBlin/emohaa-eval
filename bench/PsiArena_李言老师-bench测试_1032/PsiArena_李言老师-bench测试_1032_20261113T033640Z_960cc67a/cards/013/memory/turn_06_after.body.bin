:null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014058361074724154,"emotions":[{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"expect","name":"期待","value":3,"sort":2},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"sadness","name":"悲伤","value":2,"sort":8},{"code":"dislike","name":"厌恶","value":2,"sort":9},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af68892f4429d1fd72f88ae","courseProgressId":0,"tsGen":1794541714422,"createTime":"2026-11-13 11:48:34","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6888af4429d1fd72f88a6","chatId":"502285dd18394277ac9abb42f25c01d9","sessionId":null,"userId":99926,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"睡不好、脑子乱，确实挺消耗人的，说不清也没关系，我们可以慢慢来。这种乱糟糟的感觉，是最近才出现，还是已经持续一段时间了？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"睡不好、脑子乱，确实挺消耗人的，说不清也没关系，我们可以慢慢来。这种乱糟糟的感觉，是最近才出现，还是已经持续一段时间了？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1937,"promptTokens":204,"completionTokens":96,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:48:26"}],"imgs":null,"regenerations":0,"seqNum":7,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608329815519952,"emotions":[],"relationId":"6af6888af4429d1fd72f88a5","courseProgressId":0,"tsGen":1794541706836,"createTime":"2026-11-13 11:48:26","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultan