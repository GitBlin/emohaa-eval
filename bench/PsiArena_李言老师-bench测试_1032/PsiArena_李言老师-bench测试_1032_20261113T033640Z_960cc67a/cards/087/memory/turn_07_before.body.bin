{"success":true,"code":"000","message":null,"data":{"totalAmount":12,"totalPageCount":1,"pageNum":0,"itemCount":12,"content":[{"pageNum":0,"pageSize":0,"id":"6af69869f4429d1fd72f9a06","chatId":"ff036d92507f4ecf88eac610ec12491e","sessionId":null,"userId":100000,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"我明白，私人的事不想讲就不讲，不用勉强。工作本身还行，说明至少有个稳定的支点。那最近这种不太好的状态，是更偏向心里累，还是身体上也跟着没劲？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"我明白，私人的事不想讲就不讲，不用勉强。工作本身还行，说明至少有个稳定的支点。那最近这种不太好的状态，是更偏向心里累，还是身体上也跟着没劲？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1218,"promptTokens":191,"completionTokens":98,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 12:56:09"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219542418774528,"emotions":[],"relationId":"6af69869f4429d1fd72f9a05","courseProgressId":0,"tsGen":1794545769468,"createTime":"2026-11-13 12:56:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af69869f4429d1fd72f9a05","chatId":"ff036d92507f4ecf88eac610ec12491e","sessionId":null,"userId":100000,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"好像都不是……工作本身还行吧，就是我自己状态不好。嗯，有些私人的事，我不太想讲。<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219542418774528,"emotions":[],"relationId":"6af698