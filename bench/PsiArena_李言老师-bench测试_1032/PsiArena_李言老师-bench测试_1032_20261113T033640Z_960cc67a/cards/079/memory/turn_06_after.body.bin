{"success":true,"code":"000","message":null,"data":{"totalAmount":12,"totalPageCount":1,"pageNum":0,"itemCount":12,"content":[{"pageNum":0,"pageSize":0,"id":"6af69693f4429d1fd72f9801","chatId":"42e4ad3d33d94c8ca3b7592f23995895","sessionId":null,"userId":99992,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"不会矫情，长期加班确实容易让人情绪疲惫，这很正常。你最近的工作强度是一直这么大，还是某个阶段特别忙？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不会矫情，长期加班确实容易让人情绪疲惫，这很正常。你最近的工作强度是一直这么大，还是某个阶段特别忙？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1674,"promptTokens":194,"completionTokens":122,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 12:48:19"}],"imgs":null,"regenerations":0,"seqNum":13,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218367922468565,"emotions":[],"relationId":"6af69693f4429d1fd72f9800","courseProgressId":0,"tsGen":1794545299468,"createTime":"2026-11-13 12:48:19","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af69693f4429d1fd72f9800","chatId":"42e4ad3d33d94c8ca3b7592f23995895","sessionId":null,"userId":99992,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"有段时间了……可能跟工作有关吧，最近老是加班。不过说真的，你会不会觉得我这样有点矫情？<第6轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":12,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218367922468565,"emotions":[],"relationId":"6af69693f4429d1fd72f9801","courseProgressId"