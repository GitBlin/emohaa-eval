ntent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不会。咨询更关心你此刻的疲惫和不安，不会用离婚或带孩子来评判你。半夜喂完奶那种没底的感觉，最近经常出现吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2321,"promptTokens":209,"completionTokens":171,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 12:32:39"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.017980980391010506,"emotions":[],"relationId":"6af692e7f4429d1fd72f9408","courseProgressId":0,"tsGen":1794544359914,"createTime":"2026-11-13 12:32:39","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af692e7f4429d1fd72f9408","chatId":"ff49b38656d649ae8ac33b0cd4032a2c","sessionId":null,"userId":99976,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"我不知道……可能都有吧。就是有时候半夜喂完奶，突然觉得特别没底。对了，你们做咨询的，会不会对我这种情况有什么看法？我是说……我离婚了，还带着孩子。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.017980980391010506,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort