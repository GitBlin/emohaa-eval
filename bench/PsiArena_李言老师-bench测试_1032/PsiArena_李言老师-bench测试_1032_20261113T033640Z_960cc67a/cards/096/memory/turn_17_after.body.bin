{"success":true,"code":"000","message":null,"data":{"totalAmount":34,"totalPageCount":1,"pageNum":0,"itemCount":34,"content":[{"pageNum":0,"pageSize":0,"id":"6af69ae0f4429d1fd72f9c7e","chatId":"ede81768db644bc69ff980feb213dffd","sessionId":null,"userId":100009,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"听起来你一边怕被追问，一边又已经累到觉得被说几句都无所谓了。那如果只选一个最让你撑不住的场景，是爸妈问你怎么了，还是老师同学那种眼神？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来你一边怕被追问，一边又已经累到觉得被说几句都无所谓了。那如果只选一个最让你撑不住的场景，是爸妈问你怎么了，还是老师同学那种眼神？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1390,"promptTokens":206,"completionTokens":126,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 13:06:40"}],"imgs":null,"regenerations":0,"seqNum":35,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010983878630916006,"emotions":[],"relationId":"6af69ae0f4429d1fd72f9c7d","courseProgressId":0,"tsGen":1794546400464,"createTime":"2026-11-13 13:06:40","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af69ae0f4429d1fd72f9c7d","chatId":"ede81768db644bc69ff980feb213dffd","sessionId":null,"userId":100009,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"怕我爸妈发现，然后问我怎么了，我又解释不清。也怕老师同学觉得我是不是出什么事了……其实有时候，我又觉得被说几句也无所谓了，就是太累了。<第17轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":34,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010983878630916006,"emotions":