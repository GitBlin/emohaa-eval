ource":"agent:llm","isSuicide":false,"isSuicideConf":0.029302689989284914,"emotions":[],"relationId":"6af69adbf4429d1fd72f9c75","courseProgressId":0,"tsGen":1794546395119,"createTime":"2026-11-13 13:06:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af69ad6f4429d1fd72f9c6d","chatId":"ede81768db644bc69ff980feb213dffd","sessionId":null,"userId":100009,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"听起来这种“分不清”本身也挺累的，好像情绪来了，却找不到一个明确的出口。那我们不急着分类，先看看它最常出现的时刻——你早上醒来觉得沉的时候，通常第一个冒出来的念头是什么？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来这种“分不清”本身也挺累的，好像情绪来了，却找不到一个明确的出口。那我们不急着分类，先看看它最常出现的时刻——你早上醒来觉得沉的时候，通常第一个冒出来的念头是什么？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1402,"promptTokens":199,"completionTokens":85,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 13:06:30"}],"imgs":null,"regenerations":0,"seqNum":31,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014060509273655066,"emotions":[],"relationId":"6af69ad6f4429d1fd72f9c6c","courseProgressId":0,"tsGen":1794546390958,"createTime":"2026-11-13 13:06:30","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af69ad6f4429d1fd72f9c6c","chatId":"ede81768db644bc69ff980feb213dffd","sessionId":null,"userId":100009,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"嗯……好像都有。有时候是想到考试、想到同学，有时候也没什么事，就是一起来就觉得沉。可能我憋太久了，自己也分不清了。<第15轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":30,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014060509273655066,"emotions":[],"relationId":"6af69ad6f4429d1fd72f9c6d","courseProgressId":0,"tsGen":1794546390955,"createTime":"2026-11-13 13:06:30","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af69ad2f4429d1fd72f9c66","chatId":"ede81768db644bc69ff980feb213dffd","sessionId":null,"userId":100009,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"听起来，每天早上那种沉重感已经让你连起床都很费力了。我想先了解一点：这种“被压住”的感觉，是想到学校里的某件具体事情时更明显，还是说不清来源、就是整个人沉下去？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来，每天早上那种沉重感已经让你连起床都很费力了。我想先了解一点：这种“被压住”的感觉，是想到学校里的某件具体事情时更明显，还是说不清来源、就是整个人沉下去？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2043,"promptTokens":194,"completionTokens":129,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 13:06:26"}],"imgs":null,"regenerations":0,"seqNum":29,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00970475798434389,"emotions":[],"relationId":"6af69ad2f4429d1fd72f9c65","courseProgressId":0,"tsGen":1794546386636,"createTime":"2026-11-13 13:06:26","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af69ad2f4429d1fd72f9c65","chatId":"ede81768db644bc69ff980feb213dffd","sessionId":null,"userId":100009,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"就是……每天早上醒来，一想到要去学校，就觉得整个人被压住了，不想动。有时候干脆就赖在床上，什么都不想管。<第14轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":28,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00970475798434389,"emotions":[],"relationId":"6af69ad2f4429d1fd72f9c66","courseProgressId":0,"tsGen":1794546386633,"createTime":"2026-11-13 13:06:26","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af69acef4429d1fd72f9c61","chatId":"ede81768db644bc69ff980feb213dffd","sessionId":null,"userId":100009,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"好，我不急着给建议，你先说。你愿意讲多少就讲多少，我在这儿听着。现在最堵得慌的是哪一件事？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"好，我不急着给建议，你先说。你愿意讲多少就讲多少，我在这儿听着。现在最堵得慌的是哪一件事？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":867,"promptTokens":193,"completionTokens":66,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 13:06:22"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007576621566689061,"emotions":[],"relationId":"6af69acef4429d1fd72f9c60","courseProgressId":0,"tsGen":1794546382633,"createTime":"2026-11-13 13:06:22","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af69acef4429d1fd72f9c60","chatId":"ede81768db644bc69ff980feb213dffd","sessionId":null,"userId":100009,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"就……先别急着说我该怎么做吧。听我说完就行。我有时候自己也知道该怎么办，就是心里堵得慌。<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":26,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007576621566689061,"emotions":[],"relationId":"6af69acef4429d1fd72f9c61","courseProgressId":0,"tsGen":1794546382630,"createTime":"2026-11-13 13:06:22","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af69acbf4429d1fd72f9c5d","chatId":"ede81768db644bc69ff980feb213dffd","sessionId":null,"userId":100009,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"听起来你其实想被听见，而不只是被评价。家里一聊就落到成绩排名，确实容易把话堵回去。那如果换成一个不会急着给建议的人，你最希望对方先怎么回应你？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来你其实想被听见，而不只是被评价。家里一聊就落到成绩排名，确实容易把话堵回去。那如果换成一个不会急着给建议的人，你最希望对方先怎么回应你？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2206,"promptTokens":194,"completionTokens":222,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 13:06:19"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00757632369919191,"emotions":[],"relationId":"6af69acbf4429d1fd72f9c5c","courseProgressId":0,"tsGen":1794546379714,"createTime":"2026-11-13 13:06:19","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af69acbf4429d1fd72f9c5c","chatId":"ede81768db644bc69ff980feb213dffd","sessionId":null,"userId":