":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af696e5f4429d1fd72f9861","courseProgressId":0,"tsGen":1794545381401,"createTime":"2026-11-13 12:49:41","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["担忧","焦虑","羞耻","矛盾","不安","自我怀疑","疲惫"],"originalText":["我最近确实有些事，心里挺乱的","我光想想就烦","碰到这类话题我就觉得羞耻，好像一提就是我不正经","我是有点慌，不是嫌弃她","我总觉得一个男的，连这种事都处理不了，挺没用的","但现在又觉得这样挺累的"]},"conversation":{"type":"人际关系处理","topic":"夫妻间因一方隐瞒看小说而引发的沟通困扰、表达焦虑与信任担忧"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af696dcf4429d1fd72f9853","chatId":"2797cfe600b64ab3b448f88acfe89202","sessionId":null,"userId":99993,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"比起小说内容，你更难受的是她没敢跟你说。那如果她当时说了，你最希望听到她怎么开口？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"比起小说内容，你更难受的是她没敢跟你说。那如果她当时说了，你最希望听到她怎么开口？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2177,"promptTokens":214,"completionTokens":117,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 12:49:32"}],"imgs":null,"regenerations":0,"seqNum":25,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218677698502132,"emotions":[],"relationId":"6af696dcf4429d1fd72f9852","courseProgressId":0,"tsGen":1794545372177,"createTime":"2026-11-13 12:49:32","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af696dcf4429d1fd72f9852","chatId":"2797cfe600b64ab3b448f88acfe89202","sessionId":null,"userId":99993,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"嗯……可能我更在意她瞒着我。因为这会让我忍不住想，是不是她觉得跟我说了我会看不起她，或者……是不是我平时让她觉得没法开口。但那小说本身，我也不是完全不在意，我心里过不去那道坎。<第12轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218677698502132,"emotions":[{"code":"fear","name":"恐惧","value":4,"sort":6},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"anger","name":"愤怒","value":3,"sort":7},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"surprised","name":"惊讶","value":1,"sort":5},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2}],"relationId":"6af696dcf4429d1fd72f9853","courseProgressId":0,"tsGen":1794545372174,"createTime":"2026-11-13 12:49:32","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["担忧","焦虑","羞耻","矛盾","不安","自我怀疑","疲惫"],"originalText":["我最近确实有些事，心里挺乱的","我光想想就烦","碰到这类话题我就觉得羞耻，好像一提就是我不正经","我是有点慌，不是嫌弃她","我总觉得一个男的，连这种事都处理不了，挺没用的","但现在又觉得这样挺累的"]},"conversation":{"type":"人际关系处理","topic":"夫妻间因一方隐瞒看小说而引发的沟通困扰、表达焦虑与信任担忧"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af696d7f4429d1fd72f984b","chatId":"2797cfe600b64ab3b448f88acfe89202","sessionId":null,"userId":99993,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"能感觉到你卡在两难里，既怕伤她，也怕被追问。先别急着下结论，或许只挑一个最在意的点去谈。你更想先弄清楚的是：她为什么选择瞒着你，还是那些小说本身对你的意义？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":n