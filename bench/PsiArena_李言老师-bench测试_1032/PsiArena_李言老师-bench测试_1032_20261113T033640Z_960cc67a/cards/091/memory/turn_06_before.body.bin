{"success":true,"code":"000","message":null,"data":{"totalAmount":10,"totalPageCount":1,"pageNum":0,"itemCount":10,"content":[{"pageNum":0,"pageSize":0,"id":"6af69946f4429d1fd72f9aef","chatId":"5275d19f261c4da78ce927ab539f6af8","sessionId":null,"userId":100004,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"听起来那种“没做什么却像做错了”的感觉，挺磨人的，也容易让人更累。这种空落落的感觉，通常是在什么时候最明显呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来那种“没做什么却像做错了”的感觉，挺磨人的，也容易让人更累。这种空落落的感觉，通常是在什么时候最明显呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1872,"promptTokens":195,"completionTokens":87,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 12:59:50"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007573440548896527,"emotions":[],"relationId":"6af69946f4429d1fd72f9aee","courseProgressId":0,"tsGen":1794545990811,"createTime":"2026-11-13 12:59:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af69946f4429d1fd72f9aee","chatId":"5275d19f261c4da78ce927ab539f6af8","sessionId":null,"userId":100004,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"最先冒出来的……好像是很累，然后有点空。（停顿）就是那种，明明没做什么，却觉得自己好像哪里做错了的感觉。<第5轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":10,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007573440548896527,"emotions":[],"relationId":"6af69946f4429d1fd72f9aef","courseProgressId":0,"tsGen":1794545990808,"createTime":"2026-11-13 12:59:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af69942f4429d1fd72f9aed","chatId":"5275d19f261c4da78ce927ab539f6af8","sessionId":null,"userId":100004,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"听起来那种难受会持续很久，你会怀疑自己是不是太敏感，这本身就很消耗。敏感不等于夸张，可能只是你的身体和情绪对这件事反应更强。最近一次让你好几天缓不过来时，最先冒出来的是什么感觉？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来那种难受会持续很久，你会怀疑自己是不是太敏感，这本身就很消耗。敏感不等于夸张，可能只是你的身体和情绪对这件事反应更强。最近一次让你好几天缓不过来时，最先冒出来的是什么感觉？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2188,"promptTokens":197,"completionTokens":177,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 12:59:46"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02594152087719788,"emotions":[],"relationId":"6af69942f4429d1fd72f9aec","courseProgressId":0,"tsGen":1794545986192,"createTime":"2026-11-13 12:59:46","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af69942f4429d1fd72f9aec","chatId":"5275d19f261c4da78ce927ab539f6af8","sessionId":null,"userId":100004,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"有时候一晚上，有时候好几天都缓不过来……（犹豫）其实我也在想，是不是我太敏感了，别人好像都没我这么夸张。<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations