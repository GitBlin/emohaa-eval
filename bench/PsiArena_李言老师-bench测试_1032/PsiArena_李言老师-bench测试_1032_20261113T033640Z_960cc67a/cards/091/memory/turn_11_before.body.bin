m","isSuicide":false,"isSuicideConf":0.006690829775166151,"emotions":[{"code":"fear","name":"恐惧","value":7,"sort":6},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"calm","name":"平静","value":3,"sort":4},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af69960f4429d1fd72f9b00","courseProgressId":0,"tsGen":1794546016014,"createTime":"2026-11-13 13:00:16","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6995af4429d1fd72f9af9","chatId":"5275d19f261c4da78ce927ab539f6af8","sessionId":null,"userId":100004,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"能感觉到你开口前会反复掂量，这份小心挺累人的。其实想问就问，并不会轻易打扰到谁。你愿意说说，最近一次让你犹豫要不要开口的是什么事吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"能感觉到你开口前会反复掂量，这份小心挺累人的。其实想问就问，并不会轻易打扰到谁。你愿意说说，最近一次让你犹豫要不要开口的是什么事吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2135,"promptTokens":196,"completionTokens":142,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 13:00:10"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0040698721537501354,"emotions":[],"relationId":"6af6995af4429d1fd72f9af8","courseProgressId":0,"tsGen":1794546010967,"createTime":"2026-11-13 13:00:10","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6995af4429d1fd72f9af8"