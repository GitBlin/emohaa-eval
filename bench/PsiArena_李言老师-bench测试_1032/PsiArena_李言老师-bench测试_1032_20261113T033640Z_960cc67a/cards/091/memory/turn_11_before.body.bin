:7},{"code":"sadness","name":"悲伤","value":0,"sort":8},{"code":"dislike","name":"厌恶","value":0,"sort":9}],"relationId":"6af6994cf4429d1fd72f9af5","courseProgressId":0,"tsGen":1794545996225,"createTime":"2026-11-13 12:59:56","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["疲惫","空虚","自我怀疑","敏感","不安"],"originalText":["就是最近老觉得累，尤其是跟人打交道之后。工作的时候还好，一停下来反而更难受。","有时候一晚上，有时候好几天都缓不过来……其实我也在想，是不是我太敏感了，别人好像都没我这么夸张。","最先冒出来的……好像是很累，然后有点空。就是那种，明明没做什么，却觉得自己好像哪里做错了的感觉。","可能是……跟同事聚完回家的时候吧。对了，我想问一下，我们聊的这些，你会跟别人说吗？或者，平时我能私下联系你吗？"]},"conversation":{"type":"情绪调节","topic":"来访者诉说社交后持续疲惫、空虚和自我怀疑，并询问咨询保密与私下联系边界。"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af69946f4429d1fd72f9aef","chatId":"5275d19f261c4da78ce927ab539f6af8","sessionId":null,"userId":100004,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"听起来那种“没做什么却像做错了”的感觉，挺磨人的，也容易让人更累。这种空落落的感觉，通常是在什么时候最明显呢？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来那种“没做什么却像做错了”的感觉，挺磨人的，也容易让人更累。这种空落落的感觉，通常是在什么时候最明显呢？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1872,"promptTokens":195,"completionTokens":87,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 12:59:50"}],"imgs":null,"regenerations":0,"seqNum":11,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007573440548896527,"emotions":[],"relationId":"6af69946f4429d1fd72f9aee","courseProgressId":0,"tsGen":1794545990811,"createTime":"2026-11-13 12:59:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af69946f4429d1fd72f9aee","chatId":"5275d19f261c4da78ce927ab539f6af8","sessionId":null,"userId":1