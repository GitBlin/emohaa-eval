ull,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"晚上一个人还要被工作群追着，确实很难松下来。喝酒像是能暂时按掉那些声音，可第二天更难受，这种循环挺磨人的。你一般最难受的是晚上那阵烦躁，还是第二天醒来的后悔感？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1772,"promptTokens":203,"completionTokens":141,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 12:12:43"}],"imgs":null,"regenerations":0,"seqNum":15,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.020322091063456237,"emotions":[],"relationId":"6af68e3bf4429d1fd72f8eb2","courseProgressId":0,"tsGen":1794543163362,"createTime":"2026-11-13 12:12:43","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68e3bf4429d1fd72f8eb2","chatId":"021e527b55694a8389ada965a313644e","sessionId":null,"userId":99955,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"就是晚上一个人待着，手机还响个不停，工作群里一堆事……心里烦得慌。喝两口好像就能把那些声音关掉，可第二天又更难受。<第7轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":14,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.020322091063456237,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"anger","name":"愤怒","value":5,"sort":7},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relation