57496775006647,"emotions":[{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"anger","name":"愤怒","value":3,"sort":7},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"trust","name":"信任","value":0,"sort":3},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"fear","name":"恐惧","value":0,"sort":6}],"relationId":"6af6abd0f4429d1fd72fa206","courseProgressId":0,"tsGen":1794550736583,"createTime":"2026-11-13 14:18:56","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6abcbf4429d1fd72fa204","chatId":"4dea192842fa4a5a9e1942899a5dae44","sessionId":null,"userId":100037,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"听起来你烦的不只是东西多，更像在替别人兜底、又怕自己漏掉什么。眼霜找不到，可能也让这根弦一直绷着。那袋东西主要是谁的？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来你烦的不只是东西多，更像在替别人兜底、又怕自己漏掉什么。眼霜找不到，可能也让这根弦一直绷着。那袋东西主要是谁的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2459,"promptTokens":203,"completionTokens":179,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 14:18:51"}],"imgs":null,"regenerations":0,"seqNum":31,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012429618888758794,"emotions":[],"relationId":"6af6abcbf4429d1fd72fa203","courseProgressId":0,"tsGen":1794550731771,"createTime":"2026-11-13 14:18:51","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6abcbf4429d1fd72fa203","chatId":"4dea192842fa4a5a9e1942899a5dae44","sessionId":n