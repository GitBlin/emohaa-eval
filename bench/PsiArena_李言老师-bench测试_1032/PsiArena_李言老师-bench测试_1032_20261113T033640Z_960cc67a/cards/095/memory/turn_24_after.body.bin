sort":9},{"code":"expect","name":"期待","value":3,"sort":2},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":1,"sort":4},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"anger","name":"愤怒","value":1,"sort":7},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af6ac0ff4429d1fd72fa238","courseProgressId":0,"tsGen":1794550799778,"createTime":"2026-11-13 14:19:59","delFlag":0,"emotionTendency":{"emotion":{"type":"悲观","keywords":["空虚","失落","被落下感","自我怀疑","委屈","压抑","迷茫"],"originalText":["就是总觉得有点闷，工作也能做，但心里空空的。","看到别人发的东西，就……唉，说不上来。","可能……是被落下的感觉更多一点吧。","我有时候想，是不是我真的让他失望了。","我好像一直在等他看见我，但他眼里只有“够不够好”。","有时候我都分不清，我到底是在为自己活，还是在为他活。"]},"conversation":{"type":"自我认知与成长","topic":"自我价值感、父亲期望与自我认同的探索"}},"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6ac08f4429d1fd72fa236","chatId":"8a0cb50282bb4f9e9d5a60ef7ca4dbfc","sessionId":null,"userId":100038,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"那种沉默确实挺让人难受的，好像你的努力没被看见。你希望他说“他在努力了”，最想被确认的，是不是他其实一直有在留意你？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那种沉默确实挺让人难受的，好像你的努力没被看见。你希望他说“他在努力了”，最想被确认的，是不是他其实一直有在留意你？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1817,"promptTokens":207,"completionTokens":140,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 14:19:52"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00521961177823485,"emotions":[],"relationId":"6af6ac08f4429d1fd72fa235","courseProgressId":0,"tsGen":1794550792116,"createTime":"2026-11-13 14:19:52","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourcePr