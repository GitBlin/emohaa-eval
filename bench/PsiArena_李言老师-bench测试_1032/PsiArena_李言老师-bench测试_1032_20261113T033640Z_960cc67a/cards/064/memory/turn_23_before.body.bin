e":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6933bf4429d1fd72f9462","courseProgressId":0,"tsGen":1794544443803,"createTime":"2026-11-13 12:34:03","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af69337f4429d1fd72f9459","chatId":"57a3a01ed13b47658b6009aaf8837e43","sessionId":null,"userId":99977,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"听到这些会比较很正常，比较一出现，很容易把别人的进度当成自己的标尺。可生活节奏本来就不一样，感受不代表事实。你愿意说说，那种“落后”的感觉冒出来时，你心里最先想到的是什么吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听到这些会比较很正常，比较一出现，很容易把别人的进度当成自己的标尺。可生活节奏本来就不一样，感受不代表事实。你愿意说说，那种“落后”的感觉冒出来时，你心里最先想到的是什么吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2151,"promptTokens":198,"completionTokens":170,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 12:33:59"}],"imgs":null,"regenerations":0,"seqNum":27,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575266018594282,"emotions":[],"relationId":"6af69337f4429d1fd72f9458","courseProgressId":0,"tsGen":1794544439229,"createTime":"2026-11-13 12:33:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af69337f4429d1fd72f9458","chatId":"57a3a01ed13b47658b6009aaf8837e43","sessionId":null,"userId":99977,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"嗯……上周和同事吃饭，她们聊买房、聊结婚，我就突然觉得自己什么都落后了。明明知道不该这么想，可就是控制不住。<第13轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"remin