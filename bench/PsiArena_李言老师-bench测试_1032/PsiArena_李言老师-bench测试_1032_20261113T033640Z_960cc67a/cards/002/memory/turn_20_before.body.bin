:"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af6861ef4429d1fd72f860d","courseProgressId":0,"tsGen":1794541086961,"createTime":"2026-11-13 11:38:06","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68619f4429d1fd72f8605","chatId":"d3ae67932ece4cb1a1c846020842abe1","sessionId":null,"userId":99913,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"敏感不一定是你想多了，可能只是你太在意“被落下”的感觉。家里人那句“要合群”，听起来像在说：一个人就不够好。你独处时，最难受的是安静本身，还是那种“我是不是不被需要”的念头？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"敏感不一定是你想多了，可能只是你太在意“被落下”的感觉。家里人那句“要合群”，听起来像在说：一个人就不够好。你独处时，最难受的是安静本身，还是那种“我是不是不被需要”的念头？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1781,"promptTokens":204,"completionTokens":130,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:38:01"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01098329921391764,"emotions":[],"relationId":"6af68619f4429d1fd72f8604","courseProgressId":0,"tsGen":1794541081818,"createTime":"2026-11-13 11:38:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68619f4429d1fd72f8604","chatId":"d3ae67932ece4cb1a1c846020842abe1","sessionId":null,"userId":99913,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"她们……好像也没做什么，就是正常聊天吧。是我自己太敏感了。其实我从小就这样，家里人老说要合群、朋友多才好，我就特别怕自己是一个人。<第11轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":22,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01098329921391764,"emotions":[{"code":"fear","name":"恐惧","value":5,"sort":6},{"code":"calm","name":"平静","value":4,"sort":4},{"code":"sadness","name":"悲伤","value":4,"sort":8},{"code":"dislike","name":"厌恶","value":4,"sort":9},{"code":"trust","name":"信任","value":3,"sort":3},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af68619f4429d1fd72f8605","courseProgressId":0,"tsGen":1794541081815,"createTime":"2026-11-13 11:38:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68615f4429d1fd72f85fc","chatId":"d3ae67932ece4cb1a1c846020842abe1","sessionId":null,"userId":99913,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"听起来你有点把责任都揽在自己身上了。其实社交中的沉默不一定是你的错，对方当时的反应你还记得吗？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来你有点把责任都揽在自己身上了。其实社交中的沉默不一定是你的错，对方当时的反应你还记得吗？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2671,"promptTokens":213,"completionTokens":102,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 11:37:57"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008574255654770976,"emotions":[],"relationId":"6af68615f4429d1fd72f