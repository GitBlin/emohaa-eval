ontext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":34,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.007575888185404063,"emotions":[{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"expect","name":"期待","value":2,"sort":2},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"fear","name":"恐惧","value":1,"sort":6},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"relationId":"6af68e94f4429d1fd72f8f1c","courseProgressId":0,"tsGen":1794543252092,"createTime":"2026-11-13 12:14:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68e90f4429d1fd72f8f18","chatId":"2fb26cd05b244226abc52aec9075da21","sessionId":null,"userId":99956,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"那种饭桌气氛确实让人憋得慌，低头扒饭像在硬吞委屈。你当时最希望爸妈说一句什么，或者做什么反应？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"那种饭桌气氛确实让人憋得慌，低头扒饭像在硬吞委屈。你当时最希望爸妈说一句什么，或者做什么反应？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1648,"promptTokens":199,"completionTokens":95,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 12:14:08"}],"imgs":null,"regenerations":0,"seqNum":33,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.04208208866580114,"emotions":[],"relationId":"6af68e90f4429d1fd72f8f17","courseProgressId":0,"tsGen":1794543248241,"createTime":"2026-11-13 12:14:08","delFlag":0,"emotionTenden