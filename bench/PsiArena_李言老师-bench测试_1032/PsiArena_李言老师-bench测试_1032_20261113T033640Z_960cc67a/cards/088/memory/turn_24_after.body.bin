t":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"心里闷闷的却说不上原因，这并不奇怪，很多感受本来就不是一下子能讲清的。你觉得自己和别人不一样，反而说明你在认真留意自己的状态。这种闷闷的感觉，大概是从什么时候开始出现的？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1692,"promptTokens":203,"completionTokens":107,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 12:56:06"}],"imgs":null,"regenerations":0,"seqNum":9,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014058358416521087,"emotions":[],"relationId":"6af69866f4429d1fd72f9a02","courseProgressId":0,"tsGen":1794545766190,"createTime":"2026-11-13 12:56:06","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af69866f4429d1fd72f9a02","chatId":"69c9d36a8a2647b69e97070942031a10","sessionId":null,"userId":100001,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"（低头）说不太清楚……就是心里闷闷的，说不上来为什么。我们班同学好像都比我轻松，就我这样，是不是我太奇怪了？<第4轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":8,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014058358416521087,"emotions":[{"code":"sadness","name":"悲伤","value":6,"sort":8},{"code":"dislike","name":"厌恶","value":6,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"trust","name":"信任","value":1,"sort":3},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"expect","name":"期待","value":0,"sort":2},{"code":"surprised","name":"惊讶","value":0,"sort":5},{"code":"anger","name":"愤怒","value":0,"sort":7}],"rel