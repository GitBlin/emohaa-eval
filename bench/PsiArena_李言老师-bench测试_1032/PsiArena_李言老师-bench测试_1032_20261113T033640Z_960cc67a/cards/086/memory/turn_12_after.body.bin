":false,"isSuicideConf":0.015898755652101363,"emotions":[{"code":"sadness","name":"悲伤","value":7,"sort":8},{"code":"dislike","name":"厌恶","value":7,"sort":9},{"code":"trust","name":"信任","value":4,"sort":3},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"anger","name":"愤怒","value":2,"sort":7},{"code":"happy","name":"快乐","value":1,"sort":1},{"code":"expect","name":"期待","value":1,"sort":2},{"code":"surprised","name":"惊讶","value":1,"sort":5}],"relationId":"6af697e2f4429d1fd72f9999","courseProgressId":0,"tsGen":1794545634934,"createTime":"2026-11-13 12:53:54","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af697def4429d1fd72f998f","chatId":"6e61c43fdb144546b7a2dfe1934648aa","sessionId":null,"userId":99999,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"听起来你当时把“做好”当成不被说的办法，委屈和害怕都只能先压着。现在回头看，你最想先照顾哪一种感受？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来你当时把“做好”当成不被说的办法，委屈和害怕都只能先压着。现在回头看，你最想先照顾哪一种感受？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":1541,"promptTokens":200,"completionTokens":103,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 12:53:50"}],"imgs":null,"regenerations":0,"seqNum":21,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575415225524541,"emotions":[],"relationId":"6af697def4429d1fd72f998e","courseProgressId":0,"tsGen":1794545630207,"createTime":"2026-11-13 12:53:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af697def4429d1fd72f998e","chatId":"6e61c43fdb144546b7a2dfe1934648aa","s