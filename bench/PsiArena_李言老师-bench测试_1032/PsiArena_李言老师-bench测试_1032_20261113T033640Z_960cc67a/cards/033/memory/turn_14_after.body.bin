ents":[],"imgs":null,"regenerations":0,"seqNum":24,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.003172556457976969,"emotions":[{"code":"expect","name":"期待","value":7,"sort":2},{"code":"sadness","name":"悲伤","value":5,"sort":8},{"code":"dislike","name":"厌恶","value":5,"sort":9},{"code":"fear","name":"恐惧","value":3,"sort":6},{"code":"anger","name":"愤怒","value":3,"sort":7},{"code":"trust","name":"信任","value":2,"sort":3},{"code":"calm","name":"平静","value":2,"sort":4},{"code":"happy","name":"快乐","value":0,"sort":1},{"code":"surprised","name":"惊讶","value":0,"sort":5}],"relationId":"6af68c2bf4429d1fd72f8c66","courseProgressId":0,"tsGen":1794542635224,"createTime":"2026-11-13 12:03:55","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af68c24f4429d1fd72f8c5f","chatId":"969e68bf017c43f3bb9dc36058d1df30","sessionId":null,"userId":99946,"orgId":3721,"botId":1032,"isGreeting":false,"role":"role","content":"不傻，你是在意关系，也在保护自己。别急着用“神经质”否定自己。你希望他怎么回应你的担心，才会让你觉得被尊重？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"不傻，你是在意关系，也在保护自己。别急着用“神经质”否定自己。你希望他怎么回应你的担心，才会让你觉得被尊重？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":2841,"promptTokens":202,"completionTokens":180,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 12:03:48"}],"imgs":null,"regenerations":0,"seqNum":23,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.02032377576274093,"emotions":[],"relationId":"6af68c24f4429d1fd72f8c5e","courseProgressId":0,"tsGen":1794542628256,"createTime":"2026-11-13 12:03:48","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageN