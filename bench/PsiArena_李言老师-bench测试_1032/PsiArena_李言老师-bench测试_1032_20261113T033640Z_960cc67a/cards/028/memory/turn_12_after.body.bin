eting":false,"role":"role","content":"听起来你被反复盘问和临时拦下，确实很憋屈，明明提前说好了还不被信任。这种追着问最让你难受的，是隐私被追问，还是计划总被临时打乱？","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[{"content":"听起来你被反复盘问和临时拦下，确实很憋屈，明明提前说好了还不被信任。这种追着问最让你难受的，是隐私被追问，还是计划总被临时打乱？","options":null,"isShow":true,"label":"","evaluate":"","takingTime":3088,"promptTokens":200,"completionTokens":249,"responseSource":"agent:llm","censorData":{"labels":null,"words":null},"createTime":"2026-11-13 13:55:41"}],"imgs":null,"regenerations":0,"seqNum":17,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014060004991644597,"emotions":[],"relationId":"6af6a65df4429d1fd72f9f2a","courseProgressId":0,"tsGen":1794549341834,"createTime":"2026-11-13 13:55:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6a65df4429d1fd72f9f2a","chatId":"295cb72642454503a4d072d8c6ed225b","sessionId":null,"userId":100028,"orgId":3721,"botId":1032,"isGreeting":false,"role":"user","content":"会追着问，问是男是女，做什么的，几点回。有时候干脆说别去了，家里有事。我明明都提前说好了……<第8轮:让你的回答保持简短，限制每次回复中的信息量，字数限制在100字左右。一次提出一个问题，不要分点描述。>","options":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":16,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014060004991644597,"emotions":[],"relationId":"6af6a65df4429d1fd72f9f2b","courseProgressId":0,"tsGen":1794549341831,"createTime":"2026-11-13 13:55:41","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null},{"pageNum":0,"pageSize":0,"id":"6af6a658f4429d1fd72f9f27","chatId":"2