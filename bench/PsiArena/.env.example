# Copy to .env. This file contains NO usable credentials.
PSIARENA_COUNSELOR_PROVIDER=ai_role
PSIARENA_AI_ROLE_BOT_ID=1030
PSIARENA_AI_ROLE_BASE_URL=https://www.ai-role.cn
# Empty values fall back to DEFAULT_API_KEY/SECRET constants in ../../bot_chat_client.py.
PSIARENA_AI_ROLE_API_KEY=
PSIARENA_AI_ROLE_API_SECRET=
# Optional absolute credential file; never copied to run snapshots.
# PSIARENA_AI_ROLE_CREDENTIAL_FILE=/absolute/path/bot_chat_client.py

# Local adaptation: DeepSeek Flash client and all three judge perspectives.
# This differs from the GPT-4o configuration in paper arXiv v1.
PSIARENA_CLIENT_MODEL=deepseek-v4.1-flash-1017
PSIARENA_JUDGE_MODEL=deepseek-v4.1-flash-1017
PSIARENA_CLIENT_THINKING=enabled
PSIARENA_JUDGE_THINKING=enabled
PSIARENA_BASE_URL=https://axonhub.ai-role.cn/v1
PSIARENA_API_KEY=
# Per-role BASE_URL/API_KEY may override shared values.
PSIARENA_TEMPERATURE=0.7
PSIARENA_MAX_TOKENS=2048
# 16-dimension analyses can exceed 2048 tokens. Truncation is rejected.
PSIARENA_JUDGE_MAX_TOKENS=16384
PSIARENA_TIMEOUT=180
PSIARENA_CLIENT_REASONING_EFFORT=medium
PSIARENA_JUDGE_REASONING_EFFORT=medium
PSIARENA_CLIENT_MAX_TOKENS=8192
