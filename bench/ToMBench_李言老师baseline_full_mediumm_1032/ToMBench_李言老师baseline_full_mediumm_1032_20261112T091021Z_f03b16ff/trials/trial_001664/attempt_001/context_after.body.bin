Context":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0031720779812876225,"emotions":[],"relationId":"6af587bc9aa9dc5a833d4866","courseProgressId":0,"tsGen":1794475964673,"createTime":"2026-11-12 17:32:44","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"78685530d0684ad1bede50b4fcc1c8b8"}