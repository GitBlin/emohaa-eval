inderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005220126389977382,"emotions":[],"relationId":"6af5861a9aa9dc5a833d3f24","courseProgressId":0,"tsGen":1794475546227,"createTime":"2026-11-12 17:25:46","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"9ae34c4ff92849a29e436e4815d1e3e2"}