l,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218851053984229,"emotions":[],"relationId":"6af58a629aa9dc5a833d5187","courseProgressId":0,"tsGen":1794476642377,"createTime":"2026-11-12 17:44:02","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"f1a32fecc3b446238bf2cbff8fb61be6"}