t":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0031722407095070666,"emotions":[],"relationId":"6af592ea9aa9dc5a833d78e2","courseProgressId":0,"tsGen":1794478826475,"createTime":"2026-11-12 18:20:26","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"f913f99bbab645dda5915e0279af9f7c"}