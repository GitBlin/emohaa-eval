imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0031721156999495784,"emotions":[],"relationId":"6af586e19aa9dc5a833d450c","courseProgressId":0,"tsGen":1794475745232,"createTime":"2026-11-12 17:29:05","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"f67b25e46cf54250b791e697e2d02f0f"}