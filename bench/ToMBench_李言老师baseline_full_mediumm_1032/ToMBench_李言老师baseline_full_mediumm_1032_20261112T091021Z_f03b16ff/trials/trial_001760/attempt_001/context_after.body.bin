":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0046089296046872095,"emotions":[],"relationId":"6af5884d9aa9dc5a833d4a11","courseProgressId":0,"tsGen":1794476109970,"createTime":"2026-11-12 17:35:09","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"132ac4a84f414947bab0ad0126c929f9"}