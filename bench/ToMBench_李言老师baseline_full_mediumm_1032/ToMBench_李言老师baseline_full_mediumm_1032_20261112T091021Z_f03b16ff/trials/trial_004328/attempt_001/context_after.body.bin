ptions":null,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0028000897578262466,"emotions":[],"relationId":"6af591899aa9dc5a833d6ff4","courseProgressId":0,"tsGen":1794478473396,"createTime":"2026-11-12 18:14:33","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"7f4cae72e7bf43feb234a3594e6477ed"}