Context":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005220124764999895,"emotions":[],"relationId":"6af5938f9aa9dc5a833d7c30","courseProgressId":0,"tsGen":1794478991187,"createTime":"2026-11-12 18:23:11","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"acbcdbde8eac4128927438bb243f7334"}