l,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005218701574513798,"emotions":[],"relationId":"6af595149aa9dc5a833d83b0","courseProgressId":0,"tsGen":1794479380415,"createTime":"2026-11-12 18:29:40","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"485a9ac708864d0f99cdf3b8e927c032"}