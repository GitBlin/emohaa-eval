nt":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":9.108196916149625E-4,"emotions":[],"relationId":"6af5847a9aa9dc5a833d3699","courseProgressId":0,"tsGen":1794475130883,"createTime":"2026-11-12 17:18:50","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"86524d6a2b814588b1009dee17f1fc7c"}