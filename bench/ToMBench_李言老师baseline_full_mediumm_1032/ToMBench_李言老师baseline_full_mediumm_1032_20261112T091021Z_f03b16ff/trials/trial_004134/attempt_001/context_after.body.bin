l,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.005219249628795735,"emotions":[],"relationId":"6af591039aa9dc5a833d6d35","courseProgressId":0,"tsGen":1794478339045,"createTime":"2026-11-12 18:12:19","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"9b962111666f40c9984de2ecb5174905"}