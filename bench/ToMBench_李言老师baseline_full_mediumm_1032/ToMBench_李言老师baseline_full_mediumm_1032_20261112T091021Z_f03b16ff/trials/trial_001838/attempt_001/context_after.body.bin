:null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.002182411538082325,"emotions":[],"relationId":"6af588969aa9dc5a833d4b56","courseProgressId":0,"tsGen":1794476182775,"createTime":"2026-11-12 17:36:22","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"a9c10713c9584f20baed2b32243a01bf"}