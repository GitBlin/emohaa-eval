ent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0059110695567328965,"emotions":[],"relationId":"6af585ab9aa9dc5a833d3df6","courseProgressId":0,"tsGen":1794475435348,"createTime":"2026-11-12 17:23:55","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"e1c9cf6c9637400c9a4a2cb081cc70f9"}