Content":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.012431650304356473,"emotions":[],"relationId":"6af5839e9aa9dc5a833d2ee2","courseProgressId":0,"tsGen":1794474910879,"createTime":"2026-11-12 17:15:10","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"c19d071f175440c6ba8ab1ff2f85ce0e"}