l,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0031721145457594894,"emotions":[],"relationId":"6af586599aa9dc5a833d40b4","courseProgressId":0,"tsGen":1794475609065,"createTime":"2026-11-12 17:26:49","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"298d343311904690a2dc907d0642ddca"}