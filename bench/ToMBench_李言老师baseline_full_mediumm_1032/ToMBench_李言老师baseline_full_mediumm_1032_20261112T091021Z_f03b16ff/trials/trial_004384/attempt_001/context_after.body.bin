l,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008575754598872205,"emotions":[],"relationId":"6af591c19aa9dc5a833d70c8","courseProgressId":0,"tsGen":1794478529157,"createTime":"2026-11-12 18:15:29","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"d67a7d63b4da4e56a7b5ba7d32c34986"}