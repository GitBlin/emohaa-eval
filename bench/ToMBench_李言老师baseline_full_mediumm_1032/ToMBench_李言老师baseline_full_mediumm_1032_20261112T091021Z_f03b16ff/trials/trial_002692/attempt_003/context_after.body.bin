ontent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":4,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01098694101139889,"emotions":[],"relationId":"6af58c7c9aa9dc5a833d58a6","courseProgressId":0,"tsGen":1794477180736,"createTime":"2026-11-12 17:53:00","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"faece68257c94a48b9b2c27c2f313093"}