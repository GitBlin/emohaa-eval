l,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":3,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0035929175491991937,"emotions":[],"relationId":"6af58bb99aa9dc5a833d55f9","courseProgressId":0,"tsGen":1794476985631,"createTime":"2026-11-12 17:49:45","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"dba65fabde774c3ebffa9ecc90b27a47"}