nt":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0031720401402784786,"emotions":[],"relationId":"6af583709aa9dc5a833d2d4f","courseProgressId":0,"tsGen":1794474864945,"createTime":"2026-11-12 17:14:24","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"23853a726cc74413981ac14c6b789dd0"}