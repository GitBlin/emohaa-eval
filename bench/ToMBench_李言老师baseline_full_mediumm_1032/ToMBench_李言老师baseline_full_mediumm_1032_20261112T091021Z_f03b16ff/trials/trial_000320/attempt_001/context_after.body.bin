ull,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.003592777221670745,"emotions":[],"relationId":"6af583469aa9dc5a833d2abd","courseProgressId":0,"tsGen":1794474822510,"createTime":"2026-11-12 17:13:42","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"191ddd42d96d4ab58cf41a31438c333a"}