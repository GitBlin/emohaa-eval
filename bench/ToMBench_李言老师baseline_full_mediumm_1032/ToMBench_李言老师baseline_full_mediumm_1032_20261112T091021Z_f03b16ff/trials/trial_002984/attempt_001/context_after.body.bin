":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0035936034084446643,"emotions":[],"relationId":"6af58d429aa9dc5a833d5c7e","courseProgressId":0,"tsGen":1794477378314,"createTime":"2026-11-12 17:56:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"90c61cd5081041d987d6dc0d253d3799"}