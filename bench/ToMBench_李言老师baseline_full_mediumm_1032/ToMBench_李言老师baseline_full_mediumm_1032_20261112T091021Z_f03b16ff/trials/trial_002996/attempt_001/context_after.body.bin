geContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.015906387979758903,"emotions":[],"relationId":"6af58d489aa9dc5a833d5ca0","courseProgressId":0,"tsGen":1794477384419,"createTime":"2026-11-12 17:56:24","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"46e5e76bd5704b7e89c142c1907abc7a"}