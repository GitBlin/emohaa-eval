l,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0019263895558118162,"emotions":[],"relationId":"6af58d069aa9dc5a833d5b30","courseProgressId":0,"tsGen":1794477318672,"createTime":"2026-11-12 17:55:18","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"cdcf5b95da8c45dab9d70e8fa8bdd26b"}