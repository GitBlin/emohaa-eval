ull,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0019265719136542557,"emotions":[],"relationId":"6af58fff9aa9dc5a833d68d0","courseProgressId":0,"tsGen":1794478079764,"createTime":"2026-11-12 18:07:59","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"b48192ea24264005aec638bcbb9086cc"}