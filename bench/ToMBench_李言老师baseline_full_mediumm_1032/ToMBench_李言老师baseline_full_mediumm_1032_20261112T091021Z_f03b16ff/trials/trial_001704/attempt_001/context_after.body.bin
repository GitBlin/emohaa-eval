nt":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.014060627566575515,"emotions":[],"relationId":"6af587f19aa9dc5a833d4926","courseProgressId":0,"tsGen":1794476017096,"createTime":"2026-11-12 17:33:37","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"128d011ce93b419bbe224acf6b5501d7"}