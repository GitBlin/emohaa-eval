:null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0031721145925985915,"emotions":[],"relationId":"6af583649aa9dc5a833d2cb7","courseProgressId":0,"tsGen":1794474852616,"createTime":"2026-11-12 17:14:12","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"62a79ece98ad41fc93641890e2a63fd3"}