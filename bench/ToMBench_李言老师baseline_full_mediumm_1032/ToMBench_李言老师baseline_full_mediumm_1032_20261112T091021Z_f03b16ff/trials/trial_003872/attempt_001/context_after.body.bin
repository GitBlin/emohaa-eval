ll,"imageContent":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.003592959934238935,"emotions":[],"relationId":"6af590169aa9dc5a833d695a","courseProgressId":0,"tsGen":1794478102710,"createTime":"2026-11-12 18:08:22","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"317f1bc39e3c4919b6e6b77cd84daa1b"}