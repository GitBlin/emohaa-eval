t":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.008576049303295466,"emotions":[],"relationId":"6af5866e9aa9dc5a833d41da","courseProgressId":0,"tsGen":1794475630060,"createTime":"2026-11-12 17:27:10","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"72da60d1e9044b7da572454deab7b315"}