":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00280032232901303,"emotions":[],"relationId":"6af5923b9aa9dc5a833d7479","courseProgressId":0,"tsGen":1794478651667,"createTime":"2026-11-12 18:17:31","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"ac8a032bc1014512a81b14378ed9aa1c"}