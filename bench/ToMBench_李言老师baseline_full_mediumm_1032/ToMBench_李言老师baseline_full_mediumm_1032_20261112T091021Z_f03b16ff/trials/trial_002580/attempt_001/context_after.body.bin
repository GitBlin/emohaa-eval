udioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.003172682159148626,"emotions":[],"relationId":"6af58bf99aa9dc5a833d56ae","courseProgressId":0,"tsGen":1794477049070,"createTime":"2026-11-12 17:50:49","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"c771c11dc1034505a4d49ac7d026e766"}