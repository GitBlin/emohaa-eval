":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004608638789608479,"emotions":[],"relationId":"6af5927b9aa9dc5a833d75bf","courseProgressId":0,"tsGen":1794478715683,"createTime":"2026-11-12 18:18:35","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"db655cbef8dd401d9fdb8f3834a3a096"}