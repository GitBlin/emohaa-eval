inderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0024723192527976432,"emotions":[],"relationId":"6af58c079aa9dc5a833d56f3","courseProgressId":0,"tsGen":1794477063358,"createTime":"2026-11-12 17:51:03","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"794a9e2bba5b4dff9d9790c7b3314697"}