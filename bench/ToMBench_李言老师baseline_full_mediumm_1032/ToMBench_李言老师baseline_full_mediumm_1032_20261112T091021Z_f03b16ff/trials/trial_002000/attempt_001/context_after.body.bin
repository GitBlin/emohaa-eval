nt":null,"audioContent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.006692850032711037,"emotions":[],"relationId":"6af589349aa9dc5a833d4df6","courseProgressId":0,"tsGen":1794476340077,"createTime":"2026-11-12 17:39:00","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"166aab960e2841838be50c3730ff3465"}