l,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":3,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0028006415057913615,"emotions":[],"relationId":"6af5897b9aa9dc5a833d4ed0","courseProgressId":0,"tsGen":1794476411409,"createTime":"2026-11-12 17:40:11","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"778c8138117248d3a2cb27d35f496580"}