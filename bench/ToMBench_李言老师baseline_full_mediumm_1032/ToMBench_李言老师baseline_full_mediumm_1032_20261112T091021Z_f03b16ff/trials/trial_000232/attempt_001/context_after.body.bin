":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0066928520139863485,"emotions":[],"relationId":"6af5831d9aa9dc5a833d2888","courseProgressId":0,"tsGen":1794474781024,"createTime":"2026-11-12 17:13:01","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"b6805144bb3148b5ba60cf4570c20bdd"}