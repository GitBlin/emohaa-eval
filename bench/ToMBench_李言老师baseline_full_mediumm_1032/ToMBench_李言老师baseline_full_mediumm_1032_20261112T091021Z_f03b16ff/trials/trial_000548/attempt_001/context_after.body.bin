null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.029312228207457852,"emotions":[],"relationId":"6af583d09aa9dc5a833d30df","courseProgressId":0,"tsGen":1794474960014,"createTime":"2026-11-12 17:16:00","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"b53698a9df004621abb0c0290a4a8123"}