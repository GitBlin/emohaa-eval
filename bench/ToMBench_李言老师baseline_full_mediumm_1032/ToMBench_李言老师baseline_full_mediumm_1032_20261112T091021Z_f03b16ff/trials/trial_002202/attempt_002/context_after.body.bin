l,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":3,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0013247252827384849,"emotions":[],"relationId":"6af58a389aa9dc5a833d5109","courseProgressId":0,"tsGen":1794476600026,"createTime":"2026-11-12 17:43:20","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"932e65a1dff046e5977f23a93b5c26b7"}