nt":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.010986941820996006,"emotions":[],"relationId":"6af58e459aa9dc5a833d60ba","courseProgressId":0,"tsGen":1794477637916,"createTime":"2026-11-12 18:00:37","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"05393b132022466d946ce01e822bb6e1"}