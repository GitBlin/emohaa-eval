ntent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.004069454522592738,"emotions":[],"relationId":"6af590e09aa9dc5a833d6cbd","courseProgressId":0,"tsGen":1794478304369,"createTime":"2026-11-12 18:11:44","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"2e437c92288b4b3fa5574f0ac98a78c7"}