":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.00970847848715727,"emotions":[],"relationId":"6af5871b9aa9dc5a833d45e8","courseProgressId":0,"tsGen":1794475803812,"createTime":"2026-11-12 17:30:03","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"ad6d60c98cca4f28b9b1ef80e50d3337"}