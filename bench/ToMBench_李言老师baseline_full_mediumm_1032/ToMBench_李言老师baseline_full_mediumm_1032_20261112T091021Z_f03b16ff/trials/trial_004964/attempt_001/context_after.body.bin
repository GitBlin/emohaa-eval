inderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0035931605834318443,"emotions":[],"relationId":"6af593649aa9dc5a833d7b6c","courseProgressId":0,"tsGen":1794478948293,"createTime":"2026-11-12 18:22:28","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"0cb72025a5f44240b6441a3eb0b49697"}