ent":null,"videoContent":null,"reminderContext":null,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.01798261661319299,"emotions":[],"relationId":"6af5839a9aa9dc5a833d2ea7","courseProgressId":0,"tsGen":1794474906306,"createTime":"2026-11-12 17:15:06","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"bba4a35d748b4302868515d6cdbbd43e"}