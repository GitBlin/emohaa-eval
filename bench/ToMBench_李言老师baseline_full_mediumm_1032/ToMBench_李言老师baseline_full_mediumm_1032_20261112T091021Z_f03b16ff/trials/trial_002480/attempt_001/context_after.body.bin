erUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.0052191937747343,"emotions":[],"relationId":"6af58b7a9aa9dc5a833d5502","courseProgressId":0,"tsGen":1794476922019,"createTime":"2026-11-12 17:48:42","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"49b0c30ab94640f1a880d1f4179f316c"}