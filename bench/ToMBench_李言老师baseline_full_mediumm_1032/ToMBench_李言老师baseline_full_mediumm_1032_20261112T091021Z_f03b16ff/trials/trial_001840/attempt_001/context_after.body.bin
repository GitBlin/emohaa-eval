l,"videoCoverUrl":null,"chips":null,"customMessage":null,"media":null,"mediaTime":null,"interceptContent":null,"contents":[],"imgs":null,"regenerations":0,"seqNum":2,"responseSource":"agent:llm","isSuicide":false,"isSuicideConf":0.015906392178321748,"emotions":[],"relationId":"6af588999aa9dc5a833d4b5e","courseProgressId":0,"tsGen":1794476185165,"createTime":"2026-11-12 17:36:25","delFlag":0,"emotionTendency":null,"sourceProductType":null,"sourceProductId":null,"consultantBotId":null,"consultantUserId":null}],"first":true,"last":true},"nonce":"a5d2c79a77c544869fedefa917f10f73"}